<Project Sdk="Microsoft.NET.Sdk">

  <!-- Always On Top's logic with no WPF, Avalonia or Win32: its settings, the tool as the page sees it (IAlwaysOnTop) and
       the page's view model. The Windows app adds the engine (WinEvent hook, topmost, the border overlays, the shortcut);
       the shared page is Helm.Modules.AlwaysOnTop.UI. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Modules.AlwaysOnTop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core\Helm.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Modules.AlwaysOnTop" />
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>
