<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Wallet"
             xmlns:core="using:Helm.Core.Ui"
             x:Class="Helm.Modules.Wallet.Ui.WalletView"
             x:DataType="vm:WalletViewModel">

    <!-- Wallet itself, the same view on every platform: today's line with the tabs (Money · Debts · Goals · Insights) and
         the gear, then the tab. Every add, edit and detail opens one sheet that follows the view model's pop-up
         (WalletPopupView); the settings are a sheet behind the gear. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Helm.Modules.Wallet.UI/WalletStyles.axaml" />
    </UserControl.Styles>

    <Panel>
        <core:Backdrop />
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Page" Margin="40,28,40,40">

                <!-- A phone's page has no app bar: the menu button opens the drawer -->
                <StackPanel x:Name="MenuRow" IsVisible="False" Margin="0,0,0,12">
                    <Button Classes="chip" HorizontalAlignment="Left" Click="Menu_Click" ToolTip.Tip="Menu" AutomationProperties.Name="Open navigation">
                        <ic:SymbolIcon Symbol="Navigation" FontSize="16" />
                    </Button>
                </StackPanel>

                <!-- Today, and which view -->
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock x:Name="TodayLine" Classes="eyebrow" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                    <StackPanel x:Name="Tabs" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Border Classes="glass" Padding="3" CornerRadius="10" BoxShadow="">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <RadioButton x:Name="MoneyTab" Classes="seg" GroupName="WalletTab" IsChecked="True" Content="Money" IsCheckedChanged="Tab_Changed" />
                                <RadioButton x:Name="DebtsTab" Classes="seg" GroupName="WalletTab" Content="Debts" IsCheckedChanged="Tab_Changed" IsVisible="{Binding HasDebts}" />
                                <RadioButton x:Name="GoalsTab" Classes="seg" GroupName="WalletTab" Content="Goals" IsCheckedChanged="Tab_Changed" IsVisible="{Binding HasGoals}" />
                                <RadioButton x:Name="InsightsTab" Classes="seg" GroupName="WalletTab" Content="Insights" IsCheckedChanged="Tab_Changed" />
                            </StackPanel>
                        </Border>
                        <Button Classes="chip" Click="Settings_Click" ToolTip.Tip="Wallet settings" AutomationProperties.Name="Wallet settings">
                            <ic:SymbolIcon Symbol="Settings" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="OffBar" Classes="glass" Margin="0,16,0,0" IsVisible="False">
                    <StackPanel>
                        <TextBlock Text="Wallet is turned off" Classes="head" />
                        <TextBlock Text="Your transactions, debts and goals are kept, but new ones are not saved. Turn Wallet on in its settings (the gear)." Classes="muted" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Body">
                    <!-- A problem, or a notice about the last action -->
                    <Border Classes="glass" core:Motion.EnterOnShow="True" Margin="0,16,0,0" IsVisible="{Binding HasMessage}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="flat" Width="36" Height="36" Padding="0" Command="{Binding DismissMessageCommand}"
                                    ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss">
                                <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- The phone cannot read the banks' notifications yet: the one thing to fix first -->
                    <Border Classes="glass hero" Margin="0,16,0,0" IsVisible="{Binding NeedsAccess}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="eyebrow" Text="ONE STEP LEFT" />
                                <TextBlock Text="Turn on notification access" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" FontSize="13"
                                           Text="To save your transactions by itself, Helm reads your bank's notifications. Nothing else is read or sent anywhere." />
                            </StackPanel>
                            <Button Classes="pill" HorizontalAlignment="Stretch" Content="Open notification access" Command="{Binding OpenNotificationAccessCommand}" />
                            <StackPanel Spacing="6" IsVisible="{Binding ShowRestrictedHelp}">
                                <TextBlock Text="Android blocked it (“Restricted setting”)?" FontWeight="SemiBold" />
                                <TextBlock Classes="muted" Text="1. Try turning Helm on in Notification access and close the block message. Android only offers the next step after that." />
                                <TextBlock Classes="muted" Text="2. Open App info, tap ⋮ (top right) → Allow restricted settings, and confirm." />
                                <TextBlock Classes="muted" Text="3. Open notification access again and turn Helm on." />
                                <Button Classes="ghost" HorizontalAlignment="Stretch" Content="Open App info" Command="{Binding OpenAppDetailsCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ContentControl x:Name="TabHost" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- The notice that goes by itself ("Added 45,000 ₫ · Ăn uống: 1,240,000 ₫ left") -->
        <Border x:Name="Toast" Classes="toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,24" IsHitTestVisible="False"
                IsVisible="{Binding HasToast}" core:Motion.EnterOnShow="True">
            <Grid ColumnDefinitions="Auto,*">
                <ic:SymbolIcon Symbol="CheckmarkCircle" IconVariant="Filled" FontSize="18" Margin="0,0,10,0" Foreground="{DynamicResource HelmSuccess}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Toast}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Panel>
</UserControl>
