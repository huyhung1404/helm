<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Vault.ViewModels"
             xmlns:core="using:Helm.Core.Ui"
             xmlns:local="using:Helm.Modules.Vault.Ui"
             x:Class="Helm.Modules.Vault.Ui.VaultView"
             x:DataType="vm:VaultAppViewModel">

    <UserControl.Styles>
        <Style Selector="Border.tile">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource HelmEyebrow}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
            <Setter Property="Foreground" Value="{DynamicResource HelmEyebrow}" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <core:Backdrop />
        <Grid x:Name="Page" RowDefinitions="Auto,*" Margin="40,28,40,24">

            <!-- Where we are, and what can be done: the guide, lock, the settings (the gear) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <Grid x:Name="TopBar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel>
                        <TextBlock x:Name="Eyebrow" Classes="eyebrow" TextWrapping="Wrap" Margin="0,0,12,0" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                            <Image x:Name="Logo" Width="38" Height="38" VerticalAlignment="Center" />
                            <TextBlock Classes="display" Text="Vault" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Button Classes="chip" Click="Guide_Click" ToolTip.Tip="How the vault works" AutomationProperties.Name="User guide">
                            <ic:SymbolIcon Symbol="QuestionCircle" FontSize="16" />
                        </Button>
                        <Button Classes="ghost" IsVisible="{Binding IsItems}" Command="{Binding LockCommand}" ToolTip.Tip="Lock" AutomationProperties.Name="Lock">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="LockClosed" FontSize="14" />
                                <TextBlock Classes="label" Text="Lock" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="chip" Click="Settings_Click" ToolTip.Tip="Vault settings" AutomationProperties.Name="Vault settings">
                            <ic:SymbolIcon Symbol="Settings" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>
                <Border x:Name="OffBar" Classes="glass" Margin="0,16,0,0" IsVisible="False">
                    <StackPanel>
                        <TextBlock Text="Vault is turned off" Classes="head" />
                        <TextBlock Text="Your items are kept. Turn the vault on in its settings to use it." Classes="muted" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Panel x:Name="Body" Grid.Row="1">
                <!-- Setup, locked, a new password, the Emergency Kit: one card in the middle, the next step is the only thing to do -->
                <ScrollViewer x:Name="AuthScroller" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
                    <StackPanel MaxWidth="540" Spacing="14" Margin="0,4,0,24">

                        <!-- First run: create the vault, or bring one back -->
                        <StackPanel Spacing="14" IsVisible="{Binding IsSetup}" core:Motion.EnterOnShow="True">
                            <Border Classes="glass hero" Padding="26,24">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="eyebrow" Text="START HERE" />
                                        <TextBlock Text="Create your vault" FontSize="24" FontWeight="SemiBold" />
                                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                                   Text="Choose a vault password you will remember. It is different from your sync passphrase, and nobody can reset it. You also get a recovery key to keep safe." />
                                    </StackPanel>
                                    <TextBox Classes="glass" PasswordChar="•" PlaceholderText="Vault password (at least 14 characters)" Text="{Binding NewPassword}" AutomationProperties.Name="Vault password" />
                                    <TextBlock Classes="secondary" Text="{Binding PasswordStrength}" Margin="2,-4,0,0" />
                                    <TextBox Classes="glass" PasswordChar="•" PlaceholderText="Type it again" Text="{Binding ConfirmPassword}" AutomationProperties.Name="Type it again">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <Button Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding CreateCommand}" AutomationProperties.Name="Create vault">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Create vault" Foreground="{DynamicResource HelmPillForeground}" />
                                            <ic:SymbolIcon Symbol="ArrowRight" FontSize="16" Foreground="{DynamicResource HelmPillForeground}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Classes="glass">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Have a backup?" Classes="head" />
                                        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Restore the whole vault from a backup folder, with that vault's password or its recovery key." />
                                    </StackPanel>
                                    <DockPanel>
                                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding UseRecoveryKey}" OnContent="" OffContent="" AutomationProperties.Name="Use the recovery key" />
                                        <TextBlock Text="Use the recovery key" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBox Classes="glass" PasswordChar="•" PlaceholderText="Vault password of the backup" Text="{Binding Password}" IsVisible="{Binding !UseRecoveryKey}" AutomationProperties.Name="Vault password of the backup" />
                                    <TextBox Classes="glass mono" PlaceholderText="HELMV-XXXX-…" Text="{Binding RecoveryKey}" IsVisible="{Binding UseRecoveryKey}" AutomationProperties.Name="Recovery key of the backup" />
                                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Restore from a backup folder…" Command="{Binding RestoreFromBackupCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Locked: the fingerprint (or face, or Hello) first, else the password or the recovery key -->
                        <Border Classes="glass hero" Padding="26,24" IsVisible="{Binding IsUnlock}" core:Motion.EnterOnShow="True">
                            <StackPanel Spacing="12">
                                <Border Classes="tile" Width="52" Height="52" HorizontalAlignment="Left" CornerRadius="14">
                                    <ic:SymbolIcon Symbol="LockClosed" FontSize="26" Foreground="{DynamicResource HelmEyebrow}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Vault is locked" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Your passwords and documents are encrypted on this device." />
                                </StackPanel>
                                <Button Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding CanUseDeviceUnlock}" Command="{Binding QuickUnlockCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ic:SymbolIcon Symbol="Fingerprint" FontSize="18" Foreground="{DynamicResource HelmPillForeground}" />
                                        <TextBlock Text="{Binding DeviceUnlockName, StringFormat='Unlock with {0}'}" Foreground="{DynamicResource HelmPillForeground}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding CanUseDeviceUnlock}">
                                    <Border Height="1" Background="{DynamicResource HelmGlassStroke}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="secondary" Margin="10,0" Text="or type the vault password" />
                                    <Border Grid.Column="2" Height="1" Background="{DynamicResource HelmGlassStroke}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBox x:Name="UnlockPassword" Classes="glass" PasswordChar="•" PlaceholderText="Vault password" Text="{Binding Password}" IsVisible="{Binding !UseRecoveryKey}" AutomationProperties.Name="Vault password">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <TextBox Classes="glass mono" PlaceholderText="Recovery key: HELMV-XXXX-…" Text="{Binding RecoveryKey}" IsVisible="{Binding UseRecoveryKey}" AutomationProperties.Name="Recovery key">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <!-- What went wrong, right under the box -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" core:Motion.EnterOnShow="True">
                                    <ic:SymbolIcon Symbol="ErrorCircle" FontSize="16" Foreground="{DynamicResource HelmDanger}" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource HelmDanger}" Text="{Binding Error}" />
                                </Grid>
                                <Button Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Unlock" Command="{Binding UnlockCommand}" IsVisible="{Binding !CanUseDeviceUnlock}" />
                                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Unlock" Command="{Binding UnlockCommand}" IsVisible="{Binding CanUseDeviceUnlock}" />
                                <Button Classes="link" Command="{Binding ToggleRecoveryKeyCommand}" AutomationProperties.Name="Use the recovery key instead of the password">
                                    <Panel>
                                        <TextBlock Text="Forgot it? Use the recovery key" IsVisible="{Binding !UseRecoveryKey}" />
                                        <TextBlock Text="Use the password" IsVisible="{Binding UseRecoveryKey}" />
                                    </Panel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- After a recovery-key unlock: a new password -->
                        <Border Classes="glass hero" Padding="26,24" IsVisible="{Binding MustChangePassword}" core:Motion.EnterOnShow="True">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="eyebrow" Text="ONE MORE STEP" />
                                    <TextBlock Text="Set a new vault password" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="You unlocked with the recovery key. Choose a new password; the recovery key keeps working." />
                                </StackPanel>
                                <TextBox Classes="glass" PasswordChar="•" PlaceholderText="New password" Text="{Binding NewPassword}" AutomationProperties.Name="New password" />
                                <TextBlock Classes="secondary" Text="{Binding PasswordStrength}" Margin="2,-4,0,0" />
                                <TextBox Classes="glass" PasswordChar="•" PlaceholderText="Type it again" Text="{Binding ConfirmPassword}" AutomationProperties.Name="Type it again" />
                                <Button Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Set password" Command="{Binding SetNewPasswordCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Emergency Kit: shown once -->
                        <Border Classes="glass hero" Padding="26,24" IsVisible="{Binding HasKit}" core:Motion.EnterOnShow="True">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="eyebrow" Text="STEP 2 · RECOVERY KEY" />
                                    <TextBlock Text="Save your Emergency Kit" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                                               Text="This recovery key is the only way back in if you forget the vault password. It is shown only now. Save it, keep it offline, then type it below." />
                                </StackPanel>
                                <Border Classes="tile" Padding="14,12">
                                    <StackPanel Spacing="4">
                                        <SelectableTextBlock FontFamily="monospace" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HelmEyebrow}" Text="{Binding Kit.RecoveryKey}" />
                                        <TextBlock Classes="secondary" Text="{Binding Kit.RecoveryId, StringFormat='Recovery key id: {0}'}" />
                                    </StackPanel>
                                </Border>
                                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding SaveKitCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="ArrowDownload" FontSize="14" /><TextBlock Text="Save the Emergency Kit…" /></StackPanel>
                                </Button>
                                <TextBox Classes="glass mono" PlaceholderText="Type the recovery key to confirm" Text="{Binding KitConfirmation}" AutomationProperties.Name="Type the recovery key to confirm" />
                                <TextBlock Foreground="{DynamicResource HelmDanger}" TextWrapping="Wrap" Text="{Binding KitError}" IsVisible="{Binding KitError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <Button Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="I saved it" Command="{Binding ConfirmKitCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- A problem with the vault itself (the lock screen shows its own under the password) -->
                        <Border Classes="glass" BorderBrush="{DynamicResource HelmDanger}" core:Motion.EnterOnShow="True">
                            <Border.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="Error" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                                    <Binding Path="!IsUnlock" />
                                </MultiBinding>
                            </Border.IsVisible>
                            <TextBlock TextWrapping="Wrap" Text="{Binding Error}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- The vault: warnings that must not be missed, then the items -->
                <Grid x:Name="ItemsHost" RowDefinitions="Auto,*" IsVisible="False">
                    <StackPanel Spacing="8" Margin="0,0,0,12">
                        <Border Classes="glass" BorderBrush="{DynamicResource HelmDanger}" IsVisible="{Binding HeldWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" core:Motion.EnterOnShow="True">
                            <StackPanel Spacing="10">
                                <TextBlock TextWrapping="Wrap" Text="{Binding HeldWarning}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Keep my items" Command="{Binding KeepHeldCommand}" />
                                    <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ApplyHeldCommand}">
                                        <TextBlock Text="Delete them here too" Foreground="{DynamicResource HelmDanger}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Classes="glass" IsVisible="{Binding BackupWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" core:Motion.EnterOnShow="True">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <ic:SymbolIcon Symbol="Warning" FontSize="18" Foreground="{DynamicResource HelmEyebrow}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding BackupWarning}" />
                            </Grid>
                        </Border>
                        <Border Classes="glass" IsVisible="{Binding WeakPasswordWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" core:Motion.EnterOnShow="True">
                            <StackPanel Spacing="10">
                                <TextBlock TextWrapping="Wrap" Text="{Binding WeakPasswordWarning}" />
                                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Change the password…" Click="Settings_Click" />
                            </StackPanel>
                        </Border>
                        <Border Classes="glass" BorderBrush="{DynamicResource HelmDanger}" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" core:Motion.EnterOnShow="True">
                            <TextBlock TextWrapping="Wrap" Text="{Binding Error}" />
                        </Border>
                    </StackPanel>
                    <local:VaultItemsView x:Name="ItemsView" Grid.Row="1" DataContext="{Binding Items}" />
                </Grid>
            </Panel>
        </Grid>
    </Panel>
</UserControl>
