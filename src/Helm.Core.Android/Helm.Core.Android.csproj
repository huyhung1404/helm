<Project Sdk="Microsoft.NET.Sdk">

  <!-- What Android tools build on (the counterpart of Helm.Core.Windows): the module contract, its registration and
       the shared page frame. Tools reference this project, never Helm.App.Android. Namespaces stay Helm.Core.* so a
       tool that exists on both platforms reads the same. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Core</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- The Android SDK's implicit usings clash with Avalonia/BCL names (Application, OperationCanceledException). -->
  <ItemGroup>
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
    <Using Remove="Android.OS.Bundle" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Android" Version="12.1.3" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.343" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <!-- Same pin as Helm.App.Android: Microsoft.Data.Sqlite 8 pulls SQLitePCLRaw 2.1.6 (advisory, no 16 KB pages). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core\Helm.Core.csproj" />
    <ProjectReference Include="..\Helm.Shell\Helm.Shell.csproj" />
  </ItemGroup>

</Project>
