<!-- Helm's Avalonia look, the same on every platform. An app includes it once:
     <StyleInclude Source="avares://Helm.Ui/HelmTheme.axaml" />. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Helm.Core.Ui"
        x:Class="Helm.Core.Ui.HelmTheme">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Same surfaces as the Windows app (WPF-UI Fluent): page, card, stroke, secondary text. -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HelmPageBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="HelmBarBackground" Color="#EBEBEB" />
                    <SolidColorBrush x:Key="HelmCardBackground" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="HelmCardStroke" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="HelmSubtleFill" Color="#0A000000" />
                    <SolidColorBrush x:Key="HelmSecondaryText" Color="#5F5F5F" />
                    <SolidColorBrush x:Key="HelmSuccess" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="HelmWarningBackground" Color="#FFF4CE" />
                    <SolidColorBrush x:Key="HelmInfoBackground" Color="#F2F2F2" />
                    <SolidColorBrush x:Key="HelmDanger" Color="#C42B1C" />
                    <SolidColorBrush x:Key="HelmWarning" Color="#B7791F" />
                    <!-- The bar at the left of a problem card: bright red (broke), yellow (soon), plain (good to know) -->
                    <SolidColorBrush x:Key="HelmAlertDanger" Color="#D92D20" />
                    <SolidColorBrush x:Key="HelmAlertWarning" Color="#C27803" />
                    <SolidColorBrush x:Key="HelmAlertInfo" Color="#475569" />
                    <!-- No glow on the light page -->
                    <BoxShadows x:Key="HelmAlertGlowDanger">0 0 0 0 #00000000</BoxShadows>
                    <BoxShadows x:Key="HelmAlertGlowWarning">0 0 0 0 #00000000</BoxShadows>
                    <BoxShadows x:Key="HelmAlertGlowInfo">0 0 0 0 #00000000</BoxShadows>
                    <SolidColorBrush x:Key="HelmScrim" Color="#66000000" />
                    <!-- Glass pages (Backdrop + Border.glass; the backdrop itself is Helm.Core BackdropSpec), Helm icon colours -->
                    <SolidColorBrush x:Key="HelmSheetBackground" Color="#FCFDFE" />
                    <SolidColorBrush x:Key="HelmGlass" Color="#B8FFFFFF" />
                    <SolidColorBrush x:Key="HelmGlassHover" Color="#EBFFFFFF" />
                    <SolidColorBrush x:Key="HelmGlassStroke" Color="#1F1C2A40" />
                    <SolidColorBrush x:Key="HelmGlassStrokeStrong" Color="#B30E9688" />
                    <SolidColorBrush x:Key="HelmEyebrow" Color="#0B7F74" />
                    <SolidColorBrush x:Key="HelmPillBackground" Color="#1C1F28" />
                    <SolidColorBrush x:Key="HelmPillForeground" Color="#FFFFFF" />
                    <!-- Stacked cards: a tight contact shadow, a short soft one under the bottom edge (negative spread keeps it out of the gap
                         between cards) and a thin light edge on top: they sit on the page like cards, no dark band between them. -->
                    <BoxShadows x:Key="HelmGlassShadow">0 1 1 0 #141C2A40, 0 6 14 -6 #2E1C2A40, inset 0 1 0 0 #CCFFFFFF</BoxShadows>
                    <BoxShadows x:Key="HelmLiftShadow">0 1 1 0 #1A1C2A40, 0 12 22 -6 #401C2A40, inset 0 1 0 0 #FFFFFFFF</BoxShadows>
                    <BoxShadows x:Key="HelmHeroShadow">0 16 40 0 #241C2A40</BoxShadows>
                    <!-- Switches when on: Helm's teal unless BackdropTint gives the colour of the background where they sit -->
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0E9688" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#0B8478" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#09766B" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#0E9688" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#0B8478" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#09766B" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HelmPageBackground" Color="#202020" />
                    <SolidColorBrush x:Key="HelmBarBackground" Color="#1C1C1C" />
                    <SolidColorBrush x:Key="HelmCardBackground" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="HelmCardStroke" Color="#1D1D1D" />
                    <SolidColorBrush x:Key="HelmSubtleFill" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="HelmSecondaryText" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="HelmSuccess" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="HelmWarningBackground" Color="#433519" />
                    <SolidColorBrush x:Key="HelmInfoBackground" Color="#2E2E2E" />
                    <SolidColorBrush x:Key="HelmDanger" Color="#FF99A4" />
                    <SolidColorBrush x:Key="HelmWarning" Color="#FACC15" />
                    <SolidColorBrush x:Key="HelmAlertDanger" Color="#FF3B30" />
                    <SolidColorBrush x:Key="HelmAlertWarning" Color="#FFB800" />
                    <SolidColorBrush x:Key="HelmAlertInfo" Color="#E6EDF5" />
                    <!-- On the dark page the bar lights up a little -->
                    <BoxShadows x:Key="HelmAlertGlowDanger">0 0 12 0 #66FF3B30</BoxShadows>
                    <BoxShadows x:Key="HelmAlertGlowWarning">0 0 12 0 #66FFB800</BoxShadows>
                    <BoxShadows x:Key="HelmAlertGlowInfo">0 0 10 0 #40E6EDF5</BoxShadows>
                    <SolidColorBrush x:Key="HelmScrim" Color="#99000000" />
                    <SolidColorBrush x:Key="HelmSheetBackground" Color="#1B1E24" />
                    <SolidColorBrush x:Key="HelmGlass" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="HelmGlassHover" Color="#21FFFFFF" />
                    <SolidColorBrush x:Key="HelmGlassStroke" Color="#21FFFFFF" />
                    <SolidColorBrush x:Key="HelmGlassStrokeStrong" Color="#9900C9B5" />
                    <SolidColorBrush x:Key="HelmEyebrow" Color="#2FD3C1" />
                    <SolidColorBrush x:Key="HelmPillBackground" Color="#F5F8FC" />
                    <SolidColorBrush x:Key="HelmPillForeground" Color="#161A22" />
                    <BoxShadows x:Key="HelmGlassShadow">0 1 1 0 #40000000, 0 6 14 -6 #66000000, inset 0 1 0 0 #1AFFFFFF</BoxShadows>
                    <BoxShadows x:Key="HelmLiftShadow">0 1 1 0 #4D000000, 0 12 22 -6 #80000000, inset 0 1 0 0 #29FFFFFF</BoxShadows>
                    <BoxShadows x:Key="HelmHeroShadow">0 20 48 0 #73000000</BoxShadows>
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#2FD3C1" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#4FE0D0" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#26B8A8" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#2FD3C1" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#4FE0D0" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#26B8A8" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0B1716" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0B1716" />
                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#0B1716" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Fluent's TextBox template (Avalonia 12.1.3) with HelmTextPresenter in place of TextPresenter, so the word
                 Helm Keyboard is composing shows without an underline. Only the template: HelmTheme.axaml.cs bases this
                 theme on Fluent's TextBox theme at start, so every other setter and state still comes from Fluent. -->
            <ControlTheme x:Key="HelmTextBoxTemplate" TargetType="TextBox">
                <Setter Property="Template">
                    <ControlTemplate>
                        <DataValidationErrors>
                            <Panel>
                                <Border Name="PART_BorderElement"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        MinWidth="{TemplateBinding MinWidth}"
                                        MinHeight="{TemplateBinding MinHeight}" />
                                <Border Margin="{TemplateBinding BorderThickness}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <ContentPresenter Grid.Column="0"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Content="{TemplateBinding InnerLeftContent}" />
                                        <DockPanel x:Name="PART_InnerDockPanel" Grid.Column="1" Margin="{TemplateBinding Padding}">
                                            <TextBlock Name="PART_FloatingPlaceholder"
                                                       Foreground="{TemplateBinding PlaceholderForeground}"
                                                       IsVisible="False"
                                                       Text="{TemplateBinding PlaceholderText}"
                                                       DockPanel.Dock="Top" />
                                            <ScrollViewer Name="PART_ScrollViewer"
                                                          HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                                          VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}"
                                                          IsScrollChainingEnabled="{TemplateBinding (ScrollViewer.IsScrollChainingEnabled)}"
                                                          AllowAutoHide="{TemplateBinding (ScrollViewer.AllowAutoHide)}"
                                                          BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                                                <Panel>
                                                    <TextBlock Name="PART_Placeholder"
                                                               Foreground="{TemplateBinding PlaceholderForeground}"
                                                               Opacity="{DynamicResource TextControlPlaceholderOpacity}"
                                                               Text="{TemplateBinding PlaceholderText}"
                                                               TextAlignment="{TemplateBinding TextAlignment}"
                                                               TextWrapping="{TemplateBinding TextWrapping}"
                                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                                        <TextBlock.IsVisible>
                                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                                            </MultiBinding>
                                                        </TextBlock.IsVisible>
                                                    </TextBlock>
                                                    <ui:HelmTextPresenter Name="PART_TextPresenter"
                                                                          Text="{TemplateBinding Text, Mode=TwoWay}"
                                                                          CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                                                          CaretIndex="{TemplateBinding CaretIndex}"
                                                                          SelectionStart="{TemplateBinding SelectionStart}"
                                                                          SelectionEnd="{TemplateBinding SelectionEnd}"
                                                                          TextAlignment="{TemplateBinding TextAlignment}"
                                                                          TextWrapping="{TemplateBinding TextWrapping}"
                                                                          LineHeight="{TemplateBinding LineHeight}"
                                                                          LetterSpacing="{TemplateBinding LetterSpacing}"
                                                                          PasswordChar="{TemplateBinding PasswordChar}"
                                                                          RevealPassword="{TemplateBinding RevealPassword}"
                                                                          SelectionBrush="{TemplateBinding SelectionBrush}"
                                                                          SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                                                          CaretBrush="{TemplateBinding CaretBrush}"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Panel>
                                                <ScrollViewer.Styles>
                                                    <Style Selector="ScrollContentPresenter#PART_ContentPresenter">
                                                        <Setter Property="Cursor" Value="IBeam" />
                                                    </Style>
                                                </ScrollViewer.Styles>
                                            </ScrollViewer>
                                        </DockPanel>
                                        <ContentPresenter Grid.Column="2"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Content="{TemplateBinding InnerRightContent}" />
                                    </Grid>
                                </Border>
                            </Panel>
                        </DataValidationErrors>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Fluent blue accent (the Windows app follows the Windows accent, blue by default). -->
    <FluentTheme>
        <FluentTheme.Palettes>
            <ColorPaletteResources x:Key="Light" Accent="#0067C0" />
            <ColorPaletteResources x:Key="Dark" Accent="#4CC2FF" />
        </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource HelmCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmCardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="Border.row">
        <Setter Property="BorderBrush" Value="{DynamicResource HelmCardStroke}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,12,0,0" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style Selector="Border.infobar">
        <Setter Property="Background" Value="{DynamicResource HelmInfoBackground}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.infobar.warning">
        <Setter Property="Background" Value="{DynamicResource HelmWarningBackground}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="4,20,0,8" />
    </Style>
    <Style Selector="TextBlock.pagetitle">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="monospace" />
    </Style>
    <Style Selector="Button.flat">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
    </Style>
    <!-- Glass pages: a Backdrop behind, frosted cards (Border.glass), an accent small-caps line above the title -->
    <Style Selector="Border.glass">
        <Setter Property="Background" Value="{DynamicResource HelmGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="BoxShadow" Value="{DynamicResource HelmGlassShadow}" />
    </Style>
    <Style Selector="Border.glass.hero">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStrokeStrong}" />
        <Setter Property="BoxShadow" Value="{DynamicResource HelmHeroShadow}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="Foreground" Value="{DynamicResource HelmEyebrow}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="1.2" />
    </Style>
    <Style Selector="TextBlock.display">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- A glass card that is a button: lifts a little on hover; .selected gets the warm stroke -->
    <Style Selector="Button.glass">
        <Setter Property="Background" Value="{DynamicResource HelmGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.glass /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource HelmGlassShadow}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.glass:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="{DynamicResource HelmLiftShadow}" />
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
    </Style>
    <Style Selector="Button.glass.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStrokeStrong}" />
    </Style>
    <Style Selector="Button.glass.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStrokeStrong}" />
    </Style>
    <!-- BUTTONS AND INPUTS, one rule: radius 10, height 40 (36 for small actions in a card). Three kinds of button:
         pill = the one main action of an area (bright, filled); ghost = a secondary action (thin stroke);
         chip = an icon or option button (thin stroke; .selected / :checked marks it). Inputs use .glass.
         Cards are radius 12, big cards and sheets 16-18; round only for a day in a calendar. -->
    <!-- The one main action on a glass page: a bright pill -->
    <Style Selector="Button.pill">
        <Setter Property="Background" Value="{DynamicResource HelmPillBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource HelmPillForeground}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HelmPillBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource HelmPillForeground}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HelmPillBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource HelmPillForeground}" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <!-- A quiet secondary action next to a pill -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
    </Style>
    <!-- A text box sitting in a glass card: no box of its own -->
    <Style Selector="TextBox.bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,6" />
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.pill:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HelmPillBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource HelmPillForeground}" />
    </Style>
    <Style Selector="Button.pill:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>
    <!-- Inputs on a glass page: the same rounded glass field as the cards around them (40 high, radius 10) -->
    <Style Selector="ComboBox.glass">
        <Setter Property="Background" Value="{DynamicResource HelmGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,0,8,0" />
    </Style>
    <Style Selector="ComboBox.glass:pointerover /template/ Border#Background, ComboBox.glass:focus /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
    </Style>
    <Style Selector="ui|DateTimeBox.glass Button">
        <Setter Property="Background" Value="{DynamicResource HelmGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="ui|DateTimeBox.glass Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
    </Style>
    <Style Selector="TextBox.glass">
        <Setter Property="Background" Value="{DynamicResource HelmGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.glass:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
    </Style>
    <Style Selector="TextBox.glass:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStrokeStrong}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- The list opens under the field, left edges lined up (it centred under the field when wider than it) -->
    <Style Selector="ComboBox.glass /template/ Popup#PART_Popup">
        <Setter Property="Placement" Value="BottomEdgeAlignedLeft" />
    </Style>    <!-- A glass ComboBox's list: a rounded floating card; items are rounded rows, the chosen one marked with the
         accent stroke instead of a solid blue fill -->
    <Style Selector="ComboBox.glass /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource HelmSheetBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BoxShadow" Value="{DynamicResource HelmGlassShadow}" />
    </Style>
    <Style Selector="ComboBox.glass ComboBoxItem">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Padding" Value="12,9" />
    </Style>
    <Style Selector="ComboBox.glass ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
    </Style>
    <Style Selector="ComboBox.glass ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBox.glass ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        <Setter Property="Foreground" Value="{DynamicResource HelmEyebrow}" />
    </Style>
    <!-- A sheet or dialog that floats over a page (the date picker): solid, generously rounded (26), a thin stroke -->
    <Style Selector="Border.sheet">
        <Setter Property="Background" Value="{DynamicResource HelmSheetBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="BoxShadow" Value="{DynamicResource HelmHeroShadow}" />
    </Style>
    <!-- A day in a month grid: round; today ringed in the accent; the chosen day filled like the pill -->
    <Style Selector="Button.day">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.day:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.day.today">
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStrokeStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource HelmEyebrow}" />
    </Style>
    <Style Selector="Button.day.out">
        <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.day.selected">
        <Setter Property="Background" Value="{DynamicResource HelmPillBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource HelmPillForeground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.day.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HelmPillBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource HelmPillForeground}" />
    </Style>
    <!-- A chosen chip (a quick pick that matches the value) -->
    <Style Selector="Button.chip.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStrokeStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource HelmEyebrow}" />
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
    </Style>
    <!-- A small rounded icon or text button on a glass page (40 high, radius 10); a ToggleButton.chip shows on/off -->
    <Style Selector=":is(Button).chip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector=":is(Button).chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
    </Style>
    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStrokeStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
    </Style>

    <!-- Motion. .enter: grows into place (a popup scale) when it appears; a view puts it back on to replay it (a tab, a list).
         .lift: lights up under the pointer. Short and eased, never in the way. -->
    <Style Selector=":is(Control).enter">
        <Setter Property="RenderTransform">
            <ScaleTransform />
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:0.26" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.94" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.94" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- A glass ComboBox's list grows open from its top edge -->
    <Style Selector="ComboBox.glass /template/ Border#PopupBorder">
        <Setter Property="RenderTransformOrigin" Value="50%,0%" />
        <Setter Property="RenderTransform">
            <ScaleTransform />
        </Setter>
    </Style>
    <Style Selector="ComboBox.glass:dropdownopen /template/ Border#PopupBorder">
        <Style.Animations>
            <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.96" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.85" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- .fade: comes in by fading only (for rows that also .lift) -->
    <Style Selector=":is(Control).fade">
        <Style.Animations>
            <Animation Duration="0:0:0.3" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- (Transform strings like "translateY(-2px)" in a Setter do nothing in Avalonia 12: use transform objects and
         animate their properties, as .enter does.) .lift: a card that lights up and casts a deeper shadow under the
         pointer, as a whole. -->
    <Style Selector="Border.glass.lift">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.glass.lift:pointerover">
        <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        <Setter Property="BoxShadow" Value="{DynamicResource HelmLiftShadow}" />
    </Style>

    <!-- A plain disclosure header (a folded section's title with its turning arrow) -->
    <Style Selector="ToggleButton.fold">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,8" />
    </Style>
    <Style Selector="ToggleButton.fold:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.fold:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.fold:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.shimmer">
        <Setter Property="Height" Value="12" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource HelmCardStroke}" />
        <Style.Animations>
            <Animation Duration="0:0:1.6" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ===== Shared by every tool page (moved from TrackerView): text kinds, tags, row hit area, disclosure arrow, small actions, segmented tabs ===== -->
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.late">
            <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
        </Style>
        <Style Selector="TextBlock.done">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
        </Style>
        <Style Selector="TextBlock.head">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.stat">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tag > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- The task's text: a tap target with no look of its own (the whole card lifts and lights up instead) -->
        <Style Selector="Button.rowhit">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.rowhit:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.rowhit:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- A disclosure arrow: points right when closed, turns a quarter (down) when its section opens, and back.
             core:Motion.Turn="{Binding IsExpanded}" on the Panel.turn around a ChevronRight sets .open / .closing. -->
        <Style Selector="Panel.turn">
            <Setter Property="RenderTransform"><RotateTransform /></Setter>
        </Style>
        <Style Selector="Panel.turn.open">
            <Style.Animations>
                <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="90" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Panel.turn.closing">
            <Style.Animations>
                <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="90" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>        <!-- Small outlined action under an open task -->
        <Style Selector=":is(Button).act">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector=":is(Button).act:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
        </Style>
        <Style Selector="ToggleButton.act:checked /template/ ContentPresenter#PART_ContentPresenter, Button.act.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStrokeStrong}" />
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        </Style>
        <Style Selector="Button.act:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.act:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Tasks · Calendar · Insights -->
        <Style Selector="RadioButton.seg">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Seg" Background="Transparent" CornerRadius="8" Padding="14,7">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="RadioButton.seg:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="RadioButton.seg:checked /template/ Border#Seg">
            <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        </Style>
        <Style Selector=":is(UserControl).narrow TextBlock.display">
            <Setter Property="FontSize" Value="28" />
        </Style>
        <!-- On a phone a task's actions are icons in one row (the words are their tooltips and names) -->
        <Style Selector=":is(UserControl).narrow TextBlock.label">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(UserControl).narrow :is(Button).act">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
    <!-- The round tick of a task or habit (Tracker, Home): fills green with a pop when done -->
    <Style Selector="Button.tick">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="-11,-11,-1,-11" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tick:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tick:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tick Border.ring">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmSecondaryText}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tick:pointerover Border.ring">
        <Setter Property="BorderBrush" Value="{DynamicResource HelmEyebrow}" />
    </Style>
    <Style Selector="Button.tick.small Border.ring">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.tick.checked Border.ring">
        <Setter Property="Background" Value="{DynamicResource HelmSuccess}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmSuccess}" />
    </Style>
    <Style Selector="Button.tick Border.ring">
        <Setter Property="RenderTransform"><ScaleTransform /></Setter>
    </Style>
    <Style Selector="Button.tick.checked Border.ring">
        <Style.Animations>
            <Animation Duration="0:0:0.28" Easing="BackEaseOut">
                <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.6" /><Setter Property="ScaleTransform.ScaleY" Value="0.6" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- Every switch takes the colour of the background where it sits (BackdropTint); the teal above is its fallback -->
    <Style Selector="ToggleSwitch">
        <Setter Property="ui:BackdropTint.Enabled" Value="True" />
    </Style>
</Styles>
