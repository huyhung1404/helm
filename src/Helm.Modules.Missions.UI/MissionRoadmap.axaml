<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Missions"
             xmlns:ui="using:Helm.Modules.Missions.Ui"
             xmlns:core="using:Helm.Core.Ui"
             x:Class="Helm.Modules.Missions.Ui.MissionRoadmap"
             x:DataType="vm:MissionsViewModel">

    <!-- The roadmap: every phase as a card with its steps (done, current, to come); tap a step to see how to do it, its
         resources and note, and to edit or delete it. A new step goes at the end. -->
    <UserControl.Styles>
        <!-- The round marker in front of a step: done, skipped, current, or its number -->
        <Style Selector="Border.marker">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStrokeStrong}" />
        </Style>
        <Style Selector="Border.marker.done">
            <Setter Property="Background" Value="{DynamicResource HelmSuccess}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmSuccess}" />
        </Style>
        <Style Selector="Border.marker.skipped">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.marker.current">
            <Setter Property="Background" Value="{DynamicResource HelmPillBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmPillBackground}" />
        </Style>
        <Style Selector="Border.marker > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
        </Style>
        <Style Selector="Border.marker.done > TextBlock">
            <Setter Property="Foreground" Value="#10170F" />
        </Style>
        <Style Selector="Border.marker.current > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HelmPillForeground}" />
        </Style>
        <Style Selector="TextBlock.current">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.skipped">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
        </Style>
    </UserControl.Styles>

    <StackPanel>
        <TextBlock Text="Roadmap" Classes="head" Margin="2,0,0,10" />
        <ItemsControl ItemsSource="{Binding Phases}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:PhaseRow">
                    <Border Classes="glass" Padding="10,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="8,0,6,6">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasReward}" Margin="0,2,0,0">
                                        <ic:SymbolIcon Symbol="Gift" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Top" Foreground="{DynamicResource HelmEyebrow}" />
                                        <TextBlock Grid.Column="1" Text="{Binding RewardText}" Classes="muted" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost" Margin="10,0,0,0" VerticalAlignment="Top" IsVisible="{Binding CanClaimReward}"
                                        Command="{Binding $parent[UserControl].((vm:MissionsViewModel)DataContext).ClaimPhaseRewardCommand}" CommandParameter="{Binding}"
                                        ToolTip.Tip="I took this phase's reward" AutomationProperties.Name="I took the reward">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="Gift" FontSize="14" Foreground="{DynamicResource HelmEyebrow}" />
                                        <TextBlock Classes="label" Text="I took it" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:StepRow">
                                        <StackPanel>
                                            <!-- Tap a step to see its details -->
                                            <Button Classes="rowhit" Padding="8,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    Command="{Binding $parent[UserControl].((vm:MissionsViewModel)DataContext).ToggleStepCommand}" CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Classes="marker" Classes.done="{Binding IsDone}" Classes.skipped="{Binding IsSkipped}" Classes.current="{Binding IsCurrent}"
                                                            Margin="0,0,12,0" VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding Marker}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Classes.current="{Binding IsCurrent}" Classes.skipped="{Binding IsSkipped}" />
                                                        <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Panel Grid.Column="2" Margin="8,5,0,0" VerticalAlignment="Top" Width="12" Height="12" Classes="turn" core:Motion.Turn="{Binding IsExpanded}">
                                                        <ic:SymbolIcon Symbol="ChevronRight" FontSize="12" Foreground="{DynamicResource HelmSecondaryText}" />
                                                    </Panel>
                                                </Grid>
                                            </Button>

                                            <!-- Details -->
                                            <StackPanel Margin="44,0,8,10" Spacing="8" IsVisible="{Binding ShowBody}" core:Motion.EnterOnShow="True" core:Motion.FromTop="True">
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasDoneWhen}">
                                                    <ic:SymbolIcon Symbol="Target" FontSize="14" Margin="0,1,6,0" VerticalAlignment="Top" Foreground="{DynamicResource HelmEyebrow}" />
                                                    <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                                        <Run Text="Done when: " FontWeight="SemiBold" /><Run Text="{Binding DoneWhen}" />
                                                    </TextBlock>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Resources}" IsVisible="{Binding HasResources}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:ResourceRow"><ui:ResourceView /></DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Classes="muted" FontStyle="Italic" TextWrapping="Wrap" IsVisible="{Binding ShowNote}">
                                                    <Run Text="Note: " /><Run Text="{Binding Note}" />
                                                </TextBlock>
                                                <StackPanel Spacing="8" IsVisible="{Binding IsEditingNote}" core:Motion.EnterOnShow="True" core:Motion.FromTop="True">
                                                    <TextBox Classes="glass" PlaceholderText="What you did, a result, a link" Text="{Binding NoteDraft}" AcceptsReturn="True"
                                                             TextWrapping="Wrap" AutomationProperties.Name="Step note" />
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <Button Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Save"
                                                                Command="{Binding $parent[UserControl].((vm:MissionsViewModel)DataContext).SaveNoteCommand}" CommandParameter="{Binding}" />
                                                        <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Cancel"
                                                                Command="{Binding $parent[UserControl].((vm:MissionsViewModel)DataContext).CancelNoteCommand}" CommandParameter="{Binding}" />
                                                    </Grid>
                                                </StackPanel>
                                                <WrapPanel Margin="-4,0,0,0">
                                                    <Button Classes="act" IsVisible="{Binding CanEdit}" ToolTip.Tip="Edit step" AutomationProperties.Name="Edit step"
                                                            Command="{Binding $parent[UserControl].((vm:MissionsViewModel)DataContext).EditStepCommand}" CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="Edit" FontSize="14" /><TextBlock Classes="label" Text="Edit" /></StackPanel>
                                                    </Button>
                                                    <Button Classes="act" IsVisible="{Binding CanEditNote}" ToolTip.Tip="Write or change the note of this step"
                                                            AutomationProperties.Name="Edit note"
                                                            Command="{Binding $parent[UserControl].((vm:MissionsViewModel)DataContext).EditNoteCommand}" CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="Note" FontSize="14" /><TextBlock Classes="label" Text="Note" /></StackPanel>
                                                    </Button>
                                                    <Button Classes="act" IsVisible="{Binding CanDelete}" ToolTip.Tip="Delete step" AutomationProperties.Name="Delete step"
                                                            Command="{Binding $parent[UserControl].((vm:MissionsViewModel)DataContext).DeleteStepCommand}" CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <ic:SymbolIcon Symbol="Delete" FontSize="14" Foreground="{DynamicResource HelmDanger}" />
                                                            <TextBlock Classes="label" Text="Delete" Foreground="{DynamicResource HelmDanger}" />
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Editor -->
                                            <StackPanel Margin="44,0,8,12" Spacing="8" IsVisible="{Binding IsEditing}" core:Motion.EnterOnShow="True" core:Motion.FromTop="True">
                                                <TextBox Classes="glass" PlaceholderText="Title" Text="{Binding EditTitle}" AutomationProperties.Name="Step title" />
                                                <TextBox Classes="glass" PlaceholderText="How to do it" Text="{Binding EditDescription}" AcceptsReturn="True" TextWrapping="Wrap"
                                                         MinHeight="72" VerticalContentAlignment="Top" AutomationProperties.Name="Step description" />
                                                <Grid ColumnDefinitions="2*,*" ColumnSpacing="8">
                                                    <TextBox Classes="glass" PlaceholderText="Done when…" Text="{Binding EditDoneWhen}" AutomationProperties.Name="Done when" />
                                                    <TextBox Grid.Column="1" Classes="glass" PlaceholderText="Days, e.g. 2" Text="{Binding EditDays}" AutomationProperties.Name="Days" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <Button Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Save"
                                                            Command="{Binding $parent[UserControl].((vm:MissionsViewModel)DataContext).SaveStepCommand}" CommandParameter="{Binding}" />
                                                    <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Cancel"
                                                            Command="{Binding $parent[UserControl].((vm:MissionsViewModel)DataContext).CancelStepCommand}" CommandParameter="{Binding}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Add a step at the end of the last phase -->
        <Border Classes="glass" Padding="16,8,8,8" IsVisible="{Binding CanAddStep}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="NewStepBox" Classes="bare" FontSize="15" PlaceholderText="Add a step at the end — press Enter" Text="{Binding NewStepTitle}"
                         VerticalAlignment="Center" AutomationProperties.Name="New step">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddStepCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Classes="pill" Width="40" Height="40" MinHeight="40" Padding="0" VerticalAlignment="Center"
                        Command="{Binding AddStepCommand}" ToolTip.Tip="Add the step" AutomationProperties.Name="Add the step">
                    <ic:SymbolIcon Symbol="Add" FontSize="18" Foreground="{DynamicResource HelmPillForeground}" />
                </Button>
            </Grid>
        </Border>
        <TextBlock Text="A new step goes at the end of the last phase; open it above to add its details." Classes="muted" FontSize="12" Margin="4,6,0,0"
                   TextWrapping="Wrap" IsVisible="{Binding CanAddStep}" />
    </StackPanel>
</UserControl>
