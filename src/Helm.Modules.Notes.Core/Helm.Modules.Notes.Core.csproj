<Project Sdk="Microsoft.NET.Sdk">

  <!-- Notes logic shared by the Windows and Android apps: data model, store (on Helm Sync), the page view model and
       the Quick Capture target. No WPF, Avalonia or platform APIs here. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Modules.Notes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core\Helm.Core.csproj" />
    <!-- IDialogService / IClipboardService: the portable seams both apps already implement. -->
    <ProjectReference Include="..\Helm.Shell\Helm.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>
