<UserControl
    x:Class="Helm.Modules.ClaudeChat.Chat.ClaudeChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:chat="clr-namespace:Helm.Modules.ClaudeChat.Chat">

    <UserControl.Resources>
        <!-- Read-only, selectable text without the input chrome of the themed TextBox -->
        <Style x:Key="ChatText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type chat:UserChatItem}">
            <Border
                Margin="64,6,0,6"
                Padding="12,8"
                HorizontalAlignment="Right"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12,12,2,12">
                <TextBox Style="{StaticResource ChatText}" Text="{Binding Text, Mode=OneWay}" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:AssistantChatItem}">
            <DockPanel Margin="0,6,48,6">
                <ui:SymbolIcon
                    Margin="0,2,10,0"
                    VerticalAlignment="Top"
                    DockPanel.Dock="Left"
                    FontSize="18"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Symbol="ChatSparkle24" />
                <TextBox Style="{StaticResource ChatText}" Text="{Binding Text, Mode=OneWay}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:ToolChatItem}">
            <Expander Margin="28,2,48,2" Padding="0">
                <Expander.Header>
                    <DockPanel>
                        <ui:ProgressRing
                            Width="12"
                            Height="12"
                            Margin="0,0,8,0"
                            DockPanel.Dock="Left"
                            IsIndeterminate="True"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            DockPanel.Dock="Left"
                            FontSize="14"
                            Symbol="Wrench24"
                            Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock
                            Margin="0,0,8,0"
                            DockPanel.Dock="Left"
                            FontWeight="SemiBold"
                            Text="{Binding Name}" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Summary}"
                            TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Expander.Header>
                <ScrollViewer MaxHeight="240" Margin="22,4,0,4" VerticalScrollBarVisibility="Auto">
                    <TextBox
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Style="{StaticResource ChatText}"
                        Text="{Binding Result, Mode=OneWay, TargetNullValue='(no result yet)'}" />
                </ScrollViewer>
            </Expander>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:PermissionChatItem}">
            <Border
                x:Name="Card"
                Margin="28,6,48,6"
                Padding="14,12"
                AutomationProperties.Name="Permission request"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <ui:SymbolIcon
                            Margin="0,0,10,0"
                            DockPanel.Dock="Left"
                            FontSize="18"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Symbol="ShieldKeyhole24" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBox
                        Margin="28,6,0,0"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Style="{StaticResource ChatText}"
                        Text="{Binding Summary, Mode=OneWay}" />
                    <TextBlock
                        Margin="28,4,0,0"
                        Style="{DynamicResource HelmSecondaryText}"
                        Text="{Binding Reason}"
                        Visibility="{Binding Reason, Converter={StaticResource NotEmptyToVisibility}}" />
                    <Expander Margin="24,6,0,0" Header="Details">
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <TextBox
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Style="{StaticResource ChatText}"
                                Text="{Binding Details, Mode=OneWay}" />
                        </ScrollViewer>
                    </Expander>

                    <!-- Answer buttons while pending; the outcome afterwards -->
                    <StackPanel Margin="28,10,0,0" Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                MinWidth="110"
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Command="{Binding AllowOnceCommand}"
                                Content="Allow once" />
                            <ui:Button MinWidth="90" Command="{Binding DenyCommand}" Content="Deny" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,12,0,4"
                            Style="{DynamicResource HelmSecondaryText}"
                            Text="Or allow for the rest of this chat (nothing is saved to your Claude Code settings):"
                            Visibility="{Binding Options.Count, Converter={StaticResource NotEmptyToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button
                                        Margin="0,2,0,2"
                                        Padding="10,5"
                                        HorizontalAlignment="Left"
                                        HorizontalContentAlignment="Left"
                                        Appearance="Transparent"
                                        AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.AllowWithCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Label}">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock
                        Margin="28,8,0,0"
                        FontWeight="SemiBold"
                        Text="{Binding Outcome}"
                        Visibility="{Binding Outcome, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:NoticeChatItem}">
            <Border Margin="28,4,48,4" Padding="10,6" CornerRadius="6" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static chat:NoticeKind.Warning}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static chat:NoticeKind.Error}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBox FontSize="12" Style="{StaticResource ChatText}" Text="{Binding Text, Mode=OneWay}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{DynamicResource HelmSurface}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: status + actions. Also the drag handle for tearing the chat out (later). -->
            <Border
                x:Name="Header"
                Padding="16,10"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <DockPanel>
                    <ui:Button
                        AutomationProperties.Name="New chat"
                        Appearance="Transparent"
                        Command="{Binding NewChatCommand}"
                        DockPanel.Dock="Right"
                        Icon="{ui:SymbolIcon ChatAdd24}"
                        ToolTip="New chat: ends this session and starts over" />
                    <ui:ProgressRing
                        Width="14"
                        Height="14"
                        Margin="0,0,10,0"
                        DockPanel.Dock="Left"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Style="{DynamicResource HelmSecondaryText}"
                            Text="{Binding CostText}"
                            Visibility="{Binding CostText, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Conversation -->
            <ScrollViewer
                x:Name="Scroller"
                AutomationProperties.Name="Conversation"
                Grid.Row="1"
                Padding="16,8"
                ScrollChanged="OnScrollChanged"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}" />
            </ScrollViewer>
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="40"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="ChatSparkle24" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Ask Claude about the working folder, or ask it to change something." />
            </StackPanel>

            <!-- Composer -->
            <Border
                Grid.Row="2"
                Padding="12"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <DockPanel>
                    <Grid Margin="8,0,0,0" VerticalAlignment="Bottom" DockPanel.Dock="Right">
                        <ui:Button
                            AutomationProperties.Name="Send"
                            Appearance="Primary"
                            Command="{Binding SendCommand}"
                            Icon="{ui:SymbolIcon Send24}"
                            ToolTip="Send (Enter)"
                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:Button
                            AutomationProperties.Name="Stop"
                            Command="{Binding StopCommand}"
                            Icon="{ui:SymbolIcon Stop24}"
                            ToolTip="Stop"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <ui:TextBox
                        x:Name="Composer"
                        AutomationProperties.Name="Message"
                        MaxHeight="180"
                        AcceptsReturn="True"
                        ClearButtonEnabled="False"
                        PlaceholderText="Message Claude — Enter to send, Shift+Enter for a new line"
                        PreviewKeyDown="OnComposerKeyDown"
                        Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
