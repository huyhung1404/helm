<UserControl
    x:Class="Helm.Modules.ClaudeChat.Chat.ClaudeChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:chat="clr-namespace:Helm.Modules.ClaudeChat.Chat">

    <UserControl.Resources>
        <!-- Read-only, selectable text without the input chrome of the themed TextBox -->
        <Style x:Key="ChatText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Editable text without the themed chrome: the composer box draws the frame -->
        <Style x:Key="ComposerText" TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type chat:UserChatItem}">
            <Border
                Margin="64,6,0,6"
                Padding="12,8"
                HorizontalAlignment="Right"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12,12,2,12">
                <TextBox Style="{StaticResource ChatText}" Text="{Binding Text, Mode=OneWay}" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:AssistantChatItem}">
            <DockPanel Margin="0,6,48,6">
                <Image
                    Width="18"
                    Height="18"
                    Margin="0,2,10,0"
                    VerticalAlignment="Top"
                    DockPanel.Dock="Left"
                    Source="{x:Static chat:ClaudeLogo.Image}" />
                <chat:MarkdownView Markdown="{Binding Text, Mode=OneWay}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:ToolChatItem}">
            <Expander Margin="28,2,48,2" Padding="0">
                <Expander.Header>
                    <DockPanel>
                        <ui:ProgressRing
                            Width="12"
                            Height="12"
                            Margin="0,0,8,0"
                            DockPanel.Dock="Left"
                            IsIndeterminate="True"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            DockPanel.Dock="Left"
                            FontSize="14"
                            Symbol="Wrench24"
                            Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <TextBlock
                            Margin="0,0,8,0"
                            DockPanel.Dock="Left"
                            FontWeight="SemiBold"
                            Text="{Binding Name}" />
                        <TextBlock
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding Summary}"
                            TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Expander.Header>
                <ScrollViewer MaxHeight="240" Margin="22,4,0,4" VerticalScrollBarVisibility="Auto">
                    <TextBox
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Style="{StaticResource ChatText}"
                        Text="{Binding Result, Mode=OneWay, TargetNullValue='(no result yet)'}" />
                </ScrollViewer>
            </Expander>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:PermissionChatItem}">
            <Border
                x:Name="Card"
                Margin="28,6,48,6"
                Padding="14,12"
                AutomationProperties.Name="Permission request"
                BorderThickness="1"
                CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPending}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <ui:SymbolIcon
                            Margin="0,0,10,0"
                            DockPanel.Dock="Left"
                            FontSize="18"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Symbol="ShieldKeyhole24" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBox
                        Margin="28,6,0,0"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="12"
                        Style="{StaticResource ChatText}"
                        Text="{Binding Summary, Mode=OneWay}" />
                    <TextBlock
                        Margin="28,4,0,0"
                        Style="{DynamicResource HelmSecondaryText}"
                        Text="{Binding Reason}"
                        Visibility="{Binding Reason, Converter={StaticResource NotEmptyToVisibility}}" />
                    <Expander Margin="24,6,0,0" Header="Details">
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                            <TextBox
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Style="{StaticResource ChatText}"
                                Text="{Binding Details, Mode=OneWay}" />
                        </ScrollViewer>
                    </Expander>

                    <!-- Answer buttons while pending; the outcome afterwards -->
                    <StackPanel Margin="28,10,0,0" Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                MinWidth="110"
                                Margin="0,0,8,0"
                                Appearance="Primary"
                                Command="{Binding AllowOnceCommand}"
                                Content="Allow once" />
                            <ui:Button MinWidth="90" Command="{Binding DenyCommand}" Content="Deny" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,12,0,4"
                            Style="{DynamicResource HelmSecondaryText}"
                            Text="Or allow for the rest of this chat (nothing is saved to your Claude Code settings):"
                            Visibility="{Binding Options.Count, Converter={StaticResource NotEmptyToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button
                                        Margin="0,2,0,2"
                                        Padding="10,5"
                                        HorizontalAlignment="Left"
                                        HorizontalContentAlignment="Left"
                                        Appearance="Transparent"
                                        AutomationProperties.Name="{Binding Label}"
                                        Command="{Binding DataContext.AllowWithCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Label}">
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock
                        Margin="28,8,0,0"
                        FontWeight="SemiBold"
                        Text="{Binding Outcome}"
                        Visibility="{Binding Outcome, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type chat:NoticeChatItem}">
            <Border Margin="28,4,48,4" Padding="10,6" CornerRadius="6" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static chat:NoticeKind.Warning}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static chat:NoticeKind.Error}">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBox FontSize="12" Style="{StaticResource ChatText}" Text="{Binding Text, Mode=OneWay}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Conversation -->
        <ScrollViewer
            x:Name="Scroller"
            Padding="16,8"
            AutomationProperties.Name="Conversation"
            ScrollChanged="OnScrollChanged"
            VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" />
        </ScrollViewer>
        <StackPanel
            Margin="24,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <Image
                Width="44"
                Height="44"
                HorizontalAlignment="Center"
                Source="{x:Static chat:ClaudeLogo.Image}" />
            <TextBlock
                Margin="0,12,0,4"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Ask Claude about this folder, or ask it to change something." />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{DynamicResource HelmSecondaryText}"
                Text="Type / for commands and @ to mention a file." />
        </StackPanel>

        <!-- Composer: positions as in Claude Code for VS Code, drawn in Helm's style -->
        <Border
            x:Name="ComposerBox"
            Grid.Row="1"
            Margin="12,4,12,12"
            Padding="10,6,6,6"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBox
                        x:Name="Composer"
                        MinHeight="40"
                        MaxHeight="200"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Message"
                        PreviewKeyDown="OnComposerKeyDown"
                        SelectionChanged="OnComposerCaretMoved"
                        Style="{StaticResource ComposerText}"
                        Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                        TextChanged="OnComposerTextChanged"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <TextBlock
                        Margin="2,1,0,0"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        IsHitTestVisible="False"
                        Text="Message Claude — Enter to send, Shift+Enter for a new line"
                        Visibility="{Binding Draft, Converter={StaticResource EmptyToVisibility}}" />
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,4,0,0">
                    <Grid DockPanel.Dock="Right">
                        <ui:Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="Send"
                            Appearance="Primary"
                            Command="{Binding SendCommand}"
                            Icon="{ui:SymbolIcon ArrowUp24}"
                            ToolTip="Send (Enter)"
                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="Stop"
                            Command="{Binding StopCommand}"
                            Icon="{ui:SymbolIcon Stop24}"
                            ToolTip="Stop"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <ui:Button
                        Padding="6"
                        AutomationProperties.Name="Commands"
                        Appearance="Transparent"
                        Click="OnSlashButton"
                        DockPanel.Dock="Left"
                        Icon="{ui:SymbolIcon Add16}"
                        ToolTip="Commands and actions (/)" />
                    <ui:Button
                        Padding="6"
                        AutomationProperties.Name="Mention a file"
                        Appearance="Transparent"
                        Click="OnMentionButton"
                        DockPanel.Dock="Left"
                        Icon="{ui:SymbolIcon Mention24}"
                        ToolTip="Mention a file (@)" />
                    <ComboBox
                        x:Name="ModelPicker"
                        MinWidth="130"
                        Margin="4,0,8,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Model"
                        DisplayMemberPath="DisplayName"
                        DockPanel.Dock="Left"
                        SelectionChanged="OnModelPicked"
                        ToolTip="Model for this chat; changing it switches the running chat" />
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:ProgressRing
                            Width="12"
                            Height="12"
                            Margin="0,0,6,0"
                            IsIndeterminate="True"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{DynamicResource HelmSecondaryText}"
                            Text="{Binding StatusText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource HelmSecondaryText}"
                            Text="{Binding CostText}"
                            TextWrapping="NoWrap"
                            ToolTip="What these turns would cost at API prices; nothing is charged per token on a Claude subscription." />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- The "/" and "@" menu, above the composer -->
        <Popup
            x:Name="MenuPopup"
            AllowsTransparency="True"
            Placement="Top"
            PlacementTarget="{Binding ElementName=ComposerBox}"
            StaysOpen="False">
            <Border
                Width="{Binding ActualWidth, ElementName=ComposerBox}"
                MaxHeight="340"
                Margin="0,0,0,4"
                Padding="4"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ListBox
                    x:Name="MenuList"
                    AutomationProperties.Name="Suggestions"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="8,6,0,2" Style="{DynamicResource HelmSecondaryText}" Text="{Binding Name}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            <Setter Property="Padding" Value="8,4" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type chat:Suggestion}">
                            <Button
                                Padding="0"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{Binding Title}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnSuggestionClicked"
                                Focusable="False">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Button.Template>
                            <DockPanel>
                                <TextBlock
                                    MaxWidth="320"
                                    Margin="12,0,0,0"
                                    DockPanel.Dock="Right"
                                    Style="{DynamicResource HelmSecondaryText}"
                                    Text="{Binding Detail}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
