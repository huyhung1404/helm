<ui:FluentWindow
    x:Class="Helm.Modules.ClaudeChat.Chat.ChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Claude Chat"
    MinWidth="380"
    MinHeight="420"
    ExtendsContentIntoTitleBar="True"
    ShowInTaskbar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="Manual">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="Claude Chat" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ChatSparkle24" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <ui:Button
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Dock"
                    Appearance="Transparent"
                    Click="OnDockClick"
                    Content="Back to Helm"
                    Icon="{ui:SymbolIcon PanelLeft24}"
                    ToolTip="Put the chat back on the Claude Chat page" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- ClaudeChatView is placed here by ChatPresenter -->
        <ContentControl x:Name="Host" Grid.Row="1" Margin="8,0,8,8" />
    </Grid>
</ui:FluentWindow>
