<ui:FluentWindow
    x:Class="Helm.Modules.ClaudeChat.Chat.ChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:chat="clr-namespace:Helm.Modules.ClaudeChat.Chat"
    xmlns:cli="clr-namespace:Helm.Modules.ClaudeChat.Cli"
    Title="Claude Chat"
    MinWidth="720"
    MinHeight="460"
    ExtendsContentIntoTitleBar="True"
    Icon="{x:Static chat:ClaudeLogo.Image}"
    ShowInTaskbar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <chat:RelativeTimeConverter x:Key="RelativeTime" />
        <chat:EnumToVisibilityConverter x:Key="EnumToVisibility" />

        <!-- The status mark at the end of a chat row: running, needs you, finished unseen, failed unseen -->
        <DataTemplate x:Key="AttentionMark" DataType="{x:Type chat:ChatViewModel}">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
                <ui:ProgressRing
                    Width="12"
                    Height="12"
                    IsIndeterminate="True"
                    ToolTip="Working…"
                    Visibility="{Binding Attention, Converter={StaticResource EnumToVisibility}, ConverterParameter=Working}" />
                <ui:SymbolIcon
                    FontSize="14"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Warning24"
                    ToolTip="Waiting for your OK"
                    Visibility="{Binding Attention, Converter={StaticResource EnumToVisibility}, ConverterParameter=NeedsYou}" />
                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="{DynamicResource AccentFillColorDefaultBrush}"
                    ToolTip="Finished"
                    Visibility="{Binding Attention, Converter={StaticResource EnumToVisibility}, ConverterParameter=Done}" />
                <ui:SymbolIcon
                    FontSize="14"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Symbol="ErrorCircle24"
                    ToolTip="Stopped with an error"
                    Visibility="{Binding Attention, Converter={StaticResource EnumToVisibility}, ConverterParameter=Failed}" />
            </Grid>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Title="Claude Chat" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Width="16" Height="16" Source="{x:Static chat:ClaudeLogo.Image}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="190" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Folders and their chats -->
            <Border Padding="6" Style="{DynamicResource HelmSurface}">
                <DockPanel>
                    <DockPanel Margin="6,2,0,6" DockPanel.Dock="Top">
                        <ui:Button
                            Padding="6"
                            AutomationProperties.Name="Add folder"
                            Appearance="Transparent"
                            Command="{Binding AddFolderCommand}"
                            DockPanel.Dock="Right"
                            Icon="{ui:SymbolIcon FolderAdd24}"
                            ToolTip="Add a project folder" />
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Folders" />
                    </DockPanel>

                    <TreeView
                        x:Name="Tree"
                        AutomationProperties.Name="Folders and chats"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding Folders}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedItemChanged="OnTreeSelectionChanged">
                        <TreeView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type chat:ChatFolder}" ItemsSource="{Binding Chats}">
                                <HierarchicalDataTemplate.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                    </Style>
                                </HierarchicalDataTemplate.ItemContainerStyle>
                                <DockPanel ToolTip="{Binding Path}">
                                    <DockPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding PlacementTarget.Tag.NewChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="New chat here" />
                                            <MenuItem Command="{Binding PlacementTarget.Tag.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Close folder" />
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <DockPanel.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=TreeView}" />
                                    </DockPanel.Tag>
                                    <ui:Button
                                        Padding="4"
                                        AutomationProperties.Name="New chat in this folder"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.NewChatCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                        CommandParameter="{Binding}"
                                        DockPanel.Dock="Right"
                                        Icon="{ui:SymbolIcon Add16}"
                                        ToolTip="New chat in this folder" />
                                    <ui:SymbolIcon
                                        Margin="0,0,6,0"
                                        DockPanel.Dock="Left"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="Folder24" />
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type chat:ChatViewModel}">
                                <DockPanel>
                                    <DockPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding PlacementTarget.Tag.CloseChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Header="Close chat" />
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <DockPanel.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=TreeView}" />
                                    </DockPanel.Tag>
                                    <ui:Button
                                        Padding="4"
                                        AutomationProperties.Name="Close chat"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.CloseChatCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                        CommandParameter="{Binding}"
                                        DockPanel.Dock="Right"
                                        Icon="{ui:SymbolIcon Dismiss16}"
                                        ToolTip="Close chat (it stays in history)" />
                                    <ContentPresenter
                                        Margin="4,0"
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource AttentionMark}"
                                        DockPanel.Dock="Right" />
                                    <Image
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,6,0"
                                        DockPanel.Dock="Left"
                                        Source="{x:Static chat:ClaudeLogo.Image}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                </DockPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext" />

            <!-- The selected chat -->
            <Border Grid.Column="2" Padding="0" Style="{DynamicResource HelmSurface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: title, folder; history and new chat on the right (as in VS Code) -->
                    <Border Padding="16,8,8,8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <ui:Button
                                Padding="8"
                                AutomationProperties.Name="New chat"
                                Appearance="Transparent"
                                Command="{Binding NewChatCommand}"
                                DockPanel.Dock="Right"
                                Icon="{ui:SymbolIcon ChatAdd24}"
                                ToolTip="New chat in this folder" />
                            <ToggleButton
                                x:Name="HistoryToggle"
                                Padding="8"
                                AutomationProperties.Name="History"
                                Background="Transparent"
                                BorderThickness="0"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding IsHistoryOpen}"
                                ToolTip="Past chats in this folder">
                                <ui:SymbolIcon Symbol="History24" />
                            </ToggleButton>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{Binding SelectedChat.Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Style="{DynamicResource HelmSecondaryText}" Text="{Binding SelectedChat.Folder}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Popup
                        AllowsTransparency="True"
                        IsOpen="{Binding IsHistoryOpen}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=HistoryToggle}"
                        StaysOpen="False"
                        HorizontalOffset="-300">
                        <Border
                            Width="340"
                            MaxHeight="440"
                            Margin="0,4,0,0"
                            Padding="8"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <DockPanel>
                                <ui:TextBox
                                    Margin="0,0,0,8"
                                    AutomationProperties.Name="Search history"
                                    DockPanel.Dock="Top"
                                    Icon="{ui:SymbolIcon Search24}"
                                    PlaceholderText="Search past chats"
                                    Text="{Binding HistoryFilter, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="4"
                                    DockPanel.Dock="Top"
                                    Style="{DynamicResource HelmSecondaryText}"
                                    Text="No saved chats in this folder yet."
                                    Visibility="{Binding History.Count, Converter={StaticResource EmptyToVisibility}}" />
                                <ListBox
                                    x:Name="HistoryList"
                                    AutomationProperties.Name="Past chats"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemsSource="{Binding FilteredHistory}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                    SelectionChanged="OnHistoryPicked">
                                    <ListBox.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type cli:PastSession}">
                                            <DockPanel Margin="0,2">
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    DockPanel.Dock="Right"
                                                    Style="{DynamicResource HelmSecondaryText}"
                                                    Text="{Binding LastActive, Converter={StaticResource RelativeTime}}" />
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Popup>

                    <!-- One view, re-bound to whichever chat is selected; the chats keep running in the background -->
                    <chat:ClaudeChatView
                        x:Name="ChatView"
                        Grid.Row="1"
                        DataContext="{Binding SelectedChat}"
                        Visibility="{Binding HasChat, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
