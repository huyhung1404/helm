<core:ModulePageBase
    x:Class="Helm.Modules.ClaudeChat.ClaudeChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:chat="clr-namespace:Helm.Modules.ClaudeChat.Chat"
    ExtraMessage="{Binding Module.HotkeyError}"
    Module="{Binding Module}">

    <StackPanel>
        <TextBlock Text="Chat" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:ImageIcon Width="24" Height="24" Source="{x:Static chat:ClaudeLogo.Image}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <core:CardHeader Title="Open Claude Chat" Description="The chat has its own window, with your recent chats from every folder on the left." />
            </ui:CardControl.Header>
            <ui:Button Appearance="Primary" Command="{Binding OpenChatCommand}" Content="Open chat" Icon="{ui:SymbolIcon WindowNew24}" />
        </ui:CardControl>

        <TextBlock Text="New chats" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Folder24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Working folder" Description="{Binding DefaultWorkingDirectory, StringFormat='Where a new chat starts; you can change it in the chat window too. Empty uses {0}.'}" />
            </ui:CardControl.Header>
            <DockPanel HorizontalAlignment="Right">
                <ui:Button
                    Margin="8,0,0,0"
                    Command="{Binding BrowseWorkingDirectoryCommand}"
                    Content="Browse…"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
                <ui:TextBox Width="280" PlaceholderText="{Binding DefaultWorkingDirectory}" Text="{Binding WorkingDirectory, UpdateSourceTrigger=LostFocus}" />
            </DockPanel>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon BrainCircuit24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Model" Description="An alias (opus, sonnet, haiku) or a full model id. Empty uses Claude Code's default." />
            </ui:CardControl.Header>
            <ComboBox
                Width="200"
                HorizontalAlignment="Right"
                IsEditable="True"
                ItemsSource="{Binding Models}"
                Text="{Binding Model, UpdateSourceTrigger=LostFocus}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ShieldKeyhole24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Permissions" Description="{Binding PermissionMode.Description}" />
            </ui:CardControl.Header>
            <ComboBox
                Width="200"
                HorizontalAlignment="Right"
                DisplayMemberPath="Title"
                ItemsSource="{Binding PermissionModes}"
                SelectedItem="{Binding PermissionMode}" />
        </ui:CardControl>

        <TextBlock Text="Advanced" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Keyboard24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Shortcut to open the chat" Description="Brings up the Claude Chat window from anywhere." />
            </ui:CardControl.Header>
            <core:HotkeyPicker HorizontalAlignment="Right" DefaultGesture="{Binding DefaultHotkey}" Gesture="{Binding Hotkey}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Code24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Claude Code location" Description="{Binding CliDescription}" />
            </ui:CardControl.Header>
            <ui:TextBox Width="280" HorizontalAlignment="Right" PlaceholderText="Find automatically" Text="{Binding CliPath, UpdateSourceTrigger=LostFocus}" />
        </ui:CardControl>

    </StackPanel>
</core:ModulePageBase>
