<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:b="using:Helm.App.Android.BugReports"
             xmlns:bugs="using:Helm.Shell.BugReports"
             x:Class="Helm.App.Android.BugReports.BugReportsView"
             x:DataType="bugs:BugReportsViewModel">

    <!-- Bug reports (the drawer, above General): the list, or one bug over it; Back goes from the bug to the list. -->
    <UserControl.Styles>
        <Style Selector="Button.wide">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.filter">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource HelmSubtleFill}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,0,6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="MinHeight" Value="40" />
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Helm.Android/BugReports/BugTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Panel>
        <!-- ===== The list ===== -->
        <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}">
            <Button Classes="wide accent" Click="Report_Click" Margin="0,0,0,8" AutomationProperties.Name="Report a bug">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon Symbol="Bug" FontSize="18" />
                    <TextBlock Text="Report a bug" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Border Classes="card" Margin="0,0,0,8">
                <DockPanel>
                    <ToggleSwitch x:Name="ShakeSwitch" DockPanel.Dock="Right" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="Shake to report" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Shake to report" Classes="title" />
                        <TextBlock Text="Shake the phone while Helm is open. The Quick Settings tile works from anywhere." Classes="secondary" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBox PlaceholderText="Search bugs" Text="{Binding Query}" Margin="0,4,0,8" AutomationProperties.Name="Search bugs" />
            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding FilterCounts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bugs:FilterCount">
                            <Button Classes="filter" Classes.accent="{Binding IsSelected}" Content="{Binding Text}" CommandParameter="{Binding Filter}"
                                    Command="{Binding $parent[ItemsControl].((bugs:BugReportsViewModel)DataContext).SetFilterCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="No bugs here. Shake the phone or tap the bug in the app bar to report one." Classes="secondary" Margin="4,8"
                       IsVisible="{Binding IsEmpty}" />
            <ItemsControl ItemsSource="{Binding Bugs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="bugs:BugRowViewModel">
                        <Button Classes="flat" Padding="0" Margin="0,0,0,8" HorizontalContentAlignment="Stretch"
                                Command="{Binding $parent[ItemsControl].((bugs:BugReportsViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Title}">
                            <Border Classes="card">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Code}" FontFamily="monospace" FontSize="12" Classes="secondary" Margin="0,0,6,2" VerticalAlignment="Center" />
                                        <Border Classes="badge">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ic:SymbolIcon Symbol="{Binding Status, Converter={x:Static b:BugLook.Icon}}" FontSize="11" Foreground="{Binding Status, Converter={x:Static b:BugLook.Brush}}" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding Status, Converter={x:Static b:BugLook.Brush}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Classes="badge">
                                            <TextBlock Text="{Binding SeverityText}" Foreground="{Binding Severity, Converter={x:Static b:BugLook.Brush}}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Title}" Classes="title" Margin="0,4,0,2" />
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Meta}" Classes="secondary" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding RepliesText}" Classes="secondary" Margin="0,0,10,0" IsVisible="{Binding HasReplies}" />
                                        <TextBlock Text="Claude asks" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColor}" IsVisible="{Binding IsAsking}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ===== One bug ===== -->
        <Panel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border DataContext="{Binding Selected}">
        <StackPanel x:DataType="bugs:BugDetailViewModel">
            <Button Classes="flat" HorizontalAlignment="Left" Padding="4,8" Margin="-4,0,0,4" Command="{Binding $parent[UserControl].((bugs:BugReportsViewModel)DataContext).CloseDetailCommand}"
                    AutomationProperties.Name="All bugs">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:SymbolIcon Symbol="ArrowLeft" FontSize="18" />
                    <TextBlock Text="All bugs" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <WrapPanel>
                <TextBlock Text="{Binding Code}" FontFamily="monospace" FontSize="12" Classes="secondary" Margin="0,0,6,2" VerticalAlignment="Center" />
                <Border Classes="badge">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ic:SymbolIcon Symbol="{Binding Bug.Status, Converter={x:Static b:BugLook.Icon}}" FontSize="11" Foreground="{Binding Bug.Status, Converter={x:Static b:BugLook.Brush}}" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding Bug.Status, Converter={x:Static b:BugLook.Brush}}" />
                    </StackPanel>
                </Border>
                <Border Classes="badge">
                    <TextBlock Text="{Binding SeverityText}" Foreground="{Binding Bug.Severity, Converter={x:Static b:BugLook.Brush}}" />
                </Border>
            </WrapPanel>
            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,4" />
            <TextBlock Text="{Binding Meta}" Classes="secondary" Margin="0,0,0,12" />

            <!-- An agent works on it -->
            <Border Classes="infobar" IsVisible="{Binding IsFixing}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Bot" FontSize="18" Foreground="{DynamicResource SystemAccentColor}" />
                        <TextBlock Text="{Binding FixingText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Classes="wide" Content="Take it back" Command="{Binding TakeBackCommand}" />
                </StackPanel>
            </Border>
            <!-- Fixed, waiting for the user -->
            <Border Classes="infobar warning" IsVisible="{Binding IsToVerify}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding VerifyText}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Classes="wide" Content="Still broken" Click="ShowReopen_Click" />
                        <Button Grid.Column="2" Classes="wide accent" Content="It is fixed" Command="{Binding ConfirmFixedCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
            <!-- Closed -->
            <Border Classes="infobar" IsVisible="{Binding IsClosed}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Reopen" Click="ShowReopen_Click" MinHeight="40" VerticalContentAlignment="Center" />
                    <TextBlock Text="{Binding ClosedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <!-- The agent's question -->
            <Border Classes="card" IsVisible="{Binding IsAsking}" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Bot" FontSize="18" Foreground="{DynamicResource SystemAccentColor}" />
                        <TextBlock Text="Claude Code asks" Classes="title" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Question}" TextWrapping="Wrap" />
                    <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" PlaceholderText="Your answer" Text="{Binding AnswerText}" AutomationProperties.Name="Your answer" />
                    <ItemsControl ItemsSource="{Binding AnswerImages}" ItemTemplate="{StaticResource BugThumb}" IsVisible="{Binding HasAnswerImages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <CheckBox Content="Attach the black box (last 60 s)" IsChecked="{Binding AnswerWithBlackBox}" />
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Classes="wide" Click="AnswerImage_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="ImageAdd" FontSize="18" />
                                <TextBlock Text="Picture" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="wide accent" Content="Answer" Command="{Binding AnswerCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- What can be done -->
            <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,8">
                <Button Classes="wide accent" Click="ShowHandOff_Click" IsVisible="{Binding IsOpen}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Bot" FontSize="18" />
                        <TextBlock Text="To Claude Code" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="wide" Click="ShowClose_Click" IsVisible="{Binding !IsClosed}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="Checkmark" FontSize="18" />
                        <TextBlock Text="Close" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <Button Classes="wide" Command="{Binding CopyForClaudeCommand}" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon Symbol="Copy" FontSize="18" />
                    <TextBlock Text="Copy for Claude Code" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Close: why -->
            <Border x:Name="ClosePanel" Classes="card" IsVisible="False" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <TextBlock Text="Close this bug" Classes="title" />
                    <RadioButton x:Name="FixedRadio" GroupName="close" IsChecked="True" Content="Fixed: it no longer happens" />
                    <RadioButton x:Name="NotABugRadio" GroupName="close" Content="Not a bug: Helm works as designed" />
                    <RadioButton x:Name="DuplicateRadio" GroupName="close" Content="Duplicate of another bug" />
                    <TextBox x:Name="DuplicateOf" PlaceholderText="The original, e.g. #B7" IsVisible="{Binding #DuplicateRadio.IsChecked}" />
                    <TextBox x:Name="CloseNote" PlaceholderText="Note (optional)" />
                    <Grid ColumnDefinitions="*,8,*" Margin="0,8,0,0">
                        <Button Classes="wide" Content="Cancel" Click="HidePanels_Click" />
                        <Button Grid.Column="2" Classes="wide accent" Content="Close bug" Click="Close_Click" />
                    </Grid>
                </StackPanel>
            </Border>
            <!-- Reopen: why -->
            <Border x:Name="ReopenPanel" Classes="card" IsVisible="False" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                    <TextBlock Text="Why is it not fixed?" Classes="title" />
                    <TextBox x:Name="ReopenWhy" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" PlaceholderText="What still happens" />
                    <CheckBox x:Name="ReopenWithBox" IsChecked="True" Content="Attach the black box (last 60 s)" />
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Classes="wide" Content="Cancel" Click="HidePanels_Click" />
                        <Button Grid.Column="2" Classes="wide accent" Content="Reopen" Click="Reopen_Click" />
                    </Grid>
                </StackPanel>
            </Border>
            <!-- Hand to Claude Code: which session -->
            <Border x:Name="HandOffPanel" Classes="card" IsVisible="False" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                    <TextBlock Text="Hand to Claude Code" Classes="title" />
                    <TextBlock Text="Helm types the request into a Claude Code session on your PC. Follow it in Workspace." Classes="secondary" />
                    <StackPanel x:Name="HandOffTargets" />
                    <TextBlock x:Name="HandOffNote" Classes="secondary" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,8,*" Margin="0,6,0,0">
                        <Button Classes="wide" Content="Cancel" Click="HidePanels_Click" />
                        <Button x:Name="HandOffSend" Grid.Column="2" Classes="wide accent" Content="Send" Click="HandOff_Click" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Status}" Classes="secondary" Margin="4,0,0,8" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Conversation -->
            <TextBlock Text="Conversation" Classes="section" />
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="bugs:BugEntryViewModel">
                        <Panel>
                            <DockPanel IsVisible="{Binding IsStatus}" Margin="8,2,8,8">
                                <ic:SymbolIcon Symbol="Clock" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{DynamicResource HelmSecondaryText}" />
                                <TextBlock Classes="secondary" TextWrapping="Wrap">
                                    <Run Text="{Binding Text}" /><Run Text=" · " /><Run Text="{Binding When}" />
                                </TextBlock>
                            </DockPanel>
                            <Border Classes="card" IsVisible="{Binding IsMessage}" Margin="0,0,0,8">
                                <StackPanel>
                                    <WrapPanel>
                                        <ic:SymbolIcon Symbol="Bot" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource SystemAccentColor}" IsVisible="{Binding ByAgent}" />
                                        <TextBlock Text="{Binding Author}" Classes="title" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding When}" Classes="secondary" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Badge}" FontSize="12" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"
                                                   IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </WrapPanel>
                                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <Border Classes="badge" HorizontalAlignment="Left" Margin="0,8,0,0" IsVisible="{Binding HasBlackBox}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <ic:SymbolIcon Symbol="History" FontSize="11" />
                                            <TextBlock Text="{Binding BlackBoxText}" />
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Images}" ItemTemplate="{StaticResource BugThumb}" Margin="0,8,0,0" IsVisible="{Binding HasImages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Add details -->
            <Border Classes="card" IsVisible="{Binding CanAddDetails}">
                <StackPanel Spacing="8">
                    <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" PlaceholderText="Add details to this bug" Text="{Binding DetailsText}"
                             AutomationProperties.Name="Add details" />
                    <ItemsControl ItemsSource="{Binding DetailImages}" ItemTemplate="{StaticResource BugThumb}" IsVisible="{Binding HasDetailImages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <CheckBox Content="Attach the black box (last 60 s)" IsChecked="{Binding AttachBlackBox}" />
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Classes="wide" Click="DetailsImage_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="ImageAdd" FontSize="18" />
                                <TextBlock Text="Picture" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="wide accent" Content="Add" Command="{Binding AddDetailsCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Black box and environment -->
            <TextBlock Text="Black box" Classes="section" />
            <TextBlock Text="No black box with this bug." Classes="secondary" Margin="4,0,0,0" IsVisible="{Binding !HasBlackBox}" />
            <Border Classes="card" Padding="0" IsVisible="{Binding HasBlackBox}">
                <Expander HorizontalAlignment="Stretch" Padding="8,4,8,8">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="What happened before" />
                            <TextBlock Text="{Binding BlackBoxText}" Classes="secondary" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Steps, from what you did" Classes="title" />
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" Classes="secondary" FontSize="13" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Button Classes="filter" Content="All" Command="{Binding SetEventFilterCommand}" CommandParameter="{x:Static bugs:BlackBoxFilter.All}" />
                                <Button Classes="filter" Content="Input" Command="{Binding SetEventFilterCommand}" CommandParameter="{x:Static bugs:BlackBoxFilter.Input}" />
                                <Button Classes="filter" Content="Pages" Command="{Binding SetEventFilterCommand}" CommandParameter="{x:Static bugs:BlackBoxFilter.Navigation}" />
                                <Button Classes="filter" Content="Errors" Command="{Binding SetEventFilterCommand}" CommandParameter="{x:Static bugs:BlackBoxFilter.Errors}" />
                                <Button Classes="filter" Content="Log" Command="{Binding SetEventFilterCommand}" CommandParameter="{x:Static bugs:BlackBoxFilter.Log}" />
                                <Button Classes="filter" Content="Freezes" Command="{Binding SetEventFilterCommand}" CommandParameter="{x:Static bugs:BlackBoxFilter.Performance}" />
                            </StackPanel>
                        </ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource BlackBoxEvent}" />
                    </StackPanel>
                </Expander>
            </Border>
            <Border Classes="card" Padding="0" Margin="0,8,0,0" IsVisible="{Binding HasBlackBox}">
                <Expander HorizontalAlignment="Stretch" Padding="8,4,8,8">
                    <Expander.Header>
                        <StackPanel>
                            <TextBlock Text="Environment" />
                            <TextBlock Text="Helm, the device and sync when the black box froze" Classes="secondary" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding EnvironmentLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </Border>
        </StackPanel>
        </Border>
        </Panel>
    </Panel>
</UserControl>
