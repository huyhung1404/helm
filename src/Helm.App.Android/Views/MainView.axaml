<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:ui="using:Helm.Core.Ui"
             xmlns:vm="using:Helm.App.Android.ViewModels"
             xmlns:views="using:Helm.App.Android.Views"
             x:Class="Helm.App.Android.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource HelmBarBackground}">

    <UserControl.Styles>
        <!-- Drawer rows, as in the Windows menu: icon column, name; the shown page's row has a fill and an accent mark.
             48 dp tall for the finger. -->
        <Style Selector="Button.navrow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.navrow.active">
            <Setter Property="Background" Value="{DynamicResource HelmSubtleFill}" />
        </Style>
        <Style Selector="Border.navmark">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="ic|SymbolIcon.syncglyph.muted">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="ic|SymbolIcon.syncglyph.done">
            <Setter Property="Foreground" Value="{DynamicResource HelmSuccess}" />
        </Style>
        <Style Selector="ic|SymbolIcon.syncglyph.problem">
            <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
        </Style>
        <Style Selector="ic|SymbolIcon.syncglyph.turning">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid>
        <DockPanel>
            <!-- App bar: drawer button + page title (the Windows title bar + nav pane toggle) -->
            <Grid x:Name="AppBar" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Height="56" Background="{DynamicResource HelmBarBackground}">
                <Button Classes="flat" Width="48" Height="48" Margin="4,0,0,0" Padding="0" HorizontalContentAlignment="Center"
                        Command="{Binding TogglePaneCommand}" ToolTip.Tip="Navigation" AutomationProperties.Name="Open navigation">
                    <ic:SymbolIcon Symbol="Navigation" FontSize="22" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Navigator.Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0"
                           TextTrimming="CharacterEllipsis" />
                <!-- Sync: its state on every page; tap to sync now (or to set it up). Just the icon, without a button look (no
                     press fill), over a 48 dp touch target. -->
                <Button Grid.Column="2" Width="48" Height="48" Margin="0,0,4,0" Padding="0" Background="Transparent"
                        DataContext="{Binding Sync}" Command="{Binding SyncNowCommand}" ToolTip.Tip="{Binding ToolTip}" AutomationProperties.Name="Sync now">
                    <Button.Template>
                        <ControlTemplate>
                            <Panel Background="{TemplateBinding Background}">
                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                        </ControlTemplate>
                    </Button.Template>
                    <!-- The same sync glyph in every state, as on Windows; only its colour changes: accent and turning while
                         syncing, green for a moment when a sync finishes, red on a problem, faded when offline or not set up.
                         The origin must be in percent: Avalonia reads "0.5,0.5" as pixels, which turned it around its corner. -->
                    <ic:SymbolIcon Symbol="ArrowSync" Width="24" Height="24" FontSize="22" Classes="syncglyph" RenderTransformOrigin="50%,50%"
                                   Classes.turning="{Binding IsSyncing}" Classes.done="{Binding JustSynced}"
                                   Classes.muted="{Binding IsMuted}" Classes.problem="{Binding HasProblem}">
                        <ic:SymbolIcon.RenderTransform>
                            <RotateTransform />
                        </ic:SymbolIcon.RenderTransform>
                    </ic:SymbolIcon>
                </Button>
            </Grid>

            <Panel>
                <!-- The shown page; MainView keeps the last few pages' views (PageViews), so going back to one is instant. -->
                <Border x:Name="PageArea" Background="{DynamicResource HelmPageBackground}" CornerRadius="8,8,0,0" ClipToBounds="True" />

                <!-- Navigation drawer: slides in over the dimmed page (MainView animates it); tap the page to close it.
                     Long press a tool to open it in a window of its own. -->
                <Border x:Name="DrawerScrim" Background="{DynamicResource HelmScrim}" Opacity="0" IsHitTestVisible="{Binding IsPaneOpen}" />
                <Border x:Name="Drawer" Width="296" HorizontalAlignment="Left" IsVisible="False"
                        Background="{DynamicResource HelmBarBackground}" BoxShadow="0 0 24 0 #59000000">
                    <Border.RenderTransform>
                        <TranslateTransform X="-320" />
                    </Border.RenderTransform>
                    <DockPanel Margin="8">
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Height="1" Margin="4,4,4,4" Background="{DynamicResource HelmSecondaryText}" Opacity="0.2" />
                            <Panel>
                                <Button Classes="navrow" Classes.active="{Binding GeneralEntry.IsActive}" Command="{Binding OpenCommand}"
                                        CommandParameter="{Binding GeneralEntry}" AutomationProperties.Name="General">
                                    <Grid ColumnDefinitions="40,*">
                                        <ic:SymbolIcon Symbol="Settings" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="General" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Border Classes="navmark" IsVisible="{Binding GeneralEntry.IsActive}" />
                            </Panel>
                        </StackPanel>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:NavEntry">
                                        <Panel>
                                            <!-- A group's name: the same small caption as the Windows menu. -->
                                            <Panel Height="28" IsVisible="{Binding IsHeader}">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource HelmSecondaryText}"
                                                           Opacity="0.75" Margin="12,0,12,4" VerticalAlignment="Bottom" />
                                            </Panel>
                                            <Panel IsVisible="{Binding IsPage}">
                                                <Button Classes="navrow" Classes.active="{Binding IsActive}" CommandParameter="{Binding}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenCommand}"
                                                        AutomationProperties.Name="{Binding Title}">
                                                    <Grid ColumnDefinitions="40,*">
                                                        <ui:ModuleIcon Symbol="{Binding Icon}" Image="{Binding Image}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Button>
                                                <Border Classes="navmark" IsVisible="{Binding IsActive}" />
                                            </Panel>
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Panel>
        </DockPanel>

        <!-- A tool's actions (long press on its drawer row): a window of its own, e.g. beside Helm in split screen. -->
        <Panel IsVisible="{Binding IsSheetOpen}">
            <Border x:Name="SheetScrim" Background="{DynamicResource HelmScrim}" />
            <Border Classes="card" VerticalAlignment="Bottom" Margin="0" CornerRadius="16,16,0,0" BorderThickness="0" Padding="8,8,8,16"
                    BoxShadow="0 -8 32 0 #40000000">
                <StackPanel>
                    <TextBlock Text="{Binding SheetEntry.Title, FallbackValue=''}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource HelmSecondaryText}"
                               Margin="12,8,12,6" />
                    <Button Classes="navrow" Command="{Binding OpenSheetEntryInWindowCommand}" AutomationProperties.Name="Open in its own window">
                        <Grid ColumnDefinitions="40,*">
                            <ic:SymbolIcon Symbol="WindowNew" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Open in its own window" />
                                <TextBlock Text="Beside Helm when the screen is split" Classes="secondary" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>
        </Panel>

        <!-- Confirmation dialog (IDialogService) -->
        <Border Background="{DynamicResource HelmScrim}" IsVisible="{Binding Dialogs.IsOpen}">
            <Border Classes="card" MaxWidth="400" Margin="24" Padding="24,20" VerticalAlignment="Center" BoxShadow="0 8 32 0 #40000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Dialogs.Title}" FontSize="18" Classes="title" />
                    <TextBlock Text="{Binding Dialogs.Message}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding Dialogs.CancelCommand}" />
                        <Button Content="{Binding Dialogs.ConfirmText}" Classes="accent" Command="{Binding Dialogs.ConfirmCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
