<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:ui="using:Helm.Core.Ui"
             xmlns:vm="using:Helm.App.Android.ViewModels"
             xmlns:views="using:Helm.App.Android.Views"
             x:Class="Helm.App.Android.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource HelmBarBackground}">

    <UserControl.Styles>
        <Style Selector="Border.tabrow.active">
            <Setter Property="Background" Value="{DynamicResource HelmSubtleFill}" />
        </Style>
        <Style Selector="Border.tabrow.active TextBlock.tabtitle">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ic|SymbolIcon.syncglyph.muted">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="ic|SymbolIcon.syncglyph.done">
            <Setter Property="Foreground" Value="{DynamicResource HelmSuccess}" />
        </Style>
        <Style Selector="ic|SymbolIcon.syncglyph.problem">
            <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
        </Style>
        <Style Selector="ic|SymbolIcon.syncglyph.turning">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid>
        <DockPanel>
            <!-- App bar: drawer button + page title (the Windows title bar + nav pane toggle) -->
            <Grid x:Name="AppBar" DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Height="56" Background="{DynamicResource HelmBarBackground}">
                <Button Classes="flat" Width="48" Height="48" Margin="4,0,0,0" Padding="0" HorizontalContentAlignment="Center"
                        Command="{Binding TogglePaneCommand}" ToolTip.Tip="Navigation" AutomationProperties.Name="Open navigation">
                    <ic:SymbolIcon Symbol="Navigation" FontSize="22" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Navigator.Title}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,0"
                           TextTrimming="CharacterEllipsis" />
                <!-- Tabs: no strip (a phone has no room for one), only the number of open tabs, as in a phone browser; tap for
                     the list. -->
                <Button Grid.Column="2" Width="48" Height="48" Padding="0" Background="Transparent" Command="{Binding ShowTabsCommand}"
                        ToolTip.Tip="Open tabs" AutomationProperties.Name="Open tabs">
                    <Button.Template>
                        <ControlTemplate>
                            <Panel Background="{TemplateBinding Background}">
                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                        </ControlTemplate>
                    </Button.Template>
                    <Border Width="22" Height="22" BorderThickness="2" CornerRadius="5" BorderBrush="{Binding #TabCountText.Foreground}">
                        <TextBlock x:Name="TabCountText" Text="{Binding Navigator.TabCount}" FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Button>
                <!-- Sync: its state on every page; tap to sync now (or to set it up). Just the icon, without a button look (no
                     press fill), over a 48 dp touch target. -->
                <Button Grid.Column="3" Width="48" Height="48" Margin="0,0,4,0" Padding="0" Background="Transparent"
                        DataContext="{Binding Sync}" Command="{Binding SyncNowCommand}" ToolTip.Tip="{Binding ToolTip}" AutomationProperties.Name="Sync now">
                    <Button.Template>
                        <ControlTemplate>
                            <Panel Background="{TemplateBinding Background}">
                                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                        </ControlTemplate>
                    </Button.Template>
                    <!-- The same sync glyph in every state, as on Windows; only its colour changes: accent and turning while
                         syncing, green for a moment when a sync finishes, red on a problem, faded when offline or not set up.
                         The origin must be in percent: Avalonia reads "0.5,0.5" as pixels, which turned it around its corner. -->
                    <ic:SymbolIcon Symbol="ArrowSync" Width="24" Height="24" FontSize="22" Classes="syncglyph" RenderTransformOrigin="50%,50%"
                                   Classes.turning="{Binding IsSyncing}" Classes.done="{Binding JustSynced}"
                                   Classes.muted="{Binding IsMuted}" Classes.problem="{Binding HasProblem}">
                        <ic:SymbolIcon.RenderTransform>
                            <RotateTransform />
                        </ic:SymbolIcon.RenderTransform>
                    </ic:SymbolIcon>
                </Button>
            </Grid>

            <SplitView IsPaneOpen="{Binding IsPaneOpen}" DisplayMode="Overlay" OpenPaneLength="296" PaneBackground="{DynamicResource HelmBarBackground}">
                <SplitView.Pane>
                    <DockPanel Margin="8">
                        <!-- The open tabs, also for a full page (no app bar, so no tab button): its menu button opens this drawer. -->
                        <Button DockPanel.Dock="Top" Classes="flat" Command="{Binding ShowTabsCommand}" Margin="0,0,0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <ic:SymbolIcon Symbol="TabDesktopMultiple" FontSize="20" />
                                <TextBlock Grid.Column="1" Text="Open tabs" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Navigator.TabCount}" Classes="secondary" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <Button DockPanel.Dock="Bottom" Classes="flat" Command="{Binding OpenCommand}" CommandParameter="{Binding GeneralEntry}">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <ic:SymbolIcon Symbol="Settings" FontSize="20" />
                                <TextBlock Text="General" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:NavEntry">
                                        <Panel>
                                            <TextBlock Text="{Binding Title}" IsVisible="{Binding IsHeader}" Classes="secondary" FontWeight="SemiBold" Margin="12,16,12,4" />
                                            <Button Classes="flat" IsVisible="{Binding IsPage}" CommandParameter="{Binding}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <ui:ModuleIcon Symbol="{Binding Icon}" Image="{Binding Image}" Size="20" />
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </SplitView.Pane>

                <!-- The shown tab's page; MainView keeps every open tab's view (PageViews), so a page keeps its state. -->
                <Border x:Name="PageArea" Background="{DynamicResource HelmPageBackground}" CornerRadius="8,8,0,0" ClipToBounds="True" />
            </SplitView>
        </DockPanel>

        <!-- Open tabs: tap one to show it; each tool's tab can move to a window of its own (split screen) or close. -->
        <Panel IsVisible="{Binding IsTabsOpen}">
            <Border x:Name="TabsScrim" Background="{DynamicResource HelmScrim}" />
            <Border Classes="card" VerticalAlignment="Top" Margin="12,8,12,24" Padding="8,8,8,12" BoxShadow="0 8 32 0 #40000000">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="8,0,0,4">
                        <TextBlock Text="Open tabs" FontSize="18" Classes="title" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="flat" Content="Close others" HorizontalAlignment="Right" Command="{Binding CloseOtherTabsCommand}" />
                        <Button Grid.Column="2" Classes="flat" Width="44" Height="44" Padding="0" HorizontalContentAlignment="Center"
                                Command="{Binding HideTabsCommand}" ToolTip.Tip="Close the list" AutomationProperties.Name="Close the list">
                            <ic:SymbolIcon Symbol="ChevronUp" FontSize="20" />
                        </Button>
                    </Grid>
                    <ScrollViewer MaxHeight="520">
                        <ItemsControl ItemsSource="{Binding Navigator.Tabs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ShellTab">
                                    <Border Classes="tabrow" Classes.active="{Binding IsActive}" CornerRadius="8" Margin="0,2">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <Button Classes="flat" CommandParameter="{Binding}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectTabCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <ui:ModuleIcon Symbol="{Binding Icon}" Image="{Binding Image}" Size="20" />
                                                    <TextBlock Classes="tabtitle" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Classes="flat" Width="44" Height="44" Padding="0" HorizontalContentAlignment="Center"
                                                    IsVisible="{Binding CanOpenInWindow}" CommandParameter="{Binding}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenInWindowCommand}"
                                                    ToolTip.Tip="Open in new window" AutomationProperties.Name="Open in new window">
                                                <ic:SymbolIcon Symbol="WindowNew" FontSize="20" />
                                            </Button>
                                            <Button Grid.Column="2" Classes="flat" Width="44" Height="44" Padding="0" HorizontalContentAlignment="Center"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).CloseTabCommand}"
                                                    ToolTip.Tip="Close tab" AutomationProperties.Name="Close tab">
                                                <ic:SymbolIcon Symbol="Dismiss" FontSize="20" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- Confirmation dialog (IDialogService) -->
        <Border Background="{DynamicResource HelmScrim}" IsVisible="{Binding Dialogs.IsOpen}">
            <Border Classes="card" MaxWidth="400" Margin="24" Padding="24,20" VerticalAlignment="Center" BoxShadow="0 8 32 0 #40000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Dialogs.Title}" FontSize="18" Classes="title" />
                    <TextBlock Text="{Binding Dialogs.Message}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Cancel" Command="{Binding Dialogs.CancelCommand}" />
                        <Button Content="{Binding Dialogs.ConfirmText}" Classes="accent" Command="{Binding Dialogs.ConfirmCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
