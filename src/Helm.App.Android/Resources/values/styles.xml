<?xml version="1.0" encoding="utf-8" ?>
<resources>
  <style name="HelmTheme.NoActionBar" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <!-- Avalonia takes its accent from the theme: the Fluent blue the Windows app uses by default. -->
    <item name="colorAccent">@color/helm_accent</item>
    <item name="android:colorAccent">@color/helm_accent</item>
    <item name="android:windowActionBar">false</item>
    <item name="android:windowBackground">@drawable/splash_screen</item>
    <item name="android:windowNoTitle">true</item>
  </style>
</resources>
