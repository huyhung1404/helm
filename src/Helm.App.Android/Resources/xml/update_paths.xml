<?xml version="1.0" encoding="utf-8"?>
<paths>
  <!-- Downloaded update APKs (see AndroidUpdateService). -->
  <cache-path name="updates" path="updates/" />
  <!-- Vault documents opened in another app: wiped when the vault locks and when Helm starts. -->
  <cache-path name="vault-open" path="vault-open/" />
  <!-- Files shared from a tool, e.g. the Tracker calendar as .ics (replaced on each share). -->
  <cache-path name="share" path="share/" />
  <!-- Log files shared from General → Logs. -->
  <files-path name="logs" path="Helm/logs/" />
</paths>
