<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- In-app updater: hands the downloaded APK to the system installer (the user confirms each install). -->
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	<!-- Wallet: on Android 11+ the SMS apps must be visible for Android to name the default one (it shows the banks' SMS). -->
	<!-- Vault autofill: on Android 11+ an app must be visible for Helm to read who signed it (a login is offered only to
	     the app it was saved for, never to a fake one that took the same package name). -->
	<queries>
		<intent>
			<action android:name="android.provider.Telephony.SMS_DELIVER" />
		</intent>
		<intent>
			<action android:name="android.intent.action.MAIN" />
			<category android:name="android.intent.category.LAUNCHER" />
		</intent>
	</queries>
	<application android:label="Helm" android:icon="@drawable/icon" android:allowBackup="false" android:networkSecurityConfig="@xml/network_security_config">
		<provider android:name="androidx.core.content.FileProvider"
		          android:authorities="com.huyhung1404.helm.updates"
		          android:exported="false"
		          android:grantUriPermissions="true">
			<meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
		</provider>
	</application>
</manifest>
