<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia pieces only Windows has: the shortcut recorder (HotkeyBox) and the windows that need Win32 styles on
       their HWND (a corner card that never takes the focus, a floating panel). No WPF. -->
  <PropertyGroup>
    <RootNamespace>Helm.Ui.Windows</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia.Win32: KeyInterop (a key to its Windows virtual-key code) for the shortcut recorder. -->
    <PackageReference Include="Avalonia.Win32" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core.Windows\Helm.Core.Windows.csproj" />
    <ProjectReference Include="..\Helm.Ui\Helm.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>