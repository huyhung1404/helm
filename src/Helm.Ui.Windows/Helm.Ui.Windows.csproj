<Project Sdk="Microsoft.NET.Sdk">

  <!-- SPIKE: lets the WPF app show shared Avalonia pages while tools move over one at a time. Goes away with the WPF
       shell. Avalonia has no WPF host, so the chain is WPF WindowsFormsHost -> WinFormsAvaloniaControlHost. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Helm.Ui.Windows</RootNamespace>
  </PropertyGroup>

  <!-- WinForms' implicit usings clash with WPF names (Application, Control, UserControl...). -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Win32.Interoperability" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core.Windows\Helm.Core.Windows.csproj" />
    <ProjectReference Include="..\Helm.Ui\Helm.Ui.csproj" />
  </ItemGroup>

</Project>
