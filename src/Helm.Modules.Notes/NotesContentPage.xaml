<Page x:Class="Helm.Modules.Notes.NotesContentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uiw="clr-namespace:Helm.Ui.Windows;assembly=Helm.Ui.Windows"
      ScrollViewer.CanContentScroll="False"
      Title="Notes">

    <!-- Notes (the wall, the open note, the settings sheet) is the shared Avalonia page, Helm.Modules.Notes.UI/NotesView: the same
         view on every platform. This WPF page only hosts it and does the Windows part (the folder dialog of the Markdown export). -->
    <uiw:AvaloniaHost x:Name="Host" />
</Page>
