<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.AlwaysOnTop"
             xmlns:core="using:Helm.Core.Ui"
             x:Class="Helm.Modules.AlwaysOnTop.Ui.AlwaysOnTopView"
             x:DataType="vm:AlwaysOnTopViewModel">

    <!-- Always On Top: the tool has no other content (it works on other apps' windows), so its settings are its page. The
         first card turns it on or off; then the shortcut, the border around kept windows, the windows on top now (with
         Unpin) and the apps that are never kept on top. One card per subject, a switch on the right or a field under its
         name. -->
    <UserControl.Styles>
        <Style Selector="Border.key">
            <Setter Property="Background" Value="{DynamicResource HelmSubtleFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="Border.key > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- A colour to pick: a round-cornered chip filled with it; the chosen one ringed -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style Selector="Button.swatch.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource HelmEyebrow}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.swatch Border.fill">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
        </Style>
        <!-- A window on top: a thin line above each but the first -->
        <Style Selector="Border.win">
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,10" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <core:Backdrop />
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" core:ScrollFade.Enabled="True">
            <StackPanel x:Name="Page" Margin="40,28,40,40" Spacing="14">
                <StackPanel Margin="0,0,0,6">
                    <TextBlock x:Name="TopLine" Classes="eyebrow" TextWrapping="Wrap" />
                    <TextBlock Classes="display" Text="Always On Top" />
                    <TextBlock Classes="muted" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Keep any window above the others with a shortcut. Kept windows get a coloured border, so you always know which ones they are." />
                </StackPanel>

                <core:MasonryPanel x:Name="Cards" MinColumnWidth="430" Spacing="14">

                    <!-- On or off -->
                    <Border Classes="glass">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Always On Top is on" Classes="head" />
                                <TextBlock Text="Off frees the shortcut and puts every kept window back among the others."
                                           Classes="secondary" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="EnableSwitch" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent=""
                                          AutomationProperties.Name="Always On Top on or off" />
                        </Grid>
                    </Border>

                    <!-- The shortcut could not be registered, or window tracking failed -->
                    <Border x:Name="ProblemCard" Classes="glass" Background="{DynamicResource HelmWarningBackground}" IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*">
                            <ic:SymbolIcon Symbol="Warning" FontSize="18" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="ProblemText" Grid.Column="1" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- Shortcut -->
                    <Border Classes="glass">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Shortcut" Classes="head" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Keep on top, or let go" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <ContentControl x:Name="HotkeyPicker" />
                                    <Button x:Name="HotkeyReset" Grid.Column="1" Classes="chip" ToolTip.Tip="Back to the default shortcut"
                                            AutomationProperties.Name="Shortcut: default">
                                        <ic:SymbolIcon Symbol="ArrowUndo" FontSize="14" />
                                    </Button>
                                </Grid>
                                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Acts on the window in front: it stays above the others until you press it again." />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Not during games" TextWrapping="Wrap" />
                                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="The shortcut does nothing while a full-screen game or presentation runs." />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DoNotActivateInGameMode}" OnContent="" OffContent=""
                                              AutomationProperties.Name="Not during games" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="Play a sound" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding PlaySound}" OnContent="" OffContent=""
                                              AutomationProperties.Name="Play a sound" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Border -->
                    <Border Classes="glass">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Border" Classes="head" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Show a border around kept windows" TextWrapping="Wrap" />
                                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="A frame you can click through, so kept windows stand out." />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ShowBorder}" OnContent="" OffContent=""
                                              AutomationProperties.Name="Show a border around kept windows" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsEnabled="{Binding ShowBorder}">
                                <TextBlock Text="Use the Windows accent colour" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding UseAccentColor}" OnContent="" OffContent=""
                                              AutomationProperties.Name="Use the Windows accent colour" />
                            </Grid>
                            <StackPanel Spacing="8" IsEnabled="{Binding CanPickColor}">
                                <TextBlock Text="Colour" />
                                <WrapPanel x:Name="Swatches" Margin="0,0,-8,-8" />
                            </StackPanel>
                            <StackPanel Spacing="6" IsEnabled="{Binding ShowBorder}">
                                <TextBlock Text="Thickness" />
                                <ComboBox Classes="glass" HorizontalAlignment="Stretch" ItemsSource="{Binding Thicknesses}" SelectedItem="{Binding BorderThickness}"
                                          AutomationProperties.Name="Border thickness">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="x:Int32">
                                            <TextBlock Text="{Binding StringFormat='{}{0} px'}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- The windows on top now -->
                    <Border Classes="glass">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Windows on top" Classes="head" />
                                    <TextBlock Classes="secondary" Text="{Binding PinnedSummary}" IsVisible="{Binding HasPinned}" />
                                </StackPanel>
                                <Button x:Name="UnpinAllButton" Grid.Column="1" Classes="ghost" MinHeight="36" VerticalAlignment="Center" Command="{Binding UnpinAllCommand}"
                                        IsVisible="{Binding HasPinned}" AutomationProperties.Name="Let go of every window">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ic:SymbolIcon Symbol="PinOff" FontSize="14" />
                                        <TextBlock Text="Unpin all" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="EmptyText" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasPinned}" />
                            <ItemsControl x:Name="PinnedList" ItemsSource="{Binding Pinned}" IsVisible="{Binding HasPinned}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:PinnedWindowInfo">
                                        <Border Classes="win">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <ic:SymbolIcon Symbol="Pin" FontSize="18" VerticalAlignment="Center" Foreground="{DynamicResource HelmEyebrow}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                                    <TextBlock Classes="secondary" Text="{Binding ProcessName}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="ghost" MinHeight="36" Content="Unpin" VerticalAlignment="Center"
                                                        Command="{Binding $parent[UserControl].((vm:AlwaysOnTopViewModel)DataContext).UnpinCommand}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Title, StringFormat='Unpin {0}'}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Excluded apps -->
                    <Border Classes="glass">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Excluded apps" Classes="head" />
                                <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Programs that are never kept on top, one per line (e.g. Unity.exe)." />
                            </StackPanel>
                            <TextBox x:Name="ExcludedBox" Classes="glass" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="240"
                                     VerticalContentAlignment="Top" PlaceholderText="Example: Unity.exe" AutomationProperties.Name="Excluded apps" />
                        </StackPanel>
                    </Border>
                </core:MasonryPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
