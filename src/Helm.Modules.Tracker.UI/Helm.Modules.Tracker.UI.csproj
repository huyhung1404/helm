<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Tracker page, ONE view for every platform (SPIKE: copied from Helm.Modules.Tracker.Android). What differs
       per platform (saving/sharing the calendar, reminders on open) comes through ITrackerPageHost. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Modules.Tracker.Ui</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Ui\Helm.Ui.csproj" />
    <ProjectReference Include="..\Helm.Modules.Tracker.Core\Helm.Modules.Tracker.Core.csproj" />
  </ItemGroup>

</Project>
