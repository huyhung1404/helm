<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Tracker"
             xmlns:core="using:Helm.Core.Ui"
             x:Class="Helm.Modules.Tracker.Ui.TrackerView"
             x:DataType="vm:TrackerViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.late">
            <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
        </Style>
        <Style Selector="TextBlock.done">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
        </Style>
        <Style Selector="TextBlock.head">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.stat">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.tag">
            <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tag > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- The round tick at the start of a task -->
        <Style Selector="Button.tick">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="-11,-11,-1,-11" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tick:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tick:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tick Border.ring">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmSecondaryText}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tick:pointerover Border.ring">
            <Setter Property="BorderBrush" Value="{DynamicResource HelmEyebrow}" />
        </Style>
        <Style Selector="Button.tick.small Border.ring">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>
        <Style Selector="Button.tick.checked Border.ring">
            <Setter Property="Background" Value="{DynamicResource HelmSuccess}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmSuccess}" />
        </Style>
        <Style Selector="Button.tick Border.ring">
            <Setter Property="RenderTransform"><ScaleTransform /></Setter>
        </Style>
        <Style Selector="Button.tick.checked Border.ring">
            <Style.Animations>
                <Animation Duration="0:0:0.28" Easing="BackEaseOut">
                    <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.6" /><Setter Property="ScaleTransform.ScaleY" Value="0.6" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- The task's text: a tap target with no look of its own (the whole card lifts and lights up instead) -->
        <Style Selector="Button.rowhit">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.rowhit:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.rowhit:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- A disclosure arrow: points right when closed, turns a quarter (down) when its section opens, and back.
             core:Motion.Turn="{Binding IsExpanded}" on the Panel.turn around a ChevronRight sets .open / .closing. -->
        <Style Selector="Panel.turn">
            <Setter Property="RenderTransform"><RotateTransform /></Setter>
        </Style>
        <Style Selector="Panel.turn.open">
            <Style.Animations>
                <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="90" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Panel.turn.closing">
            <Style.Animations>
                <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="90" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>        <!-- Small outlined action under an open task -->
        <Style Selector=":is(Button).act">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector=":is(Button).act:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
        </Style>
        <Style Selector="ToggleButton.act:checked /template/ ContentPresenter#PART_ContentPresenter, Button.act.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStrokeStrong}" />
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        </Style>
        <Style Selector="Button.act:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.act:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Tasks · Calendar · Insights -->
        <Style Selector="RadioButton.seg">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Seg" Background="Transparent" CornerRadius="8" Padding="14,7">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="RadioButton.seg:checked">
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="RadioButton.seg:checked /template/ Border#Seg">
            <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
        </Style>
        <!-- Calendar -->
        <Style Selector="Button.calday">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinHeight" Value="56" />
        </Style>
        <Style Selector=":is(UserControl).narrow Button.calday">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="Button.calday.out">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.today">
            <Setter Property="Foreground" Value="{DynamicResource HelmEyebrow}" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Fill" Value="{DynamicResource HelmSecondaryText}" />
        </Style>
        <Style Selector="Ellipse.dot.debt">
            <Setter Property="Fill" Value="{DynamicResource HelmEyebrow}" />
        </Style>
        <Style Selector="Ellipse.dot.overdue">
            <Setter Property="Fill" Value="{DynamicResource HelmDanger}" />
        </Style>
        <Style Selector="Ellipse.dot.done">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector=":is(UserControl).narrow TextBlock.display">
            <Setter Property="FontSize" Value="28" />
        </Style>
        <!-- On a phone a task's actions are icons in one row (the words are their tooltips and names) -->
        <Style Selector=":is(UserControl).narrow TextBlock.label">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(UserControl).narrow :is(Button).act">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- "Split into steps", inline under the task: AI's proposed steps; the ones kept become its checklist -->
        <DataTemplate DataType="vm:TrackerProposalViewModel">
            <Border Classes="glass" Margin="0,6,0,6" BoxShadow="">
                <StackPanel Spacing="6">
                    <StackPanel IsVisible="{Binding IsBusy}">
                        <Border Classes="shimmer" Width="240" />
                        <Border Classes="shimmer" Width="180" />
                        <Border Classes="shimmer" Width="210" />
                        <TextBlock Text="{Binding Status}" Classes="muted" />
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding IsProposing}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Sparkle" FontSize="16" Foreground="{DynamicResource HelmEyebrow}" VerticalAlignment="Center" />
                            <TextBlock Text="Proposed steps" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TickedText}" Classes="muted" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Choices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TaskProposalChoice">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                        <CheckBox MinWidth="0" VerticalAlignment="Center" IsChecked="{Binding Keep}" AutomationProperties.Name="Keep this step" />
                                        <TextBox Grid.Column="1" Classes="glass" Text="{Binding Title}" TextWrapping="Wrap" AutomationProperties.Name="Step" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Content="{Binding SpreadText}" IsChecked="{Binding SpreadDates}" IsVisible="{Binding CanSpread}" />
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Classes="act" Content="Cancel" Command="{Binding CloseCommand}" />
                            <Button Classes="act" Content="Try again" Command="{Binding RetryCommand}" />
                            <Button Classes="pill" Content="{Binding AddText}" Command="{Binding AddCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding IsStuck}">
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Classes="act" Content="Try again" Command="{Binding RetryCommand}" />
                            <Button Classes="act" Content="Cancel" Command="{Binding CloseCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding CanUndo}">
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="act" Content="Undo" Command="{Binding UndoCommand}" />
                        <Button Grid.Column="2" Classes="act" Content="Done" Command="{Binding CloseCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One task: a glass row; tap it to open its steps and actions -->
        <DataTemplate DataType="vm:TrackerItemViewModel">
            <Border Classes="glass lift fade" Padding="14,12" Margin="0,0,0,8">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Classes="tick" Classes.checked="{Binding IsCompleted}" VerticalAlignment="Top"
                                Command="{Binding ToggleCompleteCommand}" AutomationProperties.Name="Done">
                            <Panel>
                                <Border Classes="ring" />
                                <ic:SymbolIcon Symbol="Checkmark" FontSize="13" Foreground="#10170F" IsVisible="{Binding IsCompleted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                        </Button>
                        <Button Grid.Column="1" Grid.ColumnSpan="2" Classes="rowhit" Padding="2,0" Margin="0,-4"
                                Command="{Binding ToggleExpandedCommand}" AutomationProperties.Name="{Binding Title}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Title}" FontSize="15" TextWrapping="Wrap" Classes.done="{Binding IsCompleted}" />
                                    <WrapPanel Margin="0,3,0,0">
                                        <Border Classes="tag" IsVisible="{Binding IsUrgent}"><TextBlock Text="Urgent" Foreground="{DynamicResource HelmDanger}" /></Border>
                                        <Border Classes="tag" IsVisible="{Binding IsHigh}"><TextBlock Text="High" Foreground="{DynamicResource HelmEyebrow}" /></Border>
                                        <Border Classes="tag" IsVisible="{Binding IsStarted}"><TextBlock Text="In progress" Foreground="{DynamicResource HelmSuccess}" /></Border>
                                        <Border Classes="tag" IsVisible="{Binding HasSubtasks}"><TextBlock Text="{Binding SubtaskProgress}" /></Border>
                                        <TextBlock Text="{Binding Details}" Classes="muted" Classes.late="{Binding IsOverdue}" VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Item.Notes}" Classes="muted" IsVisible="{Binding HasNotes}" Margin="0,3,0,0" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Panel Grid.Column="1" Margin="8,6,0,0" VerticalAlignment="Top" Width="14" Height="14" Classes="turn" core:Motion.Turn="{Binding IsExpanded}"><ic:SymbolIcon Symbol="ChevronRight" FontSize="14" Foreground="{DynamicResource HelmSecondaryText}" /></Panel>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- AI's proposed steps show under their task whether the task is open or not -->
                    <ContentControl Content="{Binding Proposal}" Margin="34,0,0,0" />
                    <StackPanel Margin="34,8,0,0" IsVisible="{Binding IsExpanded}" core:Motion.EnterOnShow="True" core:Motion.FromTop="True">
                        <core:LinksPanel DataContext="{Binding Links}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Subtasks}" IsVisible="{Binding HasSubtasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:TrackerItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Button Classes="tick small" Classes.checked="{Binding IsCompleted}" Command="{Binding ToggleCompleteCommand}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <Panel>
                                                <Border Classes="ring" />
                                                <ic:SymbolIcon Symbol="Checkmark" FontSize="11" Foreground="#10170F" IsVisible="{Binding IsCompleted}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Panel>
                                        </Button>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" Classes.done="{Binding IsCompleted}" />
                                        <Button Grid.Column="2" Classes="flat" Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center"
                                                Command="{Binding DeleteCommand}" AutomationProperties.Name="Delete step">
                                            <ic:SymbolIcon Symbol="Dismiss" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Classes="bare" PlaceholderText="+ Add a step" Text="{Binding NewSubtaskTitle}" IsVisible="{Binding CanHaveSubtasks}"
                                 Margin="0,0,0,6" AutomationProperties.Name="New step">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddSubtaskCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <WrapPanel IsVisible="{Binding !IsEditing}">
                            <Button Classes="act" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" ToolTip.Tip="Start" AutomationProperties.Name="Start">
                                <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="Play" FontSize="14" /><TextBlock Classes="label" Text="Start" /></StackPanel>
                            </Button>
                            <Button Classes="act" Command="{Binding BreakDownCommand}" IsVisible="{Binding CanBreakDown}" ToolTip.Tip="Split into steps" AutomationProperties.Name="Split into steps">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Sparkle" FontSize="14" Foreground="{DynamicResource HelmEyebrow}" />
                                    <TextBlock Classes="label" Text="Split into steps" Foreground="{DynamicResource HelmEyebrow}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="act" Command="{Binding BeginEditCommand}" ToolTip.Tip="Edit" AutomationProperties.Name="Edit">
                                <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="Edit" FontSize="14" /><TextBlock Classes="label" Text="Edit" /></StackPanel>
                            </Button>
                            <Button Classes="act" Command="{Binding Links.StartPickingCommand}" IsVisible="{Binding Links, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="Link a note" AutomationProperties.Name="Link a note">
                                <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="Link" FontSize="14" /><TextBlock Classes="label" Text="Link a note" /></StackPanel>
                            </Button>
                            <Button Classes="act" Command="{Binding MoveUpCommand}" IsVisible="{Binding IsOpen}" IsEnabled="{Binding CanMoveUp}" AutomationProperties.Name="Move up">
                                <ic:SymbolIcon Symbol="ArrowUp" FontSize="14" />
                            </Button>
                            <Button Classes="act" Command="{Binding MoveDownCommand}" IsVisible="{Binding IsOpen}" IsEnabled="{Binding CanMoveDown}" AutomationProperties.Name="Move down">
                                <ic:SymbolIcon Symbol="ArrowDown" FontSize="14" />
                            </Button>
                            <Button Classes="act" Command="{Binding DeleteCommand}" AutomationProperties.Name="Delete">
                                <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="Delete" FontSize="14" Foreground="{DynamicResource HelmDanger}" /><TextBlock Classes="label" Text="Delete" Foreground="{DynamicResource HelmDanger}" /></StackPanel>
                            </Button>
                        </WrapPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsEditing}" core:Motion.EnterOnShow="True" core:Motion.FromTop="True">
                            <TextBox Classes="glass" PlaceholderText="Title" Text="{Binding EditTitle}" AutomationProperties.Name="Title" />
                            <TextBox Classes="glass" PlaceholderText="Notes" Text="{Binding EditNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                     VerticalContentAlignment="Top" Padding="12,10" AutomationProperties.Name="Notes" />
                            <ComboBox Classes="glass" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding $parent[UserControl].((vm:TrackerViewModel)DataContext).PriorityNames}"
                                      SelectedIndex="{Binding EditPriorityIndex}" />
                            <core:DateTimeBox Classes="glass" Date="{Binding EditDueDate}" Time="{Binding EditDueTime}" Lean="Future" AllowEmpty="True" PlaceholderText="Due date (optional)" />
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsRepeating}">
                                <ComboBox Classes="glass" HorizontalAlignment="Stretch" SelectedIndex="{Binding EditRepeatIndex}"
                                          ItemsSource="{Binding $parent[UserControl].((vm:TrackerViewModel)DataContext).RepeatNames}" />
                                <TextBox Grid.Column="1" Classes="glass" Width="96" Margin="8,0,0,0" PlaceholderText="Days" Text="{Binding EditRepeatDays}" />
                            </Grid>
                            <WrapPanel>
                                <Button Classes="pill" Content="Save" Command="{Binding SaveEditCommand}" Margin="0,0,8,0" />
                                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelEditCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Panel>
        <core:Backdrop />
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Page" Margin="40,28,40,40">

                <!-- Today, and which view -->
                <Grid x:Name="TopBar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Classes="eyebrow" Text="{Binding TodayLine, Converter={x:Static core:UpperCase.Instance}}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,12,0" />
                    <StackPanel x:Name="Tabs" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <Border Classes="glass" Padding="3" CornerRadius="10" BoxShadow="" IsVisible="{Binding HasWorkspaces}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <RadioButton x:Name="TasksTab" Classes="seg" GroupName="TrackerTab" IsChecked="True" Content="Tasks" IsCheckedChanged="Tab_Changed" />
                                <RadioButton x:Name="CalendarTab" Classes="seg" GroupName="TrackerTab" Content="Calendar" IsCheckedChanged="Tab_Changed" />
                                <RadioButton x:Name="InsightsTab" Classes="seg" GroupName="TrackerTab" Content="Insights" IsCheckedChanged="Tab_Changed" />
                            </StackPanel>
                        </Border>
                        <!-- Straight to Tracker's settings (and back from there) -->
                        <Button Classes="chip" Click="Settings_Click" ToolTip.Tip="Tracker settings" AutomationProperties.Name="Tracker settings">
                            <ic:SymbolIcon Symbol="Settings" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="OffBar" Classes="glass" Margin="0,16,0,0" IsVisible="False">
                    <StackPanel>
                        <TextBlock Text="Tracker is turned off" Classes="head" />
                        <TextBlock Text="Your lists are kept. Turn Tracker on in its settings to use them." Classes="muted" />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Body">
                    <!-- First run: the way in, step by step (1 is the only thing to do now) -->
                    <Border Classes="glass hero enter" IsVisible="{Binding HasNoWorkspaces}" Margin="0,32,0,0" Padding="28,26">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="eyebrow" Text="START HERE" />
                                <TextBlock Text="Three steps to a clear head" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <UniformGrid x:Name="FirstRunSteps" Columns="3">
                                <Border Classes="glass" Margin="0,0,10,10" BorderBrush="{DynamicResource HelmGlassStrokeStrong}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="eyebrow" Text="1" />
                                        <TextBlock Text="Make a list" FontWeight="SemiBold" />
                                        <TextBlock Classes="muted" Text="One list per part of life: today, work, home." />
                                    </StackPanel>
                                </Border>
                                <Border Classes="glass" Margin="0,0,10,10" Opacity="0.55">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="eyebrow" Text="2" />
                                        <TextBlock Text="Add what needs doing" FontWeight="SemiBold" />
                                        <TextBlock Classes="muted" Text="Type it and press Enter. A due date only if it has one." />
                                    </StackPanel>
                                </Border>
                                <Border Classes="glass" Margin="0,0,10,10" Opacity="0.55">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="eyebrow" Text="3" />
                                        <TextBlock Text="Tick it off" FontWeight="SemiBold" />
                                        <TextBlock Classes="muted" Text="Done moves down, out of the way. Reports count it." />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Button x:Name="FirstRunButton" Classes="pill" HorizontalAlignment="Left" MinWidth="220" Command="{Binding CreateTasksWorkspaceCommand}"
                                    AutomationProperties.Name="Make my first list">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Make my first list" Foreground="{DynamicResource HelmPillForeground}" />
                                    <ic:SymbolIcon Symbol="ArrowRight" FontSize="16" Foreground="{DynamicResource HelmPillForeground}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- TASKS, read top to bottom: which list → add → do → done -->
                    <Panel IsVisible="{Binding ShowListsView}">
                    <StackPanel x:Name="TasksPanel" Classes="enter" core:Motion.EnterOnShow="True">
                        <!-- 1. Which list: all of them in one row, the open one highlighted -->
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,22,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding Workspaces}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:WorkspaceOption">
                                            <Button Classes="glass fade" Classes.selected="{Binding IsSelected}" MinWidth="170" MaxWidth="240" Padding="12,10"
                                                    Click="List_Click" AutomationProperties.Name="{Binding Name}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,10,0" Background="{DynamicResource HelmGlassHover}"
                                                            BorderBrush="{DynamicResource HelmGlassStroke}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource HelmEyebrow}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Summary}" Classes="muted" FontSize="12" Classes.late="{Binding HasOverdue}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button x:Name="NewListButton" Classes="ghost" MinHeight="56" Click="NewList_Click" IsVisible="False" AutomationProperties.Name="New list">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="Add" FontSize="14" /><TextBlock Text="New list" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <Border x:Name="NewListBox" Classes="glass" core:Motion.EnterOnShow="True" Margin="0,8,0,0" Padding="16,6,8,6" IsVisible="False">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="NewListName" Classes="bare" PlaceholderText="Name of the new list — press Enter" Text="{Binding NewWorkspaceName}"
                                         AutomationProperties.Name="New list name">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding CreateWorkspaceCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1" Classes="pill" MinHeight="40" Content="Create" Command="{Binding CreateWorkspaceCommand}" />
                            </Grid>
                        </Border>

                        <!-- The open list -->
                        <StackPanel Margin="0,22,0,16">
                            <TextBlock Classes="display" Text="{Binding WorkspaceName}" />
                            <TextBlock Classes="muted" FontSize="14" Margin="0,4,0,0" Text="{Binding OpenSummary}" />
                        </StackPanel>

                        <!-- 2. Add: type and press Enter; due date, priority and repeat are optional -->
                        <Border Classes="glass" Padding="16,8,8,8">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox x:Name="NewTaskBox" Classes="bare" FontSize="15" PlaceholderText="Add a task — press Enter" Text="{Binding NewTitle}"
                                             VerticalAlignment="Center" AutomationProperties.Name="New task">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <ToggleButton x:Name="MoreToggle" Grid.Column="1" Classes="chip" Margin="8,0" VerticalAlignment="Center"
                                                  IsVisible="{Binding IsTaskWorkspace}" ToolTip.Tip="Due date, priority, repeat"
                                                  AutomationProperties.Name="Due date, priority, repeat">
                                        <ic:SymbolIcon Symbol="Options" FontSize="16" />
                                    </ToggleButton>
                                    <Button Grid.Column="2" Classes="pill" Width="40" Height="40" MinHeight="40" Padding="0" VerticalAlignment="Center"
                                            Command="{Binding AddCommand}" AutomationProperties.Name="Add">
                                        <ic:SymbolIcon Symbol="Add" FontSize="18" Foreground="{DynamicResource HelmPillForeground}" />
                                    </Button>
                                </Grid>
                                <!-- Options: date, priority, repeat. They fill the row (a phone: date on its own line, the
                                     other two side by side) so nothing sits ragged; Grid positions are set in code. -->
                                <Grid x:Name="OptionsGrid" IsVisible="{Binding #MoreToggle.IsChecked}" Margin="0,10,0,0" ColumnDefinitions="2*,*,*"
                                      RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" core:Motion.EnterOnShow="True" core:Motion.FromTop="True">
                                    <core:DateTimeBox x:Name="DueBox" Classes="glass" Date="{Binding NewDueDate}" Time="{Binding NewDueTime}" Lean="Future" AllowEmpty="True"
                                                      PlaceholderText="Due date" />
                                    <ComboBox x:Name="PriorityBox" Grid.Column="1" Classes="glass" HorizontalAlignment="Stretch" ItemsSource="{Binding PriorityNames}"
                                              SelectedIndex="{Binding NewPriorityIndex}" AutomationProperties.Name="Priority" />
                                    <ComboBox x:Name="RepeatBox" Grid.Column="2" Classes="glass" HorizontalAlignment="Stretch" ItemsSource="{Binding RepeatNames}"
                                              SelectedIndex="{Binding NewRepeatIndex}" AutomationProperties.Name="Repeat" />
                                    <TextBox x:Name="DaysBox" Grid.Column="2" Grid.Row="1" Classes="glass" PlaceholderText="Days" Text="{Binding NewRepeatDays}"
                                             IsVisible="{Binding NewRepeatsForDays}" AutomationProperties.Name="Repeat for days" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Classes="glass" core:Motion.EnterOnShow="True" Margin="0,8,0,0" IsVisible="{Binding HasMessage}" BorderBrush="{DynamicResource HelmDanger}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="flat" Width="36" Height="36" Padding="0" Command="{Binding DismissMessageCommand}" AutomationProperties.Name="Dismiss">
                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 3. Do: the open tasks -->
                        <Border Classes="glass" Margin="0,12,0,0" Padding="28,24" IsVisible="{Binding HasNoOpen}">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <ic:SymbolIcon Symbol="ArrowUp" FontSize="18" Foreground="{DynamicResource HelmEyebrow}" HorizontalAlignment="Center" />
                                <TextBlock Text="Nothing to do here. Add the first task above." Classes="muted" FontSize="14" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding OpenItems}" Margin="0,12,0,0" />
                        <Button Classes="ghost" HorizontalAlignment="Stretch" Content="{Binding OpenPager.MoreText}" Command="{Binding OpenPager.ShowMoreCommand}"
                                IsVisible="{Binding OpenPager.HasMore}" />

                        <!-- 4. Done, folded away -->
                        <Button Classes="flat" HorizontalAlignment="Left" Padding="4,8" Margin="0,8,0,4" Click="ToggleDone_Click" IsVisible="{Binding HasCompleted}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Panel Width="12" Height="12" Classes="turn" core:Motion.Turn="{Binding ShowCompleted}"><ic:SymbolIcon Symbol="ChevronRight" FontSize="12" Foreground="{DynamicResource HelmSecondaryText}" /></Panel>
                                <TextBlock Text="Done" Classes="muted" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding CompletedItems}" IsVisible="{Binding ShowCompleted}" core:Motion.EnterOnShow="True" core:Motion.FromTop="True" />
                        <Button Classes="ghost" HorizontalAlignment="Stretch" Content="{Binding CompletedPager.MoreText}" Command="{Binding CompletedPager.ShowMoreCommand}">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="ShowCompleted" />
                                    <Binding Path="CompletedPager.HasMore" />
                                </MultiBinding>
                            </Button.IsVisible>
                        </Button>
                    </StackPanel>

                    <!-- INSIGHTS -->
                    <StackPanel x:Name="InsightsPanel" core:Motion.EnterOnShow="True" IsVisible="False" Margin="0,26,0,0" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="display" Text="Insights" />
                            <ComboBox Grid.Column="1" Classes="glass" ItemsSource="{Binding ReportRangeNames}" SelectedIndex="{Binding ReportRangeIndex}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Report period" />
                        </Grid>
                        <DockPanel>
                            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ReportAllWorkspaces}" OnContent="" OffContent="" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="All lists" />
                                <TextBlock Text="{Binding ReportRangeText}" Classes="muted" />
                            </StackPanel>
                        </DockPanel>
                        <UniformGrid Columns="3">
                            <Border Classes="glass" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding ReportCompleted}" Classes="stat" /><TextBlock Text="Completed" Classes="muted" /></StackPanel></Border>
                            <Border Classes="glass" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding ReportCreated}" Classes="stat" /><TextBlock Text="Added" Classes="muted" /></StackPanel></Border>
                            <Border Classes="glass" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding ReportOnTime}" Classes="stat" /><TextBlock Text="Done by the due date" Classes="muted" /></StackPanel></Border>
                            <Border Classes="glass" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding ReportAverageLead}" Classes="stat" /><TextBlock Text="Average, added to done" Classes="muted" /></StackPanel></Border>
                            <Border Classes="glass" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding ReportMedianLead}" Classes="stat" /><TextBlock Text="Median, added to done" Classes="muted" /></StackPanel></Border>
                            <Border Classes="glass" Margin="0,0,10,10"><StackPanel><TextBlock Text="{Binding ReportAverageWork}" Classes="stat" /><TextBlock Text="Average, started to done" Classes="muted" /></StackPanel></Border>
                        </UniformGrid>
                        <Border Classes="glass">
                            <StackPanel>
                                <TextBlock Text="Completed per day" Classes="head" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding ReportDays}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ReportBar">
                                            <Grid RowDefinitions="64,18" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                                                <Border VerticalAlignment="Bottom" Height="{Binding BarHeight}" CornerRadius="4,4,2,2" Margin="2,0"
                                                        Background="{DynamicResource HelmEyebrow}" />
                                                <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Classes="muted" Margin="-20,2,-20,0" TextAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Repeating tasks: days done" Classes="head" Margin="0,16,0,6" IsVisible="{Binding HasReportRepeats}" />
                                <ItemsControl ItemsSource="{Binding ReportRepeats}" IsVisible="{Binding HasReportRepeats}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ReportCount">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="SemiBold" Margin="12,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Recent changes" Classes="head" Margin="2,8,0,0" />
                        <Border Classes="glass">
                            <StackPanel>
                                <TextBlock Text="No history yet." Classes="muted" IsVisible="{Binding !HasHistory}" />
                                <ItemsControl ItemsSource="{Binding History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:HistoryRow">
                                            <StackPanel Margin="0,4">
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                <TextBlock Classes="muted"><Run Text="{Binding When}" /><Run Text=" · " /><Run Text="{Binding Workspace}" /></TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="ghost" HorizontalAlignment="Stretch" Content="{Binding HistoryPager.MoreText}" Command="{Binding HistoryPager.ShowMoreCommand}"
                                        IsVisible="{Binding HistoryPager.HasMore}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Panel>

                    <!-- CALENDAR -->
                    <StackPanel x:Name="CalendarPanel" core:Motion.EnterOnShow="True" Spacing="10" Margin="0,26,0,0" IsVisible="{Binding ShowCalendarView}">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <TextBlock Classes="display" Text="{Binding CalendarTitle}" />
                            <Button Grid.Column="1" Classes="ghost" Width="44" Padding="0" Command="{Binding CalendarPreviousCommand}" AutomationProperties.Name="Previous">
                                <ic:SymbolIcon Symbol="ChevronLeft" FontSize="16" />
                            </Button>
                            <Button Grid.Column="2" Classes="ghost" Width="44" Padding="0" Margin="6,0" Command="{Binding CalendarNextCommand}" AutomationProperties.Name="Next">
                                <ic:SymbolIcon Symbol="ChevronRight" FontSize="16" />
                            </Button>
                            <Button Grid.Column="3" Classes="ghost" Content="Today" Command="{Binding CalendarTodayCommand}" />
                        </Grid>
                        <WrapPanel>
                            <Button Classes="act" Content="Month" Command="{Binding SetCalendarMonthCommand}" Classes.selected="{Binding !IsWeekView}" />
                            <Button Classes="act" Content="Week" Command="{Binding SetCalendarWeekCommand}" Classes.selected="{Binding IsWeekView}" />
                            <CheckBox Content="All lists" IsChecked="{Binding CalendarAllWorkspaces}" Margin="8,0,12,6" />
                            <Button Classes="act" Click="ShareIcs_Click" AutomationProperties.Name="Save as a calendar file">
                                <StackPanel Orientation="Horizontal" Spacing="6"><ic:SymbolIcon Symbol="Share" FontSize="14" /><TextBlock Text=".ics" /></StackPanel>
                            </Button>
                        </WrapPanel>
                        <StackPanel IsVisible="{Binding !IsWeekView}">
                            <ItemsControl ItemsSource="{Binding CalendarWeekdayNames}" Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" Classes="muted" FontSize="12" HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding CalendarDays}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:CalendarDayViewModel">
                                        <Button Classes="glass calday" Classes.selected="{Binding IsSelected}" Classes.out="{Binding !IsInRange}" Margin="3" Padding="6"
                                                Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding AutomationName}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding DayNumber}" FontWeight="SemiBold" Classes.today="{Binding IsToday}" />
                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:CalendarEntryViewModel">
                                                            <Ellipse Width="6" Height="6" Classes="dot" Classes.debt="{Binding IsDebt}" Classes.overdue="{Binding IsOverdue}" Classes.done="{Binding IsDone}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding CalendarDays}" IsVisible="{Binding IsWeekView}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:CalendarDayViewModel">
                                    <Button Classes="glass" Classes.selected="{Binding IsSelected}" Margin="0,0,0,6" Command="{Binding SelectCommand}"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid ColumnDefinitions="80,*">
                                            <TextBlock Text="{Binding WeekLabel}" FontWeight="SemiBold" Classes.today="{Binding IsToday}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:CalendarEntryViewModel">
                                                            <TextBlock Text="{Binding Line}" TextTrimming="CharacterEllipsis" Classes.late="{Binding IsOverdue}" Classes.done="{Binding IsDone}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding MoreText}" Classes="muted" IsVisible="{Binding HasMore}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Spacing="8" IsVisible="{Binding HasCalendarDaySelection}" core:Motion.EnterOnShow="True">
                            <TextBlock Text="{Binding CalendarSelectedTitle}" Classes="head" Margin="2,12,0,0" />
                            <Border Classes="glass" Padding="16,4,6,4" IsVisible="{Binding CanAddOnCalendarDay}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Classes="bare" PlaceholderText="A task due this day — press Enter" Text="{Binding CalendarNewTitle}">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding AddOnCalendarDayCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Classes="pill" Width="40" Height="40" MinHeight="40" Padding="0" Command="{Binding AddOnCalendarDayCommand}" AutomationProperties.Name="Add">
                                        <ic:SymbolIcon Symbol="Add" FontSize="18" Foreground="{DynamicResource HelmPillForeground}" />
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Text="Nothing is due this day." Classes="muted" IsVisible="{Binding IsCalendarDayEmpty}" />
                            <ItemsControl ItemsSource="{Binding CalendarDayItems}" />
                            <ItemsControl ItemsSource="{Binding CalendarDayOthers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:CalendarEntryViewModel">
                                        <Button Classes="glass" Margin="0,0,0,8" Command="{Binding OpenCommand}" IsEnabled="{Binding IsDebt}" AutomationProperties.Name="{Binding Title}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Panel Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <ic:SymbolIcon Symbol="Person" FontSize="16" IsVisible="{Binding IsDebt}" Foreground="{DynamicResource HelmEyebrow}" />
                                                    <ic:SymbolIcon Symbol="ArrowRepeatAll" FontSize="16" IsVisible="{Binding IsProjected}" />
                                                </Panel>
                                                <TextBlock Grid.Column="1" Text="{Binding Line}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
