<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Tracker"
             xmlns:core="using:Helm.Core.Ui"
             x:Class="Helm.Modules.Tracker.Ui.TrackerSettingsView"
             x:DataType="vm:TrackerViewModel">

    <!-- Tracker's settings as a sheet over the Tracker (the gear): one card per subject, a switch or a field on the right. -->
    <UserControl.Styles>
        <Style Selector="Border.tile">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.tile.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStrokeStrong}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Classes="eyebrow" Text="TRACKER" />
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="1" Classes="chip" VerticalAlignment="Top" ToolTip.Tip="Close" AutomationProperties.Name="Close settings">
                <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
            </Button>
        </Grid>

        <!-- On or off: off keeps the lists (read only) and stops the daily reminder -->
        <Border Classes="glass">
            <DockPanel>
                <ToggleSwitch x:Name="EnableSwitch" DockPanel.Dock="Right" OnContent="" OffContent="" AutomationProperties.Name="Tracker on or off" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Tracker is on" Classes="head" />
                    <TextBlock Text="Off keeps your lists but makes them read only, and stops the daily reminder." Classes="secondary" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Manage the lists: every list on its own row (rename in place, remove), then add one -->
        <Border Classes="glass">
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Lists" Classes="head" />
                    <TextBlock Text="Add, rename or remove your to-do lists. Debts are kept in Wallet." Classes="secondary" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Workspaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:WorkspaceOption">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,10">
                                <Border Classes="tile" Classes.selected="{Binding IsSelected}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{DynamicResource HelmEyebrow}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBox Classes="glass" Text="{Binding Name, Mode=OneWay}" LostFocus="Rename_LostFocus" KeyDown="Rename_KeyDown"
                                             AutomationProperties.Name="List name" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,0,0,0">
                                        <TextBlock Text="{Binding Summary}" Classes="secondary" />
                                        <TextBlock Text="· showing now" Classes="secondary" Foreground="{DynamicResource HelmEyebrow}" IsVisible="{Binding IsSelected}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Classes="chip" VerticalAlignment="Top" ToolTip.Tip="Delete this list"
                                        Command="{Binding $parent[UserControl].((vm:TrackerViewModel)DataContext).DeleteListCommand}" CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Name, StringFormat='Delete {0}'}">
                                    <ic:SymbolIcon Symbol="Delete" FontSize="16" Foreground="{DynamicResource HelmDanger}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Classes="glass" PlaceholderText="Name of a new list" Text="{Binding NewWorkspaceName}" AutomationProperties.Name="New list name">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding CreateWorkspaceCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Classes="pill" Content="Add list" Command="{Binding CreateWorkspaceCommand}" />
                </Grid>
            </StackPanel>
        </Border>
        <Border Classes="glass">
            <StackPanel Spacing="12">
                <TextBlock Text="Display" Classes="head" />
                <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShowCompleted}" OnContent="" OffContent="" AutomationProperties.Name="Show finished tasks" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Show finished tasks" />
                        <TextBlock Text="List them under the open ones." Classes="secondary" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Tasks shown at first" />
                    <ComboBox Classes="glass" HorizontalAlignment="Stretch" ItemsSource="{x:Static core:ListPager.SizeNames}" SelectedIndex="{Binding ItemsShownIndex}"
                              AutomationProperties.Name="Tasks shown at first" />
                    <TextBlock Text="Show more adds as many again. Fewer keeps Tracker smooth to scroll." Classes="secondary" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="glass">
            <StackPanel Spacing="12">
                <TextBlock Text="Reminders" Classes="head" />
                <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding RemindersEnabled}" OnContent="" OffContent="" AutomationProperties.Name="Due date reminders" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Due date reminders" />
                        <TextBlock Text="Once a day, a notification about tasks and debts due soon or overdue." Classes="secondary" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Spacing="12" IsEnabled="{Binding RemindersEnabled}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Reminder time" />
                        <ComboBox Classes="glass" HorizontalAlignment="Stretch" ItemsSource="{Binding ReminderHourNames}" SelectedIndex="{Binding ReminderHourIndex}"
                                  AutomationProperties.Name="Reminder time" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Due soon means" />
                        <ComboBox Classes="glass" HorizontalAlignment="Stretch" ItemsSource="{Binding RemindDaysNames}" SelectedIndex="{Binding RemindDaysIndex}"
                                  AutomationProperties.Name="Due soon means" />
                    </StackPanel>
                </StackPanel>
                <Button Classes="ghost" HorizontalAlignment="Stretch" Content="Remind me now" Command="{Binding RemindNowCommand}" />
            </StackPanel>
        </Border>

        <Border Classes="glass">
            <StackPanel Spacing="10">
                <TextBlock Text="Export" Classes="head" />
                <TextBlock Text="Copies every task, or every change in the history, to paste into a spreadsheet." Classes="secondary" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" Content="Copy tasks" Command="{Binding CopyItemsCsvCommand}" />
                    <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" Content="Copy history" Command="{Binding CopyHistoryCsvCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="glass" IsVisible="{Binding HasMessage}" BorderBrush="{DynamicResource HelmDanger}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <Button x:Name="DoneButton" Classes="pill" HorizontalAlignment="Stretch" Content="Done" />
    </StackPanel>
</UserControl>
