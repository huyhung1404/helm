<Page
    x:Class="Helm.Modules.Tracker.TrackerContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.Tracker;assembly=Helm.Modules.Tracker.Core"
    Title="Tracker">

    <!-- The Tracker itself (menu and Quick access). Its options live on TrackerPage (Home → Utilities). -->
    <Page.Resources>
        <!-- Small icon-only action button in a list row -->
        <Style x:Key="RowAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A whole row as one flat button (hover shading, keyboard focus) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="12,8" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ItemRow" DataType="{x:Type local:TrackerItemViewModel}">
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Margin="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox VerticalAlignment="Center" Margin="0,0,4,0" MinWidth="0"
                                  IsChecked="{Binding Done}"
                                  ToolTip="Mark as done (records the finish time)" AutomationProperties.Name="Done" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,2">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="4" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding IsUrgent, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Urgent" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding IsHigh, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="High" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding IsStarted, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="In progress" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <Border CornerRadius="4" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}" ToolTip="{Binding RepeatText}"
                                        Visibility="{Binding RepeatText, Converter={StaticResource NotEmptyToVisibility}}">
                                    <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}" ToolTip="Subtasks done"
                                        Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SubtaskProgress}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,1,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Details}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HelmSecondaryText}">
                                        <Style.Triggers>
                                            <!-- Past its due date and still open -->
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Item.Notes}" Style="{DynamicResource HelmSecondaryText}" Margin="0,2,0,0"
                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Linked notes: click one to open it in Notes -->
                            <core:LinksPanel DataContext="{Binding Links}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Play24}" ToolTip="Start now (records the start time)" AutomationProperties.Name="Start"
                                       Command="{Binding StartCommand}" Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="Move up" AutomationProperties.Name="Move up"
                                       Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}"
                                       Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon ArrowDown24}" ToolTip="Move down" AutomationProperties.Name="Move down"
                                       Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}"
                                       Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon TaskListAdd24}" ToolTip="Add a subtask" AutomationProperties.Name="Add a subtask"
                                       Command="{Binding ToggleExpandedCommand}" Visibility="{Binding CanHaveSubtasks, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Link24}" ToolTip="Link a note, or write a new one" AutomationProperties.Name="Link a note"
                                       Command="{Binding Links.StartPickingCommand}" Visibility="{Binding Links, Converter={StaticResource NotEmptyToVisibility}}" />
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Edit24}" ToolTip="Edit" AutomationProperties.Name="Edit" Command="{Binding BeginEditCommand}" />
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete" AutomationProperties.Name="Delete" Margin="16,0,0,0" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Subtasks -->
                    <ItemsControl Margin="32,2,0,0" ItemsSource="{Binding Subtasks}" Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:TrackerItemViewModel}">
                                <DockPanel Margin="0,1">
                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete the subtask"
                                               AutomationProperties.Name="Delete subtask" Margin="16,0,0,0" Command="{Binding DeleteCommand}" />
                                    <CheckBox MinWidth="0" IsChecked="{Binding Done}" AutomationProperties.Name="{Binding Title}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </CheckBox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="32,4,0,4" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Add" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddSubtaskCommand}" />
                        <ui:TextBox PlaceholderText="A subtask" AutomationProperties.Name="New subtask" Text="{Binding NewSubtaskTitle, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddSubtaskCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                    </DockPanel>

                    <!-- Inline editor -->
                    <StackPanel Margin="32,8,0,6" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                        <ui:TextBox Margin="0,0,0,8" PlaceholderText="Title" AutomationProperties.Name="Edit title" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox Margin="0,0,0,8" PlaceholderText="Notes" AutomationProperties.Name="Edit notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                    Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Priority" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,4" />
                                <ComboBox Width="140"
                                          ItemsSource="{Binding DataContext.PriorityNames, RelativeSource={RelativeSource AncestorType=Page}}"
                                          SelectedIndex="{Binding EditPriorityIndex}" AutomationProperties.Name="Edit priority" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Due" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,4" />
                                <core:DateTimeBox Width="300" Date="{Binding EditDueDate}" Time="{Binding EditDueTime}" Lean="Future" AllowEmpty="True"
                                                  PlaceholderText="No due date" AutomationProperties.Name="Edit due date and time" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8" Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Repeat" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,4" />
                                <ComboBox Width="150" SelectedIndex="{Binding EditRepeatIndex}" AutomationProperties.Name="Edit repeat"
                                          ItemsSource="{Binding DataContext.RepeatNames, RelativeSource={RelativeSource AncestorType=Page}}"
                                          ToolTip="Does not repeat stops it from coming back" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8" Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Days" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,4" />
                                <ui:TextBox Width="110" PlaceholderText="Days" AutomationProperties.Name="Edit repeat days"
                                            Text="{Binding EditRepeatDays, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <ui:Button Margin="0,0,8,8" VerticalAlignment="Bottom" Appearance="Primary" Content="Save" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveEditCommand}" />
                            <ui:Button Margin="0,0,8,8" VerticalAlignment="Bottom" Content="Cancel" Command="{Binding CancelEditCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A number tile in the report -->
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <TextBlock Text="Tracker" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />

        <!-- Shown while the tool is turned off -->
        <ui:InfoBar x:Name="OffBar" Severity="Informational" IsClosable="False" IsOpen="False" Visibility="Collapsed" Margin="0,8,0,0"
                    Title="Tracker is turned off" Message="Your lists are kept. Turn Tracker on in its settings to use them." />

        <StackPanel x:Name="Body">
            <!-- Which list you are looking at, first and easy to see -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Board24}"
                            Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVisibility}}">
                <ui:CardControl.Header>
                    <core:CardHeader Title="Workspace" Description="{Binding SelectedWorkspace.KindText}" />
                </ui:CardControl.Header>
                <ComboBox Width="280" HorizontalAlignment="Right" AutomationProperties.Name="Current workspace"
                          ItemsSource="{Binding Workspaces}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedWorkspace}" />
            </ui:CardControl>
            <!-- First run: no workspace yet -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,24,0,4"
                    Visibility="{Binding HasNoWorkspaces, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Create your first workspace" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{DynamicResource HelmSecondaryText}" Margin="0,4,0,12"
                               Text="A workspace is one to-do list. You can add more later. Debts are kept in Wallet." />
                    <WrapPanel>
                        <ui:Button Margin="0,0,8,0" Appearance="Primary" Content="New to-do list" Icon="{ui:SymbolIcon TaskListSquareLtr24}"
                                   Command="{Binding CreateTasksWorkspaceCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Lists or calendar -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Margin="0,0,6,0" Content="Lists" Icon="{ui:SymbolIcon TaskListLtr24}" Command="{Binding ShowListsCommand}" AutomationProperties.Name="Show the lists">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Primary" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCalendar}" Value="True"><Setter Property="Appearance" Value="Secondary" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button Content="Calendar" Icon="{ui:SymbolIcon CalendarLtr24}" Command="{Binding ShowCalendarCommand}" AutomationProperties.Name="Show the calendar">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Secondary" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCalendar}" Value="True"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </StackPanel>

            <!-- Calendar: every due task and debt of the month (or week); a click on a day lists it below -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding ShowCalendarView, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8" Padding="12,8" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <core:RowLayout>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Command="{Binding DismissMessageCommand}" />
                    </core:RowLayout>
                </Border>
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="All workspaces" IsChecked="{Binding CalendarAllWorkspaces}" Margin="0,0,12,0" VerticalAlignment="Center"
                                  ToolTip="Untick to show only the workspace chosen above" />
                        <ui:Button Margin="0,0,4,0" Content="Month" Command="{Binding SetCalendarMonthCommand}" AutomationProperties.Name="Month view">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Primary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWeekView}" Value="True"><Setter Property="Appearance" Value="Secondary" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Margin="0,0,12,0" Content="Week" Command="{Binding SetCalendarWeekCommand}" AutomationProperties.Name="Week view">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Secondary" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWeekView}" Value="True"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Content="Export .ics…" Icon="{ui:SymbolIcon ArrowDownload24}" Click="ExportIcs_Click"
                                   ToolTip="Open tasks and debts with a due date, for Google Calendar, Outlook or your phone" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon ChevronLeft24}" Command="{Binding CalendarPreviousCommand}" ToolTip="Previous" AutomationProperties.Name="Previous" />
                        <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon ChevronRight24}" Command="{Binding CalendarNextCommand}" ToolTip="Next" AutomationProperties.Name="Next" />
                        <ui:Button Margin="4,0,12,0" Content="Today" Command="{Binding CalendarTodayCommand}" />
                        <TextBlock Text="{Binding CalendarTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding CalendarWeekdayNames}" Focusable="False" Visibility="{Binding IsWeekView, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="8,0,0,4" Style="{DynamicResource HelmSecondaryText}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding CalendarDays}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CalendarDayViewModel}">
                            <Button Style="{StaticResource RowButton}" Margin="2" Padding="0" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding AutomationName}">
                                <Border CornerRadius="6" Padding="8,6" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="MinHeight" Value="104" />
                                            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsWeekView, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                    <Setter Property="MinHeight" Value="300" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInRange}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding DayNumber}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsWeekView, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                            <Setter Property="Text" Value="{Binding WeekLabel}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Entries}" Focusable="False" IsHitTestVisible="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:CalendarEntryViewModel}">
                                                    <TextBlock Text="{Binding Line}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1" ToolTip="{Binding Detail}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDebt}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsProjected}" Value="True">
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding MoreText}" FontSize="12" Style="{DynamicResource HelmSecondaryText}"
                                                   Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The day clicked: its tasks (tick or edit them here), debts and repeating tasks, and a task to add on it -->
                <TextBlock Text="{Binding CalendarSelectedTitle}" Style="{DynamicResource HelmSectionHeader}"
                           Visibility="{Binding HasCalendarDaySelection, Converter={StaticResource BoolToVisibility}}" />
                <Border Style="{DynamicResource HelmSurface}" Padding="0" Visibility="{Binding HasCalendarDaySelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="12,12,12,6" Visibility="{Binding CanAddOnCalendarDay, Converter={StaticResource BoolToVisibility}}">
                            <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Appearance="Primary" Content="Add" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddOnCalendarDayCommand}" />
                            <ui:TextBox PlaceholderText="A task due this day" AutomationProperties.Name="New task on this day" Text="{Binding CalendarNewTitle, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddOnCalendarDayCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                        </DockPanel>
                        <TextBlock Margin="16,8,16,12" Text="Nothing is due this day." Style="{DynamicResource HelmSecondaryText}"
                                   Visibility="{Binding IsCalendarDayEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding CalendarDayItems}" ItemTemplate="{StaticResource ItemRow}" />
                        <ItemsControl ItemsSource="{Binding CalendarDayOthers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:CalendarEntryViewModel}">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <Button Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}" IsEnabled="{Binding IsDebt}">
                                            <DockPanel>
                                                <ui:SymbolIcon DockPanel.Dock="Left" Margin="0,0,12,0" FontSize="18" VerticalAlignment="Center">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Symbol" Value="ArrowRepeatAll24" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDebt}" Value="True"><Setter Property="Symbol" Value="Person24" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                                <TextBlock Text="{Binding Line}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowListsView, Converter={StaticResource BoolToVisibility}}">
            <!-- Add -->
            <TextBlock Text="Add a task" Style="{DynamicResource HelmSectionHeader}" />
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,4">
                <StackPanel>
                    <ui:TextBox Margin="0,0,0,8" AutomationProperties.Name="Title" PlaceholderText="What needs doing?" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <WrapPanel>
                        <StackPanel Margin="0,0,8,0" Visibility="{Binding IsTaskWorkspace, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Priority" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,4" />
                            <ComboBox Width="140" ItemsSource="{Binding PriorityNames}" SelectedIndex="{Binding NewPriorityIndex}"
                                      ToolTip="Priority" AutomationProperties.Name="Priority" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0" Visibility="{Binding IsTaskWorkspace, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Repeat" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,4" />
                            <ComboBox Width="150" ItemsSource="{Binding RepeatNames}" SelectedIndex="{Binding NewRepeatIndex}"
                                      ToolTip="A repeating task comes back every day; the report counts the days you did it" AutomationProperties.Name="Repeat" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0" Visibility="{Binding NewRepeatsForDays, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Days" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,4" />
                            <ui:TextBox Width="110" PlaceholderText="Days" ToolTip="For how many days (today counts)" AutomationProperties.Name="Repeat days"
                                        Text="{Binding NewRepeatDays, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Due (optional)" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,4" />
                            <core:DateTimeBox Width="300" Date="{Binding NewDueDate}" Time="{Binding NewDueTime}" Lean="Future" AllowEmpty="True"
                                              PlaceholderText="No due date" AutomationProperties.Name="Due date and time" />
                        </StackPanel>
                        <ui:Button VerticalAlignment="Bottom" Appearance="Primary" Content="Add" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource HelmSurface}" Margin="0,4,0,4" Padding="12,8"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <core:RowLayout>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Command="{Binding DismissMessageCommand}" />
                </core:RowLayout>
            </Border>

            <!-- Open -->
            <core:RowLayout Margin="0,24,0,8">
                <TextBlock Text="To do" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding OpenSummary}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" />
            </core:RowLayout>
            <Border Style="{DynamicResource HelmSurface}" Padding="0">
                <StackPanel>
                    <TextBlock Margin="16" Text="Nothing to do. Add a task above." Style="{DynamicResource HelmSecondaryText}"
                               Visibility="{Binding HasNoOpen, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding OpenItems}" ItemTemplate="{StaticResource ItemRow}" />
                </StackPanel>
            </Border>

            <!-- Completed -->
            <TextBlock Text="Completed" Style="{DynamicResource HelmSectionHeader}"
                       Visibility="{Binding ShowCompleted, Converter={StaticResource BoolToVisibility}}" />
            <Border Style="{DynamicResource HelmSurface}" Padding="0" Visibility="{Binding ShowCompleted, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Margin="16" Text="Nothing finished yet. Tick an item and it moves here, with its times recorded."
                               Style="{DynamicResource HelmSecondaryText}"
                               Visibility="{Binding HasCompleted, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding CompletedItems}" ItemTemplate="{StaticResource ItemRow}" />
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Report and history, once there is a workspace (not with the calendar) -->
            <StackPanel Visibility="{Binding ShowListsView, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Report" Style="{DynamicResource HelmSectionHeader}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DataBarVertical24}">
                <ui:CardControl.Header>
                    <core:CardHeader Title="Report period" Description="{Binding ReportRangeText}" />
                </ui:CardControl.Header>
                <StackPanel Width="310" Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Margin="0,0,12,0" Content="All workspaces" IsChecked="{Binding ReportAllWorkspaces}" VerticalAlignment="Center" />
                    <ComboBox Width="160" ItemsSource="{Binding ReportRangeNames}" SelectedIndex="{Binding ReportRangeIndex}" AutomationProperties.Name="Report period" />
                </StackPanel>
            </ui:CardControl>
            <UniformGrid Columns="3" Margin="0,0,0,0">
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,4,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportCompleted}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Completed" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,4,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportCreated}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Added" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportOnTime}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Done by the due date" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,4,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportAverageLead}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Average time from added to done" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,4,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportMedianLead}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Median time from added to done" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportAverageWork}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Average time from start to done" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="Completed per day" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding ReportDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReportBar}">
                                <Grid ToolTip="{Binding ToolTip}" Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="64" />
                                        <RowDefinition Height="20" />
                                    </Grid.RowDefinitions>
                                    <Border VerticalAlignment="Bottom" Height="{Binding BarHeight}" CornerRadius="2" Margin="1,0"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center" TextWrapping="NoWrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="-20,2,-20,0" TextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Repeating tasks: days done" FontWeight="SemiBold" Margin="0,16,0,6"
                               Visibility="{Binding HasReportRepeats, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding ReportRepeats}" Visibility="{Binding HasReportRepeats, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReportCount}">
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontWeight="SemiBold" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="By priority" FontWeight="SemiBold" Margin="0,16,0,6" />
                    <ItemsControl ItemsSource="{Binding ReportPriorities}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReportCount}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding Label}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Count}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- History -->
            <TextBlock Text="History" Style="{DynamicResource HelmSectionHeader}" />
            <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon History24}">
                <ui:CardExpander.Header>
                    <core:CardHeader Title="Recent changes" Description="The last 100 things added, started, completed, reopened or deleted, newest first." />
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="No history yet." Style="{DynamicResource HelmSecondaryText}"
                               Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HistoryRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding When}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Workspace}" Style="{DynamicResource HelmSecondaryText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </ui:CardExpander>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Page>
