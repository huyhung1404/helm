<Page
    x:Class="Helm.Modules.Tracker.TrackerContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.Tracker;assembly=Helm.Modules.Tracker.Core"
    Title="Tracker">

    <!-- The Tracker itself (menu and Quick access). Its options live on TrackerPage (Home → Utilities). -->
    <Page.Resources>
        <!-- Small icon-only action button in a list row -->
        <Style x:Key="RowAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Signed amount: owed to me in green, I owe in red (theme colours) -->
        <Style x:Key="AmountText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding OwedToMe}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A whole row as one flat button (hover shading, keyboard focus) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="12,8" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Signed amount of a person or an entry: + in green, - in red -->
        <Style x:Key="SignedText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding OwedToMe}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IOwe}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A person in the debt book: click to see their history and set when it is due; click again to close. -->
        <DataTemplate x:Key="PersonRow" DataType="{x:Type local:DebtPersonViewModel}">
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <Button Style="{StaticResource RowButton}" Command="{Binding ToggleExpandedCommand}" AutomationProperties.Name="{Binding Name}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Person24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HelmSecondaryText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding BalanceText}" FontSize="15" Margin="12,0,4,0" Style="{StaticResource SignedText}" />
                        </Grid>
                    </Button>

                    <StackPanel Margin="44,0,12,12" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <!-- When it is due: extend, or set a date and time -->
                        <WrapPanel Margin="0,4,0,8" Visibility="{Binding IsSettled, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="Due" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <ui:Button Margin="0,0,6,8" Content="+1 day" Command="{Binding ExtendCommand}" CommandParameter="1" ToolTip="Due one day later" />
                            <ui:Button Margin="0,0,6,8" Content="+1 week" Command="{Binding ExtendCommand}" CommandParameter="7" ToolTip="Due a week later" />
                            <ui:Button Margin="0,0,12,8" Content="+1 month" Command="{Binding ExtendCommand}" CommandParameter="30" ToolTip="Due 30 days later" />
                            <DatePicker Width="150" Margin="0,0,6,8" SelectedDate="{Binding EditDueDate}" AutomationProperties.Name="Due date" />
                            <ui:TextBox Width="92" Margin="0,0,6,8" PlaceholderText="HH:mm" AutomationProperties.Name="Due time" Text="{Binding EditDueTimeText, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Margin="0,0,6,8" Appearance="Primary" Content="Set" Command="{Binding SetDueCommand}" />
                            <ui:Button Margin="0,0,6,8" Content="No due date" Command="{Binding ClearDueCommand}" />
                        </WrapPanel>
                        <!-- Notes about this person (bank details, what was agreed…) -->
                        <core:LinksPanel DataContext="{Binding Links}" ShowActions="True" Margin="0,0,0,10" />
                        <!-- Every change of the amount, newest first, with the balance after it -->
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DebtEntryRow}">
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding When}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding KindText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Note}" Style="{DynamicResource HelmSecondaryText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding AmountText}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="4" Text="{Binding BalanceText}" Style="{DynamicResource HelmSecondaryText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        <ui:Button Grid.Column="5" Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete this entry" AutomationProperties.Name="Delete entry"
                                                   Command="{Binding DeleteCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ItemRow" DataType="{x:Type local:TrackerItemViewModel}">
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Margin="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox VerticalAlignment="Center" Margin="0,0,4,0" MinWidth="0"
                                  IsChecked="{Binding Done}"
                                  ToolTip="Mark as done (records the finish time)" AutomationProperties.Name="Done" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,2">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="4" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding IsUrgent, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Urgent" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding IsHigh, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="High" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding IsStarted, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="In progress" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <Border CornerRadius="4" Padding="4,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}" ToolTip="{Binding RepeatText}"
                                        Visibility="{Binding RepeatText, Converter={StaticResource NotEmptyToVisibility}}">
                                    <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,0" Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}" ToolTip="Subtasks done"
                                        Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SubtaskProgress}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,1,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Details}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource HelmSecondaryText}">
                                        <Style.Triggers>
                                            <!-- Past its due date and still open -->
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Item.Notes}" Style="{DynamicResource HelmSecondaryText}" Margin="0,2,0,0"
                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Linked notes: click one to open it in Notes -->
                            <core:LinksPanel DataContext="{Binding Links}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding AmountText}" Style="{StaticResource AmountText}"
                                   Visibility="{Binding IsDebt, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Play24}" ToolTip="Start now (records the start time)" AutomationProperties.Name="Start"
                                       Command="{Binding StartCommand}" Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="Move up" AutomationProperties.Name="Move up"
                                       Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}"
                                       Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon ArrowDown24}" ToolTip="Move down" AutomationProperties.Name="Move down"
                                       Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}"
                                       Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon TaskListAdd24}" ToolTip="Add a subtask" AutomationProperties.Name="Add a subtask"
                                       Command="{Binding ToggleExpandedCommand}" Visibility="{Binding CanHaveSubtasks, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Link24}" ToolTip="Link a note, or write a new one" AutomationProperties.Name="Link a note"
                                       Command="{Binding Links.StartPickingCommand}" Visibility="{Binding Links, Converter={StaticResource NotEmptyToVisibility}}" />
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Edit24}" ToolTip="Edit" AutomationProperties.Name="Edit" Command="{Binding BeginEditCommand}" />
                            <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete" AutomationProperties.Name="Delete" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Subtasks -->
                    <ItemsControl Margin="32,2,0,0" ItemsSource="{Binding Subtasks}" Visibility="{Binding HasSubtasks, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:TrackerItemViewModel}">
                                <DockPanel Margin="0,1">
                                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete the subtask"
                                               AutomationProperties.Name="Delete subtask" Command="{Binding DeleteCommand}" />
                                    <CheckBox MinWidth="0" IsChecked="{Binding Done}" AutomationProperties.Name="{Binding Title}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </CheckBox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="32,4,0,4" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Add" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddSubtaskCommand}" />
                        <ui:TextBox PlaceholderText="A subtask" AutomationProperties.Name="New subtask" Text="{Binding NewSubtaskTitle, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddSubtaskCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                    </DockPanel>

                    <!-- Inline editor -->
                    <StackPanel Margin="32,8,0,6" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel Visibility="{Binding IsDebt, Converter={StaticResource BoolToVisibility}}">
                            <ui:TextBox Width="200" Margin="0,0,8,8" PlaceholderText="Person" AutomationProperties.Name="Edit person" Text="{Binding EditPerson, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:TextBox Width="160" Margin="0,0,8,8" PlaceholderText="Amount" AutomationProperties.Name="Edit amount" Text="{Binding EditAmount, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Width="140" Margin="0,0,8,8"
                                      ItemsSource="{Binding DataContext.DirectionNames, RelativeSource={RelativeSource AncestorType=Page}}"
                                      SelectedIndex="{Binding EditDirectionIndex}" AutomationProperties.Name="Edit direction" />
                        </WrapPanel>
                        <ui:TextBox Margin="0,0,0,8" PlaceholderText="Title" AutomationProperties.Name="Edit title" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:TextBox Margin="0,0,0,8" PlaceholderText="Notes" AutomationProperties.Name="Edit notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                    Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel>
                            <ComboBox Width="140" Margin="0,0,8,8"
                                      Visibility="{Binding IsDebt, Converter={StaticResource InverseBoolToVisibility}}"
                                      ItemsSource="{Binding DataContext.PriorityNames, RelativeSource={RelativeSource AncestorType=Page}}"
                                      SelectedIndex="{Binding EditPriorityIndex}" AutomationProperties.Name="Edit priority" />
                            <DatePicker Width="160" Margin="0,0,8,8" SelectedDate="{Binding EditDueDate}" ToolTip="Due date" AutomationProperties.Name="Edit due date" />
                            <ui:TextBox Width="92" Margin="0,0,8,8" PlaceholderText="HH:mm" ToolTip="Due time (optional)" AutomationProperties.Name="Edit due time"
                                        Text="{Binding EditDueTimeText, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Width="150" Margin="0,0,8,8" SelectedIndex="{Binding EditRepeatIndex}" AutomationProperties.Name="Edit repeat"
                                      ItemsSource="{Binding DataContext.RepeatNames, RelativeSource={RelativeSource AncestorType=Page}}"
                                      Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}" ToolTip="Does not repeat stops it from coming back" />
                            <ui:TextBox Width="110" Margin="0,0,8,8" PlaceholderText="Days" AutomationProperties.Name="Edit repeat days"
                                        Text="{Binding EditRepeatDays, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsRepeating, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Margin="0,0,8,8" Appearance="Primary" Content="Save" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveEditCommand}" />
                            <ui:Button Margin="0,0,8,8" Content="Cancel" Command="{Binding CancelEditCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A number tile in the report -->
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <TextBlock Text="Tracker" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />

        <!-- Shown while the tool is turned off -->
        <ui:InfoBar x:Name="OffBar" Severity="Informational" IsClosable="False" IsOpen="False" Visibility="Collapsed" Margin="0,8,0,0"
                    Title="Tracker is turned off" Message="Your lists are kept. Turn Tracker on in its settings to use them." />

        <StackPanel x:Name="Body">
            <!-- Which list you are looking at, first and easy to see -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Board24}"
                            Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVisibility}}">
                <ui:CardControl.Header>
                    <core:CardHeader Title="Workspace" Description="{Binding SelectedWorkspace.KindText}" />
                </ui:CardControl.Header>
                <ComboBox Width="280" HorizontalAlignment="Right" AutomationProperties.Name="Current workspace"
                          ItemsSource="{Binding Workspaces}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedWorkspace}" />
            </ui:CardControl>
            <!-- First run: no workspace yet -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,24,0,4"
                    Visibility="{Binding HasNoWorkspaces, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Create your first workspace" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{DynamicResource HelmSecondaryText}" Margin="0,4,0,12"
                               Text="A workspace is one list: a to-do list for tasks, or a debt book for who owes whom. You can add more later." />
                    <WrapPanel>
                        <ui:Button Margin="0,0,8,0" Appearance="Primary" Content="New to-do list" Icon="{ui:SymbolIcon TaskListSquareLtr24}"
                                   Command="{Binding CreateTasksWorkspaceCommand}" />
                        <ui:Button Content="New debt book" Icon="{ui:SymbolIcon PersonMoney24}" Command="{Binding CreateDebtWorkspaceCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVisibility}}">
            <!-- Add -->
            <TextBlock Text="{Binding AddHeader}" Style="{DynamicResource HelmSectionHeader}" />
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,4">
                <StackPanel>
                    <WrapPanel Visibility="{Binding IsDebtWorkspace, Converter={StaticResource BoolToVisibility}}">
                        <!-- Typing a name already in the book adds to that person -->
                        <ui:TextBox Width="220" Margin="0,0,8,8" PlaceholderText="Person" AutomationProperties.Name="Person" Icon="{ui:SymbolIcon Person24}"
                                    ToolTip="Who it is with. A name already in the book adds to that person." Text="{Binding NewPerson, UpdateSourceTrigger=PropertyChanged}">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ui:TextBox x:Name="AmountBox" Width="180" Margin="0,0,8,8" PlaceholderText="Amount, e.g. 150k" AutomationProperties.Name="Amount" Icon="{ui:SymbolIcon Money24}"
                                    Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnAmountTextChanged">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ComboBox Width="140" Margin="0,0,8,8" ItemsSource="{Binding DebtKindNames}" SelectedIndex="{Binding NewDebtKindIndex}" AutomationProperties.Name="Kind"
                                  ToolTip="Owes me adds, I owe subtracts, a repayment brings the balance back toward 0" />
                    </WrapPanel>
                    <!-- Names already in the book that match what is typed: one click picks it -->
                    <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding PersonSuggestions}" Visibility="{Binding HasPersonSuggestions, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Margin="0,0,6,6" Padding="10,3" Content="{Binding}" Icon="{ui:SymbolIcon Person24}" AutomationProperties.Name="{Binding}"
                                           Command="{Binding DataContext.PickPersonCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:TextBox Margin="0,0,0,8" AutomationProperties.Name="Title" PlaceholderText="{Binding TitlePlaceholder}" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <WrapPanel>
                        <ComboBox Width="140" Margin="0,0,8,0" ItemsSource="{Binding PriorityNames}" SelectedIndex="{Binding NewPriorityIndex}"
                                  ToolTip="Priority" AutomationProperties.Name="Priority" Visibility="{Binding IsTaskWorkspace, Converter={StaticResource BoolToVisibility}}" />
                        <ComboBox Width="150" Margin="0,0,8,0" ItemsSource="{Binding RepeatNames}" SelectedIndex="{Binding NewRepeatIndex}"
                                  ToolTip="A repeating task comes back every day; the report counts the days you did it" AutomationProperties.Name="Repeat"
                                  Visibility="{Binding IsTaskWorkspace, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBox Width="110" Margin="0,0,8,0" PlaceholderText="Days" ToolTip="For how many days (today counts)" AutomationProperties.Name="Repeat days"
                                    Text="{Binding NewRepeatDays, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding NewRepeatsForDays, Converter={StaticResource BoolToVisibility}}" />
                        <DatePicker Width="160" Margin="0,0,8,0" SelectedDate="{Binding NewDueDate}" ToolTip="Due date (optional)" AutomationProperties.Name="Due date" />
                        <ui:TextBox Width="92" Margin="0,0,8,0" PlaceholderText="HH:mm" ToolTip="Due time (optional)" AutomationProperties.Name="Due time"
                                    Text="{Binding NewDueTimeText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Appearance="Primary" Content="Add" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{DynamicResource HelmSurface}" Margin="0,4,0,4" Padding="12,8"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <core:RowLayout>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Command="{Binding DismissMessageCommand}" />
                </core:RowLayout>
            </Border>

            <!-- Debt totals -->
            <UniformGrid Columns="3" Margin="0,20,0,0" Visibility="{Binding IsDebtWorkspace, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="{Binding OwedToMeText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="Owed to me" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="2,0,2,0">
                    <StackPanel>
                        <TextBlock Text="{Binding IOweText}" Style="{StaticResource StatValue}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="I owe" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding NetText}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Net" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Open -->
            <core:RowLayout Margin="0,24,0,8">
                <TextBlock Text="{Binding OpenHeader}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding OpenSummary}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" />
            </core:RowLayout>
            <Border Style="{DynamicResource HelmSurface}" Padding="0">
                <StackPanel>
                    <TextBlock Margin="16" Text="{Binding EmptyOpenText}" Style="{DynamicResource HelmSecondaryText}"
                               Visibility="{Binding HasNoOpen, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding OpenItems}" ItemTemplate="{StaticResource ItemRow}" />
                    <ItemsControl ItemsSource="{Binding DebtPeople}" ItemTemplate="{StaticResource PersonRow}" />
                </StackPanel>
            </Border>

            <!-- Completed -->
            <TextBlock Text="{Binding CompletedHeader}" Style="{DynamicResource HelmSectionHeader}"
                       Visibility="{Binding ShowCompleted, Converter={StaticResource BoolToVisibility}}" />
            <Border Style="{DynamicResource HelmSurface}" Padding="0" Visibility="{Binding ShowCompleted, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Margin="16" Text="{Binding EmptyCompletedText}"
                               Style="{DynamicResource HelmSecondaryText}"
                               Visibility="{Binding HasCompleted, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding CompletedItems}" ItemTemplate="{StaticResource ItemRow}" />
                    <ItemsControl ItemsSource="{Binding SettledPeople}" ItemTemplate="{StaticResource PersonRow}" />
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Report and history, once there is a workspace -->
            <StackPanel Visibility="{Binding HasWorkspaces, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Report" Style="{DynamicResource HelmSectionHeader}" />
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DataBarVertical24}">
                <ui:CardControl.Header>
                    <core:CardHeader Title="Report period" Description="{Binding ReportRangeText}" />
                </ui:CardControl.Header>
                <StackPanel Width="310" Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Margin="0,0,12,0" Content="All workspaces" IsChecked="{Binding ReportAllWorkspaces}" VerticalAlignment="Center" />
                    <ComboBox Width="160" ItemsSource="{Binding ReportRangeNames}" SelectedIndex="{Binding ReportRangeIndex}" AutomationProperties.Name="Report period" />
                </StackPanel>
            </ui:CardControl>
            <UniformGrid Columns="3" Margin="0,0,0,0">
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,4,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportCompleted}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding ReportCompletedLabel}" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,4,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportCreated}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Added" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportOnTime}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Done by the due date" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,4,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportAverageLead}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding ReportLeadLabel}" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,4,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportMedianLead}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding ReportMedianLabel}" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,4" Visibility="{Binding ShowTaskReport, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportAverageWork}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Average time from start to done" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="Completed per day" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding ReportDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReportBar}">
                                <Grid ToolTip="{Binding ToolTip}" Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="64" />
                                        <RowDefinition Height="18" />
                                    </Grid.RowDefinitions>
                                    <Border VerticalAlignment="Bottom" Height="{Binding BarHeight}" CornerRadius="2" Margin="1,0"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" TextWrapping="NoWrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="-20,2,-20,0" TextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Repeating tasks: days done" FontWeight="SemiBold" Margin="0,16,0,6"
                               Visibility="{Binding HasReportRepeats, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding ReportRepeats}" Visibility="{Binding HasReportRepeats, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReportCount}">
                                <DockPanel Margin="0,2">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontWeight="SemiBold" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="By priority" FontWeight="SemiBold" Margin="0,16,0,6"
                               Visibility="{Binding ShowTaskReport, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding ReportPriorities}" Visibility="{Binding ShowTaskReport, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ReportCount}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding Label}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Count}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- History -->
            <TextBlock Text="History" Style="{DynamicResource HelmSectionHeader}" />
            <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon History24}">
                <ui:CardExpander.Header>
                    <core:CardHeader Title="Recent changes" Description="The last 100 things added, started, completed, reopened or deleted, newest first." />
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="No history yet." Style="{DynamicResource HelmSecondaryText}"
                               Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HistoryRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding When}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Workspace}" Style="{DynamicResource HelmSecondaryText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </ui:CardExpander>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Page>
