<Page
    x:Class="Helm.Modules.Tracker.TrackerContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:uiw="clr-namespace:Helm.Ui.Windows;assembly=Helm.Ui.Windows"
    ScrollViewer.CanContentScroll="False"
    Title="Tracker">

    <!-- The Tracker itself (menu and Quick access) is the shared Avalonia page, Helm.Modules.Tracker.UI/TrackerView:
         the same view on every platform. This WPF page only hosts it and does the Windows parts (save dialog,
         opening the settings). The page scrolls itself, so the Frame's scroller is off (CanContentScroll). -->
    <uiw:AvaloniaHost x:Name="Host" />
</Page>
