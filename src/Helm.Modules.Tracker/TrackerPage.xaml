<core:ModulePageBase
    x:Class="Helm.Modules.Tracker.TrackerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.Tracker"
    ExtraMessage="{Binding Message}">

    <!-- Tracker's settings (Home → Utilities). The lists themselves are on TrackerContentPage. -->
    <StackPanel>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:ImageIcon Width="24" Height="24" Source="{x:Static local:TrackerLogo.Image}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <core:CardHeader Title="Open Tracker" Description="Your lists, the report and the history. Also in the menu and on Home." />
            </ui:CardControl.Header>
            <ui:Button Appearance="Primary" Content="Open Tracker" Click="OpenTracker_Click" />
        </ui:CardControl>

        <!-- Workspaces -->
        <TextBlock Text="Workspaces" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Add24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="New workspace" Description="Another to-do list. Debts are kept in Wallet." />
            </ui:CardControl.Header>
            <StackPanel Width="440" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:TextBox Width="180" Margin="0,0,8,0" PlaceholderText="Name" AutomationProperties.Name="New workspace name"
                            Text="{Binding NewWorkspaceName, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Content="Create" Icon="{ui:SymbolIcon Add24}" Command="{Binding CreateWorkspaceCommand}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Edit24}" IsEnabled="{Binding HasWorkspaces}">
            <ui:CardExpander.Header>
                <core:RowLayout>
                    <core:CardHeader Title="Edit a workspace" Description="Rename it or delete it." />
                    <ComboBox Width="220" Margin="0,0,16,0" AutomationProperties.Name="Workspace to edit" ItemsSource="{Binding Workspaces}"
                              DisplayMemberPath="Name" SelectedItem="{Binding SelectedWorkspace}" />
                </core:RowLayout>
            </ui:CardExpander.Header>
            <StackPanel>
                <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                    <core:RowLayout>
                        <core:CardHeader Title="Workspace name" />
                        <ui:TextBox Width="240" AutomationProperties.Name="Workspace name" Text="{Binding WorkspaceName, UpdateSourceTrigger=LostFocus}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Delete this workspace" Description="Removes it and its items from all your devices. The history stays in the reports." />
                        <ui:Button Content="Delete" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteWorkspaceCommand}" />
                    </core:RowLayout>
                </Border>
            </StackPanel>
        </ui:CardExpander>

        <!-- Reminders -->
        <TextBlock Text="Reminders" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon AlertOn24}" IsExpanded="True">
            <ui:CardExpander.Header>
                <core:RowLayout>
                    <core:CardHeader Title="Due date reminders" Description="Once a day, a notification about open tasks and debts that are due soon or overdue." />
                    <ui:ToggleSwitch HorizontalAlignment="Right" Margin="0,0,16,0" IsChecked="{Binding RemindersEnabled}" />
                </core:RowLayout>
            </ui:CardExpander.Header>
            <StackPanel IsEnabled="{Binding RemindersEnabled}">
                <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                    <core:RowLayout>
                        <core:CardHeader Title="Reminder time" Description="The day's reminder comes at this hour, or when Helm starts later." />
                        <ComboBox Width="140" AutomationProperties.Name="Reminder time" ItemsSource="{Binding ReminderHourNames}" SelectedIndex="{Binding ReminderHourIndex}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Due soon means" Description="How early an item with a due date is included. Overdue items always are." />
                        <ComboBox Width="160" AutomationProperties.Name="Due soon means" ItemsSource="{Binding RemindDaysNames}" SelectedIndex="{Binding RemindDaysIndex}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Try it" Description="Shows today's reminder now." />
                        <ui:Button Content="Remind me now" Icon="{ui:SymbolIcon Alert24}" Command="{Binding RemindNowCommand}" />
                    </core:RowLayout>
                </Border>
            </StackPanel>
        </ui:CardExpander>

        <!-- Display -->
        <TextBlock Text="Display" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon CheckmarkCircle24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Show finished items" Description="List completed tasks and settled debts under the open ones." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding ShowCompleted}" />
        </ui:CardControl>

        <!-- Data -->
        <TextBlock Text="Data" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowDownload24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Export to CSV" Description="Every item or every change, with times in minutes, for a spreadsheet." />
            </ui:CardControl.Header>
            <!-- Fixed width: without it WPF-UI's CardControl squeezes the icon column and clips the icon. -->
            <StackPanel Width="220" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Margin="0,0,8,0" Content="Items…" Icon="{ui:SymbolIcon TableSimple24}" Click="ExportItems_Click" />
                <ui:Button Content="History…" Icon="{ui:SymbolIcon History24}" Click="ExportHistory_Click" />
            </StackPanel>
        </ui:CardControl>
    </StackPanel>
</core:ModulePageBase>
