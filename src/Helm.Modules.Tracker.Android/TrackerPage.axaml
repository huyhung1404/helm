<ui:ModulePageBase xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="using:Helm.Core.Ui"
                   xmlns:vm="using:Helm.Modules.Tracker"
                   x:Class="Helm.Modules.Tracker.TrackerPage"
                   x:DataType="vm:TrackerViewModel">

    <!-- Tracker's settings (Home → Utilities). The lists themselves are on TrackerContentPage. -->
    <StackPanel>
        <Border Classes="infobar" IsVisible="{Binding HasMessage}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Open Tracker" Classes="title" />
                <TextBlock Text="Your lists, the report and the history. Also in the menu and on Home." Classes="secondary" />
                <Button Classes="accent" Content="Open Tracker" Click="OpenTracker_Click" />
            </StackPanel>
        </Border>

        <!-- Workspaces -->
        <TextBlock Text="Workspaces" Classes="section" />
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="New workspace" Classes="title" />
                <TextBlock Text="{Binding NewWorkspaceHint}" Classes="secondary" />
                <TextBox PlaceholderText="Name" Text="{Binding NewWorkspaceName}" AutomationProperties.Name="New workspace name" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding KindNames}" SelectedIndex="{Binding NewWorkspaceKindIndex}"
                          IsEnabled="{Binding CanAddDebtBook}" AutomationProperties.Name="New workspace kind" />
                <Button Content="Create" Command="{Binding CreateWorkspaceCommand}" />
            </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding HasWorkspaces}">
            <StackPanel Spacing="8">
                <TextBlock Text="Edit a workspace" Classes="title" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}"
                          AutomationProperties.Name="Workspace to edit">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:WorkspaceOption">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Classes="row">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Workspace name" />
                        <TextBox Text="{Binding WorkspaceName, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Workspace name" />
                    </StackPanel>
                </Border>
                <Border Classes="row" IsVisible="{Binding IsDebtWorkspace}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Currency" />
                        <TextBlock Text="Shown after every amount in the debt book, e.g. ₫ or USD." Classes="secondary" />
                        <TextBox Text="{Binding WorkspaceCurrency, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Currency" />
                    </StackPanel>
                </Border>
                <Border Classes="row">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Delete this workspace" />
                        <TextBlock Text="Removes it and its items from all your devices. The history stays in the reports." Classes="secondary" />
                        <Button Classes="danger" Content="Delete workspace" Command="{Binding DeleteWorkspaceCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Display -->
        <TextBlock Text="Display" Classes="section" />
        <Border Classes="card">
            <DockPanel>
                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShowCompleted}" OnContent="" OffContent="" AutomationProperties.Name="Show finished items" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Show finished items" Classes="title" />
                    <TextBlock Text="List completed tasks and settled debts under the open ones." Classes="secondary" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Widget (shown only when the launcher can pin widgets on request) -->
        <StackPanel x:Name="WidgetSection" IsVisible="False">
            <TextBlock Text="Widget" Classes="section" />
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Home-screen widget" Classes="title" />
                    <TextBlock Text="Your open tasks or debts on the home screen. Tap a circle to finish one, the title to switch workspace." Classes="secondary" />
                    <Button Content="Add to home screen" Click="AddWidget_Click" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Data -->
        <TextBlock Text="Data" Classes="section" />
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Export to CSV" Classes="title" />
                <TextBlock Text="Copies every item, or every change in the history, with times in minutes. Paste it into a spreadsheet." Classes="secondary" />
                <WrapPanel>
                    <Button Content="Copy items" Command="{Binding CopyItemsCsvCommand}" Margin="0,0,8,8" />
                    <Button Content="Copy history" Command="{Binding CopyHistoryCsvCommand}" Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</ui:ModulePageBase>
