<ui:ModulePageBase xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="using:Helm.Core.Ui"
                   xmlns:vm="using:Helm.Modules.Tracker"
                   x:Class="Helm.Modules.Tracker.TrackerPage"
                   x:DataType="vm:TrackerViewModel">

    <!-- Tracker's settings (Home → Utilities). The lists themselves are on TrackerContentPage. -->
    <StackPanel>
        <Border Classes="infobar" IsVisible="{Binding HasMessage}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Open Tracker" Classes="title" />
                <TextBlock Text="Your lists, the report and the history. Also in the menu and on Home." Classes="secondary" />
                <Button Classes="accent" Content="Open Tracker" Click="OpenTracker_Click" />
            </StackPanel>
        </Border>

        <!-- Workspaces -->
        <TextBlock Text="Workspaces" Classes="section" />
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="New workspace" Classes="title" />
                <TextBlock Text="Another to-do list. Debts are kept in Wallet." Classes="secondary" />
                <TextBox PlaceholderText="Name" Text="{Binding NewWorkspaceName}" AutomationProperties.Name="New workspace name" />
                <Button Content="Create" Command="{Binding CreateWorkspaceCommand}" />
            </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding HasWorkspaces}">
            <StackPanel Spacing="8">
                <TextBlock Text="Edit a workspace" Classes="title" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}"
                          AutomationProperties.Name="Workspace to edit">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:WorkspaceOption">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Classes="row">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Workspace name" />
                        <TextBox Text="{Binding WorkspaceName, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Workspace name" />
                    </StackPanel>
                </Border>
                <Border Classes="row">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Delete this workspace" />
                        <TextBlock Text="Removes it and its items from all your devices. The history stays in the reports." Classes="secondary" />
                        <Button Classes="danger" Content="Delete workspace" Command="{Binding DeleteWorkspaceCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Display -->
        <TextBlock Text="Display" Classes="section" />
        <Border Classes="card">
            <DockPanel>
                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShowCompleted}" OnContent="" OffContent="" AutomationProperties.Name="Show finished items" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Show finished items" Classes="title" />
                    <TextBlock Text="List completed tasks and settled debts under the open ones." Classes="secondary" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Reminders -->
        <TextBlock Text="Reminders" Classes="section" />
        <Border Classes="card">
            <StackPanel>
                <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding RemindersEnabled}" OnContent="" OffContent="" AutomationProperties.Name="Due date reminders" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Due date reminders" Classes="title" />
                        <TextBlock Text="Once a day, a notification about open tasks and debts that are due soon or overdue." Classes="secondary" />
                    </StackPanel>
                </DockPanel>
                <Border x:Name="NotificationsBlocked" Classes="infobar warning" IsVisible="False" Margin="0,12,0,0">
                    <TextBlock Text="Notifications are off for Helm in Android settings, so reminders cannot be shown." TextWrapping="Wrap" />
                </Border>
                <Border Classes="row" IsEnabled="{Binding RemindersEnabled}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Reminder time" />
                        <TextBlock Text="The day's reminder comes at this hour, or when you next open Helm." Classes="secondary" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ReminderHourNames}" SelectedIndex="{Binding ReminderHourIndex}"
                                  AutomationProperties.Name="Reminder time" />
                    </StackPanel>
                </Border>
                <Border Classes="row" IsEnabled="{Binding RemindersEnabled}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Due soon means" />
                        <TextBlock Text="How early an item with a due date is included. Overdue items always are." Classes="secondary" />
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RemindDaysNames}" SelectedIndex="{Binding RemindDaysIndex}"
                                  AutomationProperties.Name="Due soon means" />
                    </StackPanel>
                </Border>
                <Border Classes="row">
                    <Button Content="Remind me now" Command="{Binding RemindNowCommand}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Widget -->
        <StackPanel>
            <TextBlock Text="Widget" Classes="section" />
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Home-screen widget" Classes="title" />
                    <TextBlock TextWrapping="Wrap" Classes="secondary"
                               Text="Your open tasks or debts on the home screen: tap a circle to finish a task, the title to switch workspace. With nothing open, or after the shrink button, it becomes a small button showing how many are open; tap it for sync and +." />
                    <!-- Only when the launcher can place a widget on request -->
                    <Button x:Name="AddWidgetButton" Content="Add to home screen" Click="AddWidget_Click" IsVisible="False" />
                    <TextBlock Text="Background" Margin="0,4,0,0" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding WidgetBackgroundNames}" SelectedIndex="{Binding WidgetBackgroundIndex}" AutomationProperties.Name="Widget background" />
                    <StackPanel>
                        <TextBlock Text="{Binding WidgetOpacity, StringFormat='Opacity {0}%'}" />
                        <Slider Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding WidgetOpacity}" AutomationProperties.Name="Widget opacity" />
                    </StackPanel>
                    <TextBlock Text="Text" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding WidgetTextNames}" SelectedIndex="{Binding WidgetTextIndex}" AutomationProperties.Name="Widget text colour" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Data -->
        <TextBlock Text="Data" Classes="section" />
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Export to CSV" Classes="title" />
                <TextBlock Text="Copies every item, or every change in the history, with times in minutes. Paste it into a spreadsheet." Classes="secondary" />
                <WrapPanel>
                    <Button Content="Copy items" Command="{Binding CopyItemsCsvCommand}" Margin="0,0,8,8" />
                    <Button Content="Copy history" Command="{Binding CopyHistoryCsvCommand}" Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</ui:ModulePageBase>
