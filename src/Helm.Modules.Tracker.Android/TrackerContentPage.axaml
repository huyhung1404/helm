<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Tracker"
             xmlns:core="using:Helm.Core.Ui"
             x:Class="Helm.Modules.Tracker.TrackerContentPage"
             x:DataType="vm:TrackerViewModel">

    <!-- The Tracker itself (drawer and Quick access). Its options live on TrackerPage (Home → Utilities). -->
    <UserControl.Styles>
        <Style Selector="TextBlock.done">
            <Setter Property="TextDecorations" Value="Strikethrough" />
            <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
        </Style>
        <!-- Past its due date and still open -->
        <Style Selector="TextBlock.secondary.overdue">
            <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
        </Style>
        <Style Selector="TextBlock.owed">
            <Setter Property="Foreground" Value="{DynamicResource HelmSuccess}" />
        </Style>
        <Style Selector="TextBlock.iowe">
            <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
        </Style>
        <Style Selector="TextBlock.stat">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource HelmSubtleFill}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,0,6,2" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Square icon button in a row (44 dp touch target) -->
        <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.icon:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <!-- Calendar -->
        <Style Selector="Button.day">
            <Setter Property="Background" Value="{DynamicResource HelmCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmCardStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.day.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.day.out">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="TextBlock.today">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Fill" Value="{DynamicResource HelmSecondaryText}" />
        </Style>
        <Style Selector="Ellipse.dot.debt">
            <Setter Property="Fill" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Ellipse.dot.overdue">
            <Setter Property="Fill" Value="{DynamicResource HelmDanger}" />
        </Style>
        <Style Selector="Ellipse.dot.done">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.overdue">
            <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
        </Style>
        <Style Selector="TextBlock.debtText">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="TextBlock.projected">
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:TrackerItemViewModel">
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HelmCardStroke}" Padding="0,6">
                <StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0"
                                  IsChecked="{Binding Done}"
                                  AutomationProperties.Name="Done" />
                        <!-- Tap the text to show the row's actions -->
                        <Button Grid.Column="1" Classes="flat" Padding="4,4" Command="{Binding ToggleExpandedCommand}">
                            <StackPanel>
                                <WrapPanel>
                                    <Border Classes="badge" IsVisible="{Binding IsUrgent}">
                                        <TextBlock Text="Urgent" Foreground="{DynamicResource HelmDanger}" />
                                    </Border>
                                    <Border Classes="badge" IsVisible="{Binding IsHigh}">
                                        <TextBlock Text="High" Foreground="{DynamicResource SystemAccentColor}" />
                                    </Border>
                                    <Border Classes="badge" IsVisible="{Binding IsStarted}">
                                        <TextBlock Text="In progress" Foreground="{DynamicResource SystemAccentColor}" />
                                    </Border>
                                    <Border Classes="badge" IsVisible="{Binding RepeatText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <ic:SymbolIcon Symbol="ArrowRepeatAll" FontSize="12" Foreground="{DynamicResource SystemAccentColor}" />
                                    </Border>
                                    <Border Classes="badge" IsVisible="{Binding HasSubtasks}">
                                        <TextBlock Text="{Binding SubtaskProgress}" />
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Classes.done="{Binding IsCompleted}" />
                                <TextBlock Text="{Binding Details}" Classes="secondary" Classes.overdue="{Binding IsOverdue}" />
                                <TextBlock Text="{Binding Item.Notes}" Classes="secondary" IsVisible="{Binding HasNotes}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Linked notes: tap one to open it in Notes -->
                    <core:LinksPanel DataContext="{Binding Links}" Margin="28,0,0,4" />

                    <!-- Subtasks -->
                    <ItemsControl ItemsSource="{Binding Subtasks}" Margin="28,0,0,0" IsVisible="{Binding HasSubtasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TrackerItemViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox MinWidth="0" IsChecked="{Binding Done}" AutomationProperties.Name="{Binding Title}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center" Classes.done="{Binding IsCompleted}" />
                                    <Button Grid.Column="2" Classes="icon flat" Command="{Binding DeleteCommand}" AutomationProperties.Name="Delete subtask">
                                        <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto" Margin="28,4,0,4">
                        <Grid.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsExpanded" />
                                <Binding Path="CanHaveSubtasks" />
                            </MultiBinding>
                        </Grid.IsVisible>
                        <TextBox PlaceholderText="A subtask" Text="{Binding NewSubtaskTitle}" AutomationProperties.Name="New subtask">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddSubtaskCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Margin="6,0,0,0" Content="Add" Command="{Binding AddSubtaskCommand}" />
                    </Grid>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" IsVisible="{Binding IsExpanded}">
                        <Button Classes="icon flat" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" AutomationProperties.Name="Start">
                            <ic:SymbolIcon Symbol="Play" FontSize="18" />
                        </Button>
                        <Button Classes="icon flat" Command="{Binding MoveUpCommand}" IsVisible="{Binding IsOpen}" IsEnabled="{Binding CanMoveUp}" AutomationProperties.Name="Move up">
                            <ic:SymbolIcon Symbol="ArrowUp" FontSize="18" />
                        </Button>
                        <Button Classes="icon flat" Command="{Binding MoveDownCommand}" IsVisible="{Binding IsOpen}" IsEnabled="{Binding CanMoveDown}" AutomationProperties.Name="Move down">
                            <ic:SymbolIcon Symbol="ArrowDown" FontSize="18" />
                        </Button>
                        <Button Classes="icon flat" Command="{Binding Links.StartPickingCommand}" IsVisible="{Binding Links, Converter={x:Static ObjectConverters.IsNotNull}}"
                                AutomationProperties.Name="Link a note">
                            <ic:SymbolIcon Symbol="Link" FontSize="18" />
                        </Button>
                        <Button Classes="icon flat" Command="{Binding BeginEditCommand}" AutomationProperties.Name="Edit">
                            <ic:SymbolIcon Symbol="Edit" FontSize="18" />
                        </Button>
                        <Button Classes="icon flat danger" Command="{Binding DeleteCommand}" AutomationProperties.Name="Delete">
                            <ic:SymbolIcon Symbol="Delete" FontSize="18" />
                        </Button>
                    </StackPanel>

                    <!-- Inline editor -->
                    <StackPanel Spacing="8" Margin="0,8,0,4" IsVisible="{Binding IsEditing}">
                        <TextBox PlaceholderText="Title" Text="{Binding EditTitle}" />
                        <TextBox PlaceholderText="Notes" Text="{Binding EditNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding $parent[UserControl].((vm:TrackerViewModel)DataContext).PriorityNames}"
                                  SelectedIndex="{Binding EditPriorityIndex}" />
                        <core:DateTimeBox Date="{Binding EditDueDate}" Time="{Binding EditDueTime}" Lean="Future" AllowEmpty="True" PlaceholderText="Due date (optional)" />
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsRepeating}">
                            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding EditRepeatIndex}"
                                      ItemsSource="{Binding $parent[UserControl].((vm:TrackerViewModel)DataContext).RepeatNames}" />
                            <TextBox Grid.Column="1" Width="96" Margin="8,0,0,0" PlaceholderText="Days" Text="{Binding EditRepeatDays}" />
                        </Grid>
                        <WrapPanel>
                            <Button Classes="accent" Content="Save" Command="{Binding SaveEditCommand}" Margin="0,0,8,0" />
                            <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <StackPanel>
        <!-- Shown while the tool is turned off -->
        <Border x:Name="OffBar" Classes="infobar" IsVisible="False">
            <StackPanel>
                <TextBlock Text="Tracker is turned off" Classes="title" />
                <TextBlock Text="Your lists are kept. Turn Tracker on in its settings to use them." TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Which list you are looking at, first and easy to see -->
        <Border Classes="card" IsVisible="{Binding HasWorkspaces}">
            <StackPanel Spacing="8">
                <TextBlock Text="Workspace" Classes="title" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}"
                          AutomationProperties.Name="Current workspace">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:WorkspaceOption">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding KindText}" Classes="secondary" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <StackPanel x:Name="Body">
            <!-- First run: no workspace yet -->
            <Border Classes="card" IsVisible="{Binding HasNoWorkspaces}" Margin="0,16,0,4">
                <StackPanel Spacing="8">
                    <TextBlock Text="Create your first workspace" Classes="title" FontSize="16" />
                    <TextBlock Classes="secondary" Text="A workspace is one to-do list. You can add more later. Debts are kept in Wallet." />
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="New to-do list"
                            Command="{Binding CreateTasksWorkspaceCommand}" />
                </StackPanel>
            </Border>

            <!-- Lists or calendar -->
            <Grid ColumnDefinitions="*,8,*" Margin="0,8,0,0" IsVisible="{Binding HasWorkspaces}">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ShowListsCommand}" Classes.accent="{Binding !IsCalendar}"
                        AutomationProperties.Name="Show the lists">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="TaskList" FontSize="16" />
                        <TextBlock Text="Lists" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ShowCalendarCommand}" Classes.accent="{Binding IsCalendar}"
                        AutomationProperties.Name="Show the calendar">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="Calendar" FontSize="16" />
                        <TextBlock Text="Calendar" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Calendar: the month (dots per day) or the week (a list); a tap on a day lists it below -->
            <StackPanel Spacing="8" Margin="0,12,0,0" IsVisible="{Binding ShowCalendarView}">
                <Border Classes="infobar" IsVisible="{Binding HasMessage}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </Border>
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Button Classes="icon flat" Command="{Binding CalendarPreviousCommand}" AutomationProperties.Name="Previous">
                        <ic:SymbolIcon Symbol="ChevronLeft" FontSize="18" />
                    </Button>
                    <Button Grid.Column="1" Classes="icon flat" Command="{Binding CalendarNextCommand}" AutomationProperties.Name="Next">
                        <ic:SymbolIcon Symbol="ChevronRight" FontSize="18" />
                    </Button>
                    <TextBlock Grid.Column="2" Text="{Binding CalendarTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="3" Content="Today" Command="{Binding CalendarTodayCommand}" />
                </Grid>
                <WrapPanel>
                    <Button Content="Month" Command="{Binding SetCalendarMonthCommand}" Classes.accent="{Binding !IsWeekView}" Margin="0,0,6,6" />
                    <Button Content="Week" Command="{Binding SetCalendarWeekCommand}" Classes.accent="{Binding IsWeekView}" Margin="0,0,12,6" />
                    <CheckBox Content="All workspaces" IsChecked="{Binding CalendarAllWorkspaces}" Margin="0,0,12,6" />
                    <Button Click="ShareIcs_Click" Margin="0,0,0,6" AutomationProperties.Name="Share as a calendar file">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Share" FontSize="16" />
                            <TextBlock Text=".ics" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Month: weekday names, then 6 weeks of small cells -->
                <StackPanel IsVisible="{Binding !IsWeekView}">
                    <ItemsControl ItemsSource="{Binding CalendarWeekdayNames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" Classes="secondary" HorizontalAlignment="Center" FontSize="12" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding CalendarDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CalendarDayViewModel">
                                <Button Classes="flat day" Classes.selected="{Binding IsSelected}" Classes.out="{Binding !IsInRange}" Padding="0" Margin="1"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding AutomationName}">
                                    <StackPanel Spacing="3" Margin="0,6">
                                        <TextBlock Text="{Binding DayNumber}" HorizontalAlignment="Center" FontWeight="SemiBold" Classes.today="{Binding IsToday}" />
                                        <ItemsControl ItemsSource="{Binding Entries}" HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:CalendarEntryViewModel">
                                                    <Ellipse Width="6" Height="6" Classes="dot" Classes.debt="{Binding IsDebt}" Classes.overdue="{Binding IsOverdue}" Classes.done="{Binding IsDone}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Week: one row per day with what it lists -->
                <ItemsControl ItemsSource="{Binding CalendarDays}" IsVisible="{Binding IsWeekView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:CalendarDayViewModel">
                            <Button Classes="flat day" Classes.selected="{Binding IsSelected}" Margin="0,2" Padding="10,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding AutomationName}">
                                <Grid ColumnDefinitions="72,*">
                                    <TextBlock Text="{Binding WeekLabel}" FontWeight="SemiBold" Classes.today="{Binding IsToday}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:CalendarEntryViewModel">
                                                    <TextBlock Text="{Binding Line}" TextTrimming="CharacterEllipsis" Classes.debtText="{Binding IsDebt}" Classes.overdue="{Binding IsOverdue}"
                                                               Classes.done="{Binding IsDone}" Classes.projected="{Binding IsProjected}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding MoreText}" Classes="secondary" IsVisible="{Binding HasMore}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The day tapped: its tasks (tick or edit them here), debts and repeating tasks, and a task to add on it -->
                <StackPanel Spacing="6" IsVisible="{Binding HasCalendarDaySelection}">
                    <TextBlock Text="{Binding CalendarSelectedTitle}" Classes="section" />
                    <Border Classes="card">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanAddOnCalendarDay}">
                                <TextBox PlaceholderText="A task due this day" Text="{Binding CalendarNewTitle}" AutomationProperties.Name="New task on this day">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding AddOnCalendarDayCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1" Margin="6,0,0,0" Classes="accent" Content="Add" Command="{Binding AddOnCalendarDayCommand}" />
                            </Grid>
                            <TextBlock Text="Nothing is due this day." Classes="secondary" IsVisible="{Binding IsCalendarDayEmpty}" />
                            <ItemsControl ItemsSource="{Binding CalendarDayItems}" />
                            <ItemsControl ItemsSource="{Binding CalendarDayOthers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:CalendarEntryViewModel">
                                        <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="4,8" Command="{Binding OpenCommand}"
                                                IsEnabled="{Binding IsDebt}" AutomationProperties.Name="{Binding Title}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Panel Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <ic:SymbolIcon Symbol="Person" FontSize="18" IsVisible="{Binding IsDebt}" />
                                                    <ic:SymbolIcon Symbol="ArrowRepeatAll" FontSize="18" IsVisible="{Binding IsProjected}" />
                                                </Panel>
                                                <TextBlock Grid.Column="1" Text="{Binding Line}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="secondary" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding ShowListsView}">
            <!-- Add -->
            <TextBlock Text="Add a task" Classes="section" />
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBox PlaceholderText="What needs doing?" Text="{Binding NewTitle}" AutomationProperties.Name="Title">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding PriorityNames}" SelectedIndex="{Binding NewPriorityIndex}"
                              IsVisible="{Binding IsTaskWorkspace}" AutomationProperties.Name="Priority" />
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsTaskWorkspace}">
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding RepeatNames}" SelectedIndex="{Binding NewRepeatIndex}" AutomationProperties.Name="Repeat" />
                        <TextBox Grid.Column="1" Width="96" Margin="8,0,0,0" PlaceholderText="Days" Text="{Binding NewRepeatDays}" IsVisible="{Binding NewRepeatsForDays}"
                                 AutomationProperties.Name="Repeat days" />
                    </Grid>
                    <core:DateTimeBox Date="{Binding NewDueDate}" Time="{Binding NewDueTime}" Lean="Future" AllowEmpty="True" PlaceholderText="Due date (optional)" />
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Add" Command="{Binding AddCommand}" />
                </StackPanel>
            </Border>
            <Border Classes="infobar" IsVisible="{Binding HasMessage}" Margin="0,4,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="icon flat" Command="{Binding DismissMessageCommand}" AutomationProperties.Name="Dismiss">
                        <ic:SymbolIcon Symbol="Dismiss" FontSize="16" />
                    </Button>
                </Grid>
            </Border>

            <!-- Open -->
            <Grid ColumnDefinitions="*,Auto" Margin="4,20,0,8">
                <TextBlock Text="To do" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding OpenSummary}" Classes="secondary" VerticalAlignment="Center" />
            </Grid>
            <Border Classes="card" Padding="12,0">
                <StackPanel>
                    <TextBlock Margin="0,12" Text="Nothing to do. Add a task above." Classes="secondary" IsVisible="{Binding HasNoOpen}" />
                    <ItemsControl ItemsSource="{Binding OpenItems}" Margin="0,-1,0,0" />
                </StackPanel>
            </Border>

            <!-- Completed -->
            <TextBlock Text="Completed" Classes="section" IsVisible="{Binding ShowCompleted}" />
            <Border Classes="card" Padding="12,0" IsVisible="{Binding ShowCompleted}">
                <StackPanel>
                    <TextBlock Margin="0,12" Text="Nothing finished yet. Tick an item and it moves here, with its times recorded."
                               Classes="secondary" IsVisible="{Binding !HasCompleted}" />
                    <ItemsControl ItemsSource="{Binding CompletedItems}" Margin="0,-1,0,0" />
                </StackPanel>
            </Border>
            </StackPanel>

            <!-- Report and history, once there is a workspace -->
            <StackPanel IsVisible="{Binding ShowListsView}">
            <TextBlock Text="Report" Classes="section" />
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ReportRangeNames}" SelectedIndex="{Binding ReportRangeIndex}"
                              AutomationProperties.Name="Report period" />
                    <DockPanel>
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ReportAllWorkspaces}" OnContent="" OffContent="" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="All workspaces" />
                            <TextBlock Text="{Binding ReportRangeText}" Classes="secondary" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
            <UniformGrid Columns="2">
                <Border Classes="card" Margin="0,0,2,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportCompleted}" Classes="stat" />
                        <TextBlock Text="Completed" Classes="secondary" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="2,0,0,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportCreated}" Classes="stat" />
                        <TextBlock Text="Added" Classes="secondary" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="0,0,2,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportAverageLead}" Classes="stat" />
                        <TextBlock Text="Average time from added to done" Classes="secondary" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="2,0,0,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportMedianLead}" Classes="stat" />
                        <TextBlock Text="Median time from added to done" Classes="secondary" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="0,0,2,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportAverageWork}" Classes="stat" />
                        <TextBlock Text="Average time from start to done" Classes="secondary" />
                    </StackPanel>
                </Border>
                <Border Classes="card" Margin="2,0,0,4">
                    <StackPanel>
                        <TextBlock Text="{Binding ReportOnTime}" Classes="stat" />
                        <TextBlock Text="Done by the due date" Classes="secondary" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Border Classes="card">
                <StackPanel>
                    <TextBlock Text="Completed per day" Classes="title" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding ReportDays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ReportBar">
                                <Grid RowDefinitions="64,18" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
                                    <Border VerticalAlignment="Bottom" Height="{Binding BarHeight}" CornerRadius="2" Margin="1,0"
                                            Background="{DynamicResource SystemAccentColor}" />
                                    <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" TextWrapping="NoWrap"
                                               Classes="secondary" Margin="-20,2,-20,0" TextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Repeating tasks: days done" Classes="title" Margin="0,16,0,6" IsVisible="{Binding HasReportRepeats}" />
                    <ItemsControl ItemsSource="{Binding ReportRepeats}" IsVisible="{Binding HasReportRepeats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ReportCount">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="SemiBold" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="By priority" Classes="title" Margin="0,16,0,6" />
                    <ItemsControl ItemsSource="{Binding ReportPriorities}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ReportCount">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                    <TextBlock Text="{Binding Label}" Classes="secondary" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Count}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- History -->
            <TextBlock Text="History" Classes="section" />
            <Border Classes="card">
                <Expander Header="Recent changes" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Text="No history yet." Classes="secondary" IsVisible="{Binding !HasHistory}" />
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:HistoryRow">
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        <TextBlock Classes="secondary">
                                            <Run Text="{Binding When}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Workspace}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Border>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
