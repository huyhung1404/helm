<ui:FluentWindow
    x:Class="Helm.Modules.WatchLater.Player.PlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:self="clr-namespace:Helm.Modules.WatchLater"
    xmlns:player="clr-namespace:Helm.Modules.WatchLater.Player"
    Title="Watch Later"
    Width="432"
    Height="275"
    MinWidth="240"
    MinHeight="160"
    ExtendsContentIntoTitleBar="True"
    Icon="{x:Static self:WatchLaterLogo.Image}"
    ShowInTaskbar="True"
    Topmost="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="Manual">

    <!-- The mini player, opened only from the player's Mini player button: small, always on top, one thin bar to drag
         it by. Back to Helm puts the video back on the Watch Later page where it is. -->
    <ui:FluentWindow.Resources>
        <Style x:Key="BarAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="Transparent" MouseLeftButtonDown="Bar_MouseLeftButtonDown" ToolTip="Drag to move; double-click to go back to Helm">
            <DockPanel Margin="10,0,4,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button x:Name="SpeedButton" Style="{StaticResource BarAction}" Content="1×" FontSize="12" ToolTip="Speed (click for the next one)"
                               AutomationProperties.Name="Speed" Click="Speed_Click" />
                    <ui:Button Style="{StaticResource BarAction}" Icon="{ui:SymbolIcon ArrowMaximize24}" ToolTip="Back to Helm"
                               AutomationProperties.Name="Back to Helm" Click="Dock_Click" />
                    <ui:Button Style="{StaticResource BarAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Close" AutomationProperties.Name="Close"
                               Click="Close_Click" />
                </StackPanel>
                <TextBlock x:Name="MiniTitle" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <player:PlayerView x:Name="View" Grid.Row="1" />
    </Grid>
</ui:FluentWindow>
