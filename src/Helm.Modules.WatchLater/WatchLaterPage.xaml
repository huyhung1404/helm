<core:ModulePageBase
    x:Class="Helm.Modules.WatchLater.WatchLaterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.WatchLater"
    ExtraMessage="{Binding Message}">

    <!-- Watch Later's settings (Home → Utilities). The saved videos are on WatchLaterContentPage. The Downloads part
         binds the Windows-only WatchLaterToolsViewModel (Tools). -->
    <StackPanel>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:ImageIcon Width="24" Height="24" Source="{x:Static local:WatchLaterLogo.Image}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <core:CardHeader Title="Open Watch Later" Description="Your saved videos. Also in the menu and on Home. Share a video to Helm on your phone to save it." />
            </ui:CardControl.Header>
            <ui:Button Appearance="Primary" Content="Open Watch Later" Click="Open_Click" />
        </ui:CardControl>

        <!-- Downloads -->
        <TextBlock Text="Downloads" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon VideoClip24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Quality picked first" Description="Selected when you download; you can pick another one each time." />
            </ui:CardControl.Header>
            <ComboBox Width="160" AutomationProperties.Name="Quality picked first" ItemsSource="{Binding QualityNames}" SelectedIndex="{Binding DefaultQualityIndex}" />
        </ui:CardControl>

        <StackPanel x:Name="ToolsPanel">
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,4" Padding="12,8"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <core:RowLayout>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Appearance="Transparent" Padding="8,6" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" Command="{Binding DismissMessageCommand}" />
                </core:RowLayout>
            </Border>

            <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Folder24}" IsExpanded="True">
                <ui:CardExpander.Header>
                    <core:RowLayout>
                        <core:CardHeader Title="Download folder" Description="{Binding Folder}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Change…" Icon="{ui:SymbolIcon FolderOpen24}" Click="ChooseFolder_Click" />
                            <ui:Button Margin="8,0,0,0" Content="Open" Command="{Binding OpenFolderCommand}" />
                        </StackPanel>
                    </core:RowLayout>
                </ui:CardExpander.Header>
                <StackPanel>
                    <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                        <core:RowLayout>
                            <core:CardHeader Title="Back to the default folder" Description="Videos\Watch Later in your user folder." />
                            <ui:Button Content="Use default" Command="{Binding ResetFolderCommand}" IsEnabled="{Binding HasCustomFolder}" />
                        </core:RowLayout>
                    </Border>
                </StackPanel>
            </ui:CardExpander>

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Phone24}">
                <ui:CardControl.Header>
                    <core:CardHeader Title="Download requests from your phone"
                                     Description="When you tap Download on PC on your phone, this PC downloads the video while Helm is running." />
                </ui:CardControl.Header>
                <ui:ToggleSwitch AutomationProperties.Name="Download requests from your phone" IsChecked="{Binding DownloadRequests}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Cookies24}">
                <ui:CardControl.Header>
                    <core:CardHeader Title="Sign-in from a browser"
                                     Description="For private and group videos on Facebook: yt-dlp reads that browser's sign-in cookies. Firefox works best; close Chrome or Edge first." />
                </ui:CardControl.Header>
                <ComboBox Width="140" AutomationProperties.Name="Sign-in from a browser" ItemsSource="{Binding CookieNames}" SelectedIndex="{Binding CookiesIndex}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowDownload24}">
                <ui:CardControl.Header>
                    <core:CardHeader Title="yt-dlp" Description="{Binding YtDlpStatus}" />
                </ui:CardControl.Header>
                <ui:Button Content="Update now" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding UpdateYtDlpCommand}"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Video24}">
                <ui:CardControl.Header>
                    <core:CardHeader Title="ffmpeg" Description="{Binding FfmpegStatus}" />
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Install" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding InstallFfmpegCommand}"
                               Visibility="{Binding CanInstallFfmpeg, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Remove" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveFfmpegCommand}"
                               Visibility="{Binding CanRemoveFfmpeg, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ui:CardControl>
        </StackPanel>

        <!-- Data -->
        <TextBlock Text="Data" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon CheckmarkCircle24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Delete the watched videos" Description="{Binding WatchedSummary}" />
            </ui:CardControl.Header>
            <ui:Button Content="Delete watched" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteWatchedCommand}" IsEnabled="{Binding HasWatched}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Image24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Clear the thumbnails" Description="{Binding ThumbnailSummary}" />
            </ui:CardControl.Header>
            <ui:Button Content="Clear" Command="{Binding ClearThumbnailsCommand}" />
        </ui:CardControl>
    </StackPanel>
</core:ModulePageBase>
