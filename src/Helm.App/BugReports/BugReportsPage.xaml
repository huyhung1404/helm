<!-- Bug reports (the menu's footer, next to What's new): the bugs reported on every device, one opened beside the list. -->
<Page x:Class="Helm.App.BugReports.BugReportsPage"
      x:ClassModifier="internal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:Helm.App.BugReports"
      xmlns:bugs="clr-namespace:Helm.Shell.BugReports;assembly=Helm.Shell"
      Title="Bug reports" ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BugTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Filter" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Margin" Value="0,0,6,6" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Appearance" Value="Secondary" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- One entry of a bug's conversation: a status line, or a message with its black box and pictures -->
            <DataTemplate x:Key="Entry" DataType="{x:Type bugs:BugEntryViewModel}">
                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <DockPanel Margin="16,8" Visibility="{Binding IsStatus, Converter={StaticResource BoolToVisibility}}">
                            <ui:SymbolIcon Symbol="Clock24" FontSize="14" Margin="8,0,20,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center">
                                <Run Text="{Binding Text, Mode=OneWay}" /><Run Text="{Binding When, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </TextBlock>
                        </DockPanel>
                        <Grid Margin="16,12" Visibility="{Binding IsMessage, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding ByAgent, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <ui:SymbolIcon Symbol="Bot24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding ByAgent, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock>
                                    <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding When, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding Badge, Mode=OneWay, StringFormat='  · {0}', TargetNullValue=''}" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <ui:Button Margin="0,8,0,0" Padding="8,2" MinWidth="0" FontSize="12" HorizontalAlignment="Left" Icon="{ui:SymbolIcon History24}"
                                           Content="{Binding BlackBoxText}" Click="ShowBlackBox_Click" ToolTip="Show the black box"
                                           Visibility="{Binding HasBlackBox, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Images}" Margin="0,8,0,0" Focusable="False"
                                              Visibility="{Binding HasImages, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type bugs:BugImageItem}">
                                            <Button Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand" Click="OpenImage_Click" ToolTip="Open full size"
                                                    AutomationProperties.Name="{Binding Name}">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BugThumbTemplate}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Pictures being added (details or an answer), with a remove button each -->
            <DataTemplate x:Key="PendingImage" DataType="{x:Type bugs:BugImageItem}">
                <Grid>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BugThumbTemplate}" />
                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,11,0" Padding="3" MinWidth="0" FontSize="10"
                               Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Remove" AutomationProperties.Name="Remove image" Click="RemovePending_Click" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="Report a bug" Icon="{ui:SymbolIcon Bug24}" VerticalAlignment="Center"
                       Click="Report_Click" ToolTip="Ctrl+Alt+F12, anywhere" />
            <TextBlock Text="Bug reports" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The list -->
            <Border Style="{DynamicResource HelmSurface}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,12,12,6">
                        <ui:TextBox PlaceholderText="Search bugs" Icon="{ui:SymbolIcon Search24}" AutomationProperties.Name="Search bugs"
                                    Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding FilterCounts}" Focusable="False" AutomationProperties.Name="Filter">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type bugs:FilterCount}">
                                    <ui:Button Style="{StaticResource Filter}" Content="{Binding Text}" CommandParameter="{Binding Filter}"
                                               Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Grid>
                        <TextBlock Margin="16" Style="{DynamicResource HelmSecondaryText}" Text="No bugs here. Press Ctrl+Alt+F12 anywhere to report one."
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                        <ListBox ItemsSource="{Binding Bugs}" SelectedItem="{Binding SelectedRow}" ItemContainerStyle="{DynamicResource HelmListItem}"
                                 Background="Transparent" BorderThickness="0" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Bugs">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type bugs:BugRowViewModel}">
                                    <StackPanel Margin="0,4">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding Code}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Border Style="{StaticResource BugTag}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="{Binding Status, Converter={StaticResource BugIcon}}" FontSize="12" Margin="0,0,4,0" Foreground="{Binding Status, Converter={StaticResource BugBrush}}" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource BugBrush}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource BugTag}">
                                                <TextBlock Text="{Binding SeverityText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Severity, Converter={StaticResource BugBrush}}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <WrapPanel Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Meta}" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,10,0" />
                                            <TextBlock Style="{DynamicResource HelmSecondaryText}" Visibility="{Binding HasReplies, Converter={StaticResource BoolToVisibility}}"
                                                       Text="{Binding RepliesText}" Margin="0,0,10,0" />
                                            <TextBlock Text="Claude asks" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- The bug opened -->
            <TextBlock Grid.Column="2" Margin="0,8,0,0" Style="{DynamicResource HelmSecondaryText}" Text="Pick a bug to see its conversation and black box."
                       Visibility="{Binding Selected, Converter={StaticResource EmptyToVisibility}}" />
            <ScrollViewer x:Name="DetailScroller" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding Selected, Converter={StaticResource NotEmptyToVisibility}}">
                <StackPanel DataContext="{Binding Selected}" Margin="0,0,12,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Code}" FontFamily="Cascadia Mono, Consolas" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Border Style="{StaticResource BugTag}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{Binding Bug.Status, Converter={StaticResource BugIcon}}" FontSize="12" Margin="0,0,4,0" Foreground="{Binding Bug.Status, Converter={StaticResource BugBrush}}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Bug.Status, Converter={StaticResource BugBrush}}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource BugTag}">
                            <TextBlock Text="{Binding SeverityText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Bug.Severity, Converter={StaticResource BugBrush}}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,4" />
                    <TextBlock Text="{Binding Meta}" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,12" />

                    <!-- An agent works on it -->
                    <Border Style="{DynamicResource HelmSurface}" Padding="14,10" Margin="0,0,0,8" Visibility="{Binding IsFixing, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Take back" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding TakeBackCommand}" VerticalAlignment="Center"
                                       ToolTip="Stop waiting for the agent: the bug is open again" />
                            <ui:SymbolIcon Symbol="Bot24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding FixingText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <!-- Fixed, waiting for the user -->
                    <Border Style="{DynamicResource HelmSurface}" Padding="14,10" Margin="0,0,0,8" Visibility="{Binding IsToVerify, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="Still broken" Margin="0,0,8,0" Click="Reopen_Click" />
                                <ui:Button Appearance="Primary" Content="It is fixed" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding ConfirmFixedCommand}" />
                            </StackPanel>
                            <ui:SymbolIcon Symbol="Clock24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{Binding VerifyText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                        </DockPanel>
                    </Border>
                    <!-- Closed -->
                    <Border Style="{DynamicResource HelmSurface}" Padding="14,10" Margin="0,0,0,8" Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}">
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Reopen" Icon="{ui:SymbolIcon ArrowReset24}" Click="Reopen_Click" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{Binding ClosedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <!-- The agent's question -->
                    <Border Style="{DynamicResource HelmSurface}" Padding="14,12" Margin="0,0,0,8" Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <ui:SymbolIcon Symbol="Bot24" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Claude Code asks" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding Question}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ui:TextBox PlaceholderText="Your answer" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" AutomationProperties.Name="Your answer"
                                        Text="{Binding AnswerText, UpdateSourceTrigger=PropertyChanged}" />
                            <ItemsControl ItemsSource="{Binding AnswerImages}" ItemTemplate="{StaticResource PendingImage}" Margin="0,8,0,0" Focusable="False" Tag="answer"
                                          Visibility="{Binding HasAnswerImages, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <DockPanel Margin="0,8,0,0">
                                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="Answer" Icon="{ui:SymbolIcon Send24}" Command="{Binding AnswerCommand}" />
                                <ui:Button Content="Add image" Icon="{ui:SymbolIcon ImageAdd24}" Margin="0,0,12,0" Click="AddAnswerImage_Click" />
                                <CheckBox Content="Attach the black box (last 60 s)" IsChecked="{Binding AnswerWithBlackBox}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,4,0,4">
                        <ui:Button Appearance="Primary" Content="Hand to Claude Code" Icon="{ui:SymbolIcon Bot24}" Margin="0,0,8,8" Click="HandOff_Click"
                                   ToolTip="Type a fix request into a Claude Code session on your PC (Workspace)"
                                   Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Close" Icon="{ui:SymbolIcon Checkmark24}" Margin="0,0,8,8" Click="Close_Click"
                                   Visibility="{Binding IsClosed, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:Button Appearance="Transparent" Content="Copy for Claude Code" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,8" Command="{Binding CopyForClaudeCommand}"
                                   ToolTip="The bug and its black box as Markdown, to paste into any AI chat" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,4"
                               Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}" />

                    <TextBlock Text="Conversation" Style="{DynamicResource HelmSectionHeader}" Margin="0,12,0,8" />
                    <Border Style="{DynamicResource HelmSurface}" Padding="0">
                        <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource Entry}" Focusable="False" />
                    </Border>
                    <!-- Add details -->
                    <Border Style="{DynamicResource HelmSurface}" Margin="0,4,0,0" Padding="12" Visibility="{Binding CanAddDetails, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ui:TextBox PlaceholderText="Add details to this bug" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" AutomationProperties.Name="Add details"
                                        Text="{Binding DetailsText, UpdateSourceTrigger=PropertyChanged}" />
                            <ItemsControl ItemsSource="{Binding DetailImages}" ItemTemplate="{StaticResource PendingImage}" Margin="0,8,0,0" Focusable="False" Tag="details"
                                          Visibility="{Binding HasDetailImages, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <DockPanel Margin="0,8,0,0">
                                <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="Add" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddDetailsCommand}" />
                                <ui:Button Content="Add image" Icon="{ui:SymbolIcon ImageAdd24}" Margin="0,0,12,0" Click="AddDetailImage_Click" />
                                <CheckBox Content="Attach the black box (last 60 s)" IsChecked="{Binding AttachBlackBox}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Black box" Style="{DynamicResource HelmSectionHeader}" Margin="0,24,0,8" />
                    <TextBlock Style="{DynamicResource HelmSecondaryText}" Text="No black box with this bug."
                               Visibility="{Binding HasBlackBox, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ui:CardExpander x:Name="BlackBoxExpander" Icon="{ui:SymbolIcon History24}" Visibility="{Binding HasBlackBox, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Text="What happened before" />
                                <TextBlock Text="{Binding BlackBoxText}" Style="{DynamicResource HelmSecondaryText}" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Text="Steps, from what you did" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" Style="{DynamicResource HelmSecondaryText}" FontSize="13" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,0,0,8" x:Name="EventFilters">
                                <WrapPanel.Resources>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Setter Property="Padding" Value="10,2" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Command" Value="{Binding SetEventFilterCommand}" />
                                    </Style>
                                </WrapPanel.Resources>
                                <ui:Button Content="All" CommandParameter="{x:Static bugs:BlackBoxFilter.All}" />
                                <ui:Button Content="Input" CommandParameter="{x:Static bugs:BlackBoxFilter.Input}" />
                                <ui:Button Content="Navigation" CommandParameter="{x:Static bugs:BlackBoxFilter.Navigation}" />
                                <ui:Button Content="Errors" CommandParameter="{x:Static bugs:BlackBoxFilter.Errors}" />
                                <ui:Button Content="Log" CommandParameter="{x:Static bugs:BlackBoxFilter.Log}" />
                                <ui:Button Content="Performance" CommandParameter="{x:Static bugs:BlackBoxFilter.Performance}" />
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource BlackBoxEventTemplate}" Focusable="False" />
                        </StackPanel>
                    </ui:CardExpander>
                    <ui:CardExpander Margin="0,4,0,0" Icon="{ui:SymbolIcon Desktop24}" Visibility="{Binding HasBlackBox, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <StackPanel>
                                <TextBlock Text="Environment" />
                                <TextBlock Text="Helm, the device and sync when the black box froze" Style="{DynamicResource HelmSecondaryText}" />
                            </StackPanel>
                        </ui:CardExpander.Header>
                        <ItemsControl ItemsSource="{Binding Environment}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" Style="{DynamicResource HelmSecondaryText}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ui:CardExpander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
