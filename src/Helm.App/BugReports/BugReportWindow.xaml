<Window x:Class="Helm.App.BugReports.BugReportWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Helm.App.BugReports"
        xmlns:bugs="clr-namespace:Helm.Shell.BugReports;assembly=Helm.Shell"
        Title="Report a bug" Width="704" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True" AllowDrop="True" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="BugTemplates.xaml" />
    </Window.Resources>

    <!-- The same surface as Quick Capture's panel: rounded, shadowed, in the app's theme. -->
    <Border Margin="16" CornerRadius="8" BorderThickness="1" Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Direction="270" />
        </Border.Effect>
        <Grid Margin="16">
            <!-- The form -->
            <StackPanel Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVisibility}}">
                <DockPanel Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock x:Name="EscHint" DockPanel.Dock="Right" Text="Esc to close" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:SymbolIcon Symbol="Bug24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Report a bug" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  from a crash" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center"
                               Visibility="{Binding FromCrash, Converter={StaticResource BoolToVisibility}}" />
                </DockPanel>

                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tool" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="180" ItemsSource="{Binding Tools}" SelectedItem="{Binding Tool}" AutomationProperties.Name="Tool" />
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center" AutomationProperties.Name="Severity">
                        <WrapPanel.Resources>
                            <Style x:Key="Sev" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Padding" Value="12,4" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="Appearance" Value="Secondary" />
                                <Setter Property="Command" Value="{Binding SetSeverityCommand}" />
                            </Style>
                        </WrapPanel.Resources>
                        <ui:Button Content="Blocks me" CommandParameter="{x:Static bugs:BugSeverity.Blocking}" ToolTip="I cannot do what I wanted">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource Sev}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Blocking"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Content="Annoying" CommandParameter="{x:Static bugs:BugSeverity.Annoying}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource Sev}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Annoying"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Content="Minor" CommandParameter="{x:Static bugs:BugSeverity.Minor}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource Sev}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Minor"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </WrapPanel>
                </DockPanel>

                <ui:TextBox x:Name="Input" FontSize="16" MinHeight="96" MaxHeight="220" AcceptsReturn="True" TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" AutomationProperties.Name="What happened"
                            PlaceholderText="What happened? What you did, what you expected, what you saw."
                            Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Pictures: the user's own (Helm never takes screenshots) -->
                <Grid Margin="0,10,0,0">
                    <Rectangle x:Name="DropFrame" RadiusX="4" RadiusY="4" StrokeThickness="1" StrokeDashArray="4 3" Stroke="{DynamicResource TextFillColorTertiaryBrush}" />
                    <WrapPanel Margin="8,8,8,0">
                        <ItemsControl ItemsSource="{Binding Images}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type bugs:BugImageItem}">
                                    <Grid>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BugThumbTemplate}" />
                                        <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,11,0" Padding="3" MinWidth="0"
                                                   Icon="{ui:SymbolIcon Dismiss24}" FontSize="10" ToolTip="Remove" AutomationProperties.Name="Remove image"
                                                   Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button Content="Add image" Icon="{ui:SymbolIcon ImageAdd24}" Margin="0,0,10,8" Click="AddImage_Click" VerticalAlignment="Center" />
                        <TextBlock Text="or paste (Ctrl+V) or drop pictures here" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </WrapPanel>
                </Grid>

                <!-- The black box, frozen when this window opened -->
                <ui:CardExpander Margin="0,10,0,0" Icon="{ui:SymbolIcon History24}" AutomationProperties.Name="Black box">
                    <ui:CardExpander.Header>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Border Style="{StaticResource BugTag}" Visibility="{Binding ErrorCount, Converter={StaticResource NotEmptyToVisibility}}">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               Text="{Binding ErrorText}" />
                                </Border>
                                <Border Style="{StaticResource BugTag}" Visibility="{Binding FreezeText, Converter={StaticResource NotEmptyToVisibility}}">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}" Text="{Binding FreezeText}" />
                                </Border>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Black box" />
                                <TextBlock Text="{Binding BlackBoxText}" Style="{DynamicResource HelmSecondaryText}" />
                            </StackPanel>
                        </DockPanel>
                    </ui:CardExpander.Header>
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Events}" ItemTemplate="{StaticResource BlackBoxEventTemplate}" Focusable="False" />
                    </ScrollViewer>
                </ui:CardExpander>

                <TextBlock Margin="0,8,0,0" Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}" />

                <DockPanel Margin="0,12,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click" />
                        <ui:Button Appearance="Primary" Content="Send" Icon="{ui:SymbolIcon Send24}" Command="{Binding SendCommand}" IsDefault="False" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"
                                   Text="Nothing you type is recorded · Ctrl+Enter send" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- Sent -->
            <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" Filled="True" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <TextBlock FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="Bug" /> <Run Text="{Binding SentCode, Mode=OneWay, StringFormat='#{0}'}" FontWeight="SemiBold" /> <Run Text="saved. It syncs to your other devices with its black box and pictures." />
                    </TextBlock>
                </StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="Close" Margin="0,0,8,0" Click="Close_Click" />
                        <ui:Button Appearance="Primary" Content="Open" Click="Open_Click" />
                    </StackPanel>
                    <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding SentCode, StringFormat='Claude Code reads it with bug_get {0}'}" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
