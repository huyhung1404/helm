<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Helm.App.BugReports"
    xmlns:bugs="clr-namespace:Helm.Shell.BugReports;assembly=Helm.Shell">

    <!-- Shared by the report window and the Bug reports page. -->
    <local:BugLookConverter x:Key="BugBrush" What="brush" />
    <local:BugLookConverter x:Key="BugIcon" What="icon" />

    <!-- A small tag: a soft fill and coloured text, like Tracker's "Urgent". -->
    <Style x:Key="BugTag" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>

    <!-- One event of a black box: "-37.9 s", its kind, what happened, and the stack of an error on demand. -->
    <DataTemplate x:Key="BlackBoxEventTemplate" DataType="{x:Type bugs:BlackBoxEventItem}">
        <Grid Margin="0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Kind, Converter={StaticResource BugIcon}}" FontSize="14" Margin="0,2,0,0" VerticalAlignment="Top"
                           Foreground="{Binding Kind, Converter={StaticResource BugBrush}}" ToolTip="{Binding KindName}" />
            <StackPanel Grid.Column="2">
                <TextBlock TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding Text, Mode=OneWay}" /><Run Text="{Binding Source, Mode=OneWay, StringFormat=' · {0}', TargetNullValue=''}" FontSize="12"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </TextBlock>
                <TextBlock Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" FontSize="12">
                    <Hyperlink Command="{Binding ToggleDetailCommand}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                        <Run Text="Show or hide the stack" />
                    </Hyperlink>
                </TextBlock>
                <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         MaxHeight="220" Margin="0,4,0,4" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Stack"
                         Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- A picture thumbnail; the remove button only where the template user binds RemoveCommand on the Tag. -->
    <DataTemplate x:Key="BugThumbTemplate" DataType="{x:Type bugs:BugImageItem}">
        <Grid Width="88" Height="64" Margin="0,0,8,8" ToolTip="{Binding Name}">
            <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" ClipToBounds="True"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <Image local:BugImage.Item="{Binding}" Stretch="UniformToFill" />
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
