<Project Sdk="Microsoft.NET.Sdk">

  <!-- Helm on Windows: an Avalonia desktop app. The shell (menu, tabs, title bar) is Helm.Shell.UI's ShellView, every
       tool's page is its shared view from Helm.Modules.<X>.UI. Velopack updates, elevation, single instance, the tray
       and the black box live here. No WPF. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Helm</AssemblyName>
    <RootNamespace>Helm.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\helm.ico</ApplicationIcon>
    <StartupObject>Helm.App.Program</StartupObject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Helm.Shell.Services" />
    <Using Include="Helm.Shell.ViewModels" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\helm.ico" />
    <AvaloniaResource Include="Assets\helm.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core.Windows\Helm.Core.Windows.csproj" />
    <ProjectReference Include="..\Helm.Shell\Helm.Shell.csproj" />
    <ProjectReference Include="..\Helm.Shell.UI\Helm.Shell.UI.csproj" />
    <ProjectReference Include="..\Helm.Shell.Windows\Helm.Shell.Windows.csproj" />
    <ProjectReference Include="..\Helm.Ui\Helm.Ui.csproj" />
    <ProjectReference Include="..\Helm.Ui.Windows\Helm.Ui.Windows.csproj" />
    <ProjectReference Include="..\Helm.Ai.Core\Helm.Ai.Core.csproj" />
    <ProjectReference Include="..\Helm.Modules.Vault\Helm.Modules.Vault.csproj" />
    <ProjectReference Include="..\Helm.Modules.Tracker\Helm.Modules.Tracker.csproj" />
    <ProjectReference Include="..\Helm.Modules.Notes\Helm.Modules.Notes.csproj" />
    <ProjectReference Include="..\Helm.Modules.QuickCapture\Helm.Modules.QuickCapture.csproj" />
    <ProjectReference Include="..\Helm.Modules.Missions\Helm.Modules.Missions.csproj" />
    <ProjectReference Include="..\Helm.Modules.Wallet\Helm.Modules.Wallet.csproj" />
    <ProjectReference Include="..\Helm.Modules.Ssh\Helm.Modules.Ssh.csproj" />
    <ProjectReference Include="..\Helm.Modules.Scratch\Helm.Modules.Scratch.csproj" />
    <ProjectReference Include="..\Helm.Modules.NovelReader\Helm.Modules.NovelReader.csproj" />
    <ProjectReference Include="..\Helm.Modules.WindowZones\Helm.Modules.WindowZones.csproj" />
    <ProjectReference Include="..\Helm.Modules.Vocab\Helm.Modules.Vocab.csproj" />
    <ProjectReference Include="..\Helm.Modules.Habits\Helm.Modules.Habits.csproj" />
    <ProjectReference Include="..\Helm.Modules.Keyboard\Helm.Modules.Keyboard.csproj" />
    <ProjectReference Include="..\Helm.Modules.SlackBot\Helm.Modules.SlackBot.csproj" />
  </ItemGroup>

</Project>
