<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Helm</AssemblyName>
    <RootNamespace>Helm.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\helm.ico</ApplicationIcon>
    <StartupObject>Helm.App.Program</StartupObject>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Velopack" Version="1.2.158" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Helm.Shell.Services" />
    <Using Include="Helm.Shell.ViewModels" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\helm.ico" />
    <Resource Include="Assets\helm.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core.Windows\Helm.Core.Windows.csproj" />
    <ProjectReference Include="..\Helm.Shell\Helm.Shell.csproj" />
    <ProjectReference Include="..\Helm.Modules.AlwaysOnTop\Helm.Modules.AlwaysOnTop.csproj" />
    <ProjectReference Include="..\Helm.Modules.Vault\Helm.Modules.Vault.csproj" />
    <ProjectReference Include="..\Helm.Modules.Tracker\Helm.Modules.Tracker.csproj" />
    <ProjectReference Include="..\Helm.Modules.Notes\Helm.Modules.Notes.csproj" />
    <ProjectReference Include="..\Helm.Modules.QuickCapture\Helm.Modules.QuickCapture.csproj" />
    <ProjectReference Include="..\Helm.Modules.CommandPalette\Helm.Modules.CommandPalette.csproj" />
    <ProjectReference Include="..\Helm.Modules.WatchLater\Helm.Modules.WatchLater.csproj" />
    <ProjectReference Include="..\Helm.Modules.Missions\Helm.Modules.Missions.csproj" />
    <ProjectReference Include="..\Helm.Modules.Wallet\Helm.Modules.Wallet.csproj" />
    <ProjectReference Include="..\Helm.Modules.Ssh\Helm.Modules.Ssh.csproj" />
    <ProjectReference Include="..\Helm.Modules.Scratch\Helm.Modules.Scratch.csproj" />
    <ProjectReference Include="..\Helm.Modules.NovelReader\Helm.Modules.NovelReader.csproj" />
  </ItemGroup>

</Project>
