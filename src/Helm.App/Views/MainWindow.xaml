<ui:FluentWindow
    x:Class="Helm.App.Views.MainWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:Helm.App.Services"
    Title="Helm"
    Width="1100"
    Height="780"
    MinWidth="1000"
    MinHeight="700"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Height="48">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Width="292" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image services:AppIcon.Size="20" Margin="0,0,10,0" />
                    <TextBlock Text="Helm" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.CenterContent>
                <ui:AutoSuggestBox
                    x:Name="SearchBox"
                    Width="520"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,6"
                    PlaceholderText="Search for settings"
                    UpdateTextOnSelect="False"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:AutoSuggestBox.Icon>
                        <ui:IconSourceElement>
                            <ui:SymbolIconSource Symbol="Search24" />
                        </ui:IconSourceElement>
                    </ui:AutoSuggestBox.Icon>
                </ui:AutoSuggestBox>
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="300"
            PaneDisplayMode="Left"
            FrameMargin="0"
            Transition="FadeInWithSlide"
            TransitionDuration="150">
            <ui:NavigationView.ContentOverlay>
                <Grid />
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
