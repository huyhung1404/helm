<ui:FluentWindow
    x:Class="Helm.App.Views.MainWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:Helm.App.Services"
    Title="Helm"
    Width="1100"
    Height="780"
    MinWidth="1000"
    MinHeight="700"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Height="48">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Width="292" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="TitleIcon" services:AppIcon.Size="20" Margin="0,0,10,0" ToolTip="Menu" />
                    <TextBlock Text="Helm" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.CenterContent>
                <StackPanel Orientation="Horizontal">
                <ui:AutoSuggestBox
                    x:Name="SearchBox"
                    Width="520"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,6"
                    PlaceholderText="Search for settings"
                    UpdateTextOnSelect="False"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:AutoSuggestBox.Icon>
                        <ui:IconSourceElement>
                            <ui:SymbolIconSource Symbol="Search24" />
                        </ui:IconSourceElement>
                    </ui:AutoSuggestBox.Icon>
                </ui:AutoSuggestBox>
                <!-- Sync: its state at a glance on every page; click to sync now (or to set it up) -->
                <ui:Button x:Name="SyncButton" Margin="8,6,0,6" Padding="8" Appearance="Transparent" VerticalAlignment="Center"
                           WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding SyncNowCommand}" ToolTip="{Binding ToolTip}"
                           AutomationProperties.Name="Sync now" AutomationProperties.HelpText="{Binding ToolTip}">
                    <!-- One sync glyph in every state: it turns (accent) while syncing, shows a tick for a moment when a sync
                         finishes, fades when offline, is crossed out (faded) when not set up, and turns red with a dot on a
                         problem. The tooltip says why; the Android app bar follows the same rules. -->
                    <Grid>
                        <ui:SymbolIcon FontSize="18" RenderTransformOrigin="0.5,0.5">
                            <ui:SymbolIcon.RenderTransform>
                                <RotateTransform />
                            </ui:SymbolIcon.RenderTransform>
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="ArrowSync24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNotSetUp}" Value="True">
                                            <Setter Property="Symbol" Value="ArrowSyncOff20" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding JustSynced}" Value="True">
                                            <Setter Property="Symbol" Value="ArrowSyncCheckmark24" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Turn">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle" From="0" To="360"
                                                                         Duration="0:0:1.1" RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <RemoveStoryboard BeginStoryboardName="Turn" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <!-- Problem: a red dot as well, so it does not rely on colour alone -->
                        <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-2,0"
                                 Fill="{DynamicResource SystemFillColorCriticalBrush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                </ui:Button>
                </StackPanel>
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="300"
            PaneDisplayMode="Left"
            FrameMargin="0"
            Transition="FadeInWithSlide"
            TransitionDuration="150">
            <ui:NavigationView.ContentOverlay>
                <Grid />
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
