<ui:FluentWindow
    x:Class="Helm.App.Views.MainWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:Helm.App.Services"
    Title="Helm"
    Width="1100"
    Height="780"
    MinWidth="1000"
    MinHeight="700"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Height="48">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Width="292" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="TitleIcon" services:AppIcon.Size="20" Margin="0,0,10,0" ToolTip="Menu" />
                    <TextBlock Text="Helm" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.CenterContent>
                <StackPanel Orientation="Horizontal">
                <ui:AutoSuggestBox
                    x:Name="SearchBox"
                    Width="520"
                    HorizontalAlignment="Left"
                    Margin="0,6,0,6"
                    PlaceholderText="Search for settings"
                    UpdateTextOnSelect="False"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:AutoSuggestBox.Icon>
                        <ui:IconSourceElement>
                            <ui:SymbolIconSource Symbol="Search24" />
                        </ui:IconSourceElement>
                    </ui:AutoSuggestBox.Icon>
                </ui:AutoSuggestBox>
                <!-- Sync: its state at a glance on every page; click to sync now (or to set it up) -->
                <ui:Button x:Name="SyncButton" Margin="8,6,0,6" Padding="8" Appearance="Transparent" VerticalAlignment="Center"
                           WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding SyncNowCommand}" ToolTip="{Binding ToolTip}"
                           AutomationProperties.Name="Sync now" AutomationProperties.HelpText="{Binding ToolTip}">
                    <Grid>
                        <ui:SymbolIcon FontSize="18" Visibility="{Binding IsSyncing, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="ArrowSync24" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSynced}" Value="True">
                                            <Setter Property="Symbol" Value="ArrowSyncCheckmark24" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOffline}" Value="True">
                                            <Setter Property="Symbol" Value="CloudOff24" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                            <Setter Property="Symbol" Value="Warning24" />
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsNotSetUp}" Value="True">
                                            <Setter Property="Symbol" Value="ArrowSyncOff20" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </ui:Button>
                </StackPanel>
            </ui:TitleBar.CenterContent>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="300"
            PaneDisplayMode="Left"
            FrameMargin="0"
            Transition="FadeInWithSlide"
            TransitionDuration="150">
            <ui:NavigationView.ContentOverlay>
                <Grid />
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
