<Page
    x:Class="Helm.App.Views.Pages.HomePage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:services="clr-namespace:Helm.App.Services"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:vm="clr-namespace:Helm.App.ViewModels"
    Title="Home">

    <Page.Resources>
        <!-- Flat, full-surface button used for tiles and quick-access icons -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <TextBlock Text="Home" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- Top strip: what's new / shortcut conflicts / updates -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource TileButton}" Padding="0,0,12,0" HorizontalContentAlignment="Left" Command="{Binding OpenWhatsNewCommand}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="104" Height="60" CornerRadius="6" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B3A66" Offset="0" />
                                <GradientStop Color="#2B2B6B" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image services:AppIcon.Size="40" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Learn what's new" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Version}" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <Button Grid.Column="1" Style="{StaticResource TileButton}" Padding="12,8" Margin="12,0,0,0" HorizontalContentAlignment="Stretch"
                    Command="{Binding OpenConflictsCommand}" ToolTip="{Binding ConflictDetails}">
                <DockPanel>
                    <ui:SymbolIcon FontSize="24" Filled="True" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasConflicts}" Value="True">
                                        <Setter Property="Symbol" Value="Warning24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Shortcut conflicts" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ConflictSummary}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Button>

            <Button Grid.Column="2" Style="{StaticResource TileButton}" Padding="12,8" Margin="12,0,0,0" HorizontalContentAlignment="Stretch" Command="{Binding UpdateTileCommand}" ToolTip="{Binding UpdateTooltip}">
                <DockPanel>
                    <Grid Margin="0,0,12,0" VerticalAlignment="Center">
                        <ui:SymbolIcon FontSize="24" Filled="True" Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateTone}" Value="attention">
                                            <Setter Property="Symbol" Value="ArrowCircleDown24" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding UpdateTone}" Value="muted">
                                            <Setter Property="Symbol" Value="Info24" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                        <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22"
                                         Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding UpdateSubtitle}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left column: Quick access + Shortcuts -->
            <StackPanel Grid.Column="0">
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Quick access" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Tools you turn on will appear here." Style="{DynamicResource HelmSecondaryText}"
                                   Visibility="{Binding HasQuickAccess, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding QuickAccess}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Content at the top: a name on two lines must not push its icon above the others in the row. -->
                                    <Button Style="{StaticResource TileButton}" Padding="8,12" Margin="2" HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding DisplayName}"
                                            VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                                            Command="{Binding DataContext.LaunchModuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <ContentPresenter Content="{Binding Converter={StaticResource ModuleIcon}, ConverterParameter=32}" HorizontalAlignment="Center" Margin="0,0,0,8"
                                                              TextElement.Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource HelmSurface}">
                    <StackPanel>
                        <TextBlock Text="Shortcuts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Keyboard shortcuts of your tools will appear here." Style="{DynamicResource HelmSecondaryText}"
                                   Visibility="{Binding HasShortcuts, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Description}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ShortcutItem}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{Binding Module, Converter={StaticResource ModuleIcon}, ConverterParameter=16}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                          TextElement.Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <core:Keycaps Grid.Column="2" Gesture="{Binding Gesture}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right column: Utilities -->
            <Border Grid.Column="2" Style="{DynamicResource HelmSurface}" Padding="0" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="16,12,8,8">
                        <TextBlock Text="Utilities" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="8" Command="{Binding ToggleSortCommand}" ToolTip="{Binding SortTooltip}">
                            <ui:SymbolIcon Symbol="ArrowSort24" />
                        </ui:Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Utilities}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <Grid Margin="16,6,8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{Binding Converter={StaticResource ModuleIcon}, ConverterParameter=20}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                          TextElement.Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                        <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}" AutomationProperties.Name="{Binding DisplayName}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <ui:Button Grid.Column="3" Appearance="Transparent" Padding="8" AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0} settings'}"
                                                   Command="{Binding DataContext.OpenModuleCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                   CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="ChevronRight20" />
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No tools yet — new tools are on the way." Margin="16,4,16,16" Style="{DynamicResource HelmSecondaryText}"
                               Visibility="{Binding Utilities.Count, Converter={StaticResource EmptyToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</Page>
