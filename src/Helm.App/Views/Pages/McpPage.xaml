<Page
    x:Class="Helm.App.Views.Pages.McpPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:mcp="clr-namespace:Helm.App.Views.Mcp"
    Title="Claude &amp; MCP">

    <StackPanel Margin="24,16,24,24">
        <TextBlock Text="Claude &amp; MCP" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="Connect Claude Code, VS Code or Claude Desktop to Helm, see who is connected, and switch it off." Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,8" />

        <!-- Status: the two switches and what Claude can reach because of them -->
        <TextBlock Text="Status" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon PlugConnected24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Let Claude use Helm's tools"
                                 Description="Claude can find, read and write your notes, to-do lists, debt book and missions, and use the menus of the servers you allow in SSH, where you add Helm below. Helm has to be running. The vault is never included." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding Enabled}" AutomationProperties.Name="Let Claude use Helm's tools" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Edit24}" IsEnabled="{Binding Enabled}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Claude may change things" Description="Off: Claude can only read. On: it can also add and edit notes and tasks, tick tasks, add debts, create, re-plan and advance missions, and ask to run items of a server's menu (nothing is deleted for good)." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AllowChanges}" AutomationProperties.Name="Claude may change things" />
        </ui:CardControl>
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon AppsList24}">
            <ui:CardExpander.Header>
                <core:CardHeader Title="Tools Claude can reach" Description="{Binding ToolsSummary}" />
            </ui:CardExpander.Header>
            <ItemsControl ItemsSource="{Binding ToolGroups}" Margin="40,0,0,0" AutomationProperties.Name="Tools Claude can reach">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding Empty}" Style="{DynamicResource HelmSecondaryText}" FontStyle="Italic"
                                       Visibility="{Binding HasTools, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Tools}" Visibility="{Binding HasTools, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,4,6,0" Padding="8,2" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                ToolTip="{Binding Description}">
                                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:CardExpander>

        <!-- Connect: one expander per client -->
        <TextBlock Text="Connect" Style="{DynamicResource HelmSectionHeader}" />
        <ui:InfoBar Title="Test copy" Severity="Informational" IsClosable="False" IsOpen="True" Margin="0,0,0,8"
                    Message="This Helm uses its own data folder, so everything below starts it with --data-dir. Your usual Helm is not affected."
                    Visibility="{Binding IsTestCopy, Converter={StaticResource BoolToVisibility}}" />

        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Code24}">
            <ui:CardExpander.Header>
                <core:CardHeader Title="Claude Code (terminal and VS Code extension)" Description="{Binding ClaudeCode.StatusText}" />
            </ui:CardExpander.Header>
            <StackPanel>
                <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,8"
                                   Text="The terminal and the VS Code extension share your user settings, so this one command adds Helm in every folder. Start a new Claude session afterwards." />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Copy" Icon="{ui:SymbolIcon Copy24}"
                                       Command="{Binding CopyCommand}" CommandParameter="{Binding ClaudeCodeCommand}" />
                            <ui:TextBox IsReadOnly="True" FontFamily="Consolas" Text="{Binding ClaudeCodeCommand, Mode=OneWay}"
                                        AutomationProperties.Name="Command to add Helm to Claude Code" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <StackPanel>
                        <core:RowLayout>
                            <core:CardHeader Title="Let Helm run it" Description="Runs claude mcp add (or remove) with your normal rights and shows what it printed." />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                                 Visibility="{Binding IsClaudeBusy, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Content="Add for me" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Margin="0,0,8,0"
                                           Command="{Binding AddToClaudeCodeCommand}" IsEnabled="{Binding IsClaudeBusy, Converter={StaticResource InverseBool}}" />
                                <ui:Button Content="Remove" Icon="{ui:SymbolIcon Delete24}"
                                           Command="{Binding RemoveFromClaudeCodeCommand}" IsEnabled="{Binding IsClaudeBusy, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </core:RowLayout>
                        <ui:InfoBar Title="Claude Code is not installed" Severity="Warning" IsClosable="False" IsOpen="True" Margin="0,8,0,0"
                                    Message="Install Claude Code, open a new terminal and check that claude --version works, then press Add for me again. Until then you can copy the command above."
                                    Visibility="{Binding ClaudeMissing, Converter={StaticResource BoolToVisibility}}" />
                        <ui:HyperlinkButton Content="How to install Claude Code" Command="{Binding OpenClaudeCodeSetupCommand}" Margin="0,4,0,0"
                                            Visibility="{Binding ClaudeMissing, Converter={StaticResource BoolToVisibility}}" />
                        <ui:TextBox Margin="0,8,0,0" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="160"
                                    VerticalScrollBarVisibility="Auto" Text="{Binding ClaudeOutput, Mode=OneWay}"
                                    AutomationProperties.Name="What Claude Code printed"
                                    Visibility="{Binding ClaudeOutput, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <TextBlock Style="{DynamicResource HelmSecondaryText}">
                        <Run Text="Reads Helm's entry in" /> <Run Text="{Binding ClaudeCode.Where, Mode=OneWay}" FontFamily="Consolas" /><Run Text=", nothing else." />
                    </TextBlock>
                </Border>
            </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon WindowNew24}">
            <ui:CardExpander.Header>
                <core:CardHeader Title="VS Code (built-in MCP, Copilot agent mode)" Description="{Binding VsCode.StatusText}" />
            </ui:CardExpander.Header>
            <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                <StackPanel>
                    <TextBlock Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,8"
                               Text="In VS Code run “MCP: Open User Configuration” and add this. If the file already has other servers, copy only the helm entry into its servers." />
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Open folder" Icon="{ui:SymbolIcon FolderOpen24}"
                                   Command="{Binding OpenFolderCommand}" CommandParameter="{Binding VsCode}" />
                        <TextBlock VerticalAlignment="Center" Style="{DynamicResource HelmSecondaryText}">
                            <Run Text="User file:" /> <Run Text="{Binding VsCode.Where, Mode=OneWay}" FontFamily="Consolas" />
                        </TextBlock>
                    </DockPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Content="Copy" Icon="{ui:SymbolIcon Copy24}"
                                   Command="{Binding CopyCommand}" CommandParameter="{Binding VsCodeSnippet}" />
                        <ui:TextBox IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" AcceptsReturn="True"
                                    Text="{Binding VsCodeSnippet, Mode=OneWay}" AutomationProperties.Name="mcp.json for VS Code" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </ui:CardExpander>

        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Chat24}">
            <ui:CardExpander.Header>
                <core:CardHeader Title="Claude Desktop" Description="{Binding ClaudeDesktop.StatusText}" />
            </ui:CardExpander.Header>
            <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                <StackPanel>
                    <TextBlock Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,8"
                               Text="In Claude Desktop open Settings → Developer → Edit Config, add the helm entry to mcpServers, save, and restart Claude Desktop." />
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Open config folder" Icon="{ui:SymbolIcon FolderOpen24}"
                                   Command="{Binding OpenFolderCommand}" CommandParameter="{Binding ClaudeDesktop}" />
                        <TextBlock VerticalAlignment="Center" Style="{DynamicResource HelmSecondaryText}">
                            <Run Text="Config file:" /> <Run Text="{Binding ClaudeDesktop.Where, Mode=OneWay}" FontFamily="Consolas" />
                        </TextBlock>
                    </DockPanel>
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Content="Copy" Icon="{ui:SymbolIcon Copy24}"
                                   Command="{Binding CopyCommand}" CommandParameter="{Binding ClaudeDesktopSnippet}" />
                        <ui:TextBox IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" AcceptsReturn="True"
                                    Text="{Binding ClaudeDesktopSnippet, Mode=OneWay}" AutomationProperties.Name="claude_desktop_config.json" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </ui:CardExpander>

        <!-- Connections: the clients connected now -->
        <TextBlock Text="Connections" Style="{DynamicResource HelmSectionHeader}" />
        <Border Style="{DynamicResource HelmSurface}">
            <StackPanel>
                <TextBlock Style="{DynamicResource HelmSecondaryText}"
                           Visibility="{Binding HasConnections, Converter={StaticResource InverseBoolToVisibility}}"
                           Text="Nothing is connected now. Add Helm to a client above, then start a new Claude session there: it connects when the session starts and shows up here." />
                <ItemsControl ItemsSource="{Binding Connections}" AutomationProperties.Name="Connections">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <ui:Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Disconnect" Icon="{ui:SymbolIcon PlugDisconnected24}"
                                           AutomationProperties.Name="{Binding Name, StringFormat='Disconnect {0}'}"
                                           Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                           CommandParameter="{Binding}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{DynamicResource HelmSecondaryText}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Text="Permissions" Style="{DynamicResource HelmSectionHeader}" />
        <Border Style="{DynamicResource HelmSurface}">
            <mcp:McpPermissionsPanel DataContext="{Binding Permissions}" />
        </Border>
    </StackPanel>
</Page>
