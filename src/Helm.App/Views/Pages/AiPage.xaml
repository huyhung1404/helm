<Page
    x:Class="Helm.App.Views.Pages.AiPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:aiv="clr-namespace:Helm.App.Views.Ai"
    xmlns:mcp="clr-namespace:Helm.App.Views.Mcp"
    Title="AI">

    <Page.Resources>
        <!-- A tab button: filled while its Tag (bound to "is this one in front") is true -->
        <Style x:Key="Segment" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="MinWidth" Value="140" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                    <DataTrigger.Value><sys:Boolean>True</sys:Boolean></DataTrigger.Value>
                    <Setter Property="Appearance" Value="Primary" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <TextBlock Text="AI" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,16"
                   Text="Your AI providers' API keys (Claude, Grok…), the agents on this PC that take Helm's AI jobs first, and the AI agents that use Helm's tools." />

        <!-- Models & keys, Agents & MCP -->
        <WrapPanel Margin="0,0,0,16">
            <ui:Button Style="{StaticResource Segment}" Margin="0,0,6,0" Tag="{Binding IsKeysTab}" Content="Models &amp; keys" Icon="{ui:SymbolIcon Key24}"
                       Command="{Binding ShowKeysCommand}" AutomationProperties.Name="Models and keys" />
            <ui:Button Style="{StaticResource Segment}" Margin="0,0,6,0" Tag="{Binding IsProxyTab}" Content="Proxy" Icon="{ui:SymbolIcon ArrowSwap24}"
                       Command="{Binding ShowProxyCommand}" AutomationProperties.Name="Proxy" />
            <ui:Button Style="{StaticResource Segment}" Tag="{Binding IsAgentsTab}" Content="Agents &amp; MCP" Icon="{ui:SymbolIcon PlugConnected24}"
                       Command="{Binding ShowAgentsCommand}" AutomationProperties.Name="Agents and MCP" />
        </WrapPanel>

        <aiv:AiKeysView DataContext="{Binding Keys}"
                        Visibility="{Binding DataContext.IsKeysTab, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}" />
        <aiv:AiProxyView DataContext="{Binding Proxy}"
                         Visibility="{Binding DataContext.IsProxyTab, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}" />
        <mcp:McpAgentsView DataContext="{Binding Agents}"
                           Visibility="{Binding DataContext.IsAgentsTab, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</Page>
