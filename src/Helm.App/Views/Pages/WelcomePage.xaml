<Page
    x:Class="Helm.App.Views.Pages.WelcomePage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Welcome to Helm">
    <StackPanel Margin="24,0,24,24" MaxWidth="820" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Image Source="pack://application:,,,/Assets/helm.png" Width="64" Height="64" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Welcome to Helm" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="A personal Windows toolkit — one tab per tool." Style="{DynamicResource HelmSecondaryText}" FontSize="14" />
            </StackPanel>
        </StackPanel>

        <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Getting started" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" LineHeight="22">
                    • Turn tools on or off from <Bold>Home → Utilities</Bold> or from each tool's page.<LineBreak />
                    • Closing the window keeps Helm running in the tray; use the tray menu to exit.<LineBreak />
                    • Use the search box in the title bar to jump to any setting.<LineBreak />
                    • Enable <Bold>General → Run at startup</Bold> to launch Helm elevated at sign-in without a UAC prompt.
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:SymbolIcon Symbol="SlideLayout24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Zones" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Text="Split each monitor into zones. Hold Shift while dragging a window to snap it into a zone, or press Win+Shift+` to open the layout editor." />
            </StackPanel>
        </Border>

        <Border Style="{DynamicResource HelmSurface}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:SymbolIcon Symbol="Pin24" FontSize="20" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Always On Top" FontSize="16" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Text="Press Win+Ctrl+T to pin the active window above all others. Pinned windows get a colored border." />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
