<Page
    x:Class="Helm.App.Views.Pages.WhatsNewPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="What's new">
    <StackPanel Margin="24,0,24,24" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="What's new" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />
        <Border Style="{DynamicResource HelmSurface}">
            <StackPanel>
                <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" LineHeight="22">
                    • A clean start: Helm ships without tools for now; new tools are planned and will arrive as updates.<LineBreak />
                    • Automatic updates from GitHub Releases (General → Updates).<LineBreak />
                    • Fluent shell modelled after PowerToys Settings: Home, General, search, tray.
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
