<Page
    x:Class="Helm.App.Views.Pages.WhatsNewPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="What's new">
    <StackPanel Margin="24,0,24,24" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="What's new" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />
        <Border Style="{DynamicResource HelmSurface}">
            <StackPanel>
                <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap" LineHeight="22">
                    • New Fluent shell modelled after PowerToys Settings: Home, General, search, tray.<LineBreak />
                    • <Bold>Zones</Bold>: templates, custom grid/canvas layouts, drag-to-snap, Win+Arrow override.<LineBreak />
                    • <Bold>Always On Top</Bold>: pin windows with Win+Ctrl+T, colored border, pinned list.
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
