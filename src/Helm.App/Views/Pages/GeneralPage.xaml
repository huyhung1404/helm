<Page
    x:Class="Helm.App.Views.Pages.GeneralPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core"
    Title="General">

    <StackPanel Margin="24,0,24,24">
        <TextBlock Text="General" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ui:InfoBar Title="Something went wrong" Message="{Binding StatusMessage}" Severity="Warning" IsClosable="True"
                    IsOpen="{Binding HasStatusMessage}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}" Margin="0,0,0,12" />

        <!-- Version / updates -->
        <TextBlock Text="Version" Style="{DynamicResource HelmSectionHeader}" Margin="0,0,0,8" />
        <ui:CardExpander x:Name="UpdatesCard" Margin="0,0,0,4" IsExpanded="True" DataContext="{Binding Updates}">
            <ui:CardExpander.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/helm.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
            </ui:CardExpander.Icon>
            <ui:CardExpander.Header>
                <core:RowLayout>
                    <core:CardHeader Title="Updates" Description="{Binding CurrentVersion}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                         Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Check for updates" Command="{Binding CheckCommand}" IsEnabled="{Binding IsInstalled}" />
                    </StackPanel>
                </core:RowLayout>
            </ui:CardExpander.Header>
            <StackPanel>
                <!-- Status -->
                <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                    <StackPanel>
                        <ui:InfoBar Title="Automatic updates are off" Message="{Binding NotInstalledReason}" Severity="Informational" IsClosable="False"
                                    IsOpen="True" Margin="0,0,0,8"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:InfoBar Title="Update problem" Message="{Binding ErrorMessage}" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding HasError}" Margin="0,0,0,8"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        <core:RowLayout>
                            <StackPanel>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastCheckedText}" Style="{DynamicResource HelmSecondaryText}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ui:Button Content="Download" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadCommand}"
                                           Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
                                <ui:Button Content="Restart to update" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RestartToUpdateCommand}"
                                           Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </core:RowLayout>
                        <ProgressBar Margin="0,8,0,0" Height="4" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                        <Border Margin="0,12,0,0" Padding="12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Release notes" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource HelmExpanderRow}" IsEnabled="{Binding IsInstalled}">
                    <core:RowLayout>
                        <core:CardHeader Title="Update channel" Description="Preview gets GitHub pre-releases earlier; Stable is recommended." />
                        <ComboBox HorizontalAlignment="Right" MinWidth="140" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}" IsEnabled="{Binding IsInstalled}">
                    <core:RowLayout>
                        <core:CardHeader Title="Automatically download updates" Description="Downloads in the background; nothing is installed until you restart to update." />
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AutoDownload}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}" IsEnabled="{Binding IsInstalled}">
                    <core:RowLayout>
                        <core:CardHeader Title="Install updates automatically when Helm restarts" Description="A downloaded update is applied the next time Helm starts." />
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AutoInstallOnRestart}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Delete my settings when Helm is uninstalled" Description="Off: settings and logs in %LOCALAPPDATA%\Helm survive an uninstall/reinstall." />
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding PurgeDataOnUninstall}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <StackPanel>
                            <TextBlock Text="Release history" />
                            <TextBlock Style="{DynamicResource HelmSecondaryText}" Visibility="{Binding HasSourceOverride, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="Developer update source override:" /> <Run Text="{Binding SourceOverride, Mode=OneWay}" FontFamily="Consolas" />
                            </TextBlock>
                        </StackPanel>
                        <ui:HyperlinkButton HorizontalAlignment="Right" Content="Open GitHub releases" Command="{Binding OpenReleasesCommand}" />
                    </core:RowLayout>
                </Border>
            </StackPanel>
        </ui:CardExpander>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Shield24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Administrator mode" Description="{Binding ElevationText}" />
            </ui:CardControl.Header>
        </ui:CardControl>

        <!-- Appearance & behavior -->
        <TextBlock Text="Appearance &amp; behavior" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="App theme" Description="Light, dark, or follow the Windows setting." />
            </ui:CardControl.Header>
            <ComboBox MinWidth="180" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Power24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Run at startup" Description="Starts Helm elevated when you sign in (Task Scheduler, no UAC prompt)." />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,12,0"
                                 Visibility="{Binding IsStartupBusy, Converter={StaticResource BoolToVisibility}}" />
                <ui:ToggleSwitch IsChecked="{Binding RunAtStartup}" IsEnabled="{Binding IsStartupBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowMinimize24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Start minimized to tray" Description="Keep the window hidden when Helm launches." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding StartMinimized}" />
        </ui:CardControl>

        <!-- Sync -->
        <TextBlock Text="Sync" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardExpander Margin="0,0,0,4" IsExpanded="True" Icon="{ui:SymbolIcon ArrowSync24}" DataContext="{Binding Sync}">
            <ui:CardExpander.Header>
                <core:RowLayout>
                    <core:CardHeader Title="Sync across devices"
                                     Description="End-to-end encrypted: neither the server nor whoever issued your invite can read your data." />
                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,16,0" HorizontalAlignment="Right"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </core:RowLayout>
            </ui:CardExpander.Header>
            <StackPanel>
                <ui:InfoBar Title="Sync" Message="{Binding ErrorMessage}" Severity="Warning" IsClosable="False" IsOpen="{Binding HasError}"
                            Margin="0,0,0,8" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                <!-- 1. Not connected: invite code or device token -->
                <StackPanel Visibility="{Binding IsNotConnected, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,8"
                                       Text="Sync needs an invite code (to create your account) or a device token (to add this device to an account you already have)." />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="I have an invite code" IsChecked="{Binding UseInvite}" Margin="0,0,24,0" />
                                <RadioButton Content="I have a device token" IsChecked="{Binding UseToken}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource HelmExpanderRow}" Visibility="{Binding UseInvite, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ui:TextBox AutomationProperties.Name="Invite code" PlaceholderText="Invite code (helm_inv_…)" Text="{Binding InviteCode, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,0,0,8" />
                            <ui:TextBox AutomationProperties.Name="Account name" PlaceholderText="Account name, e.g. your name" Text="{Binding AccountNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <ui:TextBox AutomationProperties.Name="Device name" PlaceholderText="This device's name" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <ui:Button Content="Create account" Appearance="Primary" Command="{Binding ConnectCommand}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource HelmExpanderRow}" Visibility="{Binding UseToken, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ui:TextBox AutomationProperties.Name="Device token" PlaceholderText="Device token (helm_pat_…)" Text="{Binding TokenInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,0,0,8" />
                            <ui:Button Content="Connect" Appearance="Primary" Command="{Binding ConnectCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 2. Connected, key needed: create the passphrase (first device) or unlock -->
                <StackPanel Visibility="{Binding NeedsKey, Converter={StaticResource BoolToVisibility}}">
                    <ui:InfoBar Title="The account key was changed" Severity="Informational" IsClosable="False" IsOpen="True" Margin="0,0,0,8"
                                Message="A device was removed on another PC and the key was changed. Enter your passphrase once to keep syncing; nothing on this device was lost."
                                Visibility="{Binding KeyChangedElsewhere, Converter={StaticResource BoolToVisibility}}" />
                    <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0" Visibility="{Binding IsCheckingPassphrase, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Checking the account…" Style="{DynamicResource HelmSecondaryText}" />
                    </Border>
                    <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0" Visibility="{Binding IsCreatingPassphrase, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding AccountName, StringFormat='Create the passphrase for {0}'}" />
                            <TextBlock TextWrapping="Wrap" Style="{DynamicResource HelmSecondaryText}" Margin="0,4,0,8"
                                       Text="It encrypts your data before it leaves this device and unlocks sync on your other devices. Nobody can reset it for you." />
                            <ui:PasswordBox AutomationProperties.Name="New passphrase" PlaceholderText="{Binding MinPassphraseLength, StringFormat='Passphrase (at least {0} characters)'}"
                                            Password="{Binding Passphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding PassphraseStrengthText}" Style="{DynamicResource HelmSecondaryText}" Margin="0,-4,0,8" />
                            <ui:PasswordBox AutomationProperties.Name="Repeat passphrase" PlaceholderText="Repeat the passphrase" Password="{Binding PassphraseConfirm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            <ui:Button Content="Create passphrase and start syncing" Appearance="Primary" Command="{Binding CreatePassphraseCommand}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0" Visibility="{Binding IsUnlocking, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding AccountName, StringFormat='Unlock {0} on this device'}" />
                            <TextBlock TextWrapping="Wrap" Style="{DynamicResource HelmSecondaryText}" Margin="0,4,0,8"
                                       Text="Enter the passphrase you created on your first device, or use your recovery key." />
                            <ui:PasswordBox AutomationProperties.Name="Passphrase" PlaceholderText="Passphrase" Password="{Binding Passphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                            Visibility="{Binding UseRecoveryKey, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ui:TextBox AutomationProperties.Name="Recovery key" PlaceholderText="Recovery key (HELM-…)" Text="{Binding RecoveryKeyInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,0,0,8"
                                        Visibility="{Binding UseRecoveryKey, Converter={StaticResource BoolToVisibility}}" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Unlock" Appearance="Primary" Command="{Binding UnlockCommand}" Margin="0,0,16,0" />
                                <CheckBox Content="Use the recovery key instead" IsChecked="{Binding UseRecoveryKey}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Recovery key, shown once after the passphrase is created -->
                <Border Style="{DynamicResource HelmExpanderRow}" Visibility="{Binding IsShowingRecoveryKey, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ui:InfoBar Title="{Binding RecoveryKeyTitle}" Severity="Warning" IsClosable="False" IsOpen="True" Margin="0,0,0,8"
                                    Message="It is shown only this once. If you forget the passphrase, this key is the only way back into your data. Store it in a password manager or print it." />
                        <ui:TextBox AutomationProperties.Name="Your recovery key" Text="{Binding RecoveryKeyToShow, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Copy" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyRecoveryKeyCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="I saved it" Appearance="Primary" Command="{Binding DismissRecoveryKeyCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. Ready: status, storage, devices -->
                <StackPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                        <core:RowLayout>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding AccountName}" />
                                <TextBlock Text="{Binding StatusText}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ServerText}" Style="{DynamicResource HelmSecondaryText}" />
                            </StackPanel>
                            <ui:Button HorizontalAlignment="Right" Content="Sync now" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding SyncNowCommand}" />
                        </core:RowLayout>
                    </Border>
                    <Border Style="{DynamicResource HelmExpanderRow}" Visibility="{Binding NeedsProtectionUpgrade, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Strengthen passphrase protection" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Style="{DynamicResource HelmSecondaryText}" Margin="0,4,0,8"
                                       Text="Your passphrase is protected the older way (PBKDF2). Enter it once to switch to Argon2id, which makes guessing it far harder. Nothing else changes." />
                            <StackPanel Orientation="Horizontal">
                                <ui:PasswordBox AutomationProperties.Name="Passphrase to strengthen" PlaceholderText="Your passphrase" MinWidth="260"
                                                Password="{Binding UpgradePassphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                <ui:Button Content="Strengthen" Appearance="Primary" Command="{Binding UpgradeProtectionCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource HelmExpanderRow}">
                        <StackPanel>
                            <TextBlock Text="{Binding UsageText}" />
                            <ProgressBar Margin="0,6,0,0" Height="4" Minimum="0" Maximum="100" Value="{Binding UsagePercent, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource HelmExpanderRow}" Visibility="{Binding CanManageDevices, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Devices" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <core:RowLayout Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock>
                                                    <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Details}" Style="{DynamicResource HelmSecondaryText}" />
                                            </StackPanel>
                                            <ui:Button HorizontalAlignment="Right" Content="Remove" Appearance="Danger"
                                                       Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}"
                                                       Visibility="{Binding CanRevoke, Converter={StaticResource BoolToVisibility}}" />
                                        </core:RowLayout>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Padding="12" Margin="0,0,0,8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    Visibility="{Binding IsRemovingDevice, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding RemovingDeviceText}" FontWeight="SemiBold" />
                                    <TextBlock TextWrapping="Wrap" Style="{DynamicResource HelmSecondaryText}" Margin="0,4,0,8"
                                               Text="Recommended: also change the account key, so that device can never read anything written from now on. Your other devices will ask for the passphrase once, and you get a new recovery key." />
                                    <ui:PasswordBox AutomationProperties.Name="Passphrase to change the key" PlaceholderText="Your passphrase"
                                                    Password="{Binding RemovePassphrase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="Remove and change key" Appearance="Danger" Command="{Binding RemoveDeviceAndChangeKeyCommand}" Margin="0,0,8,0" />
                                        <ui:Button Content="Remove only" Command="{Binding RemoveDeviceOnlyCommand}" Margin="0,0,8,0" />
                                        <ui:Button Content="Cancel" Command="{Binding CancelRemoveDeviceCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Add a device" FontWeight="SemiBold" Margin="0,8,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox AutomationProperties.Name="New device name" PlaceholderText="Device name, e.g. Laptop" Text="{Binding NewDeviceName, UpdateSourceTrigger=PropertyChanged}" MinWidth="220" Margin="0,0,8,0" />
                                <ui:TextBox AutomationProperties.Name="New device expiry in days" PlaceholderText="Expires in days (optional)" Text="{Binding NewDeviceDays, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" Margin="0,0,8,0" />
                                <ui:Button Content="Create token" Command="{Binding AddDeviceCommand}" />
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasNewDeviceToken, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,4"
                                           Text="Copy this token now; it is shown only once. On the new device: General → Sync → I have a device token, then unlock with your passphrase." />
                                <ui:TextBox AutomationProperties.Name="New device token" Text="{Binding NewDeviceToken, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Copy" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyNewDeviceTokenCommand}" Margin="0,0,8,0" />
                                    <ui:Button Content="Done" Command="{Binding DismissNewDeviceTokenCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource HelmExpanderRow}">
                        <core:RowLayout>
                            <core:CardHeader Title="Turn off sync on this device" Description="Stops syncing and forgets this device's token and key. Your data stays." />
                            <ui:Button HorizontalAlignment="Right" Content="Turn off…" Appearance="Danger" Command="{Binding SignOutCommand}" />
                        </core:RowLayout>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ui:CardExpander>

        <!-- Files -->
        <TextBlock Text="Backup &amp; troubleshooting" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon FolderOpen24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Settings folder" Description="{Binding SettingsFolder}" />
            </ui:CardControl.Header>
            <ui:Button Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DocumentText24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Logs" Description="Rolling daily log files, kept for 14 days." />
            </ui:CardControl.Header>
            <ui:Button Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowReset24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Reset all settings" Description="Delete every setting and layout, then restart Helm." />
            </ui:CardControl.Header>
            <ui:Button Content="Reset…" Appearance="Danger" Command="{Binding ResetAllSettingsCommand}" />
        </ui:CardControl>
    </StackPanel>
</Page>
