<Page
    x:Class="Helm.App.Views.Pages.GeneralPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core"
    Title="General">

    <StackPanel Margin="0,0,24,24">
        <TextBlock Text="General" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ui:InfoBar Title="Something went wrong" Message="{Binding StatusMessage}" Severity="Warning" IsClosable="True"
                    IsOpen="{Binding HasStatusMessage}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}" Margin="0,0,0,12" />

        <!-- Version / updates -->
        <TextBlock Text="Version" Style="{DynamicResource HelmSectionHeader}" Margin="0,0,0,8" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/helm.png" Width="28" Height="28" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <core:CardHeader Title="{Binding Version}" Description="{Binding UpdateStatus}" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                 Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,0" />
                <ui:HyperlinkButton Content="Releases" Command="{Binding OpenReleasesCommand}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Shield24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Administrator mode" Description="{Binding ElevationText}" />
            </ui:CardControl.Header>
        </ui:CardControl>

        <!-- Appearance & behavior -->
        <TextBlock Text="Appearance &amp; behavior" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="App theme" Description="Light, dark, or follow the Windows setting." />
            </ui:CardControl.Header>
            <ComboBox MinWidth="180" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Power24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Run at startup" Description="Starts Helm elevated when you sign in (Task Scheduler, no UAC prompt)." />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,12,0"
                                 Visibility="{Binding IsStartupBusy, Converter={StaticResource BoolToVisibility}}" />
                <ui:ToggleSwitch IsChecked="{Binding RunAtStartup}" IsEnabled="{Binding IsStartupBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowMinimize24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Start minimized to tray" Description="Keep the window hidden when Helm launches." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding StartMinimized}" />
        </ui:CardControl>

        <!-- Files -->
        <TextBlock Text="Backup &amp; troubleshooting" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon FolderOpen24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Settings folder" Description="{Binding SettingsFolder}" />
            </ui:CardControl.Header>
            <ui:Button Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DocumentText24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Logs" Description="Rolling daily log files, kept for 14 days." />
            </ui:CardControl.Header>
            <ui:Button Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowReset24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Reset all settings" Description="Delete every setting and layout, then restart Helm." />
            </ui:CardControl.Header>
            <ui:Button Content="Reset…" Appearance="Danger" Command="{Binding ResetAllSettingsCommand}" />
        </ui:CardControl>
    </StackPanel>
</Page>
