<Page
    x:Class="Helm.App.Views.Pages.GeneralPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core"
    Title="General">

    <StackPanel Margin="24,0,24,24">
        <TextBlock Text="General" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ui:InfoBar Title="Something went wrong" Message="{Binding StatusMessage}" Severity="Warning" IsClosable="True"
                    IsOpen="{Binding HasStatusMessage}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}" Margin="0,0,0,12" />

        <!-- Version / updates -->
        <TextBlock Text="Version" Style="{DynamicResource HelmSectionHeader}" Margin="0,0,0,8" />
        <ui:CardExpander x:Name="UpdatesCard" Margin="0,0,0,4" IsExpanded="True" DataContext="{Binding Updates}">
            <ui:CardExpander.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/helm.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
            </ui:CardExpander.Icon>
            <ui:CardExpander.Header>
                <Grid>
                    <core:CardHeader Title="Updates" Description="{Binding CurrentVersion}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,16,0">
                        <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"
                                         Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Check for updates" Command="{Binding CheckCommand}" IsEnabled="{Binding IsInstalled}" />
                    </StackPanel>
                </Grid>
            </ui:CardExpander.Header>
            <StackPanel>
                <!-- Status -->
                <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                    <StackPanel>
                        <ui:InfoBar Title="Automatic updates are off" Message="{Binding NotInstalledReason}" Severity="Informational" IsClosable="False"
                                    IsOpen="True" Margin="0,0,0,8"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:InfoBar Title="Update problem" Message="{Binding ErrorMessage}" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding HasError}" Margin="0,0,0,8"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LastCheckedText}" Style="{DynamicResource HelmSecondaryText}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ui:Button Content="Download" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding DownloadCommand}"
                                           Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0" />
                                <ui:Button Content="Restart to update" Appearance="Primary" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RestartToUpdateCommand}"
                                           Visibility="{Binding IsDownloaded, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                        <ProgressBar Margin="0,8,0,0" Height="4" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                        <Border Margin="0,12,0,0" Padding="12" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                Visibility="{Binding HasReleaseNotes, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Release notes" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource HelmExpanderRow}" IsEnabled="{Binding IsInstalled}">
                    <Grid>
                        <core:CardHeader Title="Update channel" Description="Preview gets GitHub pre-releases earlier; Stable is recommended." />
                        <ComboBox HorizontalAlignment="Right" MinWidth="140" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" />
                    </Grid>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}" IsEnabled="{Binding IsInstalled}">
                    <Grid>
                        <core:CardHeader Title="Automatically download updates" Description="Downloads in the background; nothing is installed until you restart to update." />
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AutoDownload}" />
                    </Grid>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}" IsEnabled="{Binding IsInstalled}">
                    <Grid>
                        <core:CardHeader Title="Install updates automatically when Helm restarts" Description="A downloaded update is applied the next time Helm starts." />
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AutoInstallOnRestart}" />
                    </Grid>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <Grid>
                        <core:CardHeader Title="Delete my settings when Helm is uninstalled" Description="Off: settings and logs in %LOCALAPPDATA%\Helm survive an uninstall/reinstall." />
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding PurgeDataOnUninstall}" />
                    </Grid>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Release history" />
                            <TextBlock Style="{DynamicResource HelmSecondaryText}" Visibility="{Binding HasSourceOverride, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="Developer update source override:" /> <Run Text="{Binding SourceOverride, Mode=OneWay}" FontFamily="Consolas" />
                            </TextBlock>
                        </StackPanel>
                        <ui:HyperlinkButton HorizontalAlignment="Right" Content="Open GitHub releases" Command="{Binding OpenReleasesCommand}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ui:CardExpander>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Shield24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Administrator mode" Description="{Binding ElevationText}" />
            </ui:CardControl.Header>
        </ui:CardControl>

        <!-- Appearance & behavior -->
        <TextBlock Text="Appearance &amp; behavior" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DarkTheme24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="App theme" Description="Light, dark, or follow the Windows setting." />
            </ui:CardControl.Header>
            <ComboBox MinWidth="180" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Power24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Run at startup" Description="Starts Helm elevated when you sign in (Task Scheduler, no UAC prompt)." />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,12,0"
                                 Visibility="{Binding IsStartupBusy, Converter={StaticResource BoolToVisibility}}" />
                <ui:ToggleSwitch IsChecked="{Binding RunAtStartup}" IsEnabled="{Binding IsStartupBusy, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowMinimize24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Start minimized to tray" Description="Keep the window hidden when Helm launches." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding StartMinimized}" />
        </ui:CardControl>

        <!-- Files -->
        <TextBlock Text="Backup &amp; troubleshooting" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon FolderOpen24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Settings folder" Description="{Binding SettingsFolder}" />
            </ui:CardControl.Header>
            <ui:Button Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon DocumentText24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Logs" Description="Rolling daily log files, kept for 14 days." />
            </ui:CardControl.Header>
            <ui:Button Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowReset24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Reset all settings" Description="Delete every setting and layout, then restart Helm." />
            </ui:CardControl.Header>
            <ui:Button Content="Reset…" Appearance="Danger" Command="{Binding ResetAllSettingsCommand}" />
        </ui:CardControl>
    </StackPanel>
</Page>
