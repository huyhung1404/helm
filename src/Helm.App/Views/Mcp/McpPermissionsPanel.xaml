<UserControl
    x:Class="Helm.App.Views.Mcp.McpPermissionsPanel"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows">

    <!-- The switch, the elevation state, the session allowances (Revoke) and the activity log (Clear). -->
    <StackPanel>
        <core:RowLayout>
            <core:CardHeader Title="Ask before every change"
                             Description="AI agents ask before they change your notes, Tracker, Wallet or Missions, even when Helm is not running as Administrator." />
            <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AskBeforeChanges}" AutomationProperties.Name="Ask before every change" />
        </core:RowLayout>

        <DockPanel Margin="0,12,0,0">
            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ShieldKeyhole24" Margin="0,0,10,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding ElevationText}" TextWrapping="Wrap" />
        </DockPanel>

        <TextBlock Text="Allowed for this session" FontWeight="SemiBold" Margin="0,20,0,4" />
        <TextBlock Text="Nothing yet. A session allowance ends when the agent disconnects or Helm restarts." Style="{DynamicResource HelmSecondaryText}"
                   Visibility="{Binding HasAllowances, Converter={StaticResource InverseBoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Allowances}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,4">
                        <ui:Button DockPanel.Dock="Right" Content="Revoke" VerticalAlignment="Center"
                                   Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" />
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" Style="{DynamicResource HelmSecondaryText}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Margin="0,20,0,4">
            <ui:Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearActivityCommand}" VerticalAlignment="Center"
                       Visibility="{Binding HasActivity, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel>
                <TextBlock Text="Activity" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ActivitySummary}" Style="{DynamicResource HelmSecondaryText}" />
            </StackPanel>
        </DockPanel>
        <TextBlock Text="Nothing yet. Every call that changes something, or runs on a server, is listed here." Style="{DynamicResource HelmSecondaryText}"
                   Visibility="{Binding HasActivity, Converter={StaticResource InverseBoolToVisibility}}" />
        <ItemsControl ItemsSource="{Binding Activity}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4" ToolTip="{Binding Details}">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HelmSecondaryText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotDone}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
