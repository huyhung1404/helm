<UserControl
    x:Class="Helm.App.Views.Ai.SkillHubView"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- The Skill Hub card under the Features table: where the features' own prompts come from. Its DataContext is a
         SkillHubViewModel; the tokens go into password boxes only and are saved encrypted, never shown again. -->
    <Border Style="{DynamicResource HelmSurface}" Margin="0,16,0,0" Padding="20,16">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Library24" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="Prompts from your Skill Hub" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" Margin="0,4,0,12"
                       Text="Save a prompt named helm-&lt;feature&gt; on your Skill Hub (helm-ask-helm for Ask Helm) and Helm uses it instead of its own, on the PC and the phone, within 15 minutes. Archive it to go back to the built-in prompt." />

            <Grid MaxWidth="720" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="3">
                    <TextBlock Text="Address" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://skill.example.com/api/mcp"
                                AutomationProperties.Name="Skill Hub address" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <TextBlock Text="Machine token" Margin="0,0,0,4" />
                    <ui:PasswordBox PlaceholderText="{Binding TokenHint}" Password="{Binding Token, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Machine token" AutomationProperties.HelpText="{Binding TokenHint}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="Cloudflare Access client id" Margin="0,0,0,4" />
                    <ui:PasswordBox PlaceholderText="{Binding AccessHint}" Password="{Binding AccessClientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Cloudflare Access client id" AutomationProperties.HelpText="{Binding AccessHint}" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                    <TextBlock Text="Cloudflare Access client secret" Margin="0,0,0,4" />
                    <ui:PasswordBox PlaceholderText="{Binding AccessHint}" Password="{Binding AccessClientSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Cloudflare Access client secret" AutomationProperties.HelpText="{Binding AccessHint}" />
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Text="{Binding Problem}"
                       Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />

            <!-- Save, then what the last fetch did -->
            <DockPanel Margin="0,12,0,0">
                <ui:Button DockPanel.Dock="Left" Appearance="Primary" Content="Save" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding SaveCommand}"
                           ToolTip="Saves the address and the tokens typed (empty boxes keep the saved ones), then fetches the prompts. An empty address turns it off." />
                <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="18" Height="18" Margin="12,0,0,0"
                                 Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}" />
                <DockPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <ui:SymbolIcon DockPanel.Dock="Left" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="Info24" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOk}" Value="True">
                                        <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock Text="{Binding StatusText}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
