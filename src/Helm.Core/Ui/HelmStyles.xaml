<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Helm.Core.Ui">

    <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <local:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
    <local:InverseBoolConverter x:Key="InverseBool" />
    <local:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    <local:NotEmptyToVisibilityConverter x:Key="EmptyToVisibility" Invert="True" />
    <local:HexToBrushConverter x:Key="HexToBrush" />
    <local:EnumEqualsConverter x:Key="EnumEquals" />

    <!-- Section title between groups of cards ("Editor", "Zones", ...) -->
    <Style x:Key="HelmSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,24,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Row inside a CardExpander: checkbox/label + control, separated by a hairline -->
    <Style x:Key="HelmExpanderRow" TargetType="Border">
        <Setter Property="Padding" Value="56,12,16,12" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- Rounded surface used by Home cards -->
    <Style x:Key="HelmSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="HelmSecondaryText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
