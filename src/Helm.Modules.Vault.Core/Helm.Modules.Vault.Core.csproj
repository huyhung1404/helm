<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vault logic shared by the Windows and Android apps: keys, items, locking, backups. No WPF/Avalonia types.
       See docs/vault-design.md and docs/vault-format.md. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Modules.Vault</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core\Helm.Core.csproj" />
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <!-- The user guide shown in the app is docs/vault-guide.md itself: one text for GitHub and for the app. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\vault-guide.md" LogicalName="Helm.Modules.Vault.vault-guide.md" Link="Guide\vault-guide.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>
