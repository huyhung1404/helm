<Page
    x:Class="Helm.Modules.NovelReader.NovelReaderContentPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:self="clr-namespace:Helm.Modules.NovelReader"
    Title="Novel Reader" ScrollViewer.CanContentScroll="False">

    <!-- Novel Reader itself (menu and Quick access): the library of synced novels, and the open novel with its chapter
         bar, the converted text (click a word to fix it), reading aloud and the names panel. Options live on
         NovelReaderPage. -->
    <Page.Resources>
        <self:LineHeight x:Key="LineHeight" />

        <!-- The paragraph and the sentence being read aloud: the accent colour, light and stronger -->
        <SolidColorBrush x:Key="ParagraphFill" Color="{DynamicResource SystemAccentColorSecondary}" Opacity="0.14" />
        <SolidColorBrush x:Key="SentenceFill" Color="{DynamicResource SystemAccentColorSecondary}" Opacity="0.38" />

        <!-- Small icon-only action -->
        <Style x:Key="IconAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="BarItem" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title: the tool, or the open novel with a way back to the library -->
        <DockPanel Margin="0,0,0,16">
            <ui:Button DockPanel.Dock="Right" Content="Library" Icon="{ui:SymbolIcon Library24}" Command="{Binding ShowLibraryCommand}"
                       VerticalAlignment="Center" Visibility="{Binding IsBookOpen, Converter={StaticResource BoolToVisibility}}" />
            <Image Source="{x:Static self:NovelReaderLogo.Image}" Width="32" Height="32" Margin="0,0,12,0"
                   Visibility="{Binding IsLibraryShown, Converter={StaticResource BoolToVisibility}}" />
            <!-- The open novel's cover next to its title -->
            <Grid Width="32" Height="44" Margin="0,0,12,0" DataContext="{Binding OpenBookCard}"
                  Visibility="{Binding DataContext.IsBookOpen, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}">
                <Border CornerRadius="4" Visibility="{Binding HasNoCover, Converter={StaticResource BoolToVisibility}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="{Binding CoverColorStart}" Offset="0" />
                            <GradientStop Color="{Binding CoverColorEnd}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <Border CornerRadius="4" Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Cover, Converter={x:Static self:CoverImage.Instance}}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
            <TextBlock Text="Novel Reader" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"
                       Visibility="{Binding IsLibraryShown, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding BookTitle}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IsBookOpen, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <!-- Shown while the tool is turned off -->
        <ui:InfoBar x:Name="OffBar" Grid.Row="1" Severity="Informational" IsClosable="False" IsOpen="False" Visibility="Collapsed" Margin="0,0,0,12"
                    Title="Novel Reader is turned off" Message="Your novels and names are kept. Turn Novel Reader on in its settings to read." />

        <StackPanel Grid.Row="2">
            <!-- What happened: a problem, an import -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12" Padding="12,8"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <core:RowLayout>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss"
                               Command="{Binding DismissMessageCommand}" />
                </core:RowLayout>
            </Border>

            <!-- A word was held: add it to Vocabulary, with its sentence as the note -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12" Padding="12,8" DataContext="{Binding HeldWord}"
                    Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Primary" Content="Add to Vocabulary" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddCommand}" />
                        <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss"
                                   Command="{Binding DismissCommand}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Word}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Style="{DynamicResource HelmSecondaryText}" />
                        <TextBlock Text="{Binding Result}" TextWrapping="Wrap" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Another device read further -->
        <Border Grid.Row="3" Style="{DynamicResource HelmSurface}" Margin="0,0,0,12" Padding="12,8"
                Visibility="{Binding HasRemoteProgressOffer, Converter={StaticResource BoolToVisibility}}">
            <core:RowLayout>
                <TextBlock Text="{Binding RemoteProgressOffer}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Content="Continue" Command="{Binding AcceptRemoteProgressCommand}" />
                    <ui:Button Margin="4,0,0,0" Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Stay here"
                               AutomationProperties.Name="Stay here" Command="{Binding DismissRemoteProgressCommand}" />
                </StackPanel>
            </core:RowLayout>
        </Border>

        <!-- Busy: opening, downloading, adding -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding BusyText}" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,0,4" />
            <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding BusyProgress}" />
        </StackPanel>

        <Grid x:Name="Body" Grid.Row="5">
            <!-- ================================ Library ================================ -->
            <DockPanel Visibility="{Binding IsLibraryShown, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DockPanel.Dock="Top">
                    <!-- No dictionaries yet -->
                    <ui:InfoBar Margin="0,0,0,12" Severity="Warning" IsClosable="False" IsOpen="{Binding NeedsDictionaries}"
                                Visibility="{Binding NeedsDictionaries, Converter={StaticResource BoolToVisibility}}"
                                Title="No dictionaries yet" Message="Novel Reader needs the QuickTranslator dictionaries to convert. Download them once (about 30 MB); they sync to your other devices." />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding NeedsDictionaries, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button Appearance="Primary" Content="Download dictionaries" Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Command="{Binding DownloadDictionariesCommand}" IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBool}}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding DownloadStatus}" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>

                    <!-- Add a novel -->
                    <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12" Padding="16,12">
                        <StackPanel>
                            <core:RowLayout Visibility="{Binding IsAdding, Converter={StaticResource InverseBoolToVisibility}}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Add a novel" FontWeight="SemiBold" />
                                    <TextBlock Text="A Chinese .txt file in any encoding. It is kept privately and syncs to your other devices. You can also drop the file here."
                                               Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:Button Appearance="Primary" Content="Add a novel (.txt)…" Icon="{ui:SymbolIcon DocumentAdd24}" Click="AddNovel_Click" />
                            </core:RowLayout>
                            <!-- Preview: look through what is about to be stored (below), then save it -->
                            <StackPanel Visibility="{Binding IsAdding, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Add a novel" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Visibility="{Binding IsUpdating, Converter={StaticResource InverseBoolToVisibility}}" />
                                <TextBlock Text="New chapters" FontWeight="SemiBold" Margin="0,0,0,4"
                                           Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding AddSummary}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <ui:TextBox Text="{Binding AddTitle, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Title" Margin="0,0,0,8"
                                            AutomationProperties.Name="Title" />
                                <WrapPanel>
                                    <ui:Button Appearance="Primary" Margin="0,0,8,0" Content="{Binding AddButtonText}" Icon="{ui:SymbolIcon Save24}"
                                               Command="{Binding ConfirmAddCommand}" />
                                    <ui:Button Margin="0,0,8,0" Content="Retry failed" Icon="{ui:SymbolIcon ArrowClockwise24}"
                                               ToolTip="Download the failed chapters again (the others are kept)"
                                               Command="{Binding Scraper.RetryFailedCommand, ElementName=Root}"
                                               Visibility="{Binding HasPreviewFailures, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Margin="0,0,16,0" Content="Cancel" Command="{Binding CancelAddCommand}" />
                                    <CheckBox Content="Show the Chinese" IsChecked="{Binding PreviewShowChinese}" VerticalAlignment="Center" />
                                </WrapPanel>
                                <!-- "Retry failed" running -->
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding Scraper.IsRunning, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Scraper.StatusText, ElementName=Root}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" />
                                    <ProgressBar Height="4" Margin="0,6,0,0" Minimum="0" Maximum="1" Value="{Binding Scraper.Progress, ElementName=Root}"
                                                 IsIndeterminate="{Binding Scraper.IsIndeterminate, ElementName=Root}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Scrape from web -->
                    <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12" Padding="16,12"
                            Visibility="{Binding IsAdding, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel>
                            <core:RowLayout>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Scrape from web" FontWeight="SemiBold" />
                                    <TextBlock Text="Paste a chapter-list address, or type a novel's name to look for it. Helm connects to your open browser (or opens one quietly), downloads every chapter and shows them before anything is saved."
                                               Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </core:RowLayout>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            Text="{Binding Scraper.Url, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="https://… or a novel's name" Margin="0,0,8,0"
                                            AutomationProperties.Name="Chapter list URL" />
                                <ui:Button Grid.Column="1" Appearance="Primary" Content="Auto"
                                           Icon="{ui:SymbolIcon Globe24}"
                                           Command="{Binding Scraper.AutoCommand, ElementName=Root}"
                                           IsEnabled="{Binding Scraper.IsRunning, ElementName=Root, Converter={StaticResource InverseBool}}" />
                                <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="Log in…" Icon="{ui:SymbolIcon Person24}"
                                           ToolTip="Log in to the site in an Edge window (for paid chapters, or sites that show only the first ones); later scrapes keep the login"
                                           Command="{Binding Scraper.LogInCommand, ElementName=Root}" />
                                <ui:Button Grid.Column="3" Margin="8,0,0,0" Content="Cancel"
                                           Command="{Binding Scraper.CancelCommand, ElementName=Root}"
                                           Visibility="{Binding Scraper.IsRunning, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                            <!-- Novels found by name: pick one to scrape it -->
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Scraper.Results, ElementName=Root}"
                                          Visibility="{Binding Scraper.HasResults, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,4">
                                            <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="9,4" Content="Scrape" Icon="{ui:SymbolIcon ArrowDownload24}"
                                                       Command="{Binding Scraper.PickCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                                       AutomationProperties.Name="{Binding Title, StringFormat=Scrape {0}}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Site}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- The first chapters are in: read them while the rest download -->
                            <ui:Button Margin="0,8,0,0" Appearance="Primary" Icon="{ui:SymbolIcon BookOpen24}" Content="Read now"
                                       ToolTip="Add the novel with the chapters downloaded so far and open it; the rest go into it when they are in"
                                       Command="{Binding Scraper.ReadNowCommand, ElementName=Root}"
                                       Visibility="{Binding Scraper.CanReadNow, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                            <!-- Status / progress -->
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Scraper.HasStatus, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Scraper.StatusText, ElementName=Root}"
                                           Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" />
                                <ProgressBar Height="4" Margin="0,6,0,0"
                                             IsIndeterminate="{Binding Scraper.IsIndeterminate, ElementName=Root}"
                                             Minimum="0" Maximum="1"
                                             Value="{Binding Scraper.Progress, ElementName=Root}"
                                             Visibility="{Binding Scraper.IsRunning, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding Scraper.BrowserStatus, ElementName=Root}"
                                       Style="{DynamicResource HelmSecondaryText}"
                                       Visibility="{Binding Scraper.BrowserStatus, ElementName=Root, Converter={StaticResource NotEmptyToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding IsAdding, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Your novels" Style="{DynamicResource HelmSectionHeader}" Visibility="{Binding HasBooks, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="No novels yet. Add a .txt file to start reading." Style="{DynamicResource HelmSecondaryText}" Margin="0,8,0,0"
                                   Visibility="{Binding HasNoBooks, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>

                <Grid>
                <!-- The preview: chapters (failed and locked ones marked) and the chosen one as the reader shows it -->
                <Grid Margin="0,0,0,12" Visibility="{Binding IsAdding, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox Margin="0,0,12,0" ItemsSource="{Binding PreviewChapters}" SelectedItem="{Binding SelectedPreviewChapter}"
                             VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Chapters to add">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{Binding Badge}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HelmSecondaryText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Column="1" Style="{DynamicResource HelmSurface}" Padding="20,12">
                        <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PreviewLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="FontSize" Value="20" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Chinese}" TextWrapping="Wrap" Style="{DynamicResource HelmSecondaryText}" Margin="0,2,0,0"
                                                       Visibility="{Binding HasChinese, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- One card per novel: a private folder with its text, names and progress -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,24"
                              Visibility="{Binding IsAdding, Converter={StaticResource InverseBoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Books}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A novel: its cover (a picture, or drawn from the title), what was read, and its actions. Drop a picture on it to set the cover. -->
                                <Border Style="{DynamicResource HelmSurface}" Width="400" Margin="0,0,12,12" Padding="12" AllowDrop="True"
                                        DragOver="Card_DragOver" Drop="Card_Drop">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="96" Height="136" Margin="0,0,14,0" VerticalAlignment="Top" Cursor="Hand" ToolTip="Read"
                                              MouseLeftButtonUp="Cover_Click">
                                            <Border CornerRadius="6" Visibility="{Binding HasNoCover, Converter={StaticResource BoolToVisibility}}">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                                        <GradientStop Color="{Binding CoverColorStart}" Offset="0" />
                                                        <GradientStop Color="{Binding CoverColorEnd}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="{Binding Initials}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <Border CornerRadius="6" Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}"
                                                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Cover, Converter={x:Static self:CoverImage.Instance}}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <DockPanel Grid.Column="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Visibility="{Binding IsNotRenaming, Converter={StaticResource BoolToVisibility}}" />
                                            <StackPanel Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}">
                                                <ui:TextBox Text="{Binding TitleDraft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Title" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <ui:Button Appearance="Primary" Content="Save"
                                                               Command="{Binding DataContext.SaveRenameCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                    <ui:Button Margin="8,0,0,0" Content="Cancel"
                                                               Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Names}" Style="{DynamicResource HelmSecondaryText}"
                                                       Visibility="{Binding HasNames, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                                            <!-- Its web source: new chapters found, when it was looked at, and getting them -->
                                            <DockPanel Margin="0,4,0,0" Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}">
                                                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="9,4" Icon="{ui:SymbolIcon ArrowDownload24}" Content="Continue"
                                                           VerticalAlignment="Center"
                                                           ToolTip="Continue download: new chapters (and ones that failed) from the web, shown before they are saved"
                                                           AutomationProperties.Name="Continue download"
                                                           Command="{Binding Scraper.ContinueCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding SourceStatus}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <StackPanel Margin="0,6,0,0" Visibility="{Binding IsEditingSource, Converter={StaticResource BoolToVisibility}}">
                                                <ui:TextBox Text="{Binding SourceDraft, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Chapter list on the web (https://…)"
                                                            AutomationProperties.Name="Web source" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <ui:Button Appearance="Primary" Content="Save"
                                                               Command="{Binding DataContext.SaveSourceCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                    <ui:Button Margin="8,0,0,0" Content="Cancel"
                                                               Command="{Binding DataContext.CancelEditSourceCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <DockPanel Margin="0,10,0,0">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <ui:DropDownButton Padding="7,5" Margin="0,0,2,0" Icon="{ui:SymbolIcon Image24}" ToolTip="Cover picture (or drop a picture on the card)"
                                                                       AutomationProperties.Name="Cover picture" VerticalAlignment="Center">
                                                        <ui:DropDownButton.Flyout>
                                                            <ContextMenu>
                                                                <MenuItem Header="Change cover…" Click="ChangeCover_Click" />
                                                                <MenuItem Header="Remove cover" Command="{Binding DataContext.RemoveCoverCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                          CommandParameter="{Binding}" />
                                                            </ContextMenu>
                                                        </ui:DropDownButton.Flyout>
                                                    </ui:DropDownButton>
                                                    <ui:DropDownButton Padding="7,5" Margin="0,0,2,0" Icon="{ui:SymbolIcon Globe24}" ToolTip="Web source: where new chapters come from"
                                                                       AutomationProperties.Name="Web source" VerticalAlignment="Center">
                                                        <ui:DropDownButton.Flyout>
                                                            <ContextMenu>
                                                                <MenuItem Header="Web source…"
                                                                          Command="{Binding DataContext.StartEditSourceCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="{Binding AutoCheckText}" IsEnabled="{Binding HasSource}"
                                                                          Command="{Binding DataContext.ToggleAutoCheckCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="{Binding AutoSaveText}" IsEnabled="{Binding HasSource}"
                                                                          Command="{Binding DataContext.ToggleAutoSaveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="Log in to the site…" IsEnabled="{Binding HasSource}"
                                                                          Command="{Binding Scraper.LogInCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                          CommandParameter="{Binding}" />
                                                            </ContextMenu>
                                                        </ui:DropDownButton.Flyout>
                                                    </ui:DropDownButton>
                                                    <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Rename24}" ToolTip="Rename" AutomationProperties.Name="Rename"
                                                               Command="{Binding DataContext.StartRenameCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                    <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete" AutomationProperties.Name="Delete"
                                                               Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <ui:Button Appearance="Primary" Content="Read" Icon="{ui:SymbolIcon BookOpen24}" HorizontalAlignment="Left"
                                                           Command="{Binding DataContext.OpenBookCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                            </DockPanel>
                                        </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- ================================ Reader ================================ -->
            <DockPanel Visibility="{Binding IsBookOpen, Converter={StaticResource BoolToVisibility}}">
                <!-- Chapter bar, view mode, names -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal" Style="{StaticResource BarItem}">
                        <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon ChevronLeft24}" ToolTip="Previous chapter (←)"
                                   AutomationProperties.Name="Previous chapter" Command="{Binding PreviousChapterCommand}" IsEnabled="{Binding CanGoBack}" />
                        <ComboBox x:Name="ChapterBox" Width="300" ItemsSource="{Binding Chapters}" DisplayMemberPath="Title"
                                  SelectionChanged="Chapter_SelectionChanged" AutomationProperties.Name="Chapter" />
                        <ui:Button Style="{StaticResource IconAction}" Margin="2,0,0,0" Icon="{ui:SymbolIcon ChevronRight24}" ToolTip="Next chapter (→)"
                                   AutomationProperties.Name="Next chapter" Command="{Binding NextChapterCommand}" IsEnabled="{Binding CanGoForward}" />
                        <TextBlock Text="{Binding ChapterPosition}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                    <ComboBox Margin="0,0,8,8" VerticalAlignment="Center" MinWidth="130" ItemsSource="{Binding ModeNames}" SelectedIndex="{Binding ModeIndex}"
                              ToolTip="What the page shows" AutomationProperties.Name="View" />
                    <ToggleButton Margin="0,0,8,8" VerticalAlignment="Center" IsChecked="{Binding ShowNamesPanel}" Padding="10,5" ToolTip="Names of this novel and suggested names"
                                  AutomationProperties.Name="Names">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" />
                            <TextBlock Margin="6,0,0,0" Text="Names" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Margin="0,0,8,8" VerticalAlignment="Center" IsChecked="{Binding Reports.IsPanelOpen}" Padding="10,5"
                                  ToolTip="Sentences you marked as translated wrong, as a document" AutomationProperties.Name="Wrong translations">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Flag24" />
                            <TextBlock Margin="6,0,0,0" Text="Reports" />
                        </StackPanel>
                    </ToggleButton>
                    <!-- Text size: also Ctrl + mouse wheel, Ctrl + = / Ctrl + − and Ctrl + 0 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,8" VerticalAlignment="Center">
                        <ui:Button Style="{StaticResource IconAction}" Command="{Binding ZoomOutCommand}"
                                   ToolTip="Smaller text (Ctrl + −)" AutomationProperties.Name="Smaller text" Content="A−" />
                        <TextBlock Width="26" TextAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource HelmSecondaryText}"
                                   Text="{Binding FontSize, StringFormat={}{0:0}}" ToolTip="Text size (Ctrl + 0 resets it)" />
                        <ui:Button Style="{StaticResource IconAction}" Command="{Binding ZoomInCommand}"
                                   ToolTip="Larger text (Ctrl + =)" AutomationProperties.Name="Larger text" Content="A+" />
                    </StackPanel>
                </WrapPanel>

                <ui:InfoBar DockPanel.Dock="Top" Margin="0,0,0,8" Severity="Warning" IsClosable="False" IsOpen="{Binding NeedsDictionaries}"
                            Visibility="{Binding NeedsDictionaries, Converter={StaticResource BoolToVisibility}}"
                            Title="No dictionaries yet" Message="The text is shown in Chinese. Download the dictionaries in the library or in the settings." />

                <!-- The player: like an audiobook app, always at the bottom -->
                <Border DockPanel.Dock="Bottom" Style="{DynamicResource HelmSurface}" Padding="12,8" Margin="0,8,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Previous24}" ToolTip="Previous paragraph (Alt+↑)"
                                       AutomationProperties.Name="Previous paragraph" Command="{Binding PreviousParagraphCommand}" />
                            <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Rewind24}" ToolTip="Previous sentence (Alt+←)"
                                       AutomationProperties.Name="Previous sentence" Command="{Binding PreviousSentenceCommand}" />
                            <ui:Button Appearance="Primary" Margin="4,0" Padding="14,8" Command="{Binding PlayPauseCommand}" ToolTip="Read aloud / pause (Space)"
                                       AutomationProperties.Name="Play or pause">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Play24" Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <ui:SymbolIcon Symbol="Pause24" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </ui:Button>
                            <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon FastForward24}" ToolTip="Next sentence (Alt+→)"
                                       AutomationProperties.Name="Next sentence" Command="{Binding NextSentenceCommand}" />
                            <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Next24}" ToolTip="Next paragraph (Alt+↓)"
                                       AutomationProperties.Name="Next paragraph" Command="{Binding NextParagraphCommand}" />
                            <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Stop24}" ToolTip="Stop reading aloud" AutomationProperties.Name="Stop"
                                       Command="{Binding StopReadingCommand}" Visibility="{Binding IsSpeaking, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <!-- Seek through the chapter by paragraph; the faint bar behind it is the audio ready ahead -->
                        <ProgressBar Grid.Column="1" Margin="20,0" Height="4" VerticalAlignment="Center" Opacity="0.45" IsHitTestVisible="False"
                                     Minimum="0" Maximum="{Binding PlayerParagraphMax}" Value="{Binding PlayerReady}" />
                        <Slider x:Name="SeekBar" Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Minimum="0" Maximum="{Binding PlayerParagraphMax}"
                                Value="{Binding PlayerParagraph, Mode=TwoWay}" IsMoveToPointEnabled="True" SmallChange="1" LargeChange="5"
                                IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Position in the chapter"
                                Thumb.DragCompleted="SeekBar_DragCompleted" PreviewMouseLeftButtonUp="SeekBar_MouseUp" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding PlayerPosition}" Style="{DynamicResource HelmSecondaryText}" />

                        <!-- The sentence being read (click: back to it) and the voice settings -->
                        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ui:Button Style="{StaticResource IconAction}" Content="−" ToolTip="Slower ([)" AutomationProperties.Name="Slower" Command="{Binding SlowerCommand}" />
                                <TextBlock Width="36" TextAlignment="Center" VerticalAlignment="Center" Text="{Binding SpeechRateLabel}" ToolTip="Reading speed" />
                                <ui:Button Style="{StaticResource IconAction}" Content="+" ToolTip="Faster (])" AutomationProperties.Name="Faster" Command="{Binding FasterCommand}" />
                                <ComboBox Width="150" Margin="8,0,0,0" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" DisplayMemberPath="Label"
                                          ToolTip="Voice" AutomationProperties.Name="Voice" />
                                <ComboBox Width="150" Margin="8,0,0,0" ItemsSource="{Binding SleepTimerNames}" SelectedIndex="{Binding SleepTimerIndex}"
                                          ToolTip="Sleep timer: stop reading after a while" AutomationProperties.Name="Sleep timer" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                                 Visibility="{Binding IsLoadingVoice, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding ReadyLabel}" Style="{DynamicResource HelmSecondaryText}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SleepTimerLabel}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"
                                           Visibility="{Binding HasSleepTimer, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock x:Name="CurrentSentence" Text="{Binding CurrentSentenceText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Style="{DynamicResource HelmSecondaryText}" Cursor="Hand" ToolTip="Back to the sentence being read"
                                       MouseLeftButtonUp="CurrentSentence_Click" />
                        </DockPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The chapter: click a word to fix it; double-click a sentence or use a paragraph's ▶ to read from there.
                         The text fills the width left beside the names panel, and all of it when the panel is closed. -->
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" ScrollChanged="Scroller_ScrollChanged" Focusable="True"
                                  PreviewMouseWheel="Scroller_UserScroll" PreviewMouseLeftButtonDown="Scroller_MouseDown">
                        <ItemsControl x:Name="ParagraphList" ItemsSource="{Binding Paragraphs}" Margin="0,0,16,48">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="Root" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- ▶ in the margin on hover: read from this paragraph -->
                                        <ui:Button x:Name="PlayHere" Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Play24}" VerticalAlignment="Top" Margin="0,6,0,0"
                                                   ToolTip="Read aloud from here" AutomationProperties.Name="Read aloud from here" Visibility="Hidden" Click="ReadFromHere_Click" />
                                        <Border x:Name="Frame" Grid.Column="1" CornerRadius="6" Padding="12,6" Margin="0,0,0,6" Background="Transparent"
                                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Read aloud from here" Click="ReadFromHere_Click" />
                                                    <MenuItem Header="Copy the translation" Click="CopyText_Click" />
                                                    <MenuItem Header="Copy the Chinese" Click="CopyChinese_Click" />
                                                    <MenuItem Header="Report a wrong translation…" Click="ReportParagraph_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel>
                                                <TextBlock x:Name="ResumeLabel" Text="Continue reading here" FontSize="12" Margin="0,0,0,2" Visibility="Collapsed"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <self:SegmentText x:Name="Text" Line="{Binding Line}" WordClicked="Word_Clicked" ReadFromClicked="Paragraph_ReadFromClicked"
                                                                  Highlight="{Binding SpeakingSegments}" HighlightBrush="{StaticResource SentenceFill}"
                                                                  Sentences="{Binding Sentences}"
                                                                  HoverHighlight="{Binding DataContext.HoverHighlight, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                  GrammarColors="{Binding DataContext.GrammarColors, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                  FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                  LineStackingStrategy="BlockLineHeight">
                                                    <self:SegmentText.LineHeight>
                                                        <MultiBinding Converter="{StaticResource LineHeight}">
                                                            <Binding Path="DataContext.FontSize" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                            <Binding Path="DataContext.LineSpacing" RelativeSource="{RelativeSource AncestorType=Page}" />
                                                        </MultiBinding>
                                                    </self:SegmentText.LineHeight>
                                                </self:SegmentText>
                                                <!-- Study mode: each word with its Chinese, pinyin and Hán Việt above the Vietnamese -->
                                                <self:StudyText x:Name="Study" Visibility="Collapsed" Line="{Binding Line}" Readings="{Binding Readings}"
                                                                WordClicked="Word_Clicked" ReadFromClicked="Paragraph_ReadFromClicked" WordHeld="Word_Held"
                                                                Highlight="{Binding SpeakingSegments}" HighlightBrush="{StaticResource SentenceFill}"
                                                                Sentences="{Binding Sentences}"
                                                                TextSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                ShowChinese="{Binding DataContext.StudyShowChinese, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                ShowPinyin="{Binding DataContext.StudyShowPinyin, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                ShowHanViet="{Binding DataContext.StudyShowHanViet, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                HoverHighlight="{Binding DataContext.HoverHighlight, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                GrammarColors="{Binding DataContext.GrammarColors, RelativeSource={RelativeSource AncestorType=Page}}" />
                                                <TextBlock Text="{Binding Chinese}" TextWrapping="Wrap" Margin="0,4,0,0" Style="{DynamicResource HelmSecondaryText}"
                                                           FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           Visibility="{Binding ShowChinese, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                            <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="Frame" Property="Margin" Value="0,0,0,14" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSceneBreak}" Value="True">
                                            <Setter TargetName="PlayHere" Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PlayHere" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Text" Property="IsHot" Value="True" />
                                            <Setter TargetName="Study" Property="IsHot" Value="True" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding DataContext.IsStudyMode, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                            <Setter TargetName="Text" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Study" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsResumePoint}" Value="True">
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <Setter TargetName="ResumeLabel" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSpeaking}" Value="True">
                                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource ParagraphFill}" />
                                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="ResumeLabel" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Scrolled away while listening: one click back to the sentence being read -->
                    <ui:Button Appearance="Primary" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,16"
                               Icon="{ui:SymbolIcon Location24}" Content="Back to reading position" Command="{Binding FollowReadingCommand}"
                               Visibility="{Binding ShowBackToReading, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Names panel: this novel's saved names, and names found in it -->
                    <Border Grid.Column="1" Width="340" Margin="8,0,0,24" Style="{DynamicResource HelmSurface}" Padding="12"
                            Visibility="{Binding ShowNamesPanel, Converter={StaticResource BoolToVisibility}}">
                        <TabControl>
                            <TabItem Header="Saved">
                                <DockPanel Margin="0,8,0,0">
                                    <StackPanel DockPanel.Dock="Top">
                                        <ui:TextBox Text="{Binding EntryFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search names"
                                                    Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,8" AutomationProperties.Name="Search names" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <ui:Button Content="Export…" Click="ExportBookNames_Click" />
                                            <ui:Button Margin="8,0,0,0" Content="Import…" Click="ImportBookNames_Click" />
                                        </StackPanel>
                                        <!-- Names the scan added: undo them all at once -->
                                        <ui:Button Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UndoFoundNamesCommand}"
                                                   Visibility="{Binding HasFoundNames, Converter={StaticResource BoolToVisibility}}"
                                                   ToolTip="Remove every name the scan added to this novel (the ones you edited stay)">
                                            <TextBlock Text="{Binding FoundNameCount, StringFormat=Undo found names ({0})}" />
                                        </ui:Button>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                                <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Edit24}" ToolTip="Edit" AutomationProperties.Name="Edit"
                                                                           Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}"
                                                                           Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Checkmark24}" ToolTip="Save" AutomationProperties.Name="Save"
                                                                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                                                           Command="{Binding DataContext.SaveEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete" AutomationProperties.Name="Delete"
                                                                           Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Chinese}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Vietnamese}" TextWrapping="Wrap"
                                                                           Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}" />
                                                                <ui:TextBox Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"
                                                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Meaning" />
                                                                <TextBlock Text="{Binding KindLabel}" Style="{DynamicResource HelmSecondaryText}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Suggestions">
                                <DockPanel Margin="0,8,0,0">
                                    <StackPanel DockPanel.Dock="Top">
                                        <ui:Button Content="Scan for names" Icon="{ui:SymbolIcon PeopleSearch24}" Command="{Binding FindNamesCommand}"
                                                   IsEnabled="{Binding IsFindingNames, Converter={StaticResource InverseBool}}" Margin="0,0,0,6"
                                                   ToolTip="Look through the whole novel: sure names are added, doubtful ones are listed here (how: Novel Reader settings)" />
                                        <ui:Button Content="Stop" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopNameScanCommand}" Margin="0,0,0,6"
                                                   Visibility="{Binding IsAgentScanning, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding SuggestionStatus}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Suggestions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="4,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}" Style="{DynamicResource HelmSecondaryText}" />
                                                                <TextBlock Text="{Binding Chinese}" FontWeight="SemiBold" />
                                                            </DockPanel>
                                                            <DockPanel Margin="0,4,0,0">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                    <ui:Button Style="{StaticResource IconAction}" Margin="4,0,0,0" Icon="{ui:SymbolIcon PersonAdd24}" ToolTip="Save as a name of this novel"
                                                                               AutomationProperties.Name="Save as a name"
                                                                               Command="{Binding DataContext.AddSuggestionCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                    <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Not a name" AutomationProperties.Name="Not a name"
                                                                               Command="{Binding DataContext.DismissSuggestionCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" />
                                                                </StackPanel>
                                                                <ui:TextBox Text="{Binding Vietnamese, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name" />
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <!-- Reports panel: sentences marked as translated wrong, copied or saved as one document -->
                    <Border Grid.Column="1" Width="380" Margin="8,0,0,24" Style="{DynamicResource HelmSurface}" Padding="12"
                            DataContext="{Binding Reports}" Visibility="{Binding IsPanelOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="Wrong translations" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Summary}" Style="{DynamicResource HelmSecondaryText}" Margin="0,2,0,8" />
                                <CheckBox Content="All my novels" IsChecked="{Binding ShowAllNovels}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <ui:Button Margin="0,0,8,8" Content="Copy as document" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyAllCommand}"
                                               IsEnabled="{Binding HasRows}" ToolTip="The listed reports as Markdown, to paste where the translation is improved" />
                                    <ui:Button Margin="0,0,8,8" Content="Save…" Icon="{ui:SymbolIcon Save24}" Click="ExportReports_Click" IsEnabled="{Binding HasRows}"
                                               ToolTip="Save the listed reports as a Markdown file" />
                                    <!-- Claude Code on this PC suggests the right translation of each report -->
                                    <ui:Button Margin="0,0,8,8" Icon="{ui:SymbolIcon Sparkle24}" Command="{Binding AskForRestCommand}"
                                               Visibility="{Binding CanAsk, Converter={StaticResource BoolToVisibility}}"
                                               IsEnabled="{Binding IsAsking, Converter={StaticResource InverseBool}}"
                                               ToolTip="Claude Code suggests the right translation of every listed report that has none yet (through Helm's MCP tools, on your Claude plan)">
                                        <TextBlock Text="{Binding AskLabel, StringFormat={}{0} for the rest}" />
                                    </ui:Button>
                                    <ui:Button Margin="0,0,8,8" Content="Stop" Icon="{ui:SymbolIcon Stop24}" Command="{Binding StopAskingCommand}"
                                               Visibility="{Binding IsAsking, Converter={StaticResource BoolToVisibility}}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding AskStatus}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                           Visibility="{Binding HasAskStatus, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Status}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap"
                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Style="{DynamicResource HelmSecondaryText}"
                                       Text="Click a word Helm translates wrong, then Report sentence. Each report keeps the Chinese, Helm's text and the right one."
                                       Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Edit24}" ToolTip="Edit" AutomationProperties.Name="Edit"
                                                                   Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                        <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete" AutomationProperties.Name="Delete"
                                                                   Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Where}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Chinese}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding Helm}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" TextDecorations="Strikethrough"
                                                                   Visibility="{Binding HasCorrect, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="{Binding Helm}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasCorrect, Converter={StaticResource InverseBoolToVisibility}}" />
                                                        <TextBlock Text="{Binding Correct}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap"
                                                                   Visibility="{Binding HasCorrect, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="{Binding Note}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="✓ Helm gets it right now" Foreground="{DynamicResource SystemFillColorSuccessBrush}" FontSize="12" Margin="0,2,0,0"
                                                                   Visibility="{Binding IsRightNow, Converter={StaticResource BoolToVisibility}}" />
                                                        <!-- The AI's suggestion, taken as the right translation with Use -->
                                                        <DockPanel Margin="0,4,0,0" Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisibility}}">
                                                            <ui:Button DockPanel.Dock="Right" Content="Use" Padding="8,2" VerticalAlignment="Top" Margin="6,0,0,0"
                                                                       Visibility="{Binding CanUseSuggestion, Converter={StaticResource BoolToVisibility}}"
                                                                       ToolTip="Take the suggestion as the right translation"
                                                                       Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                            <StackPanel>
                                                                <TextBlock TextWrapping="Wrap">
                                                                    <Run Text="✦ " Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /><Run Text="{Binding Suggestion, Mode=OneWay}" />
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding SuggestionNote}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Report a wrong translation: the sentence, Helm's text, the right one and a note (Ctrl+Enter saves, Esc closes) -->
                    <Grid Grid.ColumnSpan="2" Margin="0,0,0,24" Background="{DynamicResource SmokeFillColorDefaultBrush}" DataContext="{Binding Reports.Editor}"
                          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" PreviewKeyDown="ReportForm_KeyDown">
                        <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <ui:Button Style="{StaticResource IconAction}" Content="◀" ToolTip="Add the sentence before" AutomationProperties.Name="Add the sentence before"
                                                   Command="{Binding AddBeforeCommand}" IsEnabled="{Binding CanAddBefore}" />
                                        <ui:Button Style="{StaticResource IconAction}" Content="▶" ToolTip="Add the sentence after" AutomationProperties.Name="Add the sentence after"
                                                   Command="{Binding AddAfterCommand}" IsEnabled="{Binding CanAddAfter}" />
                                        <ui:Button Style="{StaticResource IconAction}" Content="−" ToolTip="One sentence less" AutomationProperties.Name="One sentence less"
                                                   Command="{Binding DropCommand}" IsEnabled="{Binding CanDrop}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBox Text="{Binding Chinese, Mode=OneWay}" IsReadOnly="True" FontSize="18" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                         AutomationProperties.Name="Chinese" />
                                <TextBlock Text="Helm shows" Style="{DynamicResource HelmSecondaryText}" Margin="0,10,0,2" />
                                <TextBox Text="{Binding Helm, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                         AutomationProperties.Name="Helm's translation" />
                                <TextBlock Text="The right translation" Style="{DynamicResource HelmSecondaryText}" Margin="0,10,0,2" />
                                <ui:TextBox x:Name="CorrectBox" Text="{Binding Correct, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="56"
                                            AutomationProperties.Name="The right translation" />
                                <TextBlock Text="Note (optional): what is wrong" Style="{DynamicResource HelmSecondaryText}" Margin="0,10,0,2" />
                                <ui:TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" PlaceholderText="道 means nói here · the 的 phrase is reversed…"
                                            AutomationProperties.Name="Note" />
                                <!-- Claude Code's suggestion: shown when it arrives, put in the box with Use it -->
                                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Use it" Margin="8,0,0,0" Command="{Binding UseSuggestionCommand}"
                                                   ToolTip="Put the suggestion in the box for the right translation" />
                                        <StackPanel>
                                            <TextBlock Text="✦ Claude Code suggests" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontSize="12" />
                                            <TextBox Text="{Binding Suggestion, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                                     AutomationProperties.Name="Suggested translation" />
                                            <TextBlock Style="{DynamicResource HelmSecondaryText}" FontSize="12" TextWrapping="Wrap">
                                                <Run Text="{Binding SuggestionNote, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ErrorKind, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock Text="{Binding AskStatus}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasAskStatus, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                <DockPanel Margin="0,14,0,0">
                                    <ui:Button DockPanel.Dock="Left" Content="Ask Claude Code" Icon="{ui:SymbolIcon Sparkle24}" Command="{Binding AskAiCommand}"
                                               Visibility="{Binding CanAsk, Converter={StaticResource BoolToVisibility}}"
                                               IsEnabled="{Binding IsAsking, Converter={StaticResource InverseBool}}"
                                               ToolTip="Saves the report and has Claude Code suggest the right translation, with what Helm got wrong" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Appearance="Primary" Content="Save report" Icon="{ui:SymbolIcon Flag24}" Command="{Binding SaveCommand}"
                                                   ToolTip="Save the report (Ctrl+Enter)" />
                                        <ui:Button Margin="8,0,0,0" Content="Cancel" Command="{Binding CloseCommand}" ToolTip="Close without saving (Esc)" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>

        <!-- The clicked word: its Chinese, Hán Việt, known meanings; save a name or a meaning -->
        <Popup x:Name="WordPopup" Grid.Row="5" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True"
               DataContext="{Binding Editor}" IsOpen="{Binding IsOpen, Mode=TwoWay}">
            <Border Width="380" Padding="14" CornerRadius="8" BorderThickness="1" Margin="8"
                    Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <ui:Button Style="{StaticResource IconAction}" Content="◀" ToolTip="One more character on the left" AutomationProperties.Name="Widen left"
                                       Command="{Binding ExtendLeftCommand}" IsEnabled="{Binding CanExtendLeft}" />
                            <ui:Button Style="{StaticResource IconAction}" Content="▶" ToolTip="One more character on the right" AutomationProperties.Name="Widen right"
                                       Command="{Binding ExtendRightCommand}" IsEnabled="{Binding CanExtendRight}" />
                            <ui:Button Style="{StaticResource IconAction}" Content="⇥" ToolTip="One character less on the left" AutomationProperties.Name="Narrow left"
                                       Command="{Binding ShrinkLeftCommand}" IsEnabled="{Binding CanShrink}" />
                            <ui:Button Style="{StaticResource IconAction}" Content="⇤" ToolTip="One character less on the right" AutomationProperties.Name="Narrow right"
                                       Command="{Binding ShrinkRightCommand}" IsEnabled="{Binding CanShrink}" />
                            <ui:Button Style="{StaticResource IconAction}" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy the Chinese" AutomationProperties.Name="Copy the Chinese"
                                       Command="{Binding CopyChineseCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Chinese}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding Pinyin}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding Pinyin, Converter={StaticResource NotEmptyToVisibility}}" />
                    <TextBlock Text="{Binding HanViet}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" Margin="0,2,0,8" />
                    <TextBlock Text="{Binding SavedAs}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Visibility="{Binding HasSaved, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Meanings}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Content="{Binding}" Padding="8,3" Margin="0,0,4,4" Appearance="Secondary"
                                           Command="{Binding DataContext.PickMeaningCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:TextBox x:Name="DraftBox" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" AutomationProperties.Name="Meaning"
                                KeyDown="DraftBox_KeyDown" />
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    <CheckBox Content="For all my novels" IsChecked="{Binding ForAllNovels}" Margin="0,0,0,8" />
                    <WrapPanel>
                        <ui:Button Appearance="Primary" Content="Save as name" Icon="{ui:SymbolIcon PersonAdd24}" Margin="0,0,6,6" Command="{Binding SaveNameCommand}"
                                   ToolTip="A name wins over the phrases around it (Enter)" />
                        <ui:Button Content="Save as meaning" Margin="0,0,6,6" Command="{Binding SavePhraseCommand}" ToolTip="The meaning of this phrase (Ctrl+Enter)" />
                        <ui:Button Content="Read from here" Icon="{ui:SymbolIcon Play24}" Margin="0,0,6,6" Command="{Binding ReadFromHereCommand}"
                                   ToolTip="Read aloud from the sentence this word is in" />
                        <ui:Button Content="Remove" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,6,6" Command="{Binding RemoveCommand}"
                                   Visibility="{Binding HasSaved, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="Report sentence" Icon="{ui:SymbolIcon Flag24}" Margin="0,0,6,6" Command="{Binding ReportSentenceCommand}"
                                   Visibility="{Binding CanReport, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="Mark the sentence this word is in as translated wrong, with the right translation" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Page>
