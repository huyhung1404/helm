<Page x:Class="Helm.Modules.NovelReader.NovelReaderContentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uiw="clr-namespace:Helm.Ui.Windows;assembly=Helm.Ui.Windows"
      ScrollViewer.CanContentScroll="False"
      Title="Novel Reader">

    <!-- Novel Reader (the library, the reader, the sheets, the settings sheet) is the shared Avalonia page,
         Helm.Modules.NovelReader.UI/NovelReaderView: the same view on every platform. This WPF page only hosts it and does
         the Windows parts (file dialogs, making a cover small, scraping the web). -->
    <uiw:AvaloniaHost x:Name="Host" />
</Page>
