<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>Helm.Modules.NovelReader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core.Windows\Helm.Core.Windows.csproj" />
    <ProjectReference Include="..\Helm.Modules.NovelReader.Core\Helm.Modules.NovelReader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ONNX Runtime's native library for the VieNeu voice (the managed API comes with Helm.Modules.NovelReader.Core). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- jieba's part-of-speech list (MIT, see Resources/word-classes.LICENSE.txt), for colouring sentences under the mouse -->
    <EmbeddedResource Include="Resources\word-classes.txt.gz" LogicalName="Helm.Modules.NovelReader.word-classes.txt.gz" />
    <None Include="Resources\word-classes.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
