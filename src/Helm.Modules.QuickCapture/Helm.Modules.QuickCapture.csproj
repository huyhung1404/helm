<Project Sdk="Microsoft.NET.Sdk">

  <!-- Quick Capture on Windows: a global shortcut opens a small box that saves a line into another tool (a note, a
       task, a debt). The targets come from the tools themselves (ICaptureTarget in Helm.Core), so this project
       references no other tool. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>Helm.Modules.QuickCapture</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core.Windows\Helm.Core.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>
