<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.NovelReader"
             xmlns:core="using:Helm.Core.Ui"
             x:Class="Helm.Modules.NovelReader.Ui.NovelSentenceSheet"
             x:DataType="vm:HeldSentenceViewModel">

    <!-- A word held down: its sentence ("Câu này") said aloud, and the held word ticked to go to Vocabulary. In
         Vietnamese. -->
    <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Spacing="2">
                <TextBlock Classes="eyebrow" Text="CÂU NÀY" />
                <SelectableTextBlock Text="{Binding Sentence}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Pinyin}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasPinyin}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="chip" VerticalAlignment="Top" Command="{Binding SayCommand}" ToolTip.Tip="Nghe câu" AutomationProperties.Name="Nghe câu">
                <ic:SymbolIcon Symbol="Speaker2" FontSize="15" />
            </Button>
            <Button x:Name="CloseButton" Grid.Column="2" Classes="chip" VerticalAlignment="Top" ToolTip.Tip="Đóng (Esc)" AutomationProperties.Name="Đóng">
                <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
            </Button>
        </Grid>

        <!-- The sentence could not be said, or its words added: why -->
        <Border Classes="glass" IsVisible="{Binding HasProblem}" BorderBrush="{DynamicResource HelmDanger}" core:Motion.EnterOnShow="True">
            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
        </Border>

        <!-- The held word: tap it to tick it -->
        <StackPanel Spacing="8" IsVisible="{Binding HasWords}">
            <TextBlock Classes="eyebrow" Text="THÊM TỪ TRONG CÂU" />
            <ItemsControl ItemsSource="{Binding Words}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SentenceWordChoice">
                        <ToggleButton Classes="chip" Height="34" Margin="0,0,6,6" Content="{Binding Label}" IsChecked="{Binding Keep}" ToolTip.Tip="{Binding Tip}"
                                      AutomationProperties.Name="{Binding Label}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{Binding AddWordsText}" Command="{Binding AddWordsCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
