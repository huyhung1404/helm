<Page
    x:Class="Helm.Modules.Workspace.WorkspaceContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.Workspace"
    Title="Workspace Controller">

    <!-- The sessions (menu and Quick access). Options live on WorkspacePage (Home → Utilities). -->
    <Page.Resources>
        <DataTemplate x:Key="SessionItem" DataType="{x:Type local:SessionRow}">
            <DockPanel Margin="0,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Updated}" Style="{DynamicResource HelmSecondaryText}" Margin="8,0,0,0" />
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                 Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource SystemFillColorCautionBrush}"
                                 Visibility="{Binding NeedsYou, Converter={StaticResource BoolToVisibility}}" />
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                 Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding StateText}" Style="{DynamicResource HelmSecondaryText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Workspace Controller" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ui:InfoBar x:Name="OffBar" Grid.Row="1" Title="Workspace Controller is turned off" Severity="Informational" IsClosable="False"
                    Message="Turn it on in Home → Utilities to see your Claude sessions." Margin="0,0,0,12" />

        <!-- This PC -->
        <ui:CardControl Grid.Row="2" Margin="0,0,0,12" Icon="{ui:SymbolIcon Desktop24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="{Binding MachineName}" Description="{Binding ListeningText}" />
            </ui:CardControl.Header>
            <TextBlock Text="{Binding BridgeText}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Right" />
        </ui:CardControl>

        <Grid x:Name="Body" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Windows and their sessions -->
            <Border Style="{DynamicResource HelmSurface}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="No VS Code window is connected yet. Open VS Code: Helm Bridge connects it by itself."
                                   Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap"
                                   Visibility="{Binding HasWindows, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Windows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:WindowRow}">
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Folders}" Style="{DynamicResource HelmSecondaryText}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="No Claude session yet." Style="{DynamicResource HelmSecondaryText}" Margin="0,4,0,0"
                                                   Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <ListBox ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionItem}" Margin="0,4,0,0"
                                                 SelectedItem="{Binding DataContext.SelectedSession, RelativeSource={RelativeSource AncestorType=Page}}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="List_PreviewMouseWheel" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding HasOtherSessions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Elsewhere" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Sessions outside VS Code: Helm sees them but cannot type into them." Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" />
                            <ListBox ItemsSource="{Binding OtherSessions}" ItemTemplate="{StaticResource SessionItem}" Margin="0,4,0,0"
                                     SelectedItem="{Binding SelectedSession}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseWheel="List_PreviewMouseWheel" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- The selected session and the composer -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{DynamicResource HelmSurface}">
                    <Grid Margin="16">
                        <TextBlock Text="Pick a session on the left to read what Claude answered, or start a new one below."
                                   Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                        <DockPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="{Binding SelectedSession.Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedSession.StateText}" Style="{DynamicResource HelmSecondaryText}" />
                                <TextBlock Text="{Binding SelectedSession.Folder}" Style="{DynamicResource HelmSecondaryText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="You asked" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <TextBox Text="{Binding SelectedSession.LastPrompt, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Last prompt" />
                                <TextBlock Text="Claude answered" FontWeight="SemiBold" Margin="0,12,0,4" />
                            </StackPanel>
                            <TextBox Text="{Binding SelectedSession.LastReply, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="14"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Last answer" />
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- Composer -->
                <Border Grid.Row="1" Style="{DynamicResource HelmSurface}" Margin="0,12,0,0">
                    <StackPanel Margin="16">
                        <ui:TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                    MinHeight="72" MaxHeight="200" VerticalScrollBarVisibility="Auto" FontSize="14"
                                    PlaceholderText="The next task for Claude" AutomationProperties.Name="Prompt" />
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button Appearance="Primary" Content="Send to this session" Icon="{ui:SymbolIcon Send24}" Margin="0,0,16,8"
                                       Command="{Binding SendCommand}" />
                            <TextBlock Text="or start a new session in" VerticalAlignment="Center" Margin="0,0,8,8" />
                            <ComboBox Width="160" Margin="0,0,8,8" ItemsSource="{Binding Windows}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding NewSessionWindow}" AutomationProperties.Name="Window for a new session" />
                            <ComboBox Width="110" Margin="0,0,8,8" ItemsSource="{Binding Models}" SelectedItem="{Binding NewSessionModel}"
                                      AutomationProperties.Name="Model for a new session" />
                            <ui:Button Content="Start" Icon="{ui:SymbolIcon Add24}" Margin="0,0,0,8" Command="{Binding StartSessionCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding SendStatus}" TextWrapping="Wrap" Style="{DynamicResource HelmSecondaryText}"
                                   Visibility="{Binding SendStatus, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
