<core:ModulePageBase
    x:Class="Helm.Modules.Workspace.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.Workspace"
    Module="{Binding Module}">

    <!-- The PC side manages what is connected (VS Code windows today, Unity and other apps later); the phone is
         where you steer the sessions. -->
    <core:ModulePageBase.Resources>
        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type local:SessionRow}">
            <Border Style="{DynamicResource HelmExpanderRow}" Padding="80,8,16,8">
                <core:CardHeader Title="{Binding Title}" Description="{Binding Detail}" />
            </Border>
        </DataTemplate>
    </core:ModulePageBase.Resources>

    <StackPanel>
        <!-- Host -->
        <TextBlock Text="Host" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Desktop24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="This PC" Description="{Binding ListeningText}" />
            </ui:CardControl.Header>
        </ui:CardControl>

        <!-- VS Code -->
        <TextBlock Text="VS Code" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardExpander Margin="0,0,0,4" IsExpanded="True" Icon="{ui:SymbolIcon WindowConsole20}" IsEnabled="{Binding IsRunning}">
            <ui:CardExpander.Header>
                <core:CardHeader Title="Connected windows" Description="{Binding SessionsText}" />
            </ui:CardExpander.Header>
            <StackPanel>
                <TextBlock Text="No VS Code window is connected. Open VS Code: Helm Bridge connects each window by itself."
                           Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" Margin="0,4"
                           Visibility="{Binding HasVsCodeWindows, Converter={StaticResource InverseBoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding VsCodeWindows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:HostWindowRow}">
                            <StackPanel>
                                <Border Style="{DynamicResource HelmExpanderRow}">
                                    <core:CardHeader Title="{Binding Name}" Description="{Binding Detail}" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:CardExpander>
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Window24}">
            <ui:CardExpander.Header>
                <core:RowLayout>
                    <core:CardHeader Title="Helm Bridge for VS Code" Description="A small extension that lets Helm open a Claude tab and type into it. Helm installs and updates it." />
                    <ui:ToggleSwitch Margin="0,0,16,0" IsChecked="{Binding ManageBridgeExtension}" AutomationProperties.Name="Install Helm Bridge" />
                </core:RowLayout>
            </ui:CardExpander.Header>
            <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                <core:RowLayout>
                    <core:CardHeader Title="Status" Description="{Binding BridgeText}" />
                    <ui:Button Content="Install again" Command="{Binding InstallBridgeCommand}" />
                </core:RowLayout>
            </Border>
        </ui:CardExpander>

        <!-- Claude Code -->
        <TextBlock Text="Claude Code" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon PlugConnected24}">
            <ui:CardExpander.Header>
                <core:RowLayout>
                    <core:CardHeader Title="Claude Code hooks" Description="Claude Code tells Helm when a session starts, works, needs you or finishes. Off removes Helm's hooks." />
                    <ui:ToggleSwitch Margin="0,0,16,0" IsChecked="{Binding ManageClaudeHooks}" AutomationProperties.Name="Manage Claude Code hooks" />
                </core:RowLayout>
            </ui:CardExpander.Header>
            <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                <core:RowLayout>
                    <core:CardHeader Title="Status" Description="{Binding HooksText}" />
                    <ui:Button Content="Install again" Command="{Binding InstallHooksCommand}" IsEnabled="{Binding IsRunning}" />
                </core:RowLayout>
            </Border>
        </ui:CardExpander>
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Chat24}"
                         Visibility="{Binding HasOtherSessions, Converter={StaticResource BoolToVisibility}}">
            <ui:CardExpander.Header>
                <core:CardHeader Title="Sessions outside VS Code" Description="Claude sessions in a terminal or another editor: Helm sees them but cannot type into them." />
            </ui:CardExpander.Header>
            <ItemsControl ItemsSource="{Binding OtherSessions}" ItemTemplate="{StaticResource SessionTemplate}" />
        </ui:CardExpander>
    </StackPanel>
</core:ModulePageBase>
