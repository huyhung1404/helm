<core:ModulePageBase
    x:Class="Helm.Modules.Workspace.WorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.Workspace"
    Module="{Binding Module}">

    <!-- Workspace Controller's settings (Home → Utilities). What is connected is on WorkspaceContentPage. -->
    <StackPanel>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:ImageIcon Width="24" Height="24" Source="{x:Static local:WorkspaceLogo.Image}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <core:CardHeader Title="Open Workspace Controller" Description="The VS Code windows connected to this PC and their Claude sessions. Also in the menu and on Home." />
            </ui:CardControl.Header>
            <ui:Button Appearance="Primary" Content="Open Workspace Controller" Click="Open_Click" />
        </ui:CardControl>

        <!-- Claude Code -->
        <TextBlock Text="Claude Code" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon LinkSquare24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Connect new sessions" Description="A new Claude session is shared with your phone right away. Off: you connect each one (or a whole window) on the Workspace Controller page." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding ConnectNewSessions}" AutomationProperties.Name="Connect new sessions" />
        </ui:CardControl>
        <ui:CardExpander Margin="0,0,0,4" IsExpanded="True" Icon="{ui:SymbolIcon ShieldCheckmark24}">
            <ui:CardExpander.Header>
                <core:RowLayout>
                    <core:CardHeader Title="Approve from your phone"
                                     Description="When Claude asks to run a tool or asks you a question, the request waits for your phone instead of VS Code. If the phone does not answer in time, VS Code asks as usual." />
                    <ComboBox Width="240" Margin="0,0,16,0" ItemsSource="{Binding ApprovalChoices}" SelectedItem="{Binding ApproveFromPhone}"
                              AutomationProperties.Name="Approve from your phone" />
                </core:RowLayout>
            </ui:CardExpander.Header>
            <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                <core:RowLayout>
                    <core:CardHeader Title="Away after" Description="Minutes without keyboard or mouse on this PC. Helm's own typing does not count; using the PC while a request waits hands it back to VS Code." />
                    <ComboBox Width="120" ItemsSource="{Binding AwayChoices}" SelectedItem="{Binding AwayAfterMinutes}" AutomationProperties.Name="Away after minutes" />
                </core:RowLayout>
            </Border>
        </ui:CardExpander>
        <ui:CardExpander Margin="0,0,0,4" IsExpanded="True" Icon="{ui:SymbolIcon PlugConnected24}">
            <ui:CardExpander.Header>
                <core:RowLayout>
                    <core:CardHeader Title="Claude Code hooks" Description="Claude Code tells Helm when a session starts, works, needs you or finishes. Off removes Helm's hooks." />
                    <ui:ToggleSwitch Margin="0,0,16,0" IsChecked="{Binding ManageClaudeHooks}" AutomationProperties.Name="Manage Claude Code hooks" />
                </core:RowLayout>
            </ui:CardExpander.Header>
            <StackPanel>
                <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                    <core:RowLayout>
                        <core:CardHeader Title="Status" Description="{Binding HooksText}" />
                        <ui:Button Content="Install again" Command="{Binding InstallHooksCommand}" IsEnabled="{Binding IsRunning}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:CardHeader Title="Listening" Description="{Binding ListeningText}" />
                </Border>
            </StackPanel>
        </ui:CardExpander>

        <!-- VS Code -->
        <TextBlock Text="VS Code" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardExpander Margin="0,0,0,4" IsExpanded="True" Icon="{ui:SymbolIcon Window24}">
            <ui:CardExpander.Header>
                <core:RowLayout>
                    <core:CardHeader Title="Helm Bridge for VS Code" Description="A small extension that lets Helm open a Claude tab and type into it. Helm installs and updates it." />
                    <ui:ToggleSwitch Margin="0,0,16,0" IsChecked="{Binding ManageBridgeExtension}" AutomationProperties.Name="Install Helm Bridge" />
                </core:RowLayout>
            </ui:CardExpander.Header>
            <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                <core:RowLayout>
                    <core:CardHeader Title="Status" Description="{Binding BridgeText}" />
                    <ui:Button Content="Install again" Command="{Binding InstallBridgeCommand}" />
                </core:RowLayout>
            </Border>
        </ui:CardExpander>
    </StackPanel>
</core:ModulePageBase>
