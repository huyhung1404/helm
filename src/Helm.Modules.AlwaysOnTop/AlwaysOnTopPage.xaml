<Page x:Class="Helm.Modules.AlwaysOnTop.AlwaysOnTopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uiw="clr-namespace:Helm.Ui.Windows;assembly=Helm.Ui.Windows"
      ScrollViewer.CanContentScroll="False"
      Title="Always On Top">

    <!-- Always On Top (on/off, the shortcut, the border, the windows on top now, the excluded apps) is the shared Avalonia
         page, Helm.Modules.AlwaysOnTop.UI/AlwaysOnTopView. This WPF page only hosts it. -->
    <uiw:AvaloniaHost x:Name="Host" />
</Page>
