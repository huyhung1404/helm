<Project Sdk="Microsoft.NET.Sdk">

  <!-- See one shared page at a time without building Helm: the real view over fake data, at phone / tablet / PC width,
       light or dark, with hot reload (save an .axaml and the open page updates). Run: scripts/gallery.cmd.
       Built by CI with the solution; never shipped. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Gallery</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
  </ItemGroup>

  <!-- Hot reload, Debug only. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="HotAvalonia" Version="3.1.5" PrivateAssets="All" Publish="True" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Ui\Helm.Ui.csproj" />
    <ProjectReference Include="..\Helm.Modules.Tracker.UI\Helm.Modules.Tracker.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.Vault.UI\Helm.Modules.Vault.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.Notes.UI\Helm.Modules.Notes.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.Scratch.UI\Helm.Modules.Scratch.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.Habits.UI\Helm.Modules.Habits.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.Missions.UI\Helm.Modules.Missions.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.SlackBot.UI\Helm.Modules.SlackBot.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.WindowZones.UI\Helm.Modules.WindowZones.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.Keyboard.UI\Helm.Modules.Keyboard.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.QuickCapture.UI\Helm.Modules.QuickCapture.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.NovelReader.UI\Helm.Modules.NovelReader.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.Ssh.UI\Helm.Modules.Ssh.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.Vocab.UI\Helm.Modules.Vocab.UI.csproj" />
    <ProjectReference Include="..\Helm.Modules.Wallet.UI\Helm.Modules.Wallet.UI.csproj" />
    <ProjectReference Include="..\Helm.Shell.UI\Helm.Shell.UI.csproj" />
    <ProjectReference Include="..\Helm.ToolIcons\Helm.ToolIcons.csproj" />
  </ItemGroup>

</Project>
