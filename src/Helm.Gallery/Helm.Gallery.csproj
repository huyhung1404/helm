<Project Sdk="Microsoft.NET.Sdk">

  <!-- See one shared page at a time without building Helm: the real view + the real view model over in-memory data.
       Not part of Helm.sln or any release. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Gallery</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
  </ItemGroup>

  <!-- Hot reload: save an .axaml file and the open Gallery page updates. Debug only. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="HotAvalonia" Version="3.1.5" PrivateAssets="All" Publish="True" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Helm.Ui.Windows\InputLog.cs" Link="InputLog.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Ui\Helm.Ui.csproj" />
    <ProjectReference Include="..\Helm.Modules.Tracker.UI\Helm.Modules.Tracker.UI.csproj" />
  </ItemGroup>

</Project>
