<Page x:Class="Helm.Modules.Scratch.ScratchContentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uiw="clr-namespace:Helm.Ui.Windows;assembly=Helm.Ui.Windows"
      ScrollViewer.CanContentScroll="False"
      Title="Scratch">

    <!-- Scratch (the wall of cards, the keyboard, the settings sheet) is the shared Avalonia page, Helm.Modules.Scratch.UI/ScratchView:
         the same view on every platform. This WPF page only hosts it and does the Windows parts (the clipboard, files dropped on it). -->
    <uiw:AvaloniaHost x:Name="Host" />
</Page>
