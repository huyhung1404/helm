<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Vocabulary page, ONE view for every platform (Windows through Helm.Ui.Windows, Android, later macOS/iOS):
       Learn (the guessing card and its answer bar), Words (add, what waits for the agent, the list, a word's page with
       its tree), Roots (families, root practice), and the sheets (settings, analysis, add text, edit, a new analysis,
       the card's menu). What differs per platform (the pop-up's own settings, the phone's menu, where else words are
       added) comes through IVocabPageHost. The PC's corner card is here too (VocabPopupCard; its window is in
       Helm.Modules.Vocab); the Android overlay is not: it is drawn with Android views. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Modules.Vocab.Ui</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Ui\Helm.Ui.csproj" />
    <ProjectReference Include="..\Helm.Modules.Vocab.Core\Helm.Modules.Vocab.Core.csproj" />
  </ItemGroup>

</Project>
