<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Vocab"
             x:Class="Helm.Modules.Vocab.Ui.VocabAnswerBar"
             x:DataType="vm:VocabViewModel">

    <!-- The answer bar at the foot of the page, over the scrolling card, always in reach (a thumb on a phone, the keys on
         a PC): Skip and Show the answer before it; Forgot and Remembered after it, each saying when the word comes back.
         In root practice: Stop, then Show the meaning or Next root. -->
    <Border x:Name="Bar" Background="{DynamicResource HelmSheetBackground}" BorderBrush="{DynamicResource HelmGlassStroke}" BorderThickness="1"
            CornerRadius="16" Padding="10" BoxShadow="{DynamicResource HelmLiftShadow}">
        <Panel>
            <!-- Before the answer -->
            <Grid x:Name="AskRow" ColumnDefinitions="*,2*" ColumnSpacing="10" DataContext="{Binding Card}" x:DataType="vm:VocabCardViewModel">
                <Button Classes="ghost" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding SkipCommand}" ToolTip.Tip="Another word, without answering this one (S)"
                        AutomationProperties.Name="Skip">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="Next" FontSize="16" />
                        <TextBlock Text="Skip" VerticalAlignment="Center" />
                        <Border Classes="kbd"><TextBlock Text="S" /></Border>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="pill" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding RevealCommand}" AutomationProperties.Name="Show the answer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Show the answer" Foreground="{DynamicResource HelmPillForeground}" VerticalAlignment="Center" />
                        <Border Classes="kbd" BorderBrush="{DynamicResource HelmPillForeground}"><TextBlock Text="Space" Foreground="{DynamicResource HelmPillForeground}" /></Border>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- After it: the user's own verdict, and when the word comes back -->
            <Grid x:Name="AnswerRow" ColumnDefinitions="*,*" ColumnSpacing="10" DataContext="{Binding Card}" x:DataType="vm:VocabCardViewModel">
                <Button Classes="ghost" Classes.suggest="{Binding SuggestsForgot}" HorizontalAlignment="Stretch" MinHeight="52" Padding="10,6"
                        Command="{Binding ForgotCommand}" AutomationProperties.Name="{Binding ForgotText}">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <ic:SymbolIcon Symbol="DismissCircle" FontSize="16" Foreground="{DynamicResource HelmDanger}" />
                            <TextBlock Text="{Binding ForgotText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Classes="kbd"><TextBlock Text="1" /></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ForgotHint}" Classes="muted" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="pill" HorizontalAlignment="Stretch" MinHeight="52" Padding="10,6" Command="{Binding RememberedCommand}"
                        AutomationProperties.Name="{Binding RememberedText}">
                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="16" Foreground="{DynamicResource HelmPillForeground}" />
                            <TextBlock Text="{Binding RememberedText}" Foreground="{DynamicResource HelmPillForeground}" VerticalAlignment="Center" />
                            <Border Classes="kbd" BorderBrush="{DynamicResource HelmPillForeground}"><TextBlock Text="2" Foreground="{DynamicResource HelmPillForeground}" /></Border>
                        </StackPanel>
                        <TextBlock Text="{Binding RememberedHint}" FontSize="12" FontWeight="Normal" Opacity="0.75" Foreground="{DynamicResource HelmPillForeground}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Root practice -->
            <Grid x:Name="PracticeRow" ColumnDefinitions="*,2*" ColumnSpacing="10" DataContext="{Binding Roots}" x:DataType="vm:VocabRootsViewModel">
                <Button Classes="ghost" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding ClosePracticeCommand}" AutomationProperties.Name="Stop practising">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Stop" VerticalAlignment="Center" />
                        <Border Classes="kbd"><TextBlock Text="Esc" /></Border>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="pill" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding RevealRootCommand}" IsVisible="{Binding !IsPracticeRevealed}"
                        AutomationProperties.Name="Show the meaning">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Show the meaning" Foreground="{DynamicResource HelmPillForeground}" VerticalAlignment="Center" />
                        <Border Classes="kbd" BorderBrush="{DynamicResource HelmPillForeground}"><TextBlock Text="Space" Foreground="{DynamicResource HelmPillForeground}" /></Border>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="pill" HorizontalAlignment="Stretch" MinHeight="48" Command="{Binding NextRootCommand}" IsVisible="{Binding IsPracticeRevealed}"
                        AutomationProperties.Name="Next root">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Next root" Foreground="{DynamicResource HelmPillForeground}" VerticalAlignment="Center" />
                        <Border Classes="kbd" BorderBrush="{DynamicResource HelmPillForeground}"><TextBlock Text="Space" Foreground="{DynamicResource HelmPillForeground}" /></Border>
                    </StackPanel>
                </Button>
            </Grid>
        </Panel>
    </Border>
</UserControl>
