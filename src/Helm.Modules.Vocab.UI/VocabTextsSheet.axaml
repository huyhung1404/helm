<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Vocab"
             xmlns:core="using:Helm.Core.Ui"
             x:Class="Helm.Modules.Vocab.Ui.VocabTextsSheet"
             x:DataType="vm:VocabViewModel">

    <!-- Learn words from a text (song lyrics, an article): paste it, an AI agent proposes the words worth learning, keep
         the ones you want and add them. The list (paste form, texts pasted before) or one text (waiting for the agent,
         or its proposed words, then the text itself). -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Helm.Modules.Vocab.UI/VocabStyles.axaml" />
    </UserControl.Styles>

    <StackPanel Spacing="14" DataContext="{Binding Texts}" x:DataType="vm:VocabTextsViewModel">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Classes="chip" Margin="0,0,10,0" VerticalAlignment="Top" Command="{Binding BackCommand}" IsVisible="{Binding IsDetailOpen}"
                    ToolTip.Tip="Back to your texts" AutomationProperties.Name="Back to your texts">
                <ic:SymbolIcon Symbol="ArrowLeft" FontSize="14" />
            </Button>
            <StackPanel Grid.Column="1">
                <TextBlock Classes="eyebrow" Text="ADD TEXT" />
                <TextBlock Text="Learn words from a text" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding IsListOpen}" />
                <TextBlock Text="{Binding DetailTitle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding IsDetailOpen}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="chip" VerticalAlignment="Top" Command="{Binding CloseCommand}" ToolTip.Tip="Close" AutomationProperties.Name="Close">
                <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
            </Button>
        </Grid>

        <Border Classes="glass" IsVisible="{Binding HasMessage}" core:Motion.EnterOnShow="True">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <!-- ===== The paste form, then the texts pasted before ===== -->
        <StackPanel Spacing="14" IsVisible="{Binding IsListOpen}">
            <StackPanel Spacing="6">
                <TextBlock Text="Where it comes from (optional)" />
                <TextBox x:Name="TitleBox" Classes="glass" PlaceholderText="A song and its singer, a chapter, a page…" Text="{Binding NewTitle}"
                         AutomationProperties.Name="Where the text comes from" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Text" />
                <TextBox Classes="glass" PlaceholderText="Paste the lyrics or the article here — English or Chinese" Text="{Binding NewBody}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="150" MaxHeight="280" VerticalContentAlignment="Top" Padding="12,10" AutomationProperties.Name="Text to learn words from" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="An AI agent reads it, turns Chinese into simplified characters and picks the words worth learning. You choose which to keep before any is analyzed." />
            </StackPanel>
            <Button Classes="pill" HorizontalAlignment="Stretch" Command="{Binding AddTextCommand}" AutomationProperties.Name="Add text">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon Symbol="Add" FontSize="16" Foreground="{DynamicResource HelmPillForeground}" />
                    <TextBlock Text="Add text" Foreground="{DynamicResource HelmPillForeground}" />
                </StackPanel>
            </Button>

            <StackPanel Spacing="8" IsVisible="{Binding HasTexts}">
                <TextBlock Classes="head" Text="Your texts" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding Texts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VocabSourceRow">
                            <Border Classes="glass lift" Padding="14,8,8,8" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Button Classes="rowhit" Padding="0" Command="{Binding Open}" AutomationProperties.Name="{Binding Title}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Status}" Classes="secondary" Margin="0,2,0,0" Classes.accent="{Binding IsWaiting}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Classes="chip" Margin="8,0,0,0" Command="{Binding Remove}" ToolTip.Tip="Remove this text (the words already added stay)"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Remove {0}'}">
                                        <ic:SymbolIcon Symbol="Delete" FontSize="14" Foreground="{DynamicResource HelmDanger}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- ===== One text: waiting, or its proposed words ===== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsDetailOpen}">
            <Border Classes="inset" IsVisible="{Binding IsDetailWaiting}">
                <StackPanel Spacing="8" DataContext="{Binding $parent[UserControl].((vm:VocabViewModel)DataContext)}" x:DataType="vm:VocabViewModel">
                    <Grid ColumnDefinitions="Auto,*">
                        <Panel Width="22" Margin="0,1,10,0" VerticalAlignment="Top">
                            <ic:SymbolIcon Symbol="ArrowSync" Classes="spin" FontSize="18" Foreground="{DynamicResource HelmEyebrow}" IsVisible="{Binding IsAgentBusy}" />
                            <ic:SymbolIcon Symbol="HourglassHalf" FontSize="18" Foreground="{DynamicResource HelmEyebrow}" IsVisible="{Binding !IsAgentBusy}" />
                        </Panel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="An AI agent is reading it" IsVisible="{Binding IsAgentBusy}" />
                            <TextBlock TextWrapping="Wrap" IsVisible="{Binding !IsAgentBusy}"
                                       Text="Waiting for an AI agent connected to Helm's MCP tools to pick the words." />
                        </StackPanel>
                    </Grid>
                    <Button Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding OpenAgentCommand}" Content="See what waits"
                            ToolTip.Tip="Analysis: what waits for the agent, and its request" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding HasProposals}">
                <TextBlock Classes="head" Text="Words to look at" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="chip" MinHeight="32" Content="All" Command="{Binding SelectAllCommand}" AutomationProperties.Name="Tick every new word" />
                <Button Grid.Column="2" Classes="chip" MinHeight="32" Content="None" Command="{Binding SelectNoneCommand}" AutomationProperties.Name="Untick every word" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Proposals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VocabProposalRow">
                        <Border Classes="glass" Padding="10,8,12,10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <CheckBox IsChecked="{Binding IsChosen, Mode=TwoWay}" IsEnabled="{Binding CanTick}" MinWidth="0" VerticalAlignment="Top" Margin="0,2,0,0"
                                          AutomationProperties.Name="{Binding Word, StringFormat='Add {0}'}" />
                                <StackPanel Grid.Column="1" Margin="2,6,0,0" Spacing="2">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding Word}" FontSize="16" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Bottom" />
                                        <TextBlock Text="{Binding Phonetic}" Classes="secondary" FontSize="13" VerticalAlignment="Bottom" IsVisible="{Binding HasPhonetic}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Sentence}" Classes="secondary" FontStyle="Italic" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Reason}" Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding HasReason}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,6,0,0">
                                    <Border Classes="tag ok" Margin="0" IsVisible="{Binding IsAdded}"><TextBlock Text="Added" /></Border>
                                    <Border Classes="tag mute" Margin="0" IsVisible="{Binding AlreadyThere}"><TextBlock Text="Already yours" /></Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="pill" HorizontalAlignment="Stretch" Command="{Binding AddSelectedCommand}" IsVisible="{Binding HasProposals}"
                    AutomationProperties.Name="{Binding AddSelectedText}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon Symbol="Checkmark" FontSize="16" Foreground="{DynamicResource HelmPillForeground}" />
                    <TextBlock Text="{Binding AddSelectedText}" Foreground="{DynamicResource HelmPillForeground}" />
                </StackPanel>
            </Button>

            <StackPanel Spacing="6" Margin="0,6,0,0">
                <TextBlock Classes="head" Text="The text" />
                <TextBlock Text="{Binding DetailBody}" TextWrapping="Wrap" LineHeight="22" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
