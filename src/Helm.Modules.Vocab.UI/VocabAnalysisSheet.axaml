<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Vocab"
             x:Class="Helm.Modules.Vocab.Ui.VocabAnalysisSheet"
             x:DataType="vm:VocabViewModel">

    <!-- What waits for an AI agent connected to Helm's MCP tools (the waiting card's Details, the top bar's agent chip):
         whether one is at work, the words waiting with ✕, what else is on its list, and the request to paste into an
         agent by hand. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Helm.Modules.Vocab.UI/VocabStyles.axaml" />
    </UserControl.Styles>

    <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Classes="eyebrow" Text="ANALYSIS" />
                <TextBlock Text="{Binding AgentChipText}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="1" Classes="chip" VerticalAlignment="Top" ToolTip.Tip="Close" AutomationProperties.Name="Close">
                <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
            </Button>
        </Grid>

        <!-- The agent: at work now, or waited for -->
        <Border Classes="glass">
            <Grid ColumnDefinitions="Auto,*">
                <Panel Width="22" Margin="0,1,10,0" VerticalAlignment="Top">
                    <ic:SymbolIcon Symbol="ArrowSync" Classes="spin" FontSize="18" Foreground="{DynamicResource HelmEyebrow}" IsVisible="{Binding IsAgentBusy}" />
                    <ic:SymbolIcon Symbol="Bot" FontSize="18" Foreground="{DynamicResource HelmEyebrow}" IsVisible="{Binding !IsAgentBusy}" />
                </Panel>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Classes="head" TextWrapping="Wrap" Text="An AI agent is working on your words" IsVisible="{Binding IsAgentBusy}" />
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               Text="An AI agent connected to Helm's MCP tools breaks new words into parts, writes new ways to remember the words you keep forgetting, and fills in missing details. What it writes comes here through sync." />
                </StackPanel>
            </Grid>
        </Border>

        <Border Classes="glass" IsVisible="{Binding HasMessage}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>

        <!-- The words waiting to be broken down -->
        <Border Classes="glass">
            <StackPanel Spacing="8">
                <TextBlock Classes="head" Text="{Binding PendingCount, StringFormat='Waiting to be broken down ({0})'}" />
                <TextBlock Classes="secondary" Text="Nothing waits. New words land here." IsVisible="{Binding !HasPending}" />
                <ItemsControl ItemsSource="{Binding PendingWords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:VocabWordRow">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Note}" Classes="secondary" IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="chip" Command="{Binding Remove}" IsVisible="{Binding CanRemove}" ToolTip.Tip="Remove (a typo, or not worth learning)"
                                        AutomationProperties.Name="{Binding Text, StringFormat='Remove {0}'}">
                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- What else is on its list -->
        <Border x:Name="OthersCard" Classes="glass">
            <StackPanel Spacing="6">
                <TextBlock Classes="head" Text="Also on its list" />
                <ItemsControl x:Name="OthersList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                <Ellipse Width="5" Height="5" Margin="2,8,10,0" Fill="{DynamicResource HelmEyebrow}" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Classes="ghost" HorizontalAlignment="Stretch" Command="{Binding CopyPromptCommand}" ToolTip.Tip="Paste it into an AI agent yourself"
                    AutomationProperties.Name="Copy request">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:SymbolIcon Symbol="Copy" FontSize="14" />
                    <TextBlock Text="Copy request" />
                </StackPanel>
            </Button>
            <Button x:Name="DoneButton" Grid.Column="1" Classes="pill" HorizontalAlignment="Stretch" Content="Done" />
        </Grid>
    </StackPanel>
</UserControl>
