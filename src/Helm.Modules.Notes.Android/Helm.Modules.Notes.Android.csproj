<Project Sdk="Microsoft.NET.Sdk">

  <!-- Notes on Android: the module and its Avalonia pages. The logic and the view model come from
       Helm.Modules.Notes.Core (shared with Windows). Not in Helm.sln; CI builds it with the app. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- Same namespace as the Windows project. Never a namespace ending in ".Android": it would hide the
         Android.* SDK namespaces inside this project. -->
    <RootNamespace>Helm.Modules.Notes</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- The Android SDK's implicit usings clash with Avalonia/BCL names (Application, OperationCanceledException). -->
  <ItemGroup>
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
    <Using Remove="Android.OS.Bundle" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.343" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- ONNX Runtime's native library for the search model (the managed API comes with Helm.Embeddings). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core.Android\Helm.Core.Android.csproj" />
    <ProjectReference Include="..\Helm.Modules.Notes.Core\Helm.Modules.Notes.Core.csproj" />
  </ItemGroup>

</Project>
