<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Vocab"
             xmlns:local="using:Helm.Modules.Vocab"
             x:Class="Helm.Modules.Vocab.VocabContentPage"
             x:DataType="vm:VocabViewModel">

    <!-- Vocabulary itself (drawer and Quick access). It fills the page area (IFullPage): its own app bar (the menu,
         Analysis and +; or back, Previous, Next and ⋯ on a word's or a root's page), the Learn · Words · Roots tabs, the
         content scrolling between them and, on Learn and in root practice, the answer bar in thumb reach. Adding words,
         the analysis, menus and editing are bottom sheets (VocabSheets). Its options live on VocabPage (Home → Utilities). -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Helm.Modules.Vocab.Android/VocabStyles.axaml" />
    </UserControl.Styles>

    <Panel x:Name="Root">
        <DockPanel>
            <!-- ===== App bar ===== -->
            <Panel DockPanel.Dock="Top" Height="56" Background="{DynamicResource HelmBarBackground}">
                <!-- The tool's own -->
                <Grid x:Name="HomeBar" ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,0">
                    <Button Classes="icon" Click="Menu_Click" AutomationProperties.Name="Open navigation">
                        <ic:SymbolIcon Symbol="Navigation" FontSize="22" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="Vocabulary" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="AnalysisButton" Grid.Column="2" Classes="icon" Command="{Binding OpenAgentCommand}" AutomationProperties.Name="{Binding AgentChipText, StringFormat='Analysis: {0}'}">
                        <Panel Width="44" Height="44">
                            <ic:SymbolIcon Symbol="HourglassHalf" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border Classes="badge" IsVisible="{Binding HasPending}">
                                <TextBlock Text="{Binding PendingCount}" />
                            </Border>
                        </Panel>
                    </Button>
                    <Button x:Name="AddButton" Grid.Column="3" Classes="icon" Command="{Binding OpenAddCommand}" AutomationProperties.Name="Add words">
                        <ic:SymbolIcon Symbol="Add" FontSize="24" />
                    </Button>
                </Grid>

                <!-- A word's page: back, the word and where it is in the list, Previous, Next, ⋯ -->
                <Grid x:Name="WordBar" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="4,0" IsVisible="False">
                    <Button Classes="icon" Command="{Binding CloseDetailCommand}" AutomationProperties.Name="All words">
                        <ic:SymbolIcon Symbol="ArrowLeft" FontSize="22" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                        <TextBlock Text="{Binding Detail.Word.Text, FallbackValue=''}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding WordPosition}" Classes="hint" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="icon" Command="{Binding PreviousWordCommand}" IsEnabled="{Binding HasPreviousWord}" AutomationProperties.Name="Previous word">
                        <ic:SymbolIcon Symbol="ChevronLeft" FontSize="22" />
                    </Button>
                    <Button Grid.Column="3" Classes="icon" Command="{Binding NextWordCommand}" IsEnabled="{Binding HasNextWord}" AutomationProperties.Name="Next word">
                        <ic:SymbolIcon Symbol="ChevronRight" FontSize="22" />
                    </Button>
                    <Button Grid.Column="4" Classes="icon" Click="WordMenu_Click" AutomationProperties.Name="More for this word">
                        <ic:SymbolIcon Symbol="MoreVertical" FontSize="22" />
                    </Button>
                </Grid>

                <!-- A family's page: back, the root and where it is in the list, Previous, Next -->
                <Grid x:Name="FamilyBar" ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,0" IsVisible="False">
                    <Button Classes="icon" Command="{Binding Roots.CloseSelectedCommand}" AutomationProperties.Name="All roots">
                        <ic:SymbolIcon Symbol="ArrowLeft" FontSize="22" />
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                        <TextBlock FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"><Run Text="{Binding Roots.Selected.Form, FallbackValue=''}" /><Run Text="  " /><Run Text="{Binding Roots.Selected.Meaning, FallbackValue=''}" FontWeight="Normal" /></TextBlock>
                        <TextBlock Text="{Binding Roots.RootPosition}" Classes="hint" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="icon" Command="{Binding Roots.PreviousFamilyCommand}" IsEnabled="{Binding Roots.HasPreviousRoot}" AutomationProperties.Name="Previous root">
                        <ic:SymbolIcon Symbol="ChevronLeft" FontSize="22" />
                    </Button>
                    <Button Grid.Column="3" Classes="icon" Command="{Binding Roots.NextFamilyCommand}" IsEnabled="{Binding Roots.HasNextRoot}" AutomationProperties.Name="Next root">
                        <ic:SymbolIcon Symbol="ChevronRight" FontSize="22" />
                    </Button>
                </Grid>
            </Panel>

            <!-- Shown while the tool is turned off -->
            <Border x:Name="OffBar" DockPanel.Dock="Top" Classes="infobar warning" Margin="16,10,16,0" IsVisible="False">
                <StackPanel>
                    <TextBlock Text="Vocabulary is turned off" Classes="title" />
                    <TextBlock Text="Your words are kept. Turn Vocabulary on in its settings to use them." TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== Learn · Words · Roots ===== -->
            <Border x:Name="Tabs" DockPanel.Dock="Top" Classes="seg" Margin="16,10,16,6">
                <Grid ColumnDefinitions="*,2,*,2,*">
                    <Button Classes="seg" Classes.on="{Binding IsLearning}" Command="{Binding ShowLearnCommand}" AutomationProperties.Name="Learn">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="HatGraduation" FontSize="18" />
                            <TextBlock Text="Learn" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="seg" Classes.on="{Binding IsWordsTab}" Command="{Binding ShowWordsCommand}" AutomationProperties.Name="Words">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="BookLetter" FontSize="18" />
                            <TextBlock Text="Words" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Classes="seg" Classes.on="{Binding IsRootsTab}" Command="{Binding ShowRootsCommand}" AutomationProperties.Name="Roots">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Organization" FontSize="18" />
                            <TextBlock Text="Roots" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== The answer bar (Learn) ===== -->
            <Border DockPanel.Dock="Bottom" Classes="answerbar">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsLearning" />
                        <Binding Path="Card.HasWord" />
                    </MultiBinding>
                </Border.IsVisible>
                <Panel x:Name="AnswerBar" DataContext="{Binding Card}" x:DataType="vm:VocabCardViewModel">
                    <!-- Before the answer: skip it, or see it -->
                    <Grid ColumnDefinitions="Auto,10,*" IsVisible="{Binding !IsRevealed}">
                        <Button Classes="tall" MinHeight="56" Padding="16,0" Command="{Binding SkipCommand}" AutomationProperties.Name="Skip">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="Next" FontSize="18" />
                                <TextBlock Text="Skip" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="accent big" Content="Show the answer" Command="{Binding RevealCommand}" IsVisible="{Binding !IsTyping}" />
                    </Grid>
                    <!-- After it: the user's own verdict, and when the word comes back -->
                    <Grid ColumnDefinitions="*,10,*" IsVisible="{Binding IsRevealed}">
                        <Button Classes="big" Command="{Binding ForgotCommand}" AutomationProperties.Name="{Binding ForgotText}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <ic:SymbolIcon Symbol="DismissCircle" FontSize="18" Foreground="{DynamicResource HelmDanger}" />
                                    <TextBlock Text="{Binding ForgotText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="sub" Text="{Binding ForgotHint}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="accent big" Command="{Binding RememberedCommand}" AutomationProperties.Name="{Binding RememberedText}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="18" />
                                    <TextBlock Text="{Binding RememberedText}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="sub" Text="{Binding RememberedHint}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Panel>
            </Border>

            <!-- ===== The root practice bar ===== -->
            <Border DockPanel.Dock="Bottom" Classes="answerbar">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsRootsTab" />
                        <Binding Path="Roots.HasPractice" />
                        <Binding Path="Roots.ShowsList" />
                    </MultiBinding>
                </Border.IsVisible>
                <Grid ColumnDefinitions="Auto,10,*" DataContext="{Binding Roots}" x:DataType="vm:VocabRootsViewModel">
                    <Button Classes="tall" MinHeight="56" Padding="20,0" Content="Stop" Command="{Binding ClosePracticeCommand}" />
                    <Button Grid.Column="2" Classes="accent big" Content="Show the meaning" Command="{Binding RevealRootCommand}" IsVisible="{Binding !IsPracticeRevealed}" />
                    <Button Grid.Column="2" Classes="accent big" Content="Next root" Command="{Binding NextRootCommand}" IsVisible="{Binding IsPracticeRevealed}" />
                </Grid>
            </Border>

            <!-- ===== The tab's content ===== -->
            <ScrollViewer x:Name="MainScroll" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Body" Margin="16,8,16,24" Spacing="0">
                    <Border Classes="infobar" IsVisible="{Binding HasMessage}" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon" Command="{Binding DismissMessageCommand}" AutomationProperties.Name="Dismiss">
                                <ic:SymbolIcon Symbol="Dismiss" FontSize="16" />
                            </Button>
                        </Grid>
                    </Border>

                    <local:VocabLearnView IsVisible="{Binding IsLearning}" />

                    <Panel IsVisible="{Binding IsWordsTab}">
                        <Panel x:Name="WordsList" IsVisible="{Binding !HasDetail}">
                            <local:VocabWordsView DataContext="{Binding List}" />
                        </Panel>
                        <Panel IsVisible="{Binding HasDetail}">
                            <local:VocabWordView DataContext="{Binding Detail}" />
                        </Panel>
                    </Panel>

                    <Panel x:Name="RootsList" IsVisible="{Binding IsRootsTab}">
                        <local:VocabRootsView DataContext="{Binding Roots}" />
                    </Panel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <local:VocabSheets x:Name="Sheets" />
    </Panel>
</UserControl>
