<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Vocab"
             xmlns:local="using:Helm.Modules.Vocab"
             x:Class="Helm.Modules.Vocab.VocabContentPage"
             x:DataType="vm:VocabViewModel">

    <!-- Vocabulary itself (drawer and Quick access): Learn (only the card) and Words (adding, the list, a word's tree).
         Its options live on VocabPage (Home → Utilities). -->
    <UserControl.Styles>
        <!-- One box of the tree, small enough that most words fit the phone's width; the word's own box is filled,
             the tapped one outlined -->
        <Style Selector="Button.node">
            <Setter Property="Background" Value="{DynamicResource HelmSubtleFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmCardStroke}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.node.root">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="{DynamicResource HelmPageBackground}" />
        </Style>
        <Style Selector="Button.node.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="2.5" />
        </Style>
        <Style Selector="Border.line">
            <Setter Property="Background" Value="{DynamicResource HelmSecondaryText}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Border.bar">
            <Setter Property="BorderBrush" Value="{DynamicResource HelmSecondaryText}" />
            <Setter Property="BorderThickness" Value="0,1.5,0,0" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="TextBlock.role">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource HelmSuccess}" />
        </Style>
        <Style Selector="TextBlock.role.sound">
            <Setter Property="Foreground" Value="#E5A50A" />
        </Style>
        <Style Selector="TextBlock.accent">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <!-- A typed answer: right letters green, wrong ones red and struck through, missing ones amber and underlined -->
        <Style Selector="TextBlock.piece">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2E9E44" />
        </Style>
        <Style Selector="TextBlock.piece.wrong">
            <Setter Property="Foreground" Value="#D13438" />
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
        <Style Selector="TextBlock.piece.missing">
            <Setter Property="Foreground" Value="#E5A50A" />
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="TextBlock.verdict">
            <Setter Property="Foreground" Value="#D13438" />
        </Style>
        <Style Selector="TextBlock.verdict.close">
            <Setter Property="Foreground" Value="#E5A50A" />
        </Style>
        <Style Selector="TextBlock.verdict.correct">
            <Setter Property="Foreground" Value="#2E9E44" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource HelmSubtleFill}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style Selector="TextBlock.group">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="10,10,10,2" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- The two tabs: the one in front is filled -->
        <Style Selector="Button.tab">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,10" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- The tree, top-down: a line up to the parent, the box, a line down, then the children side by side.
             Siblings' half lines (LineFromLeft / LineToRight) meet into one bar under their parent. -->
        <DataTemplate DataType="vm:VocabNodeViewModel">
            <StackPanel>
                <Grid ColumnDefinitions="*,*" Height="12" IsVisible="{Binding HasParent}">
                    <Border Classes="bar" IsVisible="{Binding LineFromLeft}" />
                    <Border Grid.Column="1" Classes="bar" IsVisible="{Binding LineToRight}" />
                    <Border Grid.ColumnSpan="2" Classes="line" Width="1.5" HorizontalAlignment="Center" />
                </Grid>
                <Button Classes="node" Classes.root="{Binding IsRoot}" Classes.selected="{Binding IsSelected}" Margin="3,0"
                        Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding Form}">
                    <StackPanel>
                        <TextBlock Classes="role" Classes.sound="{Binding IsSound}" Text="{Binding RoleText}" IsVisible="{Binding HasRole}" />
                        <TextBlock Text="{Binding Form}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Caption}" FontSize="10" Opacity="0.8" HorizontalAlignment="Center" IsVisible="{Binding HasCaption}" />
                        <TextBlock Text="{Binding ShortMeaning}" FontSize="10" Opacity="0.8" HorizontalAlignment="Center" IsVisible="{Binding HasShortMeaning}" />
                    </StackPanel>
                </Button>
                <Border Classes="line" Width="1.5" Height="12" HorizontalAlignment="Center" IsVisible="{Binding HasChildren}" />
                <ItemsControl ItemsSource="{Binding Children}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Resources>
        <!-- How a word is built: its tree (scrolls sideways when wide), then the tapped part. On the Learn card and the Words tab. -->
        <DataTemplate x:Key="PartsView" x:DataType="vm:VocabWordDetailViewModel">
            <StackPanel Spacing="6">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding Root}" HorizontalAlignment="Center" />
                </ScrollViewer>
                <TextBlock Classes="secondary" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                           Text="Tap a part to see what it means and which of your words share it." IsVisible="{Binding IsWordSelected}" />
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HelmCardStroke}" Padding="0,8,0,0" IsVisible="{Binding IsPartSelected}">
                    <StackPanel Spacing="2">
                        <Grid ColumnDefinitions="*,Auto">
                            <WrapPanel>
                                <TextBlock Text="{Binding CardTitle}" FontSize="22" FontWeight="SemiBold" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding CardKind}" Classes="secondary" VerticalAlignment="Center" />
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Classes="icon flat" Command="{Binding SayPartCommand}" IsVisible="{Binding CanSayPart}" AutomationProperties.Name="Say this part">
                                    <ic:SymbolIcon Symbol="Speaker2" FontSize="18" />
                                </Button>
                                <Button Classes="icon flat" Command="{Binding BeginEditPartCommand}" AutomationProperties.Name="Edit this part">
                                    <ic:SymbolIcon Symbol="Edit" FontSize="18" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock local:ToneText.Text="{Binding CardPhonetic}" IsVisible="{Binding HasCardPhonetic}" />
                        <TextBlock Text="{Binding CardHanViet}" Classes="secondary" IsVisible="{Binding HasCardHanViet}" />
                        <TextBlock Text="{Binding CardMeaning}" FontSize="16" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CardOrigin}" Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding HasCardOrigin}" />
                        <StackPanel IsVisible="{Binding HasAlsoIn}" Margin="0,6,0,0" Spacing="4">
                            <TextBlock Text="Also in your words" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding AlsoIn}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:VocabWordLink">
                                        <Button Margin="0,0,6,6" Content="{Binding Text}" Command="{Binding Open}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- Edit the tapped part by hand (every word with it shows the change) -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsEditingPart}" Margin="0,8,0,0">
                            <TextBlock Text="Meaning" Classes="secondary" />
                            <TextBox Text="{Binding EditPartMeaning}" AutomationProperties.Name="Meaning" TextWrapping="Wrap" AcceptsReturn="True" />
                            <TextBlock Text="Origin" Classes="secondary" />
                            <TextBox Text="{Binding EditPartOrigin}" AutomationProperties.Name="Origin" TextWrapping="Wrap" AcceptsReturn="True" />
                            <TextBlock Text="Phonetic" Classes="secondary" />
                            <TextBox Text="{Binding EditPartPhonetic}" AutomationProperties.Name="Phonetic" />
                            <TextBlock Text="Hán Việt" Classes="secondary" />
                            <TextBox Text="{Binding EditPartHanViet}" AutomationProperties.Name="Hán Việt" />
                            <Grid ColumnDefinitions="*,8,*" Margin="0,8,0,0">
                                <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Save" Command="{Binding SavePartCommand}" />
                                <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Cancel" Command="{Binding CancelEditPartCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
        <!-- One word in a list: the group it starts, the word, its reading (tones in colour), level, meaning, how well it is known -->
        <DataTemplate x:Key="WordRow" x:DataType="vm:VocabWordRow">
            <StackPanel>
                <TextBlock Text="{Binding Header}" Classes="group" IsVisible="{Binding HasHeader}" />
                <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,8" Command="{Binding Open}"
                        AutomationProperties.Name="{Binding Text}">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <WrapPanel>
                                <TextBlock Text="{Binding Text}" FontSize="16" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBlock local:ToneText.Text="{Binding Phonetic}" VerticalAlignment="Center" IsVisible="{Binding HasPhonetic}" />
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                <Border Classes="badge" IsVisible="{Binding HasLevel}">
                                    <TextBlock Text="{Binding Level}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Border Classes="badge" IsVisible="{Binding IsPending}">
                                    <TextBlock Text="Waiting" FontSize="11" FontWeight="SemiBold" Foreground="#E5A50A" />
                                </Border>
                                <Border Classes="badge" IsVisible="{Binding IsHard}">
                                    <TextBlock Text="Often forgotten" FontSize="11" FontWeight="SemiBold" Foreground="#E5A50A" />
                                </Border>
                                <Border Classes="badge" IsVisible="{Binding IsHidden}">
                                    <TextBlock Text="Hidden" FontSize="11" FontWeight="SemiBold" Classes="secondary" />
                                </Border>
                                <Button Classes="icon flat" Command="{Binding Remove}" IsVisible="{Binding CanRemove}" AutomationProperties.Name="Remove">
                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding Meaning}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LevelText}" Classes="secondary" FontSize="11"
                                   IsVisible="{Binding LevelText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DataTemplate>

        <!-- What helps to use a word: examples (gap card source), collocations, mnemonic, words easy to mix up, labels -->
        <DataTemplate x:Key="InfoView" x:DataType="vm:VocabWordInfo">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Labels}" FontSize="12" Classes="accent" IsVisible="{Binding HasLabels}" TextWrapping="Wrap" />
                <StackPanel IsVisible="{Binding HasExamples}" Spacing="2">
                    <TextBlock Text="Examples" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Examples}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:VocabExample">
                                <StackPanel Margin="0,2,0,4">
                                    <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" Classes="secondary" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel IsVisible="{Binding HasCollocations}" Spacing="2">
                    <TextBlock Text="Goes with" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Collocations}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel IsVisible="{Binding HasForms}" Spacing="2">
                    <TextBlock Text="Word family" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Forms}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VocabForm">
                                <WrapPanel Margin="0,1">
                                    <TextBlock Text="{Binding Word}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding PartOfSpeech}" Classes="secondary" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" />
                                </WrapPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel IsVisible="{Binding HasSynonyms}" Spacing="2">
                    <TextBlock Text="Similar" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Synonyms}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel IsVisible="{Binding HasAntonyms}" Spacing="2">
                    <TextBlock Text="Opposite" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Antonyms}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel IsVisible="{Binding HasMnemonic}" Spacing="2">
                    <TextBlock Text="To remember it" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Mnemonic}" TextWrapping="Wrap" FontStyle="Italic" />
                </StackPanel>
                <StackPanel IsVisible="{Binding HasConfusables}" Spacing="2">
                    <TextBlock Text="Easy to mix up with" FontWeight="SemiBold" Foreground="#E5A50A" />
                    <ItemsControl ItemsSource="{Binding Confusables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- Shown while the tool is turned off -->
        <Border x:Name="OffBar" Classes="infobar" IsVisible="False">
            <StackPanel>
                <TextBlock Text="Vocabulary is turned off" Classes="title" />
                <TextBlock Text="Your words are kept. Turn Vocabulary on in its settings to use them." TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="Body">
            <!-- Learn, Add, Words, Roots -->
            <Grid ColumnDefinitions="*,4,*,4,*,4,*" Margin="0,0,0,12">
                <Button Classes="tab" Classes.accent="{Binding IsLearning}" Command="{Binding ShowLearnCommand}" AutomationProperties.Name="Learn">
                    <StackPanel Spacing="2">
                        <ic:SymbolIcon Symbol="HatGraduation" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Learn" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="tab" Classes.accent="{Binding IsAdding}" Command="{Binding ShowAddCommand}" AutomationProperties.Name="Add words">
                    <StackPanel Spacing="2">
                        <ic:SymbolIcon Symbol="Add" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Add" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Classes="tab" Classes.accent="{Binding IsWordsTab}" Command="{Binding ShowWordsCommand}" AutomationProperties.Name="Words">
                    <StackPanel Spacing="2">
                        <ic:SymbolIcon Symbol="BookLetter" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding WordsTabText}" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="6" Classes="tab" Classes.accent="{Binding IsRootsTab}" Command="{Binding ShowRootsCommand}" AutomationProperties.Name="Roots">
                    <StackPanel Spacing="2">
                        <ic:SymbolIcon Symbol="Organization" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Roots" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Classes="infobar" IsVisible="{Binding HasMessage}" Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="icon flat" Command="{Binding DismissMessageCommand}" AutomationProperties.Name="Dismiss">
                        <ic:SymbolIcon Symbol="Dismiss" FontSize="16" />
                    </Button>
                </Grid>
            </Border>

            <!-- ===== Learn: one word at a time ===== -->
            <StackPanel IsVisible="{Binding IsLearning}" Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding LearnSummary}" Classes="secondary" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox Grid.Column="1" Width="160" ItemsSource="{Binding Settings.CardModes}" SelectedIndex="{Binding Settings.CardModeIndex}"
                              AutomationProperties.Name="Kind of card" />
                </Grid>
                <TextBlock Text="All caught up: nothing is due now. These cards are extra rounds." TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource HelmSuccess}" IsVisible="{Binding IsCaughtUp}" />
                <Border Classes="card" DataContext="{Binding Card}" x:DataType="vm:VocabCardViewModel">
                    <StackPanel>
                        <!-- Nothing to learn yet -->
                        <StackPanel IsVisible="{Binding !HasWord}" Spacing="8" Margin="0,16">
                            <TextBlock Text="No word to learn yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                                       Text="Add the words you meet on the Add tab. Once an AI agent breaks them down, they come here one at a time." />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding HasWord}" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LevelText}" Classes="secondary" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Border Classes="badge" IsVisible="{Binding IsHard}" Margin="0,2,6,2">
                                        <TextBlock Text="Often forgotten" FontSize="11" FontWeight="SemiBold" Foreground="#E5A50A" />
                                    </Border>
                                    <Border Classes="badge" IsVisible="{Binding IsNewlyHelped}" Margin="0,2">
                                        <TextBlock Text="New way to remember it" FontSize="11" FontWeight="SemiBold" Classes="accent" />
                                    </Border>
                                </WrapPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Classes="icon flat" Command="{Binding KnowCommand}" AutomationProperties.Name="I know it">
                                        <ic:SymbolIcon Symbol="CheckmarkStarburst" FontSize="18" />
                                    </Button>
                                    <Button Classes="icon flat" Command="{Binding HideCommand}" AutomationProperties.Name="Hide from the cards">
                                        <ic:SymbolIcon Symbol="EyeOff" FontSize="18" />
                                    </Button>
                                    <Button Classes="icon flat" Command="{Binding SkipCommand}" AutomationProperties.Name="Skip">
                                        <ic:SymbolIcon Symbol="ArrowNext" FontSize="18" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- The front: a tap shows the answer -->
                            <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,28" Command="{Binding RevealCommand}"
                                    AutomationProperties.Name="Show the answer">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding FrontText}" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                               IsVisible="{Binding FrontIsWord}" />
                                    <TextBlock Text="{Binding FrontText}" FontSize="20" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                               IsVisible="{Binding FrontIsText}" />
                                    <Button Classes="accent" HorizontalAlignment="Center" Padding="20,12" Command="{Binding SayCommand}" IsVisible="{Binding FrontIsListen}"
                                            AutomationProperties.Name="Play">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ic:SymbolIcon Symbol="Speaker2" FontSize="20" />
                                            <TextBlock Text="Play" VerticalAlignment="Center" FontSize="16" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding FrontNote}" Classes="secondary" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                               IsVisible="{Binding HasFrontNote}" />
                                    <TextBlock Text="{Binding FrontHint}" Classes="secondary" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                               IsVisible="{Binding !IsRevealed}" />
                                </StackPanel>
                            </Button>

                            <!-- Type cards: the word typed here, checked on Enter or Check -->
                            <Grid ColumnDefinitions="*,8,Auto" IsVisible="{Binding IsTyping}" Margin="0,0,0,8">
                                <TextBox x:Name="TypeBox" FontSize="18" PlaceholderText="Type the word" Text="{Binding Typed}" AutomationProperties.Name="Type the word">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding CheckCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="2" Classes="accent" Content="Check" Command="{Binding CheckCommand}" />
                            </Grid>

                            <!-- The answer, what helps to use it, how it is built, then the user's own verdict -->
                            <StackPanel IsVisible="{Binding IsRevealed}" Spacing="4">
                                <!-- What was typed, letter by letter against the word -->
                                <StackPanel IsVisible="{Binding HasAnswer}" HorizontalAlignment="Center" Spacing="2" Margin="0,0,0,6">
                                    <ItemsControl ItemsSource="{Binding AnswerPieces}" HorizontalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VocabAnswerPiece">
                                                <TextBlock Text="{Binding Text}" Classes="piece" Classes.wrong="{Binding IsWrong}" Classes.missing="{Binding IsMissing}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding AnswerMessage}" Classes="verdict" Classes.correct="{Binding AnswerIsCorrect}" Classes.close="{Binding AnswerIsClose}"
                                               FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Text}" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap"
                                           IsVisible="{Binding ShowsWordOnReveal}" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <TextBlock local:ToneText.Text="{Binding Phonetic}" FontSize="17" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding HanViet}" Classes="secondary" FontSize="15" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Traditional}" Classes="secondary" FontSize="15" />
                                </WrapPanel>
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button Classes="flat" Command="{Binding SayCommand}" IsVisible="{Binding CanSay}" AutomationProperties.Name="Listen">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:SymbolIcon Symbol="Speaker2" FontSize="18" />
                                            <TextBlock Text="Listen" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="flat" Command="{Binding YouGlishCommand}" IsVisible="{Binding ShowYouGlish}" AutomationProperties.Name="YouGlish">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:SymbolIcon Symbol="Video" FontSize="18" />
                                            <TextBlock Text="YouGlish" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Text="{Binding Meaning}" FontSize="20" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Explanation}" Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                <ContentControl Margin="0,10,0,0" Content="{Binding Info}" ContentTemplate="{StaticResource InfoView}" />

                                <StackPanel IsVisible="{Binding HasExplanationTree}" Margin="0,10,0,0" Spacing="6">
                                    <TextBlock Text="How it's built" FontWeight="SemiBold" />
                                    <ContentControl Content="{Binding ExplanationTree}" ContentTemplate="{StaticResource PartsView}" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,10,*" Margin="0,16,0,0">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,12" Content="Forgot" Command="{Binding ForgotCommand}" />
                                    <Button Grid.Column="2" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,12" Content="Remembered"
                                            Command="{Binding RememberedCommand}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== Add: new words, and what waits for the agent ===== -->
            <StackPanel IsVisible="{Binding IsAdding}">
                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Add a word" Classes="title" />
                        <TextBox PlaceholderText="relative, 补救…" Text="{Binding NewWord}" FontSize="16" AutomationProperties.Name="New word">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <TextBox PlaceholderText="Where you met it (optional)" Text="{Binding NewNote}" AutomationProperties.Name="Note" />
                        <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Add" Command="{Binding AddCommand}" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap" FontSize="12"
                                   Text="Faster: select a word in any app and tap Add word, or share it to Save to Helm." />
                    </StackPanel>
                </Border>

                <Border Classes="infobar" IsVisible="{Binding HasAgentWork}" Margin="0,4,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding AgentWorkText}" TextWrapping="Wrap" />
                        <TextBlock Text="Helm on your PC does this with Claude Code (by itself when that is on); the result syncs here." Classes="secondary" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Recently added" Classes="section" IsVisible="{Binding HasRecentWords}" />
                <Border Classes="card" Padding="4" IsVisible="{Binding HasRecentWords}">
                    <ItemsControl ItemsSource="{Binding RecentWords}" ItemTemplate="{StaticResource WordRow}" />
                </Border>
            </StackPanel>

            <!-- ===== Words: the list, a word's page ===== -->
            <StackPanel IsVisible="{Binding IsWordsTab}">
                <!-- A word opened: back, its fields, what helps to use it, how it is built -->
                <StackPanel IsVisible="{Binding HasDetail}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Classes="flat" Command="{Binding CloseDetailCommand}" AutomationProperties.Name="Back to the words">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="ArrowLeft" FontSize="18" />
                                <TextBlock Text="All words" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Classes="icon flat" Command="{Binding Detail.SayWordCommand}" IsVisible="{Binding Detail.CanSay}" AutomationProperties.Name="Say the word">
                                <ic:SymbolIcon Symbol="Speaker2" FontSize="18" />
                            </Button>
                            <Button Classes="icon flat" Command="{Binding Detail.YouGlishCommand}" IsVisible="{Binding Detail.ShowYouGlish}" AutomationProperties.Name="YouGlish">
                                <ic:SymbolIcon Symbol="Video" FontSize="18" />
                            </Button>
                            <Button Classes="icon flat" Command="{Binding Detail.KnowCommand}" IsVisible="{Binding !Detail.IsPending}" AutomationProperties.Name="I know it">
                                <ic:SymbolIcon Symbol="CheckmarkStarburst" FontSize="18" />
                            </Button>
                            <Button Classes="icon flat" Command="{Binding Detail.ToggleHiddenCommand}" AutomationProperties.Name="Hide from the cards, or show again">
                                <Panel>
                                    <ic:SymbolIcon Symbol="EyeOff" FontSize="18" IsVisible="{Binding !Detail.IsHidden}" />
                                    <ic:SymbolIcon Symbol="Eye" FontSize="18" IsVisible="{Binding Detail.IsHidden}" />
                                </Panel>
                            </Button>
                            <Button Classes="icon flat" Command="{Binding Detail.Editor.BeginCommand}" AutomationProperties.Name="Edit the word">
                                <ic:SymbolIcon Symbol="Edit" FontSize="18" />
                            </Button>
                            <Button Classes="icon flat" Command="{Binding DeleteWordCommand}" AutomationProperties.Name="Delete the word">
                                <ic:SymbolIcon Symbol="Delete" FontSize="18" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel DataContext="{Binding Detail}" x:DataType="vm:VocabWordDetailViewModel">
                        <Border Classes="card">
                            <StackPanel Spacing="4">
                                <WrapPanel>
                                    <TextBlock Text="{Binding Word.Text}" FontSize="30" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Word.Traditional}" FontSize="22" Classes="secondary" VerticalAlignment="Bottom" IsVisible="{Binding ShowTraditional}" />
                                </WrapPanel>
                                <WrapPanel>
                                    <TextBlock local:ToneText.Text="{Binding Word.Phonetic}" FontSize="16" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Word.HanViet}" Classes="secondary" FontSize="15" FontWeight="SemiBold" IsVisible="{Binding HasHanViet}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Word.Meaning}" FontSize="17" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Word.Explanation}" Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding HasExplanation}" />
                                <TextBlock Text="{Binding Word.Note, StringFormat='Your note: {0}'}" Classes="secondary" FontStyle="Italic" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                                <TextBlock Text="{Binding LevelText}" Classes="secondary" FontSize="12" />
                                <WrapPanel Margin="0,0,0,6">
                                    <Border Classes="badge" IsVisible="{Binding IsHard}" Margin="0,2,6,2">
                                        <TextBlock Text="Often forgotten: Claude Code writes a new way to remember it" FontSize="11" FontWeight="SemiBold" Foreground="#E5A50A" TextWrapping="Wrap" />
                                    </Border>
                                    <Border Classes="badge" IsVisible="{Binding IsHidden}" Margin="0,2">
                                        <TextBlock Text="Hidden from the cards" FontSize="11" FontWeight="SemiBold" Classes="secondary" />
                                    </Border>
                                </WrapPanel>
                                <ContentControl Content="{Binding Info}" ContentTemplate="{StaticResource InfoView}" />
                                <Border Classes="infobar" IsVisible="{Binding IsPending}" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
                                </Border>

                                <!-- Edit by hand -->
                                <StackPanel Spacing="4" DataContext="{Binding Editor}" x:DataType="vm:VocabWordEditor" IsVisible="{Binding IsOpen}" Margin="0,8,0,0">
                                    <TextBlock Text="Phonetic" Classes="secondary" />
                                    <TextBox Text="{Binding Phonetic}" AutomationProperties.Name="Phonetic" />
                                    <TextBlock Text="Meaning" Classes="secondary" />
                                    <TextBox Text="{Binding Meaning}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Meaning" />
                                    <TextBlock Text="Hán Việt" Classes="secondary" />
                                    <TextBox Text="{Binding HanViet}" AutomationProperties.Name="Hán Việt" />
                                    <TextBlock Text="Traditional" Classes="secondary" />
                                    <TextBox Text="{Binding Traditional}" AutomationProperties.Name="Traditional" />
                                    <TextBlock Text="Explanation" Classes="secondary" />
                                    <TextBox Text="{Binding Explanation}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Explanation" />
                                    <TextBlock Text="To remember it (mnemonic)" Classes="secondary" />
                                    <TextBox Text="{Binding Mnemonic}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Mnemonic" />
                                    <TextBlock Text="Examples: one per line, sentence | translation" Classes="secondary" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding Examples}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Examples" />
                                    <TextBlock Text="Goes with: separated by commas" Classes="secondary" />
                                    <TextBox Text="{Binding Collocations}" AutomationProperties.Name="Collocations" />
                                    <TextBlock Text="Easy to mix up with: one per line, word | what tells them apart" Classes="secondary" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding Confusables}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Confusables" />
                                    <TextBlock Text="Word family: one per line, word | part of speech | meaning" Classes="secondary" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding Forms}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Word family" />
                                    <TextBlock Text="Similar: separated by commas" Classes="secondary" />
                                    <TextBox Text="{Binding Synonyms}" AutomationProperties.Name="Synonyms" />
                                    <TextBlock Text="Opposite: separated by commas" Classes="secondary" />
                                    <TextBox Text="{Binding Antonyms}" AutomationProperties.Name="Antonyms" />
                                    <TextBlock Text="Level (B1, HSK3)" Classes="secondary" />
                                    <TextBox Text="{Binding Level}" AutomationProperties.Name="Level" />
                                    <TextBlock Text="Part of speech" Classes="secondary" />
                                    <TextBox Text="{Binding PartOfSpeech}" AutomationProperties.Name="Part of speech" />
                                    <TextBlock Text="Topic" Classes="secondary" />
                                    <TextBox Text="{Binding Topic}" AutomationProperties.Name="Topic" />
                                    <TextBlock Text="Your tags: separated by commas (Aptis, Truyện)" Classes="secondary" TextWrapping="Wrap" />
                                    <TextBox Text="{Binding Tags}" AutomationProperties.Name="Tags" />
                                    <TextBlock Text="Your note" Classes="secondary" />
                                    <TextBox Text="{Binding Note}" TextWrapping="Wrap" AcceptsReturn="True" AutomationProperties.Name="Your note" />
                                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource HelmDanger}" IsVisible="{Binding HasError}" />
                                    <Grid ColumnDefinitions="*,8,*" Margin="0,8,0,0">
                                        <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Save" Command="{Binding SaveCommand}" />
                                        <Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Cancel" Command="{Binding CancelCommand}" />
                                    </Grid>
                                </StackPanel>

                                <Button Classes="flat" Content="Ask for a new analysis" Command="{Binding BeginRedoCommand}" Margin="0,4,0,0" />
                                <StackPanel Spacing="8" IsVisible="{Binding IsAskingRedo}">
                                    <TextBox PlaceholderText="What should change? e.g. tách lat thành ferre" Text="{Binding RedoNote}" TextWrapping="Wrap"
                                             AutomationProperties.Name="What should change" />
                                    <Button Classes="accent" Content="Send back" Command="{Binding SendRedoCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Classes="card" IsVisible="{Binding HasTree}" Padding="8,12">
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PartsView}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- The list: one language, searched, filtered, sorted, in groups -->
                <Panel IsVisible="{Binding !HasDetail}">
                <StackPanel DataContext="{Binding List}" x:DataType="vm:VocabWordListViewModel" Spacing="8">
                    <Grid ColumnDefinitions="*,6,*">
                        <Button Classes="tab" Classes.accent="{Binding IsEnglish}" Content="{Binding EnglishTabText}" Command="{Binding ShowEnglishCommand}"
                                AutomationProperties.Name="English words" />
                        <Button Grid.Column="2" Classes="tab" Classes.accent="{Binding IsChinese}" Content="{Binding ChineseTabText}" Command="{Binding ShowChineseCommand}"
                                AutomationProperties.Name="Chinese words" />
                    </Grid>
                    <TextBox PlaceholderText="Search words and meanings" Text="{Binding SearchText}" IsVisible="{Binding HasWords}" AutomationProperties.Name="Search words" />
                    <Grid ColumnDefinitions="*,6,*" IsVisible="{Binding HasWords}">
                        <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Sorts}" SelectedIndex="{Binding SortIndex}" AutomationProperties.Name="Order" />
                        <ComboBox Grid.Column="2" HorizontalAlignment="Stretch" ItemsSource="{Binding FilterNames}" SelectedIndex="{Binding FilterIndex}" AutomationProperties.Name="Show" />
                    </Grid>
                    <Border Classes="card" Padding="4">
                        <StackPanel>
                            <TextBlock Margin="12" TextWrapping="Wrap" Classes="secondary" IsVisible="{Binding HasNoWords}"
                                       Text="Words show up here once an AI agent has broken them down. Add the words you meet on the Add tab, one at a time: learning them as they come is what makes them stick." />
                            <TextBlock Margin="12" Text="No word matches." Classes="secondary" IsVisible="{Binding HasNoMatches}" />
                            <ItemsControl ItemsSource="{Binding Words}" ItemTemplate="{StaticResource WordRow}" />
                            <!-- A page at a time: the phone draws every row it is given -->
                            <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,8"
                                    Content="{Binding Pager.MoreText}" Command="{Binding Pager.ShowMoreCommand}" IsVisible="{Binding Pager.HasMore}"
                                    AutomationProperties.Name="Show more words" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Panel>
            </StackPanel>

            <!-- ===== Roots: families of words that share a part ===== -->
            <Panel IsVisible="{Binding IsRootsTab}">
            <StackPanel DataContext="{Binding Roots}" x:DataType="vm:VocabRootsViewModel" Spacing="8">
                <Grid ColumnDefinitions="*,6,*">
                    <Button Classes="tab" Classes.accent="{Binding IsEnglish}" Content="English" Command="{Binding ShowEnglishCommand}" />
                    <Button Grid.Column="2" Classes="tab" Classes.accent="{Binding IsChinese}" Content="中文" Command="{Binding ShowChineseCommand}" />
                </Grid>
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding NextRootCommand}" AutomationProperties.Name="Practise roots">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="HatGraduation" FontSize="18" />
                        <TextBlock Text="Practise roots" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Practising a root -->
                <Border Classes="card" IsVisible="{Binding HasPractice}">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="What does this part mean?" Classes="secondary" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="icon flat" Command="{Binding ClosePracticeCommand}" AutomationProperties.Name="Stop practising">
                                <ic:SymbolIcon Symbol="Dismiss" FontSize="16" />
                            </Button>
                        </Grid>
                        <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,16" Command="{Binding RevealRootCommand}"
                                AutomationProperties.Name="Show the meaning">
                            <StackPanel>
                                <TextBlock Text="{Binding Practice.Form}" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Practice.Kind}" Classes="secondary" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel IsVisible="{Binding IsPracticeRevealed}" Spacing="4">
                            <TextBlock Text="{Binding Practice.Meaning}" FontSize="18" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="{Binding Practice.Origin}" Classes="secondary" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="Its family" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <ItemsControl ItemsSource="{Binding Practice.Words}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:VocabWordLink">
                                        <Button Margin="0,0,6,6" Content="{Binding Text}" Command="{Binding Open}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Button Classes="accent" HorizontalAlignment="Center" Content="Next root" Command="{Binding NextRootCommand}" />
                    </StackPanel>
                </Border>

                <!-- The chosen family -->
                <Border Classes="card" IsVisible="{Binding HasSelected}">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <WrapPanel>
                                <TextBlock Text="{Binding Selected.Form}" FontSize="24" FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Selected.Kind}" Classes="secondary" VerticalAlignment="Center" />
                            </WrapPanel>
                            <Button Grid.Column="1" Classes="icon flat" Command="{Binding CloseSelectedCommand}" AutomationProperties.Name="Close the family">
                                <ic:SymbolIcon Symbol="Dismiss" FontSize="16" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding Selected.Meaning}" FontSize="16" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Selected.Origin}" Classes="secondary" TextWrapping="Wrap" />
                        <TextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap"
                                   Text="More words of this family: on the PC, Helm's Roots tab has Suggest 3 more words (Claude Code)." />
                    </StackPanel>
                </Border>

                <!-- Every part, the biggest families first -->
                <Border Classes="card" Padding="4">
                    <StackPanel>
                        <TextBlock Margin="12" TextWrapping="Wrap" Classes="secondary" IsVisible="{Binding HasNoRoots}"
                                   Text="The parts of your words show up here once they are broken down; a part shared by several words makes a family." />
                        <ItemsControl ItemsSource="{Binding Roots}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:VocabRootRow">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" Classes="group" IsVisible="{Binding HasHeader}" />
                                        <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,8" Command="{Binding Select}"
                                                AutomationProperties.Name="{Binding Form}">
                                            <StackPanel>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding Form}" FontSize="17" FontWeight="SemiBold" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Meaning}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    </WrapPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="secondary" FontSize="12" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Words}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:VocabWordLink">
                                                            <TextBlock Margin="0,0,10,0" Text="{Binding Text}" Classes="accent" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,0,8"
                                Content="{Binding Pager.MoreText}" Command="{Binding Pager.ShowMoreCommand}" IsVisible="{Binding Pager.HasMore}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </Panel>
        </StackPanel>
    </StackPanel>
</UserControl>
