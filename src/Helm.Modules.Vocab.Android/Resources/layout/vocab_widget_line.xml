<?xml version="1.0" encoding="utf-8"?>
<!-- One line of the Vocabulary widget's answer list (the word, its reading, meaning, parts, an example). Size and
     colour are set per line in code. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vocab_widget_line"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="1dp"
    android:paddingBottom="1dp"
    android:gravity="center_horizontal"
    android:textSize="13sp"
    android:textColor="@color/vocab_widget_text" />
