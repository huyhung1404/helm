<?xml version="1.0" encoding="utf-8"?>
<!-- The Vocabulary widget: one word; a tap on it shows the reading, the meaning, each part and an example in a list
     that scrolls when it is long. Forgot and Remembered are small round buttons on the top row, so they always fit.
     The title opens Helm (on the word once its meaning shows); the arrow skips to another word. The background is a
     picture so its colour and opacity can follow the settings. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/vocab_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/vocab_widget_background"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/vocab_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:textSize="14sp"
        android:textColor="@color/vocab_widget_secondary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/vocab_widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/vocab_widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/vocab_widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vocabulary"
                android:textSize="12sp"
                android:textColor="@color/vocab_widget_secondary"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/vocab_widget_forgot"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="6dp"
                android:background="@drawable/vocab_widget_round"
                android:src="@drawable/vocab_widget_forgot"
                android:contentDescription="Forgot"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/vocab_widget_remembered"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="8dp"
                android:padding="6dp"
                android:background="@drawable/vocab_widget_round_accent"
                android:src="@drawable/vocab_widget_remembered"
                android:contentDescription="Remembered"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/vocab_widget_skip"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:padding="6dp"
                android:src="@drawable/vocab_widget_skip"
                android:contentDescription="Another word" />
        </LinearLayout>

        <!-- Before the answer: the word alone; a tap shows the meaning -->
        <LinearLayout
            android:id="@+id/vocab_widget_word_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/vocab_widget_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/vocab_widget_text"
                android:maxLines="2"
                android:ellipsize="end"
                android:gravity="center" />

            <TextView
                android:id="@+id/vocab_widget_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to see the meaning"
                android:textSize="12sp"
                android:textColor="@color/vocab_widget_secondary" />
        </LinearLayout>

        <!-- The answer: scrolls with a swipe when it does not fit -->
        <ListView
            android:id="@+id/vocab_widget_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbarStyle="outsideOverlay"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
