<ui:ModulePageBase xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="using:Helm.Core.Ui"
                   xmlns:vm="using:Helm.Modules.Vocab"
                   x:Class="Helm.Modules.Vocab.VocabPage"
                   x:DataType="vm:VocabViewModel">

    <!-- Vocabulary's settings (Home → Utilities). The words themselves are on VocabContentPage. -->
    <StackPanel>
        <Border Classes="infobar" IsVisible="{Binding HasMessage}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Open Vocabulary" Classes="title" />
                <TextBlock Text="Your words and their parts. Also in the menu and on Home." Classes="secondary" TextWrapping="Wrap" />
                <Button Classes="accent" Content="Open Vocabulary" Click="OpenVocabulary_Click" />
            </StackPanel>
        </Border>

        <!-- Over other apps: the pop-up card, the bubble, the apps they stay out of (DataContext: VocabOverlaySettingsViewModel) -->
        <StackPanel x:Name="OverlayPanel" x:DataType="vm:VocabOverlaySettingsViewModel">
            <Border Classes="infobar" IsVisible="{Binding HasMessage}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DismissMessageCommand}" AutomationProperties.Name="Dismiss" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Permissions, only while one is missing -->
            <Border Classes="infobar warning" IsVisible="{Binding NeedsDraw}">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap"
                               Text="To show words over your other apps, Helm needs “Display over other apps”. Turn it on for Helm, then come back." />
                    <Button Classes="accent" Content="Allow display over other apps" Command="{Binding OpenDrawSettingsCommand}" />
                </StackPanel>
            </Border>
            <Border Classes="infobar warning" IsVisible="{Binding NeedsUsageAccess}">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap"
                               Text="To stay out of the apps below, Helm needs to see which app is open: turn on “Usage access” for Helm, then come back." />
                    <Button Classes="accent" Content="Allow usage access" Command="{Binding OpenUsageSettingsCommand}" />
                </StackPanel>
            </Border>

            <!-- Pop-up card -->
            <TextBlock Text="Pop-up card" Classes="section" />
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="A word now and then" Classes="title" />
                            <TextBlock Classes="secondary" TextWrapping="Wrap"
                                       Text="From time to time a card with one of your words appears over the app you are using. Tap the word for its meaning, then Forgot or Remembered. Unanswered, it goes away after a minute and a half." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.PopupEnabled}" OnContent="" OffContent="" AutomationProperties.Name="A word now and then" />
                    </Grid>
                    <TextBlock Text="How often" Classes="secondary" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Settings.PopupFrequencyNames}" SelectedIndex="{Binding Settings.PopupFrequencyIndex}"
                              IsEnabled="{Binding Settings.PopupEnabled}" AutomationProperties.Name="How often" />
                    <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding Settings.IsCustomFrequency}">
                        <TextBox Text="{Binding Settings.CustomFromText}" PlaceholderText="Shortest (seconds)" AutomationProperties.Name="Shortest gap in seconds" />
                        <TextBox Grid.Column="2" Text="{Binding Settings.CustomToText}" PlaceholderText="Longest (seconds)" AutomationProperties.Name="Longest gap in seconds" />
                    </Grid>
                    <TextBlock Text="{Binding Settings.CustomError}" Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding Settings.HasCustomError}" />
                    <Button Content="Show a word now" Command="{Binding ShowNowCommand}" />
                </StackPanel>
            </Border>

            <!-- Bubble -->
            <TextBlock Text="Floating bubble" Classes="section" />
            <Border Classes="card">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="A bubble over your apps" Classes="title" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="Tap it for a word to guess; drag it to move it. Drag it onto the ✕ at the bottom to put it away until you next unlock the phone." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.BubbleEnabled}" OnContent="" OffContent="" AutomationProperties.Name="A bubble over your apps" />
                </Grid>
            </Border>

            <!-- Blocked apps -->
            <TextBlock Text="Don't show in these apps" Classes="section" />
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Classes="secondary" TextWrapping="Wrap"
                               Text="Neither the card nor the bubble appears while one of these apps is open. Neither ever appears while the phone is sideways (games, videos)." />
                    <!-- Hidden while picking: a tick would add a row here and push the list under the finger -->
                    <ItemsControl ItemsSource="{Binding Blocked}" IsVisible="{Binding !IsPicking}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:VocabAppRow">
                                <Border Classes="row">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="2" Content="Remove" AutomationProperties.Name="Remove" Click="Unblock_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Choose apps…" Command="{Binding ChooseAppsCommand}" IsVisible="{Binding !IsPicking}" />

                    <!-- The picker: every app in the launcher, ticked when blocked -->
                    <StackPanel Spacing="8" IsVisible="{Binding IsPicking}">
                        <Grid ColumnDefinitions="*,8,Auto">
                            <TextBox Text="{Binding Search}" PlaceholderText="Search apps" AutomationProperties.Name="Search apps" />
                            <Button Grid.Column="2" Classes="accent" Content="Done" Command="{Binding DonePickingCommand}" />
                        </Grid>
                        <TextBlock Text="Loading your apps…" Classes="secondary" IsVisible="{Binding IsLoadingApps}" />
                        <ItemsControl ItemsSource="{Binding Apps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:VocabAppRow">
                                    <CheckBox IsChecked="{Binding IsBlocked}" HorizontalAlignment="Stretch" Margin="0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Image Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Display -->
        <TextBlock Text="Display" Classes="section" />
        <Border Classes="card">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="Show traditional characters" />
                        <TextBlock Text="Next to a Chinese word or part when it differs (补救 (補救))." Classes="secondary" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowTraditional}" OnContent="" OffContent="" AutomationProperties.Name="Show traditional characters" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="Chinese: type the pinyin" />
                        <TextBlock Text="Every card of a Chinese word asks for its pinyin before the answer; no tones is fine (bujiu)." Classes="secondary" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.TypePinyin}" OnContent="" OffContent="" AutomationProperties.Name="Chinese: type the pinyin" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="Say the word when its meaning shows" />
                        <TextBlock Text="On the Learn tab, the word is read aloud as you check it." Classes="secondary" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.AutoSay}" OnContent="" OffContent="" AutomationProperties.Name="Say the word when its meaning shows" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="YouGlish button" />
                        <TextBlock Text="Next to the word: hear real people say it in YouTube videos (opens youglish.com)." Classes="secondary" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding Settings.ShowYouGlish}" OnContent="" OffContent="" AutomationProperties.Name="YouGlish button" />
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="Words per page" />
                    <TextBlock Text="The Words and Roots lists show one page at a time, so they stay quick." Classes="secondary" TextWrapping="Wrap" />
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Settings.ItemsShownNames}" SelectedIndex="{Binding Settings.ItemsShownIndex}"
                              AutomationProperties.Name="Words per page" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Analysis -->
        <TextBlock Text="Analysis" Classes="section" />
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Breaking words down" Classes="title" />
                <TextBlock Classes="secondary" TextWrapping="Wrap"
                           Text="Words you add wait until an AI agent breaks them down: ask Claude Code on your PC (Helm's tools must be allowed there). The analysis syncs here." />
                <Button Content="Copy request" Command="{Binding CopyPromptCommand}" />
            </StackPanel>
        </Border>
    </StackPanel>
</ui:ModulePageBase>
