<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Helm.Modules.Vocab"
             xmlns:local="using:Helm.Modules.Vocab"
             x:Class="Helm.Modules.Vocab.VocabSheets"
             x:DataType="vm:VocabViewModel"
             x:Name="Self">

    <!-- The bottom sheets over the whole Vocabulary page: the card's ⋯ and the word's ⋯ menus, Delete and the list's
         order (opened by the page), Add words and Analysis (the app bar's + and hourglass; Copy request is in the
         settings), Add text, Edit (92% high) and Ask for a new analysis. Each as the design's .sheet: the grab, a header
         (padding 8 8 4 20), a body (padding 8 20 20, 14 between) and a footer. A tap on the dimmed page closes a sheet,
         except Edit, which closes with ✕ or Save. -->
    <Panel>
        <!-- ===== The card's ⋯ ===== -->
        <Panel x:Name="CardMenu" IsVisible="False">
            <Border Classes="scrim" PointerPressed="Scrim_PointerPressed" />
            <Border Classes="sheet">
                <StackPanel>
                    <Border Classes="grab" />
                    <TextBlock Classes="sheettitle" Text="{Binding Card.Text}" Margin="20,8,8,4" />
                    <StackPanel Margin="0,0,0,12">
                        <Button Classes="mi" Command="{Binding Card.KnowCommand}" Click="Close_Click" AutomationProperties.Name="I know it">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <local:LineIcon Kind="Star" Size="22" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="I know it" />
                                    <TextBlock Text="It comes back in a month" Classes="hint" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Classes="mi" Command="{Binding Card.HideCommand}" Click="Close_Click" AutomationProperties.Name="Hide from the cards">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <local:LineIcon Kind="EyeOff" Size="22" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hide from the cards" />
                                    <TextBlock Text="The Learn tab, the pop-up and the bubble" Classes="hint" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Classes="mi" Click="OpenCardWord_Click" AutomationProperties.Name="Open its page">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <local:LineIcon Kind="Open" Size="22" VerticalAlignment="Center" />
                                <TextBlock Text="Open its page" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="mi" Click="EditCardWord_Click" AutomationProperties.Name="Edit">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <local:LineIcon Kind="Edit" Size="22" VerticalAlignment="Center" />
                                <TextBlock Text="Edit" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ===== The word's ⋯ (its page) ===== -->
        <Panel x:Name="WordMenu" IsVisible="False">
            <Border Classes="scrim" PointerPressed="Scrim_PointerPressed" />
            <Border Classes="sheet">
                <StackPanel>
                    <Border Classes="grab" />
                    <TextBlock Classes="sheettitle" Text="{Binding Detail.Word.Text, FallbackValue=''}" Margin="20,8,8,4" />
                    <StackPanel Margin="0,0,0,12">
                        <Button Classes="mi" Command="{Binding Detail.KnowCommand, FallbackValue={x:Null}}" Click="Close_Click"
                                IsVisible="{Binding !Detail.IsPending, FallbackValue=False}" AutomationProperties.Name="I know it">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <local:LineIcon Kind="Star" Size="22" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="I know it" />
                                    <TextBlock Text="It comes back in a month" Classes="hint" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Classes="mi" Command="{Binding Detail.ToggleHiddenCommand, FallbackValue={x:Null}}" Click="Close_Click"
                                AutomationProperties.Name="Hide from the cards, or show again">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Panel VerticalAlignment="Center">
                                    <local:LineIcon Kind="EyeOff" Size="22" IsVisible="{Binding !Detail.IsHidden, FallbackValue=True}" />
                                    <local:LineIcon Kind="Eye" Size="22" IsVisible="{Binding Detail.IsHidden, FallbackValue=False}" />
                                </Panel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hide from the cards" IsVisible="{Binding !Detail.IsHidden, FallbackValue=True}" />
                                    <TextBlock Text="Show in the cards again" IsVisible="{Binding Detail.IsHidden, FallbackValue=False}" />
                                    <TextBlock Text="The Learn tab, the pop-up and the bubble" Classes="hint" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Classes="mi" Command="{Binding Detail.BeginRedoCommand, FallbackValue={x:Null}}" Click="Close_Click" AutomationProperties.Name="Ask for a new analysis">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <local:LineIcon Kind="Redo" Size="22" VerticalAlignment="Center" />
                                <TextBlock Text="Ask for a new analysis" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="mi danger" Click="AskDelete_Click" AutomationProperties.Name="Delete the word">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <local:LineIcon Kind="Trash" Size="22" VerticalAlignment="Center" />
                                <TextBlock Text="Delete" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ===== Delete the word? ===== -->
        <Panel x:Name="DeleteWord" IsVisible="False">
            <Border Classes="scrim" PointerPressed="Scrim_PointerPressed" />
            <Border Classes="sheet">
                <StackPanel>
                    <Border Classes="grab" />
                    <TextBlock Classes="sheettitle" Margin="20,8,8,4" TextWrapping="Wrap" TextTrimming="None"
                               Text="{Binding Detail.Word.Text, FallbackValue='', StringFormat='Delete “{0}”?'}" />
                    <TextBlock Margin="20,8,20,20" TextWrapping="Wrap" Text="Its reviews go with it. Its parts stay for your other words." />
                    <Border Classes="sheetfoot">
                        <Grid ColumnDefinitions="*,10,*">
                            <Button Classes="tall" HorizontalAlignment="Stretch" Content="Cancel" Click="Close_Click" />
                            <Button Grid.Column="2" Classes="tall dangersolid" HorizontalAlignment="Stretch" Content="Delete" Command="{Binding DeleteWordConfirmedCommand}"
                                    Click="Close_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ===== The list's order ===== -->
        <Panel x:Name="Order" IsVisible="False">
            <Border Classes="scrim" PointerPressed="Scrim_PointerPressed" />
            <Border Classes="sheet">
                <StackPanel>
                    <Border Classes="grab" />
                    <TextBlock Classes="sheettitle" Text="Order" Margin="20,8,8,4" />
                    <ListBox Classes="menu" Margin="0,0,0,12" ItemsSource="{Binding List.Sorts}" SelectedIndex="{Binding List.SortIndex}" Tapped="Order_Tapped"
                             AutomationProperties.Name="Order">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    <local:LineIcon Grid.Column="1" Classes="check" Kind="Check" Size="22" Foreground="{DynamicResource VocabAccent}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Panel>

        <!-- ===== Add text (not in the design): paste a text, then its proposed words ===== -->
        <Panel DataContext="{Binding Texts}" x:DataType="vm:VocabTextsViewModel" IsVisible="{Binding IsOpen}">
            <Border Classes="scrim" PointerPressed="CloseTexts_Pressed" />
            <Border Classes="sheet" MaxHeight="{Binding #Self.Bounds.Height, Converter={x:Static local:VocabConverters.SheetHeight}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Border Classes="grab" />
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,8,8,4">
                            <Button Classes="icon" Margin="0,0,8,0" Command="{Binding BackCommand}" IsVisible="{Binding IsDetailOpen}" AutomationProperties.Name="Back to your texts">
                                <local:LineIcon Kind="Back" Size="22" />
                            </Button>
                            <TextBlock Grid.Column="1" Classes="sheettitle" Text="Add text" IsVisible="{Binding IsListOpen}" />
                            <TextBlock Grid.Column="1" Classes="sheettitle" Text="{Binding DetailTitle}" IsVisible="{Binding IsDetailOpen}" />
                            <Button Grid.Column="2" Classes="icon" Margin="8,0,0,0" Command="{Binding CloseCommand}" AutomationProperties.Name="Close">
                                <local:LineIcon Kind="X" Size="22" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Classes="sheetfoot">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Message}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
                            <Button Classes="accent tall" HorizontalAlignment="Stretch" Command="{Binding AddTextCommand}" IsVisible="{Binding IsListOpen}"
                                    AutomationProperties.Name="Add text">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <local:LineIcon Kind="Plus" Size="18" VerticalAlignment="Center" />
                                    <TextBlock Text="Add text" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="accent tall" HorizontalAlignment="Stretch" Command="{Binding AddSelectedCommand}" IsVisible="{Binding HasProposals}"
                                    AutomationProperties.Name="{Binding AddSelectedText}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <local:LineIcon Kind="Check" Size="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AddSelectedText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,8,20,20" Spacing="14">
                            <!-- The paste form and the texts pasted before -->
                            <StackPanel Spacing="14" IsVisible="{Binding IsListOpen}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Where it comes from (optional)" Classes="label" />
                                    <TextBox PlaceholderText="A song and its singer, a chapter…" Text="{Binding NewTitle}" AutomationProperties.Name="Where the text comes from" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Text" Classes="label" />
                                    <TextBox PlaceholderText="Paste the lyrics or the article here" Text="{Binding NewBody}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="160" MaxHeight="260" AutomationProperties.Name="Text to learn words from" />
                                </StackPanel>
                                <TextBlock Classes="hint" TextWrapping="Wrap"
                                           Text="Claude Code picks the words worth learning (Chinese in simplified characters). You choose which to keep before any is analyzed." />
                                <StackPanel IsVisible="{Binding HasTexts}">
                                    <TextBlock Text="Your texts" Classes="label" />
                                    <ItemsControl ItemsSource="{Binding Texts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VocabSourceRow">
                                                <Border Classes="lrow">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Button Classes="flat" Padding="0,8" Command="{Binding Open}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Title}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Status}" Classes="hint" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="1" Classes="icon" Margin="10,0,0,0" Command="{Binding Remove}" AutomationProperties.Name="{Binding Title, StringFormat='Remove {0}'}">
                                                            <local:LineIcon Kind="Trash" Size="16" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- One text: waiting, or its proposed words -->
                            <StackPanel Spacing="10" IsVisible="{Binding IsDetailOpen}">
                                <Border Classes="part" IsVisible="{Binding IsDetailWaiting}">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <local:LineIcon Kind="Pc" Size="24" Foreground="{DynamicResource VocabAccent}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Text="Waiting for Claude Code to pick the words. It starts by itself." />
                                    </Grid>
                                </Border>
                                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding HasProposals}">
                                    <TextBlock Text="Words to look at" Classes="label" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="flat" FontSize="14" Foreground="{DynamicResource VocabAccent}" Padding="6,4" Command="{Binding SelectAllCommand}" Content="All"
                                            AutomationProperties.Name="Tick every new word" />
                                    <Button Grid.Column="2" Classes="flat" FontSize="14" Foreground="{DynamicResource VocabAccent}" Padding="6,4" Command="{Binding SelectNoneCommand}" Content="None"
                                            AutomationProperties.Name="Untick every word" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Proposals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VocabProposalRow">
                                            <Border Classes="lrow">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <CheckBox IsChecked="{Binding IsChosen, Mode=TwoWay}" IsEnabled="{Binding CanTick}" MinWidth="0" VerticalAlignment="Top"
                                                              AutomationProperties.Name="{Binding Word, StringFormat='Add {0}'}" />
                                                    <StackPanel Grid.Column="1" Margin="4,6,0,6" Spacing="2">
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding Word}" FontSize="17" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Bottom" />
                                                            <TextBlock Text="{Binding Phonetic}" FontSize="13" Foreground="{DynamicResource HelmSecondaryText}" IsVisible="{Binding HasPhonetic}"
                                                                       VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding Meaning}" FontSize="14" Foreground="{DynamicResource VocabText2}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Sentence}" Classes="hint" FontStyle="Italic" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Reason}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasReason}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Classes="tag acc" Margin="10,8,0,0" VerticalAlignment="Top" IsVisible="{Binding IsAdded}">
                                                        <TextBlock Text="Added" />
                                                    </Border>
                                                    <Border Grid.Column="2" Classes="tag" Margin="10,8,0,0" VerticalAlignment="Top" IsVisible="{Binding AlreadyThere}">
                                                        <TextBlock Text="Already yours" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="The text" Classes="label" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding DetailBody}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- ===== Add words ===== -->
        <Panel IsVisible="{Binding IsAddOpen}">
            <Border Classes="scrim" PointerPressed="Scrim_PointerPressed" />
            <Border Classes="sheet" MaxHeight="{Binding #Self.Bounds.Height, Converter={x:Static local:VocabConverters.SheetHeight}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Border Classes="grab" />
                        <Grid ColumnDefinitions="*,Auto" Margin="20,8,8,4">
                            <TextBlock Classes="sheettitle" Text="Add words" />
                            <Button Grid.Column="1" Classes="icon" Margin="8,0,0,0" Command="{Binding CloseAddCommand}" AutomationProperties.Name="Close">
                                <local:LineIcon Kind="X" Size="22" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Classes="sheetfoot">
                        <Button Classes="accent tall" HorizontalAlignment="Stretch" Command="{Binding AddCommand}" AutomationProperties.Name="Add">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:LineIcon Kind="Plus" Size="18" VerticalAlignment="Center" />
                                <TextBlock Text="Add" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,8,20,20" Spacing="14">
                            <Border Classes="infobar" IsVisible="{Binding HasMessage}" Margin="0">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Word" Classes="label" />
                                <TextBox PlaceholderText="relative, 补救…" Text="{Binding NewWord}" FontSize="20" MinHeight="52" AutomationProperties.Name="New word">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Where you met it (optional)" Classes="label" />
                                <TextBox Text="{Binding NewNote}" AutomationProperties.Name="Where you met it" />
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource HelmSecondaryText}" FontSize="13"><Run Text="Several at once with commas. Anywhere on the phone: select a word, then tap " /><Run Text="Add word" FontWeight="Bold" /><Run Text="." /></TextBlock>
                            <StackPanel IsVisible="{Binding HasRecentWords}">
                                <TextBlock Text="Added recently" Classes="label" />
                                <ItemsControl ItemsSource="{Binding RecentWords}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VocabWordRow">
                                            <!-- .lrow: the word, where it was met, its state, ✕ while it waits; 10 apart -->
                                            <Border Classes="lrow">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <Button Classes="flat" Padding="0" MinHeight="47" Command="{Binding Open}" Click="CloseAdd_Click" IsHitTestVisible="{Binding !IsPending}"
                                                            AutomationProperties.Name="{Binding Text}">
                                                        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Text}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="hint" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                    <Border Grid.Column="1" Classes="tag warn" Margin="10,0,0,0" IsVisible="{Binding IsPending}">
                                                        <TextBlock Text="Waiting" />
                                                    </Border>
                                                    <Border Grid.Column="1" Classes="tag acc" Margin="10,0,0,0" IsVisible="{Binding !IsPending}">
                                                        <TextBlock Text="Ready" />
                                                    </Border>
                                                    <Button Grid.Column="2" Classes="icon" Margin="10,0,0,0" Command="{Binding Remove}" IsVisible="{Binding CanRemove}"
                                                            AutomationProperties.Name="{Binding Text, StringFormat='Remove {0}'}">
                                                        <local:LineIcon Kind="X" Size="16" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- ===== Analysis ===== -->
        <Panel IsVisible="{Binding IsAgentOpen}">
            <Border Classes="scrim" PointerPressed="Scrim_PointerPressed" />
            <Border Classes="sheet" MaxHeight="{Binding #Self.Bounds.Height, Converter={x:Static local:VocabConverters.SheetHeight}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Border Classes="grab" />
                        <Grid ColumnDefinitions="*,Auto" Margin="20,8,8,4">
                            <TextBlock Classes="sheettitle" Text="Analysis" />
                            <Button Grid.Column="1" Classes="icon" Margin="8,0,0,0" Command="{Binding CloseAgentCommand}" AutomationProperties.Name="Close">
                                <local:LineIcon Kind="X" Size="22" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,8,20,20" Spacing="14">
                            <!-- .part as a row: the PC, 12 from its text -->
                            <Border Classes="part">
                                <Grid ColumnDefinitions="Auto,*">
                                    <local:LineIcon Kind="Pc" Size="24" Foreground="{DynamicResource VocabAccent}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Text="Claude Code on your PC breaks these down while Helm runs there. They come back here through sync." />
                                </Grid>
                            </Border>
                            <Border Classes="infobar" IsVisible="{Binding HasMessage}" Margin="0">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding PendingCount, StringFormat='Waiting ({0})'}" Classes="label" />
                                <TextBlock Text="Nothing waits." Classes="hint" Margin="0,8,0,0" IsVisible="{Binding !HasPending}" />
                                <ItemsControl ItemsSource="{Binding PendingWords}" IsVisible="{Binding HasPending}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VocabWordRow">
                                            <Border Classes="lrow">
                                                <Grid ColumnDefinitions="*,Auto,Auto">
                                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Note}" Classes="hint" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                    <Button Grid.Column="2" Classes="icon" Margin="10,0,0,0" Command="{Binding Remove}" IsVisible="{Binding CanRemove}"
                                                            AutomationProperties.Name="{Binding Text, StringFormat='Remove {0}'}">
                                                        <local:LineIcon Kind="X" Size="16" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Panel>

        <!-- ===== Edit the word (92% high; only ✕ or Save closes it) ===== -->
        <Panel IsVisible="{Binding Detail.Editor.IsOpen, FallbackValue=False}">
            <Border Classes="scrim" />
            <local:VocabEditSheet DataContext="{Binding Detail}" Height="{Binding #Self.Bounds.Height, Converter={x:Static local:VocabConverters.FullSheetHeight}}" />
        </Panel>

        <!-- ===== Ask for a new analysis (not in the design: the ⋯ menu's row opens it) ===== -->
        <Panel IsVisible="{Binding Detail.IsAskingRedo, FallbackValue=False}">
            <Border Classes="scrim" PointerPressed="Scrim_PointerPressed" />
            <Border Classes="sheet" DataContext="{Binding Detail}" x:DataType="vm:VocabWordDetailViewModel">
                <StackPanel>
                    <Border Classes="grab" />
                    <TextBlock Classes="sheettitle" Text="Ask for a new analysis" Margin="20,8,8,4" />
                    <StackPanel Margin="20,8,20,20" Spacing="14">
                        <TextBlock Classes="hint" FontSize="14"
                                   Text="It goes back to the agent with your note; the word waits until Claude Code on your PC analyzes it again." />
                        <TextBox PlaceholderText="What should change? e.g. tách lat thành ferre" Text="{Binding RedoNote}" TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="88" AutomationProperties.Name="What should change" />
                    </StackPanel>
                    <Border Classes="sheetfoot">
                        <Grid ColumnDefinitions="*,10,*">
                            <Button Classes="tall" HorizontalAlignment="Stretch" Content="Cancel" Command="{Binding BeginRedoCommand}" />
                            <Button Grid.Column="2" Classes="accent tall" HorizontalAlignment="Stretch" Content="Send back" Command="{Binding SendRedoCommand}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</UserControl>
