<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:vm="using:Helm.Modules.Vocab"
             xmlns:local="using:Helm.Modules.Vocab"
             x:Class="Helm.Modules.Vocab.VocabRootsView"
             x:DataType="vm:VocabRootsViewModel">

    <!-- The Roots tab: the families (parts several words share) as cards, the biggest first; Practise turns it into a
         card that asks a root's meaning; a family opened takes the whole tab (the app bar walks the families). -->
    <StackPanel Spacing="10">
        <!-- ===== The families: 10 between the rows ===== -->
        <StackPanel Spacing="10">
            <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="ShowsList" />
                    <Binding Path="!HasPractice" />
                </MultiBinding>
            </StackPanel.IsVisible>
            <Grid ColumnDefinitions="*,8,Auto">
                <Border Classes="seg">
                    <Grid ColumnDefinitions="*,2,*">
                        <Button Classes="seg" Classes.on="{Binding IsEnglish}" Command="{Binding ShowEnglishCommand}" AutomationProperties.Name="English roots">
                            <TextBlock><Run Text="English " /><Run Text="{Binding EnglishCount}" FontSize="13" Foreground="{DynamicResource HelmSecondaryText}" /></TextBlock>
                        </Button>
                        <Button Grid.Column="2" Classes="seg" Classes.on="{Binding IsChinese}" Command="{Binding ShowChineseCommand}" AutomationProperties.Name="Chinese parts">
                            <TextBlock><Run Text="中文 " /><Run Text="{Binding ChineseCount}" FontSize="13" Foreground="{DynamicResource HelmSecondaryText}" /></TextBlock>
                        </Button>
                    </Grid>
                </Border>
                <Button Grid.Column="2" Classes="tall sm" MinHeight="44" Command="{Binding NextRootCommand}" IsVisible="{Binding HasRoots}" AutomationProperties.Name="Practise roots">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <local:LineIcon Kind="Cap" Size="18" VerticalAlignment="Center" />
                        <TextBlock Text="Practise" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Classes="card" Padding="16,12" IsVisible="{Binding HasNoRoots}">
                <TextBlock Classes="hint" FontSize="14" Margin="0,8"
                           Text="The parts of your words show up here once they are broken down; a part shared by several words makes a family." />
            </Border>

            <ItemsControl ItemsSource="{Binding Roots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VocabRootRow">
                        <StackPanel Spacing="10">
                            <!-- h2.sh, 6 more above it -->
                            <TextBlock Text="{Binding Header}" Classes="label" Margin="0,6,0,0" IsVisible="{Binding HasHeader}" />
                            <!-- .fam: padding 14 16, 6 between its lines -->
                            <Button Classes="fam" Command="{Binding Select}" AutomationProperties.Name="{Binding Form}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="{Binding Form}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" Classes="hint" Margin="8,0,0,3" VerticalAlignment="Bottom" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="hint" Margin="8,0,0,3" VerticalAlignment="Bottom" TextWrapping="NoWrap" />
                                    </Grid>
                                    <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding FirstWords}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemSpacing="12" LineSpacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:VocabWordLink">
                                                <TextBlock FontSize="14"><Run Text="{Binding Split.Before}" /><Run Classes="hl" Text="{Binding Split.Match}" /><Run Text="{Binding Split.After}" /></TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding MoreWordsText}" Classes="hint" FontSize="12" IsVisible="{Binding HasMoreWords}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Not in the design: a page at a time -->
            <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Pages.HasPages}">
                <Button Classes="icon" Command="{Binding Pages.PreviousPageCommand}" AutomationProperties.Name="Previous page">
                    <local:LineIcon Kind="Left" Size="20" />
                </Button>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Pages.PageText}" FontSize="14" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Pages.RangeText}" Classes="hint" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" Classes="icon" Command="{Binding Pages.NextPageCommand}" AutomationProperties.Name="Next page">
                    <local:LineIcon Kind="Right" Size="20" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- ===== Practising a root: like a Learn card (Stop, Show the meaning and Next root are in the bottom bar) ===== -->
        <Border Classes="card" Padding="0">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="ShowsList" />
                    <Binding Path="HasPractice" />
                </MultiBinding>
            </Border.IsVisible>
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,6,4,0">
                    <Border Classes="tag acc">
                        <TextBlock Text="Root practice" />
                    </Border>
                    <Button Grid.Column="2" Classes="icon" Command="{Binding ClosePracticeCommand}" AutomationProperties.Name="Stop practising">
                        <local:LineIcon Kind="X" Size="20" />
                    </Button>
                </Grid>
                <Button Classes="front" MinHeight="240" Command="{Binding RevealRootCommand}" AutomationProperties.Name="Show the meaning">
                    <StackPanel Spacing="10">
                        <TextBlock Text="What does this part mean?" Classes="hint" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Practice.Form}" FontSize="52" FontWeight="SemiBold" LineHeight="57.2" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Practice.Kind}" Classes="hint" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border IsVisible="{Binding IsPracticeRevealed}" Margin="16,0" Padding="0,16,0,20" BorderBrush="{DynamicResource VocabLine}" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Practice.Meaning}" FontSize="20" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{Binding Practice.Origin}" Classes="hint" HorizontalAlignment="Center" TextAlignment="Center" IsVisible="{Binding Practice.HasOrigin}" />
                        <ItemsControl ItemsSource="{Binding Practice.Words}" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemSpacing="6" LineSpacing="6" ItemsAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VocabWordLink">
                                    <Button Classes="wl" Command="{Binding Open}" AutomationProperties.Name="{Binding Text}">
                                        <TextBlock><Run Text="{Binding Split.Before}" /><Run Classes="hl" Text="{Binding Split.Match}" /><Run Text="{Binding Split.After}" /></TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== A family opened: 12 between its cards ===== -->
        <StackPanel Spacing="12" IsVisible="{Binding HasSelected}">
            <Border Classes="card" Padding="16">
                <StackPanel Spacing="6">
                    <WrapPanel>
                        <TextBlock Text="{Binding Selected.Form}" FontSize="34" FontWeight="SemiBold" LineHeight="37.4" Margin="0,0,10,0" VerticalAlignment="Bottom" />
                        <Border Classes="tag" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Selected.Kind}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding Selected.Meaning}" FontSize="18" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Selected.Origin}" Classes="hint" FontSize="14" IsVisible="{Binding Selected.HasOrigin}" />
                    <!-- The design's "Suggest 3 more words" runs Claude Code, which is on the PC only -->
                    <TextBlock Classes="hint" FontSize="12" Margin="0,8,0,0"
                               Text="More words of this family: on the PC, Helm's Roots tab has Suggest 3 more words (Claude Code)." />
                </StackPanel>
            </Border>
            <Border Classes="card" Padding="0" ClipToBounds="True">
                <StackPanel>
                    <TextBlock Text="{Binding Selected.Words.Count, StringFormat='Your words with it ({0})', FallbackValue=''}" Classes="label" Margin="16,14,16,6" />
                    <ItemsControl ItemsSource="{Binding Selected.Words}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VocabWordLink">
                                <Button Classes="prow" Command="{Binding Open}" AutomationProperties.Name="{Binding Text}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="17" FontWeight="SemiBold"><Run Text="{Binding Split.Before}" /><Run Classes="hl" Text="{Binding Split.Match}" /><Run Text="{Binding Split.After}" /></TextBlock>
                                            <TextBlock Text="{Binding Meaning}" Classes="hint" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Dots}" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:Boolean">
                                                    <Ellipse Classes="dot" Classes.on="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
