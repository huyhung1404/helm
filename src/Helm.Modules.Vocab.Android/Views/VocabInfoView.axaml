<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Helm.Modules.Vocab"
             xmlns:local="using:Helm.Modules.Vocab"
             x:Class="Helm.Modules.Vocab.VocabInfoView"
             x:DataType="vm:VocabWordInfo">

    <!-- What helps to use a word, one collapsible section each, in the design's order: the mnemonic (a blue box under a
         blue title), examples, collocations, its family, similar and opposite words, words easy to mix up (amber).
         Sections without content are left out; 8 between the lines of a section. -->
    <StackPanel>
        <local:VocabSection Classes="memo" Title="To remember it" Key="info.mnemonic" IsVisible="{Binding HasMnemonic}">
            <Border Classes="memo">
                <TextBlock Text="{Binding Mnemonic}" TextWrapping="Wrap" FontStyle="Italic" />
            </Border>
        </local:VocabSection>

        <local:VocabSection Title="Examples" Key="info.examples" IsVisible="{Binding HasExamples}">
            <ItemsControl ItemsSource="{Binding Examples}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VocabExample">
                        <Border Classes="ex">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Translation}" Classes="hint" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </local:VocabSection>

        <local:VocabSection Title="Goes with" Key="info.collocations" IsVisible="{Binding HasCollocations}">
            <TextBlock Text="{Binding Collocations}" TextWrapping="Wrap" />
        </local:VocabSection>

        <local:VocabSection Title="Word family" Key="info.forms" IsVisible="{Binding HasForms}">
            <ItemsControl ItemsSource="{Binding Forms}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VocabForm">
                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding Word}" FontWeight="Bold" /><Run Text=" " /><Run Text="{Binding PartOfSpeech}" FontSize="13" Foreground="{DynamicResource HelmSecondaryText}" /><Run Text=" · " /><Run Text="{Binding Meaning}" /></TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </local:VocabSection>

        <local:VocabSection Title="Similar · opposite" Key="info.similar">
            <local:VocabSection.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="HasSynonyms" />
                    <Binding Path="HasAntonyms" />
                </MultiBinding>
            </local:VocabSection.IsVisible>
            <TextBlock Text="{Binding SimilarOpposite}" TextWrapping="Wrap" />
        </local:VocabSection>

        <local:VocabSection Classes="warn" Title="Easy to mix up with" Key="info.confusables" IsVisible="{Binding HasConfusables}">
            <ItemsControl ItemsSource="{Binding Confusables}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding Converter={x:Static local:VocabConverters.MixWord}}" FontWeight="Bold" /><Run Text="{Binding Converter={x:Static local:VocabConverters.MixNote}}" /></TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </local:VocabSection>
    </StackPanel>
</UserControl>
