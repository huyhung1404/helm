<Project Sdk="Microsoft.NET.Sdk">

  <!-- Scratch logic shared by the Windows and Android apps: data model, store (records on Helm Sync, files as encrypted
       blobs), the page view model. No WPF, Avalonia or platform APIs here. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Modules.Scratch</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core\Helm.Core.csproj" />
    <!-- IDialogService / IClipboardService / IDeviceInfo: the portable seams both apps already implement. -->
    <ProjectReference Include="..\Helm.Shell\Helm.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>
