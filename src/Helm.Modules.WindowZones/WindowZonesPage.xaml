<core:ModulePageBase
    x:Class="Helm.Modules.WindowZones.WindowZonesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.WindowZones"
    Module="{Binding Module}">

    <!-- Window Zones' settings (Home → Utilities). The zones and their windows are on WindowZonesContentPage. -->
    <StackPanel>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:ImageIcon Width="24" Height="24" Source="{x:Static local:WindowZonesLogo.Image}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <core:CardHeader Title="Open Window Zones" Description="See your zones and the windows in them, name them and draw new ones. Also in the menu and on Home." />
            </ui:CardControl.Header>
            <ui:Button Appearance="Primary" Content="Open Window Zones" Click="OpenZones_Click" />
        </ui:CardControl>

        <!-- Shortcuts -->
        <TextBlock Text="Shortcuts" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Keyboard24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Open or close a zone" Description="With the zone's number. Closed: its windows come back. Behind other apps: it comes to the front. In front: its windows are minimized." />
            </ui:CardControl.Header>
            <ComboBox MinWidth="190" AutomationProperties.Name="Open or close a zone" ItemsSource="{Binding ZoneModifierNames}" SelectedIndex="{Binding ZoneModifiersIndex}" />
        </ui:CardControl>
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon TabDesktopArrowClockwise24}" IsExpanded="True">
            <ui:CardExpander.Header>
                <core:CardHeader Title="Switch windows in a zone" Description="Only while the window in front shares its zone with others; otherwise the keys go to the app." />
            </ui:CardExpander.Header>
            <StackPanel>
                <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                    <core:RowLayout>
                        <core:CardHeader Title="Next window" />
                        <core:HotkeyPicker Gesture="{Binding NextWindowHotkey}" DefaultGesture="{Binding DefaultNextWindowHotkey}" AutomationProperties.Name="Next window" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Previous window" />
                        <core:HotkeyPicker Gesture="{Binding PreviousWindowHotkey}" DefaultGesture="{Binding DefaultPreviousWindowHotkey}" AutomationProperties.Name="Previous window" />
                    </core:RowLayout>
                </Border>
            </StackPanel>
        </ui:CardExpander>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon SlideLayout24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Zone editor shortcut" Description="Opens the editor on every monitor to draw, move and resize zones." />
            </ui:CardControl.Header>
            <core:HotkeyPicker Gesture="{Binding EditorHotkey}" DefaultGesture="{Binding DefaultEditorHotkey}" AutomationProperties.Name="Zone editor shortcut" />
        </ui:CardControl>

        <!-- Behavior -->
        <TextBlock Text="Behavior" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon CursorHover24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Key to hold while dragging" Description="Hold it while you drag a window by its title bar: the zones show, drop the window in one and it fits it." />
            </ui:CardControl.Header>
            <ComboBox Width="120" AutomationProperties.Name="Key to hold while dragging" ItemsSource="{Binding DragKeyNames}" SelectedIndex="{Binding DragKeyIndex}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowMaximize24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Own size back when dragged out" Description="A window dragged out of its zone gets back the size it had before it went in." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="Own size back when dragged out" IsChecked="{Binding RestoreSizeOnLeave}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon TabDesktop24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Show the zone's windows as tabs" Description="For a moment at the top of the zone, when you switch windows or open it." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="Show the zone's windows as tabs" IsChecked="{Binding ShowTabStrip}" />
        </ui:CardControl>

        <!-- Appearance -->
        <TextBlock Text="Appearance" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Eye24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Zone opacity" Description="How solid the zones look while you drag a window. Lower shows more of the desktop." />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <Slider Width="180" VerticalAlignment="Center" Minimum="{Binding MinOpacity}" Maximum="{Binding MaxOpacity}"
                        TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                        Value="{Binding ZoneOpacity}" AutomationProperties.Name="Zone opacity" />
                <TextBlock Width="44" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ZoneOpacityText}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon NumberSymbol24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Show zone numbers" Description="The number (and name) of each zone while you drag a window." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="Show zone numbers" IsChecked="{Binding ShowZoneNumbers}" />
        </ui:CardControl>

        <!-- Excluded apps -->
        <TextBlock Text="Excluded apps" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Prohibited24}">
            <ui:CardExpander.Header>
                <core:CardHeader Title="Excluded apps" Description="Process names whose windows never go into a zone, one per line (e.g. a game)." />
            </ui:CardExpander.Header>
            <ui:TextBox Text="{Binding ExcludedAppsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                        MinHeight="100" MaxHeight="240" VerticalScrollBarVisibility="Auto" PlaceholderText="Example: game.exe"
                        AutomationProperties.Name="Excluded apps" />
        </ui:CardExpander>
    </StackPanel>
</core:ModulePageBase>
