<Page x:Class="Helm.Modules.WindowZones.WindowZonesContentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uiw="clr-namespace:Helm.Ui.Windows;assembly=Helm.Ui.Windows"
      ScrollViewer.CanContentScroll="False"
      Title="Window Zones">

    <!-- Window Zones (the screens, a card per zone, the zone editor sheet, the settings sheet) is the shared Avalonia
         page, Helm.Modules.WindowZones.UI/WindowZonesView. This WPF page only hosts it; the full-screen editor
         ("Edit on the screens") is still the app's own window. -->
    <uiw:AvaloniaHost x:Name="Host" />
</Page>
