<ui:ModulePageBase xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="using:Helm.Core.Ui"
                   xmlns:vm="using:Helm.Modules.NovelReader"
                   xmlns:speech="using:Helm.Modules.NovelReader.Speech"
                   xmlns:vieneu="using:Helm.Modules.NovelReader.Speech.VieNeu"
                   x:Class="Helm.Modules.NovelReader.NovelReaderPage"
                   x:DataType="vm:NovelReaderViewModel">

    <!-- Novel Reader's settings (Home → Utilities). Reading is on NovelReaderContentPage. -->
    <StackPanel>
        <Border Classes="infobar" IsVisible="{Binding HasMessage}">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Open Novel Reader" Classes="title" />
                <TextBlock Text="Your novels, where you stopped reading and the names you fixed, from every device. Also in the menu and on Home." Classes="secondary" />
                <Button Classes="accent" Content="Open Novel Reader" Click="OpenReader_Click" />
            </StackPanel>
        </Border>

        <!-- Novel Lens -->
        <TextBlock Text="Novel Lens" Classes="section" />
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Read Fanqie's pages in study form" Classes="title" />
                <TextBlock Text="While the Fanqie app (番茄小说) is open, a 译 button floats over it. Press it: Helm reads the page shown (recognised on the phone, offline) and covers the screen with it, each word with its Chinese, pinyin, Hán Việt and Vietnamese. Next turns Fanqie's page and reads the new one. Nothing of the pages is saved." Classes="secondary" />
                <TextBlock x:Name="LensState" Classes="secondary" />
                <Button x:Name="LensButton" Content="Accessibility settings" Click="LensSettings_Click" />
                <Border Classes="row">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Names from" />
                        <ComboBox x:Name="LensBook" HorizontalAlignment="Stretch" SelectionChanged="LensBook_SelectionChanged" AutomationProperties.Name="Names from" />
                        <TextBlock Text="The names you fixed for this novel are used on the lens's pages too, with the names for every novel. Tap a word on the lens to save a name or a meaning." Classes="secondary" />
                        <TextBlock Text="A novel you read only in Fanqie: give it a novel here, by its title, to keep its names (it has no text in Novel Reader)." Classes="secondary" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Create" Click="LensCreate_Click" />
                            <TextBox x:Name="LensNewTitle" PlaceholderText="The novel's title" AutomationProperties.Name="New novel for names" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Classes="row">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="LensTapLabel" />
                        <TextBlock Text="Where Next taps Fanqie to turn the page, from the left edge (Back taps the same distance from the right)." Classes="secondary" />
                        <Slider x:Name="LensTap" Minimum="0.6" Maximum="0.98" SmallChange="0.02" TickFrequency="0.02" IsSnapToTickEnabled="True"
                                ValueChanged="LensTap_ValueChanged" AutomationProperties.Name="Where Next taps" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Dictionaries -->
        <TextBlock Text="Dictionaries" Classes="section" />
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="QuickTranslator dictionaries" Classes="title" />
                <TextBlock Text="{Binding DictionaryStatus}" Classes="secondary" />
                <TextBlock Text="Dictionaries added on your PC arrive here through Helm Sync. You can also download them on the phone (about 30 MB)." Classes="secondary" />
                <WrapPanel>
                    <Button Margin="0,0,8,8" Content="Download dictionaries" Command="{Binding DownloadDictionariesCommand}" IsEnabled="{Binding !IsDownloading}" />
                    <Button Margin="0,0,8,8" Content="Cancel" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsDownloading}" />
                    <Button Margin="0,0,8,8" Content="Import files" Click="ImportDictionaries_Click" />
                </WrapPanel>
                <TextBlock Text="{Binding DownloadStatus}" Classes="secondary" />
            </StackPanel>
        </Border>

        <!-- Reading aloud -->
        <TextBlock Text="Reading aloud" Classes="section" />
        <Border Classes="card">
            <StackPanel Spacing="8">
                <!-- VieNeu: natural Vietnamese voices that run in Helm, downloaded once -->
                <StackPanel Spacing="4" DataContext="{Binding VieNeu}" x:DataType="vieneu:VieNeuVoiceViewModel">
                    <TextBlock Text="VieNeu voices (Vietnamese)" Classes="title" />
                    <TextBlock Text="{Binding Status}" Classes="secondary" TextWrapping="Wrap" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding IsDownloading}" />
                    <WrapPanel>
                        <Button Margin="0,0,8,8" Content="{Binding Size, StringFormat='Download ({0})'}" Command="{Binding DownloadCommand}" IsVisible="{Binding CanDownload}" />
                        <Button Margin="0,0,8,8" Content="Stop" Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloading}" />
                        <Button Margin="0,0,8,8" Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding IsInstalled}" />
                    </WrapPanel>
                    <TextBlock Text="Eleven women's voices of VieNeu-TTS v3 Turbo (Ngọc Huyền first). They run in Helm, offline; the text never leaves the phone. Download on Wi-Fi." Classes="secondary" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Text="Voice" Classes="title" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" AutomationProperties.Name="Voice">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="speech:SpeechVoice">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Text="{Binding Description}" Classes="secondary" IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="VieNeu's voices once they are downloaded, and the phone's own Vietnamese voices. Sound is held in memory while you listen, never saved." Classes="secondary" />
                <WrapPanel>
                    <Button Margin="0,0,8,8" Content="Listen" Click="Listen_Click" />
                    <Button Margin="0,0,8,8" Content="Get Vietnamese voices" Click="InstallVoices_Click" />
                    <Button Margin="0,0,8,8" Content="Text-to-speech settings" Click="VoiceSettings_Click" />
                </WrapPanel>
                <TextBlock x:Name="ListenNote" Classes="secondary" IsVisible="False" />

                <Border Classes="row">
                    <StackPanel Spacing="4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SpeechRateLabel}" />
                            <TextBlock Text="Speed" />
                        </DockPanel>
                        <Slider Minimum="0.5" Maximum="3" SmallChange="0.1" LargeChange="0.25" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="{Binding SpeechRate}" AutomationProperties.Name="Speed" />
                    </StackPanel>
                </Border>
                <Border Classes="row" IsEnabled="{Binding SupportsPitch}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Pitch" />
                        <Slider Minimum="0.5" Maximum="2" SmallChange="0.1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                Value="{Binding SpeechPitch}" AutomationProperties.Name="Pitch" />
                    </StackPanel>
                </Border>
                <Border Classes="row">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Volume" />
                        <Slider Minimum="0" Maximum="1" SmallChange="0.05" Value="{Binding SpeechVolume}" AutomationProperties.Name="Volume" />
                    </StackPanel>
                </Border>
                <Border Classes="row">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Pause between paragraphs" />
                        <Slider Minimum="0" Maximum="2" SmallChange="0.05" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                Value="{Binding ParagraphPause}" AutomationProperties.Name="Pause between paragraphs" />
                    </StackPanel>
                </Border>
                <Border Classes="row">
                    <DockPanel>
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ContinueToNextChapter}" OnContent="" OffContent="" AutomationProperties.Name="Go on to the next chapter" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Go on to the next chapter" />
                            <TextBlock Text="Keeps reading chapter after chapter, also with the screen off." Classes="secondary" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Classes="row" IsEnabled="{Binding ContinueToNextChapter}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding PrefetchChapters, StringFormat='Chapters downloaded ahead: {0}'}" />
                        <TextBlock Text="The sentences ahead are downloaded up to this many chapters past the one being read, no further." Classes="secondary" />
                        <Slider Minimum="1" Maximum="10" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding PrefetchChapters}" AutomationProperties.Name="Chapters downloaded ahead" />
                    </StackPanel>
                </Border>
                <Border Classes="row">
                    <DockPanel>
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding FallbackToOfflineVoice}" OnContent="" OffContent="" AutomationProperties.Name="Use an offline voice when offline" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Use an offline voice when offline" />
                            <TextBlock Text="When an online voice cannot be reached, an offline Vietnamese voice reads on." Classes="secondary" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Finding names -->
        <TextBlock Text="Finding names" Classes="section" />
        <Border Classes="card">
            <StackPanel Spacing="8">
                <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding AutoScanNames}" OnContent="" OffContent="" AutomationProperties.Name="Find names when a novel is opened" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Find names when a novel is opened" />
                        <TextBlock Text="The first time, its character names are looked for and the sure ones added, marked as found. Undo them in Names; a name you delete is not added again." Classes="secondary" />
                    </StackPanel>
                </DockPanel>
                <Border Classes="row">
                    <TextBlock Text="Found from how words are used in the novel (free, offline). Finding names with AI runs in Helm on your PC, with Claude Code; the names it finds sync here." Classes="secondary" />
                </Border>
            </StackPanel>
        </Border>

        <!-- In the background -->
        <TextBlock Text="With the screen off" Classes="section" />
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Reading in the background" Classes="title" />
                <TextBlock Text="Novel Reader keeps reading with Helm in the background or the screen off, and goes on to the next chapter. Pause, skip and stop from the notification, the lock screen or your headphones. Unplugging headphones or a call pauses it." Classes="secondary" />
                <TextBlock x:Name="BatteryNote" Classes="secondary" />
                <Button Content="Battery settings" Click="Battery_Click" />
            </StackPanel>
        </Border>


        <!-- The text -->
        <TextBlock Text="Text" Classes="section" />
        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Show" Classes="title" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ModeNames}" SelectedIndex="{Binding ModeIndex}" AutomationProperties.Name="What the page shows" />
                <Border Classes="row">
                    <DockPanel>
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding PrioritizeNames}" OnContent="" OffContent="" AutomationProperties.Name="Names first" />
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Names first" />
                            <TextBlock Text="A name wins over a longer phrase that starts before it." Classes="secondary" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Classes="row">
                    <DockPanel>
                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShowChinese}" OnContent="" OffContent="" AutomationProperties.Name="Show the Chinese" />
                        <TextBlock Text="Show the Chinese under each paragraph" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                <Border Classes="row">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Font size" />
                        <Slider Minimum="12" Maximum="40" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" AutomationProperties.Name="Font size" />
                    </StackPanel>
                </Border>
                <Border Classes="row">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Line spacing" />
                        <Slider Minimum="1" Maximum="3" SmallChange="0.1" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding LineSpacing}" AutomationProperties.Name="Line spacing" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</ui:ModulePageBase>
