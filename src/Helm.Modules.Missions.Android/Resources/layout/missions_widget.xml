<?xml version="1.0" encoding="utf-8"?>
<!-- The Missions widget: up to three missions in progress, each with the step it is on and its progress. A fixed
     layout (no list), so it needs no RemoteViewsService; a tap anywhere opens Missions. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/missions_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/missions_widget_background"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/missions_notification"
                android:tint="@color/missions_widget_accent"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Missions"
                android:textColor="@color/missions_widget_text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true" />
            <TextView
                android:id="@+id/missions_widget_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/missions_widget_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/missions_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/missions_widget_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/missions_widget_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/missions_widget_title1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/missions_widget_secondary"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/missions_widget_step1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/missions_widget_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <ProgressBar
                android:id="@+id/missions_widget_bar1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressTint="@color/missions_widget_accent"
                android:progressBackgroundTint="@color/missions_widget_track" />
            <TextView
                android:id="@+id/missions_widget_progress1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/missions_widget_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/missions_widget_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/missions_widget_title2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/missions_widget_secondary"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/missions_widget_step2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/missions_widget_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <ProgressBar
                android:id="@+id/missions_widget_bar2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressTint="@color/missions_widget_accent"
                android:progressBackgroundTint="@color/missions_widget_track" />
            <TextView
                android:id="@+id/missions_widget_progress2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/missions_widget_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/missions_widget_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/missions_widget_title3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/missions_widget_secondary"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/missions_widget_step3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/missions_widget_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />
            <ProgressBar
                android:id="@+id/missions_widget_bar3"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressTint="@color/missions_widget_accent"
                android:progressBackgroundTint="@color/missions_widget_track" />
            <TextView
                android:id="@+id/missions_widget_progress3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/missions_widget_secondary"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
