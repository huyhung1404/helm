<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.SlackBot"
             xmlns:core="using:Helm.Core.Ui"
             x:Class="Helm.Modules.SlackBot.Ui.SlackBotSettingsView"
             x:DataType="vm:SlackBotViewModel">

    <!-- Slack Report's settings as a sheet over the page (the gear): on/off, the connection and the Slack app, what it
         reads, how Claude sorts, the list on screen, and the signature of posts by AI agents. One card per subject; a
         switch or a field on the right, or a label above a full-width field. -->
    <UserControl.Styles>
        <!-- A switch keeps clear of the text beside it -->
        <Style Selector="DockPanel > ToggleSwitch">
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <!-- A folded section's title keeps the text colour when open (Fluent paints a checked toggle's text for an accent fill) -->
        <Style Selector="ToggleButton.fold:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        </Style>
        <Style Selector="Border.step">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStrokeStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style Selector="Border.step > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HelmEyebrow}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.preview">
            <Setter Property="Background" Value="{DynamicResource HelmSubtleFill}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Classes="eyebrow" Text="SLACK REPORT" />
                <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="1" Classes="chip" VerticalAlignment="Top" ToolTip.Tip="Close" AutomationProperties.Name="Close settings">
                <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
            </Button>
        </Grid>

        <!-- On or off: off keeps what it read (read only) and stops reading Slack -->
        <Border Classes="glass">
            <DockPanel>
                <ToggleSwitch x:Name="EnableSwitch" DockPanel.Dock="Right" OnContent="" OffContent="" AutomationProperties.Name="Slack Report on or off" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Slack Report is on" Classes="head" />
                    <TextBlock Text="Off stops reading Slack. What it kept stays on the page, read only." Classes="secondary" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The connection, and the Slack app it reads through -->
        <Border Classes="glass">
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Slack" Classes="head" />
                    <TextBlock Text="{Binding Status}" Classes="secondary" TextWrapping="Wrap" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding HasTokens}">
                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ReconnectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="ArrowSync" FontSize="15" />
                            <TextBlock Text="Reconnect" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding DisconnectCommand}"
                            ToolTip.Tip="Removes the tokens from this PC" AutomationProperties.Name="Disconnect">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="PlugDisconnected" FontSize="15" Foreground="{DynamicResource HelmDanger}" />
                            <TextBlock Text="Disconnect" Foreground="{DynamicResource HelmDanger}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Classes="secondary" IsVisible="{Binding HasTokens}"
                           Text="Disconnect removes the tokens from this PC. What Slack Report kept stays until it is two weeks old." />

                <!-- The Slack app: open on these steps until it is connected -->
                <ToggleButton x:Name="AppFold" Classes="fold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,6"
                              AutomationProperties.Name="Your Slack app">
                    <Grid ColumnDefinitions="Auto,*">
                        <Panel Width="12" Height="12" Margin="0,0,10,0" Classes="turn" core:Motion.Turn="{Binding #AppFold.IsChecked}" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="ChevronRight" FontSize="12" Foreground="{DynamicResource HelmSecondaryText}" />
                        </Panel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Your Slack app" FontWeight="SemiBold" />
                            <TextBlock Classes="secondary" Text="Slack Report reads Slack as you, through an app you make in your workspace. The tokens stay on this PC, encrypted." />
                        </StackPanel>
                    </Grid>
                </ToggleButton>
                <StackPanel x:Name="AppSteps" Spacing="16" IsVisible="{Binding #AppFold.IsChecked}" core:Motion.EnterOnShow="True" core:Motion.FromTop="True">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="step"><TextBlock Text="1" /></Border>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="Make the app" FontWeight="SemiBold" />
                            <TextBlock Classes="secondary"
                                       Text="Create New App → From a manifest → your workspace → paste the manifest → Create → Install to Workspace. Your workspace may ask an admin to approve it." />
                            <Grid x:Name="ManifestGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <Button x:Name="CopyManifestButton" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ic:SymbolIcon Symbol="Copy" FontSize="15" />
                                        <TextBlock x:Name="CopyManifestText" Text="Copy manifest" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="OpenAppsButton" Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding OpenSlackAppsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ic:SymbolIcon Symbol="Open" FontSize="15" />
                                        <TextBlock Text="Open Slack apps" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="step"><TextBlock Text="2" /></Border>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="User token" FontWeight="SemiBold" />
                            <TextBlock Classes="secondary" Text="OAuth &amp; Permissions → User OAuth Token (xoxp-…)." />
                            <TextBox x:Name="UserTokenBox" Classes="glass" PasswordChar="•" PlaceholderText="xoxp-…" AutomationProperties.Name="User token" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="step"><TextBlock Text="3" /></Border>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="App token" FontWeight="SemiBold" />
                            <TextBlock Classes="secondary" Text="Basic Information → App-Level Tokens → Generate, with the connections:write scope (xapp-…)." />
                            <TextBox x:Name="AppTokenBox" Classes="glass" PasswordChar="•" PlaceholderText="xapp-…" AutomationProperties.Name="App token" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="step"><TextBlock Text="4" /></Border>
                        <StackPanel Grid.Column="1" Spacing="8">
                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding TokenProblem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <ic:SymbolIcon Symbol="ErrorCircle" FontSize="16" Margin="0,1,8,0" VerticalAlignment="Top" Foreground="{DynamicResource HelmDanger}" />
                                <TextBlock Grid.Column="1" Text="{Binding TokenProblem}" Classes="late" TextWrapping="Wrap" />
                            </Grid>
                            <Button x:Name="ConnectButton" Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" AutomationProperties.Name="Connect">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <ic:SymbolIcon Symbol="PlugConnected" FontSize="15" Foreground="{DynamicResource HelmPillForeground}" />
                                    <TextBlock Text="Connect" Foreground="{DynamicResource HelmPillForeground}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Which conversations it reads, and where AI agents may post -->
        <Border Classes="glass">
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Channels and DMs" Classes="head" />
                    <TextBlock Text="{Binding ChannelsSummary}" Classes="secondary" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Classes="glass" PlaceholderText="Find a channel or person" Text="{Binding ChannelFilter}" AutomationProperties.Name="Find a channel">
                    <TextBox.InnerLeftContent>
                        <ic:SymbolIcon Symbol="Search" FontSize="15" Margin="10,0,0,0" Foreground="{DynamicResource HelmSecondaryText}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBlock Classes="secondary"
                           Text="Read: on your list and in the report. Write: AI agents (Fairy) may post there, signed as AI and asked first each time (needs Read). Slack Report never answers by itself. Both off: nothing from it is read, kept or shown to Claude, and what was kept is removed." />
                <Grid ColumnDefinitions="*,64,64" Margin="0,0,14,0">
                    <TextBlock Grid.Column="1" Text="Read" Classes="secondary" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Write" Classes="secondary" HorizontalAlignment="Center" />
                </Grid>
                <ScrollViewer MaxHeight="340" Padding="0,0,14,0" HorizontalScrollBarVisibility="Disabled" core:ScrollFade.Enabled="True">
                    <ItemsControl ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SlackChannelRow">
                                <Grid ColumnDefinitions="*,64,64" Margin="0,2">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                    <ToggleSwitch Grid.Column="1" HorizontalAlignment="Center" OnContent="" OffContent="" IsChecked="{Binding CanRead}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Read {0}'}" />
                                    <ToggleSwitch Grid.Column="2" HorizontalAlignment="Center" OnContent="" OffContent="" IsChecked="{Binding CanWrite}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat='Write in {0}'}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding CatchUpQuietDms}" OnContent="" OffContent="" AutomationProperties.Name="Catch up on quiet DMs" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Catch up on quiet DMs" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap"
                                   Text="Off: after Helm was off, only DMs with a message in the last 30 days are read back (fast). Quiet DMs still arrive live while Helm runs." />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ReadBots}" OnContent="" OffContent="" AutomationProperties.Name="Messages from bots and apps" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Messages from bots and apps" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Off: only those that call you by name are read." />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- How Claude sorts -->
        <Border Classes="glass">
            <StackPanel Spacing="12">
                <TextBlock Text="Sorting" Classes="head" />
                <StackPanel Spacing="6">
                    <TextBlock Text="What matters to you" />
                    <TextBlock Classes="secondary" Text="Your role, your projects, who you answer to: Claude reads it with every batch. Write it in any language." />
                    <TextBox Classes="glass" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" VerticalContentAlignment="Top" Padding="12,10" AutomationProperties.Name="What matters to you"
                             PlaceholderText="e.g. I lead the Unity client of game X. Build failures, release dates and questions from my lead need me."
                             Text="{Binding AboutMe, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
                <Grid x:Name="ModelGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="12">
                    <StackPanel x:Name="ModelField" Spacing="6">
                        <TextBlock Text="Claude model" />
                        <ComboBox x:Name="ModelBox" Classes="glass" HorizontalAlignment="Stretch" AutomationProperties.Name="Claude model" />
                    </StackPanel>
                    <StackPanel x:Name="EffortField" Grid.Column="1" Spacing="6">
                        <TextBlock Text="Effort" />
                        <ComboBox x:Name="EffortBox" Classes="glass" HorizontalAlignment="Stretch" AutomationProperties.Name="Effort" />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="secondary" Text="Effort is how hard Claude thinks: higher answers better, takes longer and uses more of your plan." />
                <StackPanel Spacing="6">
                    <TextBlock Text="Sort channel messages every" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox Classes="glass" Text="{Binding ChannelSeconds, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Sort channel messages every, in seconds" />
                        <TextBlock Grid.Column="1" Text="seconds" VerticalAlignment="Center" Classes="muted" />
                    </Grid>
                    <TextBlock Classes="secondary" Text="1800 = every 30 minutes; at least 10. Each run with new messages uses Claude Code. Messages for you are sorted within seconds anyway." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The report and the list on screen (Windows: over every app) -->
        <Border Classes="glass">
            <StackPanel Spacing="12">
                <TextBlock Text="On screen" Classes="head" />
                <StackPanel Spacing="6">
                    <TextBlock Text="Worth-knowing report times" />
                    <TextBox Classes="glass" Text="{Binding ReportTimes, UpdateSourceTrigger=LostFocus}" PlaceholderText="12:00, 17:00" AutomationProperties.Name="Report times" />
                    <TextBlock Classes="secondary" Text="Messages that need nothing from you wait and show up on the list together at these times of day. To-do messages show at once." />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="Remind me of what still waits" />
                    <ComboBox x:Name="RemindBox" Classes="glass" HorizontalAlignment="Stretch" AutomationProperties.Name="Remind me of what still waits" />
                    <TextBlock Classes="secondary" Text="A message still on the list after this long brings the list back (unfolded, lit up, with the sound when on), and again as long as it waits." />
                </StackPanel>
                <DockPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding PlaySound}" OnContent="" OffContent="" AutomationProperties.Name="Sound for new items" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sound for new items" />
                        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Plays when something lands on the list." />
                    </StackPanel>
                </DockPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="See-through list" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Slider Minimum="0.3" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Value="{Binding OverlayOpacity}" AutomationProperties.Name="See-through list" />
                        <TextBlock Grid.Column="1" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}" />
                    </Grid>
                    <TextBlock Classes="secondary" Text="How much the list on screen shows while the mouse is not on it." />
                </StackPanel>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ResetOverlayCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon Symbol="ArrowUndo" FontSize="15" />
                        <TextBlock Text="Put the list back in its corner" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Posts by AI agents (Fairy, through the MCP tools), openly as AI -->
        <Border Classes="glass">
            <StackPanel Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="Posts by AI agents" Classes="head" />
                    <TextBlock Classes="secondary"
                               Text="A small grey line Helm puts under every message an AI agent posts where Write is on (asked first each time), so nobody takes it for you. {me} is your name; it always says AI. Slack Report itself never answers." />
                </StackPanel>
                <Grid x:Name="SignatureGrid" ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="12">
                    <StackPanel x:Name="SignatureField" Spacing="6">
                        <TextBlock Text="AI signature" />
                        <TextBox Classes="glass" Text="{Binding Signature, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="AI signature" />
                    </StackPanel>
                    <StackPanel x:Name="EmojiField" Grid.Column="1" Spacing="6">
                        <TextBlock Text="Signature emoji" />
                        <TextBox Classes="glass" Text="{Binding SignatureEmoji, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Signature emoji" />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="secondary" Text="A Slack emoji code in front of the signature, e.g. :robot_face:, or your own emoji uploaded in Slack." />
                <StackPanel Spacing="6">
                    <TextBlock Classes="secondary" Text="A post looks like this (in Slack the last line is small and grey):" />
                    <Border Classes="preview">
                        <TextBlock Text="{Binding ReplyPreview}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
                <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Back to the default" Command="{Binding ResetSignatureCommand}" />
            </StackPanel>
        </Border>

        <Button x:Name="DoneButton" Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Done" />
    </StackPanel>
</UserControl>
