<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.QuickCapture"
             xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Ui"
             x:Class="Helm.Modules.QuickCapture.Ui.QuickCaptureView"
             x:DataType="vm:QuickCaptureViewModel">

    <!-- Quick Capture's settings: the tool has no page of content (its box floats over any app), so this is its page. -->
    <Panel>
        <core:Backdrop />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" core:ScrollFade.Enabled="True">
            <StackPanel x:Name="Page" Margin="40,28,40,40" Spacing="14">
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Classes="eyebrow" Text="ANY APP" />
                    <TextBlock Classes="display" Text="Quick Capture" />
                    <TextBlock x:Name="Lead" Classes="muted" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Press a shortcut in any app to save a note, a task or a debt in a second, without opening Helm." />
                </StackPanel>

                <core:MasonryPanel x:Name="Cards" MinColumnWidth="430" Spacing="14">

                <!-- On or off -->
                <Border Classes="glass">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Quick Capture is on" Classes="head" />
                            <TextBlock x:Name="SwitchHint" Text="Off frees the shortcut for other apps." Classes="secondary" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="EnableSwitch" Grid.Column="1" VerticalAlignment="Center" OnContent="" OffContent="" AutomationProperties.Name="Quick Capture on or off" />
                    </Grid>
                </Border>

                <!-- A shortcut that could not be registered, a box that could not open -->
                <Border x:Name="ProblemCard" Classes="glass" Background="{DynamicResource HelmWarningBackground}" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*">
                        <ic:SymbolIcon Symbol="Warning" FontSize="18" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="ProblemText" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- Activation -->
                <Border Classes="glass">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="ActivationTitle" Text="Activation" Classes="head" />
                        <!-- Where there is no shortcut (a phone): how else it opens (the share sheet, a tile). -->
                        <ContentControl x:Name="WaysToOpen" IsVisible="False" />
                        <StackPanel x:Name="ShortcutPart" Spacing="6">
                            <TextBlock Text="Activation shortcut" />
                            <ContentControl x:Name="ActivationHotkey" />
                            <TextBlock Text="Opens the capture box over any app." Classes="secondary" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="TryButton" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding TryCommand}"
                                AutomationProperties.Name="Open Quick Capture">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="Flash" FontSize="14" />
                                <TextBlock Text="Open Quick Capture now" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Behavior -->
                <Border Classes="glass">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Behavior" Classes="head" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Save to" />
                            <ComboBox Classes="glass" HorizontalAlignment="Stretch" ItemsSource="{Binding TargetNames}" SelectedIndex="{Binding DefaultTargetIndex}"
                                      AutomationProperties.Name="Save to" />
                            <TextBlock x:Name="SaveToHint" Text="Where the text goes when you just type and press Enter. Tab switches in the box." Classes="secondary" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- What to type -->
                <Border Classes="glass">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="What to type" Classes="head" />
                            <TextBlock x:Name="TypeHint" Text="Start with a prefix to pick where it goes. Enter saves, Shift+Enter adds a line, Esc closes." Classes="secondary" TextWrapping="Wrap" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Examples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:CaptureExample">
                                    <Grid ColumnDefinitions="96,52,*" ColumnSpacing="8" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding Prefix}" FontFamily="Cascadia Mono, Consolas, monospace" Foreground="{DynamicResource HelmEyebrow}" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="2" Text="{Binding Example}" TextWrapping="Wrap" Classes="muted" VerticalAlignment="Top" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                </core:MasonryPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
