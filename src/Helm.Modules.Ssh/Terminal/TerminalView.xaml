<UserControl
    x:Class="Helm.Modules.Ssh.Terminal.TerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <!-- The terminal (xterm.js in WebView2). A WebView2 is a native window that WPF cannot draw over, so the page puts
         its controls around it, never on it. -->
    <Grid>
        <wv2:WebView2 x:Name="Web" AutomationProperties.Name="Terminal" />
        <StackPanel x:Name="Problem" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="480">
            <ui:SymbolIcon Symbol="WindowConsole20" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="ProblemText" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
