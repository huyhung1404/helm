<Page x:Class="Helm.Modules.Ssh.SshContentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uiw="clr-namespace:Helm.Ui.Windows;assembly=Helm.Ui.Windows"
      ScrollViewer.CanContentScroll="False"
      Title="SSH">

    <!-- SSH (the servers, connecting, the shell and the AI agent tab, the server's menu, the settings sheet) is the shared
         Avalonia page, Helm.Modules.Ssh.UI/SshView: the same view on every platform. This WPF page only hosts it and does
         the Windows parts (the terminal in WebView2, the file dialog, OpenSSH's folder). -->
    <uiw:AvaloniaHost x:Name="Host" />
</Page>
