<Page
    x:Class="Helm.Modules.Ssh.SshContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.Ssh;assembly=Helm.Modules.Ssh.Core"
    xmlns:self="clr-namespace:Helm.Modules.Ssh"
    xmlns:term="clr-namespace:Helm.Modules.Ssh.Terminal"
    Title="SSH" ScrollViewer.CanContentScroll="False">

    <!-- SSH itself (menu and Quick access): pick a server, connect, and the terminal fills the rest. The servers, this
         device's key and the known server keys are managed on SshPage (Home → Utilities). -->
    <Page.Resources>
        <DataTemplate x:Key="HostItem" DataType="{x:Type local:SshHostRow}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Target}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource HelmSecondaryText}" />
                <TextBlock Text="{Binding State}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                           Visibility="{Binding State, Converter={StaticResource NotEmptyToVisibility}}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <ui:Button DockPanel.Dock="Right" Content="Servers and key" Icon="{ui:SymbolIcon Server24}" VerticalAlignment="Center"
                       ToolTip="Add or edit servers, and this device's key" Click="Settings_Click" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{x:Static self:SshLogo.Image}" Width="32" Height="32" Margin="0,0,12,0" />
                <TextBlock Text="SSH" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Shown while the tool is turned off -->
        <ui:InfoBar x:Name="OffBar" Grid.Row="1" Severity="Informational" IsClosable="False" IsOpen="False" Visibility="Collapsed" Margin="0,0,0,12"
                    Title="SSH is turned off" Message="Your servers are kept. Turn SSH on in its settings to connect." />

        <!-- What happened: a refused key, a server that could not be reached, a key that changed -->
        <Border Grid.Row="2" Style="{DynamicResource HelmSurface}" Margin="0,0,0,12" Padding="12,8"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <core:RowLayout>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <ui:Button Margin="8,0,0,0" Content="Open Vault" Icon="{ui:SymbolIcon LockOpen24}" Command="{Binding OpenVaultCommand}"
                           Visibility="{Binding CanOpenVault, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Appearance="Transparent" Padding="8,6" MinWidth="0" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss"
                           Command="{Binding DismissMessageCommand}" />
            </core:RowLayout>
        </Border>

        <!-- The server picker: the tool's main choice -->
        <Border x:Name="Picker" Grid.Row="3" Style="{DynamicResource HelmSurface}" Margin="0,0,0,12" Padding="12">
            <Grid>
                <!-- No servers yet -->
                <core:RowLayout Visibility="{Binding HasHosts, Converter={StaticResource InverseBoolToVisibility}}">
                    <core:CardHeader Title="No servers yet" Description="Already use ssh on this PC? Import your SSH config: same servers, same keys. Or add a server by hand." />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Margin="0,0,8,0" Content="Import from SSH config" Icon="{ui:SymbolIcon ArrowDownload24}"
                                   ToolTip="Adds the servers in .ssh\config with their key files, and trusts the server keys in .ssh\known_hosts" Click="Import_Click" />
                        <ui:Button Content="Add a server" Icon="{ui:SymbolIcon Add24}" Click="AddServer_Click" />
                    </StackPanel>
                </core:RowLayout>

                <WrapPanel Visibility="{Binding HasHosts, Converter={StaticResource BoolToVisibility}}" Orientation="Horizontal">
                    <ComboBox Width="320" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="Server"
                              ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" ItemTemplate="{StaticResource HostItem}" />
                    <ui:PasswordBox x:Name="PasswordBox" Width="200" Margin="0,0,8,0" VerticalAlignment="Center" PlaceholderText="{Binding PasswordPrompt}"
                                    AutomationProperties.Name="{Binding PasswordPrompt}" KeyDown="Password_KeyDown"
                                    Visibility="{Binding NeedsPassword, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Appearance="Primary" Margin="0,0,8,0" VerticalAlignment="Center" Content="Connect" Icon="{ui:SymbolIcon PlugConnected24}"
                               IsEnabled="{Binding CanConnect}" Click="Connect_Click"
                               Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ui:Button Margin="0,0,8,0" VerticalAlignment="Center" Content="Disconnect" Icon="{ui:SymbolIcon PlugDisconnected24}"
                               Command="{Binding DisconnectCommand}"
                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button x:Name="MenuButton" Margin="0,0,8,0" VerticalAlignment="Center" Content="Menu" Icon="{ui:SymbolIcon AppsList24}"
                               ToolTip="What this server's menu offers; a choice runs in the terminal" Click="Menu_Click"
                               Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Margin="0,0,8,0" VerticalAlignment="Center" Content="Install this device's key" Icon="{ui:SymbolIcon Key24}"
                               ToolTip="Add this device's key to the server's authorized_keys, then sign in with it instead of the password"
                               Command="{Binding InstallKeyCommand}"
                               Visibility="{Binding CanInstallKey, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding SessionStatus}" VerticalAlignment="Center" Margin="4,0,0,0" Style="{StaticResource HelmSecondaryText}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- The shell, and what AI agents run on this server: a tab once one ran something. Both keep going whichever is
             shown; the agent's tab only shows (its runs are on Helm's own channels, never typed into the shell). -->
        <DockPanel Grid.Row="4" Margin="0,0,0,8" Visibility="{Binding HasAgentTab, Converter={StaticResource BoolToVisibility}}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding ShowingAgent, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Margin="0,0,8,0" Content="Stop" Icon="{ui:SymbolIcon RecordStop24}" Command="{Binding StopAgentCommand}"
                           ToolTip="Stop what the AI agent runs on this server now; it is told you stopped it"
                           Visibility="{Binding AgentRunning, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="Clear" Icon="{ui:SymbolIcon Broom24}" Command="{Binding ClearAgentCommand}" ToolTip="Empty this tab" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource {x:Type ToggleButton}}" GroupName="SshTabs" MinWidth="120" Margin="0,0,6,0"
                             IsChecked="{Binding ShowingShell}" AutomationProperties.Name="Terminal" ToolTip="Your shell on this server">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="WindowConsole20" Margin="0,0,6,0" />
                        <TextBlock Text="Terminal" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource {x:Type ToggleButton}}" GroupName="SshTabs" MinWidth="120"
                             IsChecked="{Binding ShowingAgent}" AutomationProperties.Name="AI agent"
                             ToolTip="What AI agents run on this server, with their output">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Bot24" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding AgentTabTitle}" />
                        <Ellipse Width="7" Height="7" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                 ToolTip="New since you last looked" Visibility="{Binding AgentUnseen, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </RadioButton>
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource HelmSecondaryText}" TextWrapping="Wrap"
                           Text="Read-only. Your shell keeps running in Terminal."
                           Visibility="{Binding ShowingAgent, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DockPanel>

        <Grid x:Name="Body" Grid.Row="5">
            <Border CornerRadius="8" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Visibility="{Binding ShowTerminal, Converter={StaticResource BoolToVisibility}}">
                <term:TerminalView x:Name="Terminal" />
            </Border>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="420"
                        Visibility="{Binding HasSession, Converter={StaticResource InverseBoolToVisibility}}">
                <Image Source="{x:Static self:SshLogo.Image}" Width="48" Height="48" Opacity="0.6" />
                <TextBlock Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource HelmSecondaryText}"
                           Text="Choose a server and connect. The session keeps running while you use the rest of Helm." />
            </StackPanel>

            <!-- The server's menu (docs/ssh-menu.md): a popup over the terminal, which stays readable beside it. A popup is
                 its own window, so it shows above WebView2. -->
            <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom" VerticalOffset="6"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="MenuPopup_Closed">
                <Border DataContext="{Binding Menu}" Width="380" Margin="0,0,12,12" Padding="6"
                        Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- Title, and reading the menu again -->
                        <DockPanel Margin="8,4,2,6">
                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="6" MinWidth="0" Icon="{ui:SymbolIcon ArrowSync24}"
                                       ToolTip="Read the menu again" AutomationProperties.Name="Read the menu again" Command="{Binding LoadCommand}" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="Reading the server's menu…" Margin="8,4,8,10" Style="{StaticResource HelmSecondaryText}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Problem}" Margin="8,4,8,10" TextWrapping="Wrap"
                                   Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />

                        <!-- The items, as the server grouped them -->
                        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:MenuEntry}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Group}" Margin="10,10,0,2" FontSize="12" Style="{StaticResource HelmSecondaryText}"
                                                       Visibility="{Binding StartsGroup, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:Button Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="10,7"
                                                       AutomationProperties.Name="{Binding Title}" Click="MenuItem_Click">
                                                <DockPanel>
                                                    <ui:SymbolIcon DockPanel.Dock="Right" Symbol="ChevronRight24" FontSize="14" Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   Visibility="{Binding HasParams, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Warning24" FontSize="14" Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" ToolTip="Asks before it runs"
                                                                   Visibility="{Binding IsDangerous, Converter={StaticResource BoolToVisibility}}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" />
                                                        <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource HelmSecondaryText}"
                                                                   ToolTip="{Binding Description}" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </ui:Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- An item with parameters: its form -->
                        <StackPanel Margin="8,0,8,4" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Selected.Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Selected.Description}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8" Style="{StaticResource HelmSecondaryText}"
                                       Visibility="{Binding Selected.HasDescription, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:MenuParamField}">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Title}" Margin="0,0,0,4" />
                                            <Grid>
                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" AutomationProperties.Name="{Binding Title}"
                                                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                                                <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Title}"
                                                            Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                                <ui:ToggleSwitch IsChecked="{Binding BoolValue}" AutomationProperties.Name="{Binding Title}"
                                                                 Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Error}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                       Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <ui:Button Content="Back" Margin="0,0,8,0" Command="{Binding BackCommand}" />
                                <ui:Button Appearance="Primary" Content="Run" Icon="{ui:SymbolIcon Play24}" Command="{Binding RunCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Runs in the terminal, as if typed. Ctrl+C stops it." FontSize="11" Margin="8,8,8,2" Style="{StaticResource HelmSecondaryText}"
                                   Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Page>
