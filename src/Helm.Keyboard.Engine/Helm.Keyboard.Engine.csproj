<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Vietnamese typing rules of Helm Keyboard, with no dependencies: the Windows input method (Helm.Keyboard.Tip,
       compiled to native code and loaded into every app) and the tests use the very same code. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Typing</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>
