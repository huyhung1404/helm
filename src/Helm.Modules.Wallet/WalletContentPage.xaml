<Page
    x:Class="Helm.Modules.Wallet.WalletContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.Wallet;assembly=Helm.Modules.Wallet.Core"
    xmlns:self="clr-namespace:Helm.Modules.Wallet"
    Title="Wallet">

    <!-- Wallet itself (menu and Quick access). Its options live on WalletPage (Home → Utilities). -->
    <Page.Resources>
        <!-- Small icon-only action button in a list row -->
        <Style x:Key="RowAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A whole row as one flat button (hover shading, keyboard focus) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="12,8" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small label: the category, "auto" -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,2,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

        <!-- A field label above its box -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource HelmSecondaryText}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- The big number of a summary card -->
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Signed amount: money in green, money out in the normal text colour -->
        <Style x:Key="AmountText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsIncome}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A category's share of the month: name, bar, amount -->
        <DataTemplate x:Key="SpendRow" DataType="{x:Type local:CategorySpendRow}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUncategorized}" Value="True">
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding CountText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" />
                </StackPanel>
                <ProgressBar Grid.Column="1" Height="8" Margin="12,0" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding ShareText}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </DataTemplate>

        <!-- A transaction: one click on a suggested category files it; click the row for the rest -->
        <DataTemplate x:Key="TransactionRow" DataType="{x:Type local:TransactionRow}">
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <Button Style="{StaticResource RowButton}" Command="{Binding ToggleExpandedCommand}" AutomationProperties.Name="{Binding Title}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource Chip}" Visibility="{Binding IsCategorized, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Helm picked this category from earlier transactions like it">
                                        <TextBlock Text="auto" FontSize="12" />
                                    </Border>
                                    <TextBlock Text="{Binding Details}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" VerticalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontSize="15" Style="{StaticResource AmountText}" />
                        </Grid>
                    </Button>

                    <!-- One-click categories while it waits for one -->
                    <ItemsControl Margin="12,0,12,8" ItemsSource="{Binding Suggestions}" Focusable="False"
                                  Visibility="{Binding IsCategorized, Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CategoryChip}">
                                <ui:Button Margin="0,0,6,4" Padding="10,4" Content="{Binding Name}" Command="{Binding PickCommand}" ToolTip="Put it in this category" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Expanded: the category, the details, edit and delete -->
                    <StackPanel Margin="12,0,12,12" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                                <ComboBox Width="220" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DisplayMemberPath="Name"
                                          AutomationProperties.Name="Category" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                                <ui:Button Content="To categorize" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UncategorizeCommand}" Margin="0,0,6,0"
                                           ToolTip="Back to the transactions to categorize"
                                           Visibility="{Binding IsCategorized, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Content="Edit" Icon="{ui:SymbolIcon Edit24}" Command="{Binding BeginEditCommand}" Margin="0,0,6,0" />
                                <ui:Button Content="Delete" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteCommand}" Margin="16,0,0,0" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding BalanceText}" Style="{DynamicResource HelmSecondaryText}"
                                   Visibility="{Binding HasBalance, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                        <Border Style="{DynamicResource HelmSurface}" Margin="0,8,0,0" Padding="12,8"
                                Visibility="{Binding HasOriginal, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy the notification"
                                           AutomationProperties.Name="Copy the notification" Command="{Binding CopyOriginalCommand}" />
                                <StackPanel>
                                    <TextBlock Text="The bank's notification" Style="{DynamicResource HelmSecondaryText}" FontSize="12" />
                                    <TextBlock Text="{Binding OriginalText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Editor -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel>
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" />
                                    <ui:TextBox Width="160" AutomationProperties.Name="Amount" Text="{Binding EditAmount, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <CheckBox Content="Money in" IsChecked="{Binding EditIsIncome}" VerticalAlignment="Bottom" Margin="0,0,12,12" />
                                <StackPanel Margin="0,0,8,8">
                                    <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                                    <DatePicker Width="160" SelectedDate="{Binding EditDate}" AutomationProperties.Name="Date" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Margin="0,0,0,8" AutomationProperties.Name="Description" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Note" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Margin="0,0,0,8" AutomationProperties.Name="Note" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                                        Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Appearance="Primary" Content="Save" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding SaveEditCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Image Source="{x:Static self:WalletLogo.Image}" Width="32" Height="32" Margin="0,0,12,0" />
            <TextBlock Text="Wallet" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Shown while the tool is turned off -->
        <ui:InfoBar x:Name="OffBar" Severity="Informational" IsClosable="False" IsOpen="False" Visibility="Collapsed" Margin="0,0,0,12"
                    Title="Wallet is turned off" Message="Your transactions are kept. Turn Wallet on in its settings to work with them; the phone stops saving new ones meanwhile." />

        <!-- The month, first and easy to see -->
        <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="This month" Command="{Binding ThisMonthCommand}" Margin="0,0,8,0"
                               Visibility="{Binding IsCurrentMonth, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ui:Button x:Name="AddButton" Appearance="Primary" Content="Add transaction" Icon="{ui:SymbolIcon Add24}" Command="{Binding OpenAddCommand}"
                               ToolTip="Cash, or a bank Helm does not read" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon ChevronLeft24}" Command="{Binding PreviousMonthCommand}" ToolTip="Previous month" AutomationProperties.Name="Previous month" />
                    <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon ChevronRight24}" Command="{Binding NextMonthCommand}" IsEnabled="{Binding CanGoNext}"
                               ToolTip="Next month" AutomationProperties.Name="Next month" />
                    <TextBlock Text="{Binding MonthTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel x:Name="Body">
            <!-- What happened: saved, copied, a problem -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8" Padding="12,8" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <core:RowLayout>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Command="{Binding DismissMessageCommand}" />
                </core:RowLayout>
            </Border>

            <!-- Adding a transaction by hand -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8" Visibility="{Binding IsAddOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="New transaction" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox x:Name="NewAmountBox" Width="160" PlaceholderText="50k, 1.5tr" AutomationProperties.Name="Amount"
                                        Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Content="Money in" IsChecked="{Binding NewIsIncome}" VerticalAlignment="Bottom" Margin="0,0,12,12" />
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                            <DatePicker Width="160" SelectedDate="{Binding NewDate}" AutomationProperties.Name="Date" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                            <ComboBox Width="220" ItemsSource="{Binding NewCategories}" SelectedItem="{Binding NewCategory}" DisplayMemberPath="Name"
                                      AutomationProperties.Name="Category" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                    <ui:TextBox Margin="0,0,0,8" PlaceholderText="What it was for" AutomationProperties.Name="Description"
                                Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Content="Add" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}" Margin="0,0,8,0" />
                        <ui:Button Content="Cancel" Command="{Binding CancelAddCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The month in numbers -->
            <UniformGrid Columns="3" Margin="0,0,0,4">
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,4,4">
                    <StackPanel>
                        <TextBlock Text="Spent" Style="{DynamicResource HelmSecondaryText}" />
                        <TextBlock Text="{Binding SpentText}" Style="{StaticResource Figure}" />
                        <TextBlock Text="{Binding SpentTodayText}" Style="{DynamicResource HelmSecondaryText}"
                                   Visibility="{Binding HasSpentToday, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="2,0,2,4">
                    <StackPanel>
                        <TextBlock Text="Money in" Style="{DynamicResource HelmSecondaryText}" />
                        <TextBlock Text="{Binding IncomeText}" Style="{StaticResource Figure}" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Margin="4,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Net" Style="{DynamicResource HelmSecondaryText}" />
                        <TextBlock Text="{Binding NetText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Figure}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNetNegative}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding CountText}" Style="{DynamicResource HelmSecondaryText}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Text="{Binding CompareText}" Style="{DynamicResource HelmSecondaryText}" Margin="4,0,0,8"
                       Visibility="{Binding HasCompare, Converter={StaticResource BoolToVisibility}}" />

            <!-- The budget -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,4" Visibility="{Binding HasBudget, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding BudgetText}" Style="{DynamicResource HelmSecondaryText}" />
                        <TextBlock Text="Monthly budget" FontWeight="SemiBold" />
                    </DockPanel>
                    <ProgressBar Margin="0,8,0,6" Height="8" Minimum="0" Maximum="100" Value="{Binding BudgetPercent, Mode=OneWay}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverBudget}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Text="{Binding BudgetDetail}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverBudget}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Waiting for a category -->
            <StackPanel Visibility="{Binding HasToCategorize, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ToCategorizeTitle}" Style="{DynamicResource HelmSectionHeader}" />
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8" Padding="12,8" Visibility="{Binding HasSimilar, Converter={StaticResource BoolToVisibility}}">
                    <core:RowLayout>
                        <TextBlock Text="{Binding SimilarText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Appearance="Primary" Content="Yes" Command="{Binding ApplySimilarCommand}" Margin="0,0,6,0" />
                            <ui:Button Content="No" Command="{Binding DismissSimilarCommand}" />
                        </StackPanel>
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Padding="0">
                    <ItemsControl ItemsSource="{Binding ToCategorize}" ItemTemplate="{StaticResource TransactionRow}" Focusable="False" />
                </Border>
                <TextBlock Text="{Binding MoreToCategorizeText}" Style="{DynamicResource HelmSecondaryText}" Margin="4,6,0,0"
                           Visibility="{Binding HasMoreToCategorize, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Where the money went -->
            <StackPanel Visibility="{Binding HasSpending, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Spending by category" Style="{DynamicResource HelmSectionHeader}" />
                <Border Style="{DynamicResource HelmSurface}">
                    <ItemsControl ItemsSource="{Binding Spending}" ItemTemplate="{StaticResource SpendRow}" Focusable="False" />
                </Border>
            </StackPanel>
            <StackPanel Visibility="{Binding HasEarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Money in by category" Style="{DynamicResource HelmSectionHeader}" />
                <Border Style="{DynamicResource HelmSurface}">
                    <ItemsControl ItemsSource="{Binding Earning}" ItemTemplate="{StaticResource SpendRow}" Focusable="False" />
                </Border>
            </StackPanel>

            <!-- The month's transactions -->
            <TextBlock Text="Transactions" Style="{DynamicResource HelmSectionHeader}" />
            <DockPanel Margin="0,0,0,8">
                <ComboBox DockPanel.Dock="Left" Width="150" Margin="0,0,8,0" ItemsSource="{x:Static local:WalletViewModel.FilterNames}" SelectedIndex="{Binding FilterIndex}"
                          AutomationProperties.Name="Show" />
                <ui:TextBox PlaceholderText="Search descriptions, notes, categories" Icon="{ui:SymbolIcon Search24}" AutomationProperties.Name="Search"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            </DockPanel>
            <TextBlock Text="{Binding EmptyText}" Style="{DynamicResource HelmSecondaryText}" Margin="4,0,0,8"
                       Visibility="{Binding HasDays, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:DayGroup}">
                        <StackPanel Margin="0,0,0,12">
                            <DockPanel Margin="4,0,4,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" Style="{DynamicResource HelmSecondaryText}" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            </DockPanel>
                            <Border Style="{DynamicResource HelmSurface}" Padding="0">
                                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TransactionRow}" Focusable="False" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</Page>
