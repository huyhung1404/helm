<Page
    x:Class="Helm.Modules.Wallet.WalletContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.Wallet;assembly=Helm.Modules.Wallet.Core"
    xmlns:self="clr-namespace:Helm.Modules.Wallet"
    Title="Wallet">

    <!-- Wallet itself (menu and Quick access). Its options live on WalletPage (Home → Utilities). -->
    <Page.Resources>
        <!-- Small icon-only action button in a list row -->
        <Style x:Key="RowAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A whole row as one flat button (hover shading, keyboard focus) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="12,8" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A small label: "auto" -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,2,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>

        <!-- A field label above its box -->
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource HelmSecondaryText}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- The big number of a summary card -->
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- A card's title -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Signed amount: money in green, money out in the normal text colour -->
        <Style x:Key="AmountText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsIncome}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A category picker item: its badge and name -->
        <DataTemplate x:Key="ChoiceItem" DataType="{x:Type local:CategoryChoice}">
            <StackPanel Orientation="Horizontal">
                <self:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="22" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- A slice of the donut, named: badge, name and count, a bar of its share in its colour, amount and share -->
        <DataTemplate x:Key="LegendRow" DataType="{x:Type local:DonutSegment}">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <self:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="30" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <Border Height="6" CornerRadius="3" Margin="0,4,0,0" HorizontalAlignment="Left" Background="{Binding Color, Converter={x:Static self:WalletConverters.Ink}}">
                        <Border.Width>
                            <MultiBinding Converter="{x:Static self:WalletContentPage.ShareWidth}">
                                <Binding Path="Share" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=StackPanel}" />
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ShareText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Money in by category: badge, name, bar, amount -->
        <DataTemplate x:Key="EarningRow" DataType="{x:Type local:CategorySpendRow}">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <self:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="30" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding CountText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding ShareText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- A transaction: one click on a suggested category files it; click the row for the rest -->
        <DataTemplate x:Key="TransactionRow" DataType="{x:Type local:TransactionRow}">
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <Button Style="{StaticResource RowButton}" Command="{Binding ToggleExpandedCommand}" AutomationProperties.Name="{Binding Title}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <self:CategoryBadge Icon="{Binding CategoryIcon}" Color="{Binding CategoryColor}" Size="34" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2,8,0"
                                               Visibility="{Binding IsCategorized, Converter={StaticResource BoolToVisibility}}" />
                                    <Border Style="{StaticResource Chip}" Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibility}}"
                                            ToolTip="Helm picked this category from earlier transactions like it">
                                        <TextBlock Text="auto" FontSize="12" />
                                    </Border>
                                    <TextBlock Text="{Binding Details}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" VerticalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontSize="15" Style="{StaticResource AmountText}" />
                        </Grid>
                    </Button>

                    <!-- One-click categories while it waits for one -->
                    <ItemsControl Margin="58,0,12,8" ItemsSource="{Binding Suggestions}" Focusable="False"
                                  Visibility="{Binding IsCategorized, Converter={StaticResource InverseBoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CategoryChip}">
                                <ui:Button Margin="0,0,6,4" Padding="6,3,12,3" Command="{Binding PickCommand}" ToolTip="Put it in this category">
                                    <StackPanel Orientation="Horizontal">
                                        <self:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="22" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ui:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Expanded: the category, a new category, the details, edit and delete -->
                    <StackPanel Margin="58,0,12,12" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                                <ComboBox Width="240" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" ItemTemplate="{StaticResource ChoiceItem}"
                                          AutomationProperties.Name="Category" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Or a new category" Style="{StaticResource FieldLabel}" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBox Width="180" PlaceholderText="Name" AutomationProperties.Name="New category name"
                                                Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}">
                                        <ui:TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding CreateCategoryCommand}" />
                                        </ui:TextBox.InputBindings>
                                    </ui:TextBox>
                                    <ui:Button Margin="6,0,0,0" Content="Add" Icon="{ui:SymbolIcon Add24}" Command="{Binding CreateCategoryCommand}"
                                               ToolTip="Make the category and put this transaction in it" />
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="To categorize" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UncategorizeCommand}" Margin="0,0,6,0"
                                       ToolTip="Back to the transactions to categorize"
                                       Visibility="{Binding IsCategorized, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Content="Edit" Icon="{ui:SymbolIcon Edit24}" Command="{Binding BeginEditCommand}" Margin="0,0,6,0" />
                            <ui:Button Content="Delete" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteCommand}" Margin="16,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding BalanceText}" Style="{DynamicResource HelmSecondaryText}"
                                   Visibility="{Binding HasBalance, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                        <Border Style="{DynamicResource HelmSurface}" Margin="0,8,0,0" Padding="12,8"
                                Visibility="{Binding HasOriginal, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy the notification"
                                           AutomationProperties.Name="Copy the notification" Command="{Binding CopyOriginalCommand}" />
                                <StackPanel>
                                    <TextBlock Text="The bank's notification" Style="{DynamicResource HelmSecondaryText}" FontSize="12" />
                                    <TextBlock Text="{Binding OriginalText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Editor -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,0,8" VerticalAlignment="Top">
                                    <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox AutomationProperties.Name="Amount" Text="{Binding EditAmount, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnAmountTextChanged" />
                                        <CheckBox Grid.Column="1" Content="Money in" IsChecked="{Binding EditIsIncome}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,8" VerticalAlignment="Top">
                                    <TextBlock Text="When" Style="{StaticResource FieldLabel}" />
                                    <core:DateTimeBox Date="{Binding EditDate}" Time="{Binding EditTime}" Lean="Past" AutomationProperties.Name="When" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Margin="0,0,0,8" AutomationProperties.Name="Description" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Note" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Margin="0,0,0,8" AutomationProperties.Name="Note" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"
                                        Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Appearance="Primary" Content="Save" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding SaveEditCommand}" Margin="0,0,8,0" />
                                <ui:Button Content="Cancel" Command="{Binding CancelEditCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Image Source="{x:Static self:WalletLogo.Image}" Width="32" Height="32" Margin="0,0,12,0" />
            <TextBlock Text="Wallet" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Shown while the tool is turned off -->
        <ui:InfoBar x:Name="OffBar" Severity="Informational" IsClosable="False" IsOpen="False" Visibility="Collapsed" Margin="0,0,0,12"
                    Title="Wallet is turned off" Message="Your transactions are kept. Turn Wallet on in its settings to work with them; the phone stops saving new ones meanwhile." />

        <!-- The month, first and easy to see -->
        <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="This month" Command="{Binding ThisMonthCommand}" Margin="0,0,8,0"
                               Visibility="{Binding IsCurrentMonth, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ui:Button x:Name="AddButton" Appearance="Primary" Content="Add transaction" Icon="{ui:SymbolIcon Add24}" Command="{Binding OpenAddCommand}"
                               ToolTip="Cash, or a bank Helm does not read" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon ChevronLeft24}" Command="{Binding PreviousMonthCommand}" ToolTip="Previous month" AutomationProperties.Name="Previous month" />
                    <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon ChevronRight24}" Command="{Binding NextMonthCommand}" IsEnabled="{Binding CanGoNext}"
                               ToolTip="Next month" AutomationProperties.Name="Next month" />
                    <TextBlock Text="{Binding MonthTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel x:Name="Body">
            <!-- What happened: saved, copied, a problem -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8" Padding="12,8" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <core:RowLayout>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Command="{Binding DismissMessageCommand}" />
                </core:RowLayout>
            </Border>

            <!-- Adding a transaction by hand -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8" Visibility="{Binding IsAddOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="New transaction" Style="{StaticResource CardTitle}" />
                    <!-- Two aligned columns: every label above its box, every row starting on the same line -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,12" VerticalAlignment="Top">
                            <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="NewAmountBox" PlaceholderText="50k, 1.5tr" AutomationProperties.Name="Amount"
                                            Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnAmountTextChanged" />
                                <CheckBox Grid.Column="1" Content="Money in" IsChecked="{Binding NewIsIncome}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,12" VerticalAlignment="Top">
                            <TextBlock Text="When" Style="{StaticResource FieldLabel}" />
                            <core:DateTimeBox Date="{Binding NewDate}" Time="{Binding NewTime}" Lean="Past" AutomationProperties.Name="When" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Top">
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding NewCategories}" SelectedItem="{Binding NewCategory}" ItemTemplate="{StaticResource ChoiceItem}"
                                      AutomationProperties.Name="Category" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12" VerticalAlignment="Top">
                            <TextBlock Text="Or a new category" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox PlaceholderText="Name" AutomationProperties.Name="New category name"
                                        ToolTip="Made for this transaction; change its icon and colour in Wallet's settings"
                                        Text="{Binding AddCategoryName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,12">
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox PlaceholderText="What it was for" AutomationProperties.Name="Description"
                                        Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Content="Add" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}" Margin="0,0,8,0" />
                        <ui:Button Content="Cancel" Command="{Binding CancelAddCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The month's cash flow: money in, spent and net as bars on one scale -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" />
                        <TextBlock Text="Cash flow" Style="{StaticResource CardTitle}" Margin="0" />
                    </DockPanel>
                    <ItemsControl Margin="0,8,0,4" ItemsSource="{Binding CashFlow}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CashFlowRow}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <self:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="34" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <!-- The bar grows from the left (square) to a rounded end -->
                                        <Border Height="16" CornerRadius="0,4,4,0" HorizontalAlignment="Left" Background="{Binding Color, Converter={x:Static self:WalletConverters.Ink}}">
                                            <Border.Width>
                                                <MultiBinding Converter="{x:Static self:WalletContentPage.ShareWidth}">
                                                    <Binding Path="Fraction" />
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{Binding AmountText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding SpentTodayText}" Style="{DynamicResource HelmSecondaryText}"
                               Visibility="{Binding HasSpentToday, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding CompareText}" Style="{DynamicResource HelmSecondaryText}"
                               Visibility="{Binding HasCompare, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- The budget: a meter with a mark where spending would be on track today -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8" Visibility="{Binding HasBudget, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding BudgetText}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" />
                        <TextBlock Text="Monthly budget" Style="{StaticResource CardTitle}" Margin="0" />
                    </DockPanel>
                    <self:BudgetMeter Margin="0,10,0,6" Percent="{Binding BudgetPercent}" Pace="{Binding BudgetPacePercent}" IsOver="{Binding IsOverBudget}"
                                      ToolTip="The mark is where spending would be on track today" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding IsCurrentMonth, Converter={StaticResource BoolToVisibility}}">
                            <Border Width="2" Height="12" Background="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="on track today" Style="{DynamicResource HelmSecondaryText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Visibility="{Binding IsOverBudget, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding BudgetDetail}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Waiting for a category -->
            <StackPanel Visibility="{Binding HasToCategorize, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ToCategorizeTitle}" Style="{DynamicResource HelmSectionHeader}" />
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8" Padding="12,8" Visibility="{Binding HasSimilar, Converter={StaticResource BoolToVisibility}}">
                    <core:RowLayout>
                        <TextBlock Text="{Binding SimilarText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Appearance="Primary" Content="Yes" Command="{Binding ApplySimilarCommand}" Margin="0,0,6,0" />
                            <ui:Button Content="No" Command="{Binding DismissSimilarCommand}" />
                        </StackPanel>
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmSurface}" Padding="0">
                    <ItemsControl ItemsSource="{Binding ToCategorize}" ItemTemplate="{StaticResource TransactionRow}" Focusable="False" />
                </Border>
                <TextBlock Text="{Binding MoreToCategorizeText}" Style="{DynamicResource HelmSecondaryText}" Margin="4,6,0,0"
                           Visibility="{Binding HasMoreToCategorize, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- Where the money went, and when -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{DynamicResource HelmSurface}">
                    <StackPanel>
                        <TextBlock Text="Spending by category" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Nothing spent this month yet." Style="{DynamicResource HelmSecondaryText}"
                                   Visibility="{Binding HasSpending, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Visibility="{Binding HasSpending, Converter={StaticResource BoolToVisibility}}">
                            <self:DonutChart Model="{Binding SpendingDonut}" Width="190" Height="190" Margin="0,4,0,12"
                                             AutomationProperties.Name="Spending by category" />
                            <ItemsControl ItemsSource="{Binding SpendingDonut.Segments}" ItemTemplate="{StaticResource LegendRow}" Focusable="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Spending by day" Style="{StaticResource CardTitle}" />
                            <self:BarChart Model="{Binding DailyChart}" Height="220" AutomationProperties.Name="Spending by day" />
                            <!-- The key of the reference line -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding DailyChart.HasReference, Converter={StaticResource BoolToVisibility}}">
                                <Border Width="16" Height="2" Background="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding DailyChart.ReferenceLabel}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Last 6 months" Style="{StaticResource CardTitle}" />
                            <self:BarChart Model="{Binding MonthsChart}" Height="190" AutomationProperties.Name="Money in and spending in the last six months"
                                           ToolTip="Click a month to open it" />
                            <!-- The key: which column is which -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Width="12" Height="12" CornerRadius="2" Background="{Binding MonthsChart.Color, Converter={x:Static self:WalletConverters.Ink}}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding MonthsChart.Name}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" Margin="0,0,16,0" />
                                <Border Width="12" Height="12" CornerRadius="2" Background="{Binding MonthsChart.Color2, Converter={x:Static self:WalletConverters.Ink}}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding MonthsChart.Name2}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource HelmSurface}" Visibility="{Binding HasEarning, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="Money in by category" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding Earning}" ItemTemplate="{StaticResource EarningRow}" Focusable="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- The month's transactions -->
            <TextBlock Text="Transactions" Style="{DynamicResource HelmSectionHeader}" />
            <DockPanel Margin="0,0,0,8">
                <ComboBox DockPanel.Dock="Left" Width="150" Margin="0,0,8,0" ItemsSource="{x:Static local:WalletViewModel.FilterNames}" SelectedIndex="{Binding FilterIndex}"
                          AutomationProperties.Name="Show" />
                <ui:TextBox PlaceholderText="Search descriptions, notes, categories" Icon="{ui:SymbolIcon Search24}" AutomationProperties.Name="Search"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
            </DockPanel>
            <TextBlock Text="{Binding EmptyText}" Style="{DynamicResource HelmSecondaryText}" Margin="4,0,0,8"
                       Visibility="{Binding HasDays, Converter={StaticResource InverseBoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:DayGroup}">
                        <StackPanel Margin="0,0,0,12">
                            <DockPanel Margin="4,0,4,4">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" Style="{DynamicResource HelmSecondaryText}" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            </DockPanel>
                            <Border Style="{DynamicResource HelmSurface}" Padding="0">
                                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TransactionRow}" Focusable="False" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</Page>
