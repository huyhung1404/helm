<Page
    x:Class="Helm.Modules.Wallet.WalletContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.Wallet;assembly=Helm.Modules.Wallet.Core"
    xmlns:self="clr-namespace:Helm.Modules.Wallet"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Title="Wallet">

    <!-- Wallet itself (menu and Quick access). Its options live on WalletPage (Home → Utilities). The page shows the month;
         every add, edit and delete opens the pop-up (WalletPopup) over it. -->
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Helm.Modules.Wallet;component/WalletStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A slice of the donut, named: badge, name, a bar of its share in its colour, amount and share -->
            <DataTemplate x:Key="LegendRow" DataType="{x:Type local:DonutSegment}">
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <self:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="30" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <Border Height="6" CornerRadius="3" Margin="0,4,0,0" HorizontalAlignment="Left" Background="{Binding Color, Converter={x:Static self:WalletConverters.Ink}}">
                            <Border.Width>
                                <MultiBinding Converter="{x:Static self:WalletContentPage.ShareWidth}">
                                    <Binding Path="Share" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=StackPanel}" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ShareText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- Money in by category: badge, name and count, amount and share -->
            <DataTemplate x:Key="EarningRow" DataType="{x:Type local:CategorySpendRow}">
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <self:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="30" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CountText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ShareText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- Money / Debts: the one shown is the accent button -->
            <Style x:Key="MoneyTab" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="Margin" Value="0,0,2,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMoneyView}" Value="True">
                        <Setter Property="Appearance" Value="Secondary" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DebtsTab" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDebtsView}" Value="True">
                        <Setter Property="Appearance" Value="Secondary" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Margin="24,16,24,32">
        <!-- Wallet, and Money or Debts -->
        <DockPanel Margin="0,0,0,16">
            <Border DockPanel.Dock="Right" Padding="2" CornerRadius="6" BorderThickness="1" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorInputActiveBrush}"
                    Visibility="{Binding HasDebts, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Style="{StaticResource MoneyTab}" Content="Money" Icon="{ui:SymbolIcon Wallet24}" Command="{Binding ShowMoneyCommand}" />
                    <ui:Button Style="{StaticResource DebtsTab}" Content="Debts" Icon="{ui:SymbolIcon People24}" Command="{Binding ShowDebtsCommand}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Image Source="{x:Static self:WalletLogo.Image}" Width="32" Height="32" Margin="0,0,12,0" />
                <TextBlock Text="Wallet" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Shown while the tool is turned off -->
        <ui:InfoBar x:Name="OffBar" Severity="Informational" IsClosable="False" IsOpen="False" Visibility="Collapsed" Margin="0,0,0,12"
                    Title="Wallet is turned off" Message="Your transactions are kept. Turn Wallet on in its settings to work with them; the phone stops saving new ones meanwhile." />

        <StackPanel x:Name="Body">
            <!-- What happened: a problem, or "Copied" -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12" Padding="12,8" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <core:RowLayout>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Command="{Binding DismissMessageCommand}" />
                </core:RowLayout>
            </Border>

            <!-- ============================== Money ============================== -->
            <StackPanel Visibility="{Binding IsMoneyView, Converter={StaticResource BoolToVisibility}}">
                <!-- The month, what waits for a category, adding one by hand -->
                <DockPanel Margin="0,0,0,16">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="This month" Command="{Binding ThisMonthCommand}" Margin="0,0,8,0"
                                   Visibility="{Binding IsCurrentMonth, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:Button x:Name="ToCategorizeButton" Command="{Binding OpenToCategorizeCommand}" Margin="0,0,8,0"
                                   Visibility="{Binding HasToCategorize, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="Transactions from the bank that wait for a category" AutomationProperties.Name="{Binding ToCategorizeTitle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Tag24" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="To categorize" VerticalAlignment="Center" />
                                <Border Style="{StaticResource Pill}">
                                    <TextBlock Text="{Binding ToCategorize.Count}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="AddButton" Appearance="Primary" Content="Add transaction" Icon="{ui:SymbolIcon Add24}" Command="{Binding OpenAddCommand}"
                                   ToolTip="Cash, or a bank Helm does not read" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon ChevronLeft24}" Command="{Binding PreviousMonthCommand}" ToolTip="Previous month" AutomationProperties.Name="Previous month" />
                        <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon ChevronRight24}" Command="{Binding NextMonthCommand}" IsEnabled="{Binding CanGoNext}"
                                   ToolTip="Next month" AutomationProperties.Name="Next month" Margin="2,0,0,0" />
                        <TextBlock Text="{Binding MonthTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- The month in four numbers: money in, spent, net, and the funds (or the budget) -->
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <Border Style="{DynamicResource HelmSurface}" Margin="0,0,6,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownLeft24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                                <TextBlock Text="Money in" Style="{DynamicResource HelmSecondaryText}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding IncomeText}" Style="{StaticResource Figure}" Margin="0,4,0,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{Binding CountText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource HelmSurface}" Margin="3,0,3,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="Spent" Style="{DynamicResource HelmSecondaryText}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding SpentText}" Style="{StaticResource Figure}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding SpentTodayText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12"
                                       Visibility="{Binding HasSpentToday, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding CompareText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding HasCompare, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource HelmSurface}" Margin="3,0,3,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataTrending24" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="Net" Style="{DynamicResource HelmSecondaryText}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding NetText}" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Figure}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNetNegative}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Grid Margin="6,0,0,0">
                        <!-- The funds: what is left of all of them, and which need a look -->
                        <Border Style="{DynamicResource HelmSurface}" Visibility="{Binding Funds.HasFunds, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Funds.UsedPercentText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Savings24" FontSize="16" Margin="0,0,6,0" />
                                        <TextBlock Text="Funds" Style="{DynamicResource HelmSecondaryText}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Funds.LeftText, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" />
                                    <Run Text="left" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                                <self:BudgetMeter Margin="0,6,0,6" Percent="{Binding Funds.UsedPercent}" Pace="{Binding BudgetPacePercent}" IsOver="{Binding Funds.TotalIsOver}"
                                                  ToolTip="The mark is where spending would be on track today" />
                                <StackPanel Orientation="Horizontal" DataContext="{Binding Funds}">
                                    <ui:SymbolIcon FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAlerts}" Value="True">
                                                        <Setter Property="Symbol" Value="Warning24" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AlertIsOver}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <TextBlock Text="{Binding AlertText}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- No funds yet: the single monthly budget, if one is set -->
                        <Border Style="{DynamicResource HelmSurface}" Visibility="{Binding ShowBudgetCard, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding BudgetText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Monthly budget" Style="{DynamicResource HelmSecondaryText}" FontWeight="SemiBold" />
                                </DockPanel>
                                <self:BudgetMeter Margin="0,10,0,6" Percent="{Binding BudgetPercent}" Pace="{Binding BudgetPacePercent}" IsOver="{Binding IsOverBudget}"
                                                  ToolTip="The mark is where spending would be on track today" />
                                <TextBlock Text="{Binding BudgetDetail}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </UniformGrid>

                <!-- The funds as honey pots -->
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,16">
                    <StackPanel DataContext="{Binding Funds}">
                        <DockPanel Margin="0,0,0,12">
                            <ui:Button DockPanel.Dock="Right" Content="Add fund" Icon="{ui:SymbolIcon Add24}" Command="{Binding OpenAddCommand}" />
                            <TextBlock Text="Funds this month" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Spending in a fund's categories comes off that fund" Style="{DynamicResource HelmSecondaryText}" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>
                        <TextBlock Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding HasNoFunds, Converter={StaticResource BoolToVisibility}}"
                                   Text="Set an amount for each part of your month (eating, getting around, home and bills…) and pick its categories. Spending in them comes off the fund, and Helm warns before a fund runs out." />
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource FundTile}" ItemsPanel="{StaticResource Wrap}" Focusable="False" />
                            <Button Command="{Binding OpenOutsideCommand}" Cursor="Hand" Margin="0,0,10,10" Width="268" FocusVisualStyle="{x:Null}"
                                    Visibility="{Binding HasOutside, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Outside funds: put them in a fund">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="8" Padding="12" BorderThickness="1" Background="Transparent" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <TextBlock Text="Outside funds" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,2,0,0">
                                        <Run Text="{Binding OutsideText, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" />
                                        <Run Text="spent" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding OutsideNames}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="13" Margin="0,0,4,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="Put them in a fund" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- The bills that come every month: this month paid or not; "Paid" saves the spending (Undo) -->
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,16" Visibility="{Binding Bills, Converter={StaticResource NotEmptyToVisibility}}">
                    <StackPanel DataContext="{Binding Bills}">
                        <DockPanel Margin="0,0,0,8">
                            <ui:Button DockPanel.Dock="Right" Content="Add bill" Icon="{ui:SymbolIcon Add24}" Command="{Binding BeginAddCommand}" />
                            <ui:SymbolIcon Symbol="ReceiptMoney24" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Bills" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding SummaryText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>
                        <TextBlock Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Visibility="{Binding HasNoBills, Converter={StaticResource BoolToVisibility}}"
                                   Text="Electricity, internet, rent: bills that come every month. Helm reminds you before each is due, and “Paid” saves the spending. Ask Helm can add them too (“tiền điện ngày 15”)." />

                        <!-- What the last Paid or Delete did, with Undo -->
                        <Border Style="{StaticResource Box}" Margin="0,4,0,8" Padding="12,6" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss"
                                           Command="{Binding DismissMessageCommand}" />
                                <ui:Button DockPanel.Dock="Right" Content="Undo" Appearance="Transparent" Command="{Binding UndoCommand}"
                                           Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Add or edit: name, the amount (empty: it varies), the day of the month -->
                        <Border Style="{StaticResource Box}" Margin="0,4,0,8" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Tiền điện" MaxLength="60" AutomationProperties.Name="Bill name" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Amount" Style="{StaticResource FieldLabel}" />
                                        <ui:TextBox Text="{Binding FormAmount, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Varies" AutomationProperties.Name="Amount every month" />
                                        <TextBlock Text="{Binding FormAmountHint}" Style="{StaticResource FieldHint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Due day" Style="{StaticResource FieldLabel}" />
                                        <ui:NumberBox Value="{Binding FormDay}" Minimum="1" Maximum="31" MaxDecimalPlaces="0" SmallChange="1" ClearButtonEnabled="False"
                                                      AutomationProperties.Name="Day of the month it is due" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding FormProblem}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding HasFormProblem, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ui:Button Appearance="Primary" Content="Save" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding SaveEditCommand}" />
                                    <ui:Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelEditCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- One row per bill: name, amount or "varies", the due day, this month's state, Paid, edit, delete -->
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:BillRow}">
                                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Style="{DynamicResource HelmSecondaryText}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding AmountText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DueText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Margin="0,0,4,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                                   Visibility="{Binding IsPaid, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding StateText}" FontSize="12" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HelmSecondaryText}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:Button Content="Paid" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding PayCommand}" Margin="0,0,4,0"
                                                               Visibility="{Binding CanPay, Converter={StaticResource BoolToVisibility}}"
                                                               ToolTip="Saves this month's payment in the Wallet and marks the month paid"
                                                               AutomationProperties.Name="{Binding Name, StringFormat='{}{0}: paid'}" />
                                                    <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Edit24}" Command="{Binding EditCommand}" ToolTip="Edit"
                                                               AutomationProperties.Name="{Binding Name, StringFormat='Edit {0}'}" />
                                                    <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Delete24}" Command="{Binding DeleteCommand}" ToolTip="Delete"
                                                               AutomationProperties.Name="{Binding Name, StringFormat='Delete {0}'}" />
                                                </StackPanel>
                                            </Grid>
                                            <!-- A bill that varies: how much it came to this month -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsAskingAmount, Converter={StaticResource BoolToVisibility}}">
                                                <ui:TextBox Text="{Binding PayAmount, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="How much? 450k" Width="180"
                                                            AutomationProperties.Name="{Binding Name, StringFormat='How much was {0}'}" />
                                                <ui:Button Appearance="Primary" Content="Save" Margin="8,0,0,0" Command="{Binding PayCommand}" />
                                                <ui:Button Content="Cancel" Margin="8,0,0,0" Command="{Binding CancelPayCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- The month's transactions on the left, where the money went on the right -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{DynamicResource HelmSurface}" Padding="0" VerticalAlignment="Top">
                        <StackPanel>
                            <DockPanel Margin="16,14,16,12">
                                <ListBox DockPanel.Dock="Right" Style="{StaticResource Segmented}" Margin="12,0,0,0" ItemsSource="{x:Static local:WalletViewModel.FilterNames}"
                                         SelectedIndex="{Binding FilterIndex}" AutomationProperties.Name="Show" />
                                <TextBlock Text="Transactions" Style="{StaticResource CardTitle}" />
                            </DockPanel>
                            <ui:TextBox Margin="16,0,16,12" PlaceholderText="Search descriptions, notes, categories" Icon="{ui:SymbolIcon Search24}" AutomationProperties.Name="Search"
                                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                            <TextBlock Text="{Binding EmptyText}" Style="{DynamicResource HelmSecondaryText}" Margin="16,0,16,16" TextWrapping="Wrap"
                                       Visibility="{Binding HasDays, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:DayGroup}">
                                        <StackPanel>
                                            <DockPanel Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" Margin="16,6" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Margin="16,6" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TransactionRow}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:Button Content="{Binding TransactionPager.MoreText}" Command="{Binding TransactionPager.ShowMoreCommand}" Margin="16,12" HorizontalAlignment="Stretch"
                                       Visibility="{Binding TransactionPager.HasMore, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Spending by category" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="Nothing spent this month yet." Style="{DynamicResource HelmSecondaryText}" Margin="0,8,0,0"
                                           Visibility="{Binding HasSpending, Converter={StaticResource InverseBoolToVisibility}}" />
                                <StackPanel Visibility="{Binding HasSpending, Converter={StaticResource BoolToVisibility}}">
                                    <self:DonutChart Model="{Binding SpendingDonut}" Width="190" Height="190" Margin="0,12,0,12" AutomationProperties.Name="Spending by category" />
                                    <ItemsControl ItemsSource="{Binding SpendingDonut.Segments}" ItemTemplate="{StaticResource LegendRow}" Focusable="False" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Spending by day" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <self:BarChart Model="{Binding DailyChart}" Height="200" AutomationProperties.Name="Spending by day" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding DailyChart.HasReference, Converter={StaticResource BoolToVisibility}}">
                                    <Border Width="16" Height="2" Background="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding DailyChart.ReferenceLabel}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Last 6 months" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <self:BarChart Model="{Binding MonthsChart}" Height="180" AutomationProperties.Name="Money in and spending in the last six months"
                                               ToolTip="Click a month to open it" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Width="12" Height="12" CornerRadius="2" Background="{Binding MonthsChart.Color, Converter={x:Static self:WalletConverters.Ink}}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding MonthsChart.Name}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" Margin="0,0,16,0" />
                                    <Border Width="12" Height="12" CornerRadius="2" Background="{Binding MonthsChart.Color2, Converter={x:Static self:WalletConverters.Ink}}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding MonthsChart.Name2}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource HelmSurface}" Visibility="{Binding HasEarning, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Money in by category" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding Earning}" ItemTemplate="{StaticResource EarningRow}" Focusable="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ============================== Debts ============================== -->
            <StackPanel DataContext="{Binding Debts}" Visibility="{Binding DataContext.IsDebtsView, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12" Padding="12,8" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <core:RowLayout>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Command="{Binding DismissMessageCommand}" />
                    </core:RowLayout>
                </Border>

                <DockPanel Margin="0,0,0,16">
                    <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="Add debt" Icon="{ui:SymbolIcon Add24}" Command="{Binding OpenAddCommand}" />
                    <TextBlock Text="Debt book" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OpenSummary}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" Margin="12,2,0,0" />
                </DockPanel>

                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Border Style="{DynamicResource HelmSurface}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Owed to me" Style="{DynamicResource HelmSecondaryText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OwedToMeText}" Style="{StaticResource Figure}" Margin="0,4,0,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource HelmSurface}" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="I owe" Style="{DynamicResource HelmSecondaryText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding IOweText}" Style="{StaticResource Figure}" Margin="0,4,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource HelmSurface}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Net" Style="{DynamicResource HelmSecondaryText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding NetText}" Style="{StaticResource Figure}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Style="{DynamicResource HelmSurface}" Padding="0">
                            <StackPanel>
                                <DockPanel Margin="16,14,16,10">
                                    <TextBlock DockPanel.Dock="Right" Text="Click a person for their history and due date" Style="{DynamicResource HelmSecondaryText}" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Outstanding" Style="{StaticResource CardTitle}" />
                                </DockPanel>
                                <TextBlock Margin="16,0,16,16" Text="Nothing outstanding. Everyone is square." Style="{DynamicResource HelmSecondaryText}"
                                           Visibility="{Binding HasNoPeople, Converter={StaticResource BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding People}" ItemTemplate="{StaticResource PersonRow}" Focusable="False" />
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource HelmSurface}" Padding="0" Margin="0,12,0,0" Visibility="{Binding HasSettled, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel Margin="16,8">
                                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="Show or hide" Command="{Binding ToggleSettledCommand}" />
                                    <TextBlock Text="Settled" Style="{StaticResource CardTitle}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding SettledPeople}" ItemTemplate="{StaticResource PersonRow}" Focusable="False"
                                              Visibility="{Binding ShowSettled, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="2" Style="{DynamicResource HelmSurface}" VerticalAlignment="Top">
                        <DockPanel>
                            <ui:SymbolIcon DockPanel.Dock="Left" Symbol="BuildingBank24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="Lent or borrowed by bank transfer?" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap"
                                           Text="Open that transaction in Money and choose Lent, borrowed, paid back. It then counts neither as spending nor as income." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Page>
