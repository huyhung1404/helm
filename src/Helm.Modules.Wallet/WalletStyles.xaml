<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Helm.Modules.Wallet;assembly=Helm.Modules.Wallet.Core"
    xmlns:self="clr-namespace:Helm.Modules.Wallet">

    <!-- What the Wallet page and its pop-up share: one look for every choice, chip, row and jar. -->

    <!-- Small icon-only action button -->
    <Style x:Key="RowAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A whole row as one flat button (hover shading, keyboard focus) -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A chip: a category or a choice; picked chips (IsSelected) get the accent outline -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Padding" Value="4,3,12,3" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A chip with a dashed outline: something to add or open -->
    <Style x:Key="ChipDashed" TargetType="Button" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- One choice of a few, side by side (kind, filter, due date…): a list box whose picked item is the accent -->
    <Style x:Key="Segmented" TargetType="ListBox">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorInputActiveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" CornerRadius="4" Padding="12,5" Margin="1,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                    <ContentPresenter x:Name="Cp" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter TargetName="Cp" Property="TextElement.FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A field label above its box -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource HelmSecondaryText}">
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A line under a field: help, or what was understood ("= 1,200,000 ₫") -->
    <Style x:Key="FieldHint" TargetType="TextBlock" BasedOn="{StaticResource HelmSecondaryText}">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A card's title -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The big number of a summary card -->
    <Style x:Key="Figure" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- "auto": Helm picked the category -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
    </Style>

    <!-- A count on a button ("To categorize 3") -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>

    <!-- A boxed note inside a pop-up (the bank's notification, a suggestion) -->
    <Style x:Key="Box" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    </Style>

    <!-- Signed amount: money in green, money out in the normal text colour -->
    <Style x:Key="AmountText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsIncome}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Signed amount of a person: + in green, - in red -->
    <Style x:Key="SignedText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding OwedToMe}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IOwe}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A fund's status line: amber low, orange used up, red over, green on track (with its words and icon) -->
    <Style x:Key="FundStatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Low">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="UsedUp">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Over">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FundStatusIcon" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Symbol" Value="CheckmarkCircle24" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Low">
                <Setter Property="Symbol" Value="Warning24" />
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="UsedUp">
                <Setter Property="Symbol" Value="Warning24" />
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Over">
                <Setter Property="Symbol" Value="ErrorCircle24" />
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A category chip (form, details): its badge, name and why it says more -->
    <DataTemplate x:Key="PickChip" DataType="{x:Type local:CategoryPick}">
        <Button Style="{StaticResource Chip}" Command="{Binding PickCommand}" AutomationProperties.Name="{Binding Name}">
            <StackPanel Orientation="Horizontal">
                <self:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="22" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Note, StringFormat=' · {0}'}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" VerticalAlignment="Center"
                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- A one-click category under a transaction to categorize -->
    <DataTemplate x:Key="SuggestionChip" DataType="{x:Type local:CategoryChip}">
        <Button Style="{StaticResource Chip}" Command="{Binding PickCommand}" ToolTip="Put it in this category" AutomationProperties.Name="{Binding Name}">
            <StackPanel Orientation="Horizontal">
                <self:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="22" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- A fund's category, shown (not picked) -->
    <DataTemplate x:Key="ChoiceChip" DataType="{x:Type local:CategoryChoice}">
        <Border BorderThickness="1" CornerRadius="15" Padding="4,3,12,3" Margin="0,0,6,6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <self:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="22" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="Wrap">
        <WrapPanel />
    </ItemsPanelTemplate>

    <!-- A transaction: badge, title, category (and "auto"), time and bank, amount; a click opens its details -->
    <DataTemplate x:Key="TransactionRow" DataType="{x:Type local:TransactionRow}">
        <Button Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <self:CategoryBadge Icon="{Binding CategoryIcon}" Color="{Binding CategoryColor}" Size="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Visibility="{Binding IsCategorized, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="To categorize" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Style="{DynamicResource HelmSecondaryText}"
                                   Visibility="{Binding IsCategorized, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Border Style="{StaticResource Tag}" Margin="0,0,6,0" Visibility="{Binding IsAuto, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="Helm picked this category from earlier transactions like it">
                            <TextBlock Text="auto" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding Details}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontSize="15" Margin="12,0,0,0" Style="{StaticResource AmountText}" />
            </Grid>
        </Button>
    </DataTemplate>

    <!-- A transaction to categorize: its row, then one-click categories (AI's pick first, or the new one it proposes,
         made only when clicked) and "Lent, borrowed…" -->
    <DataTemplate x:Key="ToCategorizeRow" DataType="{x:Type local:TransactionRow}">
        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TransactionRow}" />
                <WrapPanel Margin="64,0,16,10">
                    <Button Style="{StaticResource ChipDashed}" Padding="8,3,12,3" Command="{Binding AcceptProposedCategoryCommand}"
                            Visibility="{Binding HasProposedCategory, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="AI proposes this new category: a click makes it and files the transaction in it"
                            AutomationProperties.Name="{Binding ProposedCategoryText}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Sparkle24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding ProposedCategoryText}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource SuggestionChip}" ItemsPanel="{StaticResource Wrap}" Focusable="False" />
                    <Button Style="{StaticResource ChipDashed}" Command="{Binding OpenDebtFormCommand}" Visibility="{Binding CanBeDebt, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Put this money in the debt book: it then counts neither as spending nor as income">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PersonMoney24" FontSize="15" Margin="4,0,6,0" />
                            <TextBlock Text="Lent, borrowed…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ChipDashed}" Padding="12,3" Command="{Binding OpenCommand}" Content="More…" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A fund on the page: its honey pot, name, what is left or over, status, spent of held -->
    <DataTemplate x:Key="FundTile" DataType="{x:Type local:FundRow}">
        <Button Command="{Binding OpenCommand}" Cursor="Hand" Margin="0,0,10,10" Width="268" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Name}"
                AutomationProperties.HelpText="{Binding StatusText}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Padding="12" BorderThickness="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Status}" Value="Over">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <self:FundJar Width="62" Height="70" Level="{Binding LeftShare}" Color="{Binding Color}" Status="{Binding Status}" Text="{Binding PercentText}" TextSize="12"
                              Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="6,0,0,0">
                            <TextBlock Text="{Binding KindShort}" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding BigText, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" />
                        <Run Text="{Binding BigLabel, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <ui:SymbolIcon Style="{StaticResource FundStatusIcon}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource FundStatusText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding OfText}" Style="{DynamicResource HelmSecondaryText}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>

    <!-- A person in the debt book: a click opens their pop-up -->
    <DataTemplate x:Key="PersonRow" DataType="{x:Type local:DebtPersonViewModel}">
        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Button Style="{StaticResource RowButton}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,12,0" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" FontSize="12" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HelmSecondaryText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding BalanceText}" FontSize="15" Margin="12,0,8,0" Style="{StaticResource SignedText}" />
                    <ui:SymbolIcon Grid.Column="3" Symbol="ChevronRight24" FontSize="16" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </Border>
    </DataTemplate>
</ResourceDictionary>
