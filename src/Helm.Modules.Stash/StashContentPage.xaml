<Page
    x:Class="Helm.Modules.Stash.StashContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.Stash;assembly=Helm.Modules.Stash.Core"
    xmlns:self="clr-namespace:Helm.Modules.Stash"
    Title="Stash" ScrollViewer.CanContentScroll="False" AllowDrop="True">

    <!-- Stash itself (menu and Quick access): add files and text, the filters, and everything as a wall of cards that show
         their content (a text in full, a photo at its shape). Files can be dropped on the page and pasted with Ctrl+V.
         Options live on StashPage. -->
    <Page.Resources>
        <self:StashThumbnailConverter x:Key="Thumbnail" />

        <!-- Small icon-only action (messages, the trash) -->
        <Style x:Key="RowAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Small icon-only action on a card -->
        <Style x:Key="CardAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One thing: a card in the theme's card colours, as tall as what it shows -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A filter above the cards: the selected one is filled -->
        <Style x:Key="FilterButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Appearance" Value="Secondary" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Appearance" Value="Primary" />
                </DataTrigger>
                <!-- The trash: a bin with the count -->
                <DataTrigger Binding="{Binding IsTrash}" Value="True">
                    <Setter Property="Icon" Value="{ui:SymbolIcon Delete24}" />
                    <Setter Property="ToolTip" Value="Trash" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A button with no chrome (a picture or a file name that opens the file) -->
        <Style x:Key="BareButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="Root" Margin="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Paste" Icon="{ui:SymbolIcon ClipboardPaste24}" Margin="0,0,8,0" Click="Paste_Click"
                           ToolTip="Add the files, picture or text on the clipboard (Ctrl+V)" IsEnabled="{Binding IsNotBusy}" />
                <ui:Button Content="Add text" Icon="{ui:SymbolIcon TextT24}" Margin="0,0,8,0" Command="{Binding OpenTextBoxCommand}"
                           ToolTip="Type or paste a note, a link, an address" IsEnabled="{Binding IsNotBusy}" />
                <ui:Button Appearance="Primary" Content="Add files" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddFilesCommand}"
                           ToolTip="Pick files to add (or drop them on this page)" IsEnabled="{Binding IsNotBusy}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{x:Static self:StashLogo.Image}" Width="32" Height="32" Margin="0,0,12,0" />
                <TextBlock Text="Stash" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Shown while the tool is turned off -->
        <ui:InfoBar x:Name="OffBar" Grid.Row="1" Severity="Informational" IsClosable="False" IsOpen="False" Visibility="Collapsed" Margin="0,0,0,12"
                    Title="Stash is turned off" Message="Everything in it is kept. Turn Stash on in its settings to add and take things out." />

        <!-- Sync off, storage full: what you add does not reach the other devices -->
        <ui:InfoBar Grid.Row="1" Severity="Warning" IsClosable="False" Margin="0,0,0,12" Message="{Binding SyncNote}"
                    IsOpen="{Binding HasSyncNote, Mode=OneWay}" Visibility="{Binding HasSyncNote, Converter={StaticResource BoolToVisibility}}" />

        <!-- What happened, and what is going on (adding, downloading) -->
        <StackPanel Grid.Row="2">
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12" Padding="12,8"
                    Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <core:RowLayout>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Style="{StaticResource RowAction}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss"
                               Command="{Binding DismissMessageCommand}" />
                </core:RowLayout>
            </Border>
            <Border Style="{DynamicResource HelmSurface}" Margin="0,0,0,12" Padding="12,10"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Margin="0,8,0,0" Height="4" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressKnown, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Add a piece of text -->
        <Border Grid.Row="3" Style="{DynamicResource HelmSurface}" Padding="12" Margin="0,0,0,12"
                Visibility="{Binding IsTextBoxOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ui:TextBox x:Name="TextBox" PlaceholderText="A link, an address, a code, a few lines to have on your phone…" AcceptsReturn="True"
                            TextWrapping="Wrap" MinHeight="72" MaxHeight="240" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                            AutomationProperties.Name="Text to add" Text="{Binding NewText, UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.InputBindings>
                        <KeyBinding Key="Return" Modifiers="Ctrl" Command="{Binding SaveTextCommand}" />
                        <KeyBinding Key="Escape" Command="{Binding CancelTextCommand}" />
                    </ui:TextBox.InputBindings>
                </ui:TextBox>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Appearance="Primary" Content="Add" Icon="{ui:SymbolIcon Add24}" ToolTip="Add (Ctrl+Enter)" Command="{Binding SaveTextCommand}" />
                    <ui:Button Margin="8,0,0,0" Content="Cancel" Command="{Binding CancelTextCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Filters and search -->
        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding FilterTabs}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:StashFilterTab}">
                        <ui:Button Style="{StaticResource FilterButton}" Content="{Binding Label}" AutomationProperties.Name="{Binding Name}"
                                   Command="{Binding DataContext.ShowFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Style="{StaticResource RowAction}" Content="Empty trash" Icon="{ui:SymbolIcon Delete24}" Margin="0,0,8,6"
                           ToolTip="Delete everything in the trash for good" Command="{Binding EmptyTrashCommand}" IsEnabled="{Binding HasTrash}"
                           Visibility="{Binding ShowingTrash, Converter={StaticResource BoolToVisibility}}" />
                <ui:TextBox x:Name="SearchBox" Width="240" Margin="0,0,0,6" PlaceholderText="Search (Ctrl+F)" Icon="{ui:SymbolIcon Search24}"
                            AutomationProperties.Name="Search the stash" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="Body" Grid.Row="5">
            <!-- Empty -->
            <StackPanel Margin="4,8,4,16" Visibility="{Binding IsListEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding EmptyListText}" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap"
                           Text="Tip: drop files on this page, or press Ctrl+V to add the files, picture or text you copied. On your phone, share photos to “Helm Stash”."
                           Visibility="{Binding NotShowingTrash, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <!-- The wall of cards: each shows what it holds and is as tall as that; the cards fill the columns -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False"
                          Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                <!-- Drag a card onto another one to move it there (code-behind) -->
                <ItemsControl x:Name="Wall" ItemsSource="{Binding Rows}" Focusable="False" Margin="0,4,8,24" AutomationProperties.Name="Stash" AllowDrop="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <self:MasonryPanel MinColumnWidth="230" Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:StashRowViewModel}">
                            <Border Style="{StaticResource Card}" ToolTip="{Binding Meta}" Cursor="SizeAll" AutomationProperties.Name="{Binding Name}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <!-- Right-click: everything else that can be done with it -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open" Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuItem Header="Copy" Command="{Binding PlacementTarget.Tag.CopyCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Send to clipboard on all devices"
                                                  Command="{Binding PlacementTarget.Tag.SendToClipboardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuItem Header="Save as…" Command="{Binding PlacementTarget.Tag.SaveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}" />
                                        <Separator />
                                        <MenuItem Header="Move to the trash" Command="{Binding PlacementTarget.Tag.TrashCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuItem Header="Restore" Command="{Binding PlacementTarget.Tag.RestoreCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" Visibility="{Binding Trashed, Converter={StaticResource BoolToVisibility}}" />
                                        <MenuItem Header="Delete for good" Command="{Binding PlacementTarget.Tag.DeleteForeverCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" Visibility="{Binding Trashed, Converter={StaticResource BoolToVisibility}}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <!-- A photo or a video: the picture itself, at its own shape; a click opens it -->
                                    <Button Style="{StaticResource BareButton}" ToolTip="Open" AutomationProperties.Name="Open"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail, Converter={StaticResource Thumbnail}}" Stretch="Uniform" />
                                            <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.85"
                                                    Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                                                <ui:SymbolIcon Symbol="Play24" Filled="True" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <!-- A text: all of it -->
                                    <TextBlock Margin="2,0,2,0" Text="{Binding FullText}" TextWrapping="Wrap" FontSize="14" LineHeight="20"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Any other file (or a photo without a picture): its icon and name; a click opens it -->
                                    <Button Style="{StaticResource BareButton}" ToolTip="Open" AutomationProperties.Name="Open"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Button.Visibility>
                                            <MultiBinding Converter="{x:Static self:AllTrueToVisibility.Instance}">
                                                <Binding Path="IsFile" />
                                                <Binding Path="HasNoThumbnail" />
                                            </MultiBinding>
                                        </Button.Visibility>
                                        <DockPanel Margin="2,2,2,0">
                                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Top"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <Grid>
                                                    <ui:SymbolIcon Symbol="Image24" FontSize="22" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:SymbolIcon Symbol="Video24" FontSize="22" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:SymbolIcon Symbol="Document24" FontSize="22" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Visibility="{Binding IsDocument, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </DockPanel>
                                    </Button>

                                    <!-- Footer: size and time, the upload state, and the card's actions -->
                                    <DockPanel Margin="2,6,0,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <ui:Button Style="{StaticResource CardAction}" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy" AutomationProperties.Name="Copy"
                                                       Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <ui:Button Style="{StaticResource CardAction}" Icon="{ui:SymbolIcon ClipboardArrowRight24}" AutomationProperties.Name="Send to clipboard"
                                                       ToolTip="Send to clipboard: copies it here and on your other devices that are syncing"
                                                       Command="{Binding DataContext.SendToClipboardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                       Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:Button Style="{StaticResource CardAction}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Move to the trash" AutomationProperties.Name="Move to the trash"
                                                       Command="{Binding DataContext.TrashCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                       Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:Button Style="{StaticResource CardAction}" Icon="{ui:SymbolIcon ArrowUndo24}" ToolTip="Restore" AutomationProperties.Name="Restore"
                                                       Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                       Visibility="{Binding Trashed, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:Button Style="{StaticResource CardAction}" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete for good" AutomationProperties.Name="Delete for good"
                                                       Command="{Binding DataContext.DeleteForeverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                       Visibility="{Binding Trashed, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Footer}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
