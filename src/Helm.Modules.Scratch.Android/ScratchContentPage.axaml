<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Scratch"
             x:Class="Helm.Modules.Scratch.ScratchContentPage"
             x:DataType="vm:ScratchViewModel">

    <!-- Scratch itself (drawer and Quick access): adding, the filters and a wall of cards showing their content, or one
         thing's details (Back returns to the wall). Its options live on ScratchPage (Home → Utilities). -->
    <UserControl.Styles>
        <!-- A filter: the selected one is filled -->
        <Style Selector="Button.filter">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <!-- An action in the details: full width of its column -->
        <Style Selector="Button.action">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,10" />
        </Style>
        <!-- One thing on the wall: a card as tall as what it shows -->
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,8,4,4" />
        </Style>
        <!-- The card's content as a tap target, without button chrome -->
        <Style Selector="Button.bare">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.thumb">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="8">
        <!-- Shown while the tool is turned off -->
        <Border x:Name="OffBar" Classes="infobar warning" IsVisible="False">
            <TextBlock Text="Scratch is turned off. Everything in it is kept; turn Scratch on in its settings to add and take things out." TextWrapping="Wrap" />
        </Border>

        <!-- Sync off, storage full: what you add does not reach the other devices -->
        <Border Classes="infobar warning" IsVisible="{Binding HasSyncNote}">
            <TextBlock Text="{Binding SyncNote}" TextWrapping="Wrap" />
        </Border>

        <!-- What happened -->
        <Border Classes="infobar" IsVisible="{Binding HasMessage}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="flat" Width="44" Height="44" Padding="0" HorizontalContentAlignment="Center"
                        Command="{Binding DismissMessageCommand}" AutomationProperties.Name="Dismiss">
                    <ic:SymbolIcon Symbol="Dismiss" FontSize="16" />
                </Button>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Adding, downloading -->
        <Border Classes="card" IsVisible="{Binding IsBusy}">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding !IsProgressKnown}" />
            </StackPanel>
        </Border>

        <Panel x:Name="Body">
            <!-- The list -->
            <StackPanel IsVisible="{Binding IsDetailClosed}" Spacing="8">
                <Grid ColumnDefinitions="*,6,*,6,*" IsEnabled="{Binding IsNotBusy}">
                    <Button Classes="accent action" Command="{Binding AddFilesCommand}" AutomationProperties.Name="Add files">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Add" FontSize="16" />
                            <TextBlock Text="Files" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="action" Command="{Binding OpenTextBoxCommand}" AutomationProperties.Name="Add text">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="TextT" FontSize="16" />
                            <TextBlock Text="Text" />
                        </StackPanel>
                    </Button>
                    <!-- What another app copied: a file or a picture, or text -->
                    <Button Grid.Column="4" Classes="action" Click="Paste_Click" AutomationProperties.Name="Paste">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="ClipboardPaste" FontSize="16" />
                            <TextBlock Text="Paste" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Add a piece of text -->
                <Border Classes="card" IsVisible="{Binding IsTextBoxOpen}">
                    <StackPanel Spacing="8">
                        <TextBox x:Name="TextBox" PlaceholderText="A link, an address, a code, a few lines for your PC…" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="96" MaxHeight="240" VerticalContentAlignment="Top"
                                 Text="{Binding NewText}" AutomationProperties.Name="Text to add" />
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Classes="accent action" Content="Add" Command="{Binding SaveTextCommand}" />
                            <Button Grid.Column="2" Classes="action" Content="Cancel" Command="{Binding CancelTextCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Filters -->
                <ItemsControl ItemsSource="{Binding FilterTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ScratchFilterTab">
                            <Button Classes="filter" Classes.accent="{Binding IsSelected}" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding $parent[ItemsControl].((vm:ScratchViewModel)DataContext).ShowFilterCommand}" CommandParameter="{Binding}">
                                <!-- The trash: a bin with the count -->
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ic:SymbolIcon Symbol="Delete" FontSize="16" IsVisible="{Binding IsTrash}" />
                                    <TextBlock Text="{Binding Label}" IsVisible="{Binding HasLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox PlaceholderText="Search" Text="{Binding Search}" AutomationProperties.Name="Search Scratch" />
                    <Button Grid.Column="1" Classes="flat danger" Margin="8,0,0,0" Padding="10,6" Content="Empty trash" Command="{Binding EmptyTrashCommand}"
                            IsVisible="{Binding ShowingTrash}" IsEnabled="{Binding HasTrash}" AutomationProperties.Name="Empty the trash" />
                </Grid>

                <!-- The wall of cards: each shows what it holds and is as tall as that; a tap shows its details -->
                <!-- Hold a card, then drag it onto another one to move it there (code-behind) -->
                <ItemsControl x:Name="Wall" ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vm:MasonryPanel MinColumnWidth="150" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ScratchRowViewModel">
                            <Border Classes="tile">
                                <StackPanel Spacing="4">
                                    <Button Classes="bare" AutomationProperties.Name="{Binding Name}"
                                            Command="{Binding $parent[ItemsControl].((vm:ScratchViewModel)DataContext).SelectCommand}" CommandParameter="{Binding}">
                                        <Panel>
                                            <!-- A photo or a video: the picture at its own shape -->
                                            <Panel IsVisible="{Binding HasThumbnail}">
                                                <Image Source="{Binding Thumbnail, Converter={x:Static vm:ScratchThumbnailConverter.Instance}}" Stretch="Uniform" />
                                                <Border Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"
                                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" IsVisible="{Binding IsVideo}">
                                                    <ic:SymbolIcon Symbol="Play" IconVariant="Filled" FontSize="14" />
                                                </Border>
                                            </Panel>
                                            <!-- A text: all of it -->
                                            <TextBlock Text="{Binding FullText}" TextWrapping="Wrap" FontSize="14" IsVisible="{Binding IsText}" />
                                            <!-- Any other file: its icon and name -->
                                            <StackPanel Spacing="6">
                                                <StackPanel.IsVisible>
                                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                        <Binding Path="IsFile" />
                                                        <Binding Path="HasNoThumbnail" />
                                                    </MultiBinding>
                                                </StackPanel.IsVisible>
                                                <Border Classes="thumb" HorizontalAlignment="Left">
                                                    <Panel>
                                                        <ic:SymbolIcon Symbol="Image" FontSize="22" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsVisible="{Binding IsImage}" />
                                                        <ic:SymbolIcon Symbol="Video" FontSize="22" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsVisible="{Binding IsVideo}" />
                                                        <ic:SymbolIcon Symbol="Document" FontSize="22" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsVisible="{Binding IsDocument}" />
                                                    </Panel>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Panel>
                                    </Button>

                                    <!-- Footer: when, the upload state, Copy and Delete -->
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Classes="flat small" AutomationProperties.Name="Copy"
                                                    Command="{Binding $parent[ItemsControl].((vm:ScratchViewModel)DataContext).CopyCommand}" CommandParameter="{Binding}">
                                                <ic:SymbolIcon Symbol="Copy" FontSize="16" />
                                            </Button>
                                            <Button Classes="flat small" AutomationProperties.Name="Move to the trash" IsVisible="{Binding IsLive}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ScratchViewModel)DataContext).TrashCommand}" CommandParameter="{Binding}">
                                                <ic:SymbolIcon Symbol="Delete" FontSize="16" />
                                            </Button>
                                            <Button Classes="flat small" AutomationProperties.Name="Restore" IsVisible="{Binding Trashed}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ScratchViewModel)DataContext).RestoreCommand}" CommandParameter="{Binding}">
                                                <ic:SymbolIcon Symbol="ArrowUndo" FontSize="16" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Footer}" FontSize="11" Classes="secondary" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource SystemAccentColor}" TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding HasStatus}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding EmptyListText}" Classes="secondary" TextWrapping="Wrap" Margin="4,8" IsVisible="{Binding IsListEmpty}" />
                <TextBlock Text="Tip: in Gallery or any app, tap Share → Helm Scratch to put photos, videos and files here."
                           Classes="secondary" TextWrapping="Wrap" Margin="4,0" IsVisible="{Binding NotShowingTrash}" />
            </StackPanel>

            <!-- One thing's details -->
            <StackPanel IsVisible="{Binding IsDetailOpen}" Spacing="8">
                <Button HorizontalAlignment="Left" Classes="flat" Padding="8,6" Command="{Binding CloseDetailCommand}" AutomationProperties.Name="Back to the list">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="ArrowLeft" FontSize="16" />
                        <TextBlock Text="Scratch" />
                    </StackPanel>
                </Button>

                <!-- The picture: a tap opens the file itself -->
                <Button Classes="flat" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Open"
                        Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" IsVisible="{Binding Selected.HasThumbnail, FallbackValue=False}">
                    <Border CornerRadius="8" ClipToBounds="True" Height="240" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Panel>
                            <Image Source="{Binding Selected.Thumbnail, Converter={x:Static vm:ScratchThumbnailConverter.Instance}}" Stretch="Uniform" />
                            <Border Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" IsVisible="{Binding Selected.IsVideo, FallbackValue=False}">
                                <ic:SymbolIcon Symbol="Play" IconVariant="Filled" FontSize="20" />
                            </Border>
                        </Panel>
                    </Border>
                </Button>

                <Border Classes="card">
                    <StackPanel Spacing="4">
                        <SelectableTextBlock Text="{Binding Selected.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Selected.Meta}" Classes="secondary" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Selected.Status}" FontSize="12" Foreground="{DynamicResource SystemAccentColor}"
                                   IsVisible="{Binding Selected.HasStatus, FallbackValue=False}" />
                        <!-- The whole text, to read and select -->
                        <SelectableTextBlock Margin="0,8,0,0" Text="{Binding DetailText}" TextWrapping="Wrap"
                                             IsVisible="{Binding Selected.IsText, FallbackValue=False}" />
                    </StackPanel>
                </Border>

                <!-- Here and on the other devices -->
                <Button Classes="action" Command="{Binding SendToClipboardCommand}" CommandParameter="{Binding Selected}" AutomationProperties.Name="Send to clipboard"
                        IsVisible="{Binding Selected.IsLive, FallbackValue=False}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="ClipboardArrowRight" FontSize="16" />
                        <TextBlock Text="Send to clipboard (all devices)" />
                    </StackPanel>
                </Button>

                <!-- A file -->
                <StackPanel Spacing="8">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Selected.IsFile" FallbackValue="False" />
                            <Binding Path="Selected.IsLive" FallbackValue="False" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Classes="accent action" Command="{Binding OpenCommand}" CommandParameter="{Binding Selected}" AutomationProperties.Name="Open">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="Open" FontSize="16" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="action" Command="{Binding SendCommand}" CommandParameter="{Binding Selected}" AutomationProperties.Name="Share">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="Share" FontSize="16" />
                                <TextBlock Text="Share" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,8,*">
                        <Button Classes="action" Command="{Binding SaveCommand}" CommandParameter="{Binding Selected}" AutomationProperties.Name="Save to phone">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="ArrowDownload" FontSize="16" />
                                <TextBlock Text="Save to phone" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="action" Command="{Binding TrashCommand}" CommandParameter="{Binding Selected}" AutomationProperties.Name="Move to the trash">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="Delete" FontSize="16" />
                                <TextBlock Text="Trash" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- A text -->
                <Grid ColumnDefinitions="*,8,*">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Selected.IsText" FallbackValue="False" />
                            <Binding Path="Selected.IsLive" FallbackValue="False" />
                        </MultiBinding>
                    </Grid.IsVisible>
                    <Button Classes="accent action" Command="{Binding CopyTextCommand}" CommandParameter="{Binding Selected}" AutomationProperties.Name="Copy">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Copy" FontSize="16" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="action" Command="{Binding TrashCommand}" CommandParameter="{Binding Selected}" AutomationProperties.Name="Move to the trash">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Delete" FontSize="16" />
                            <TextBlock Text="Trash" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- In the trash: bring it back or delete it for good -->
                <Grid ColumnDefinitions="*,8,*" IsVisible="{Binding Selected.Trashed, FallbackValue=False}">
                    <Button Classes="accent action" Content="Restore" Command="{Binding RestoreCommand}" CommandParameter="{Binding Selected}" />
                    <Button Grid.Column="2" Classes="danger action" Content="Delete for good" Command="{Binding DeleteForeverCommand}" CommandParameter="{Binding Selected}" />
                </Grid>
            </StackPanel>
        </Panel>
    </StackPanel>
</UserControl>
