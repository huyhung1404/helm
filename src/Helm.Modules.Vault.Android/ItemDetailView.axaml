<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:local="using:Helm.Modules.Vault"
             xmlns:vm="using:Helm.Modules.Vault.ViewModels"
             xmlns:items="using:Helm.Modules.Vault.Items"
             x:Class="Helm.Modules.Vault.ItemDetailView"
             x:DataType="vm:ItemDetailViewModel">
    <UserControl.Styles>
        <!-- A two-factor code shown in place of its secret: big, fixed-width digits -->
        <Style Selector="TextBlock.code">
            <Setter Property="FontFamily" Value="monospace" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="4">
        <!-- Header -->
        <Border Classes="card">
            <StackPanel Spacing="8">
                <DockPanel>
                    <!-- Avatar: the item's own picture, else its first letter on a color from its title -->
                    <Panel DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Border CornerRadius="12" Background="{Binding AvatarColor, Converter={x:Static local:HexBrush.Converter}}" IsVisible="{Binding !HasIcon}">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="12" ClipToBounds="True" IsVisible="{Binding HasIcon}">
                            <Image Source="{Binding Icon, Converter={x:Static local:IconBitmap.Converter}}" Stretch="UniformToFill" />
                        </Border>
                    </Panel>
                    <TextBlock Classes="title" FontSize="18" VerticalAlignment="Center" Text="{Binding Title}" IsVisible="{Binding !IsEditing}" TextWrapping="Wrap" />
                    <TextBox PlaceholderText="Title" Text="{Binding Title}" IsVisible="{Binding IsEditing}" AutomationProperties.Name="Title" VerticalAlignment="Center" />
                </DockPanel>
                <WrapPanel IsVisible="{Binding IsEditing}">
                    <Button Margin="0,0,8,4" Command="{Binding ChooseIconCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="ImageAdd" FontSize="16" />
                            <TextBlock Text="Choose icon…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,4" Content="Remove icon" Command="{Binding RemoveIconCommand}" IsVisible="{Binding HasIcon}" />
                </WrapPanel>
                <DockPanel IsVisible="{Binding IsEditing}">
                    <TextBlock DockPanel.Dock="Left" Text="Type" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" HorizontalAlignment="Stretch" AutomationProperties.Name="Type" />
                </DockPanel>
                <CheckBox Content="Favorite" IsChecked="{Binding Favorite}" IsVisible="{Binding IsEditing}" />
                <WrapPanel>
                    <Button Margin="0,0,8,4" Content="Edit" Command="{Binding EditCommand}">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsEditing" />
                                <Binding Path="!Trashed" />
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                    <Button Margin="0,0,8,4" Content="Move to trash" Command="{Binding MoveToTrashCommand}">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!IsEditing" />
                                <Binding Path="!Trashed" />
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                    <Button Classes="accent" Margin="0,0,8,4" Content="Save" Command="{Binding SaveCommand}" IsVisible="{Binding IsEditing}" />
                    <Button Margin="0,0,8,4" Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsEditing}" />
                    <Button Classes="accent" Margin="0,0,8,4" Content="Restore" Command="{Binding RestoreFromTrashCommand}" IsVisible="{Binding Trashed}" />
                    <Button Classes="danger" Margin="0,0,8,4" Content="Delete for good" Command="{Binding DeleteForeverCommand}" IsVisible="{Binding Trashed}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Classes="infobar warning" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock TextWrapping="Wrap" Text="{Binding Error}" />
        </Border>

        <!-- Conflicts -->
        <Border Classes="card" IsVisible="{Binding HasConflicts}">
            <StackPanel Spacing="8">
                <TextBlock Classes="title" Text="Edited on two devices" />
                <TextBlock Classes="secondary" Text="Both versions are kept. Choose the one to keep; the other goes into the history." />
                <Button Content="Keep the version shown here" Command="{Binding KeepCurrentCommand}" />
                <ItemsControl ItemsSource="{Binding Conflicts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConflictViewModel">
                            <Border Classes="row">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding When}" />
                                    <TextBlock Classes="secondary" Text="{Binding Summary}" />
                                    <Button Content="Keep this one" Command="{Binding KeepThisCommand}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Fields -->
        <Border Classes="card">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldViewModel">
                            <StackPanel Margin="0,4,0,8">
                                <!-- View -->
                                <DockPanel IsVisible="{Binding !Owner.IsEditing}">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Classes="flat" Width="44" Command="{Binding ToggleRevealCommand}" IsVisible="{Binding IsSecret}" AutomationProperties.Name="Show or hide">
                                            <Panel>
                                                <ic:SymbolIcon Symbol="Eye" FontSize="18" IsVisible="{Binding !IsRevealed}" />
                                                <ic:SymbolIcon Symbol="EyeOff" FontSize="18" IsVisible="{Binding IsRevealed}" />
                                            </Panel>
                                        </Button>
                                        <Button Classes="flat" Width="44" Command="{Binding CopyCommand}" IsVisible="{Binding CanCopy}" AutomationProperties.Name="Copy">
                                            <ic:SymbolIcon Symbol="Copy" FontSize="18" />
                                        </Button>
                                        <!-- A file: open it, or save a copy -->
                                        <Button Classes="flat" Width="44" Command="{Binding OpenFileCommand}" IsVisible="{Binding HasFile}" AutomationProperties.Name="Open">
                                            <ic:SymbolIcon Symbol="Open" FontSize="18" />
                                        </Button>
                                        <Button Classes="flat" Width="44" Command="{Binding SaveFileCommand}" IsVisible="{Binding HasFile}" AutomationProperties.Name="Save a copy">
                                            <ic:SymbolIcon Symbol="ArrowDownload" FontSize="18" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Classes="secondary" Text="{Binding Name}" />
                                        <TextBlock TextWrapping="Wrap" Text="{Binding Display}" IsVisible="{Binding IsValueField}"
                                                   Classes.code="{Binding HasTotpCode}" />
                                        <!-- A two-factor code: how long it stays valid -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasTotpCode}">
                                            <ProgressBar Width="90" MinWidth="0" Height="3" MinHeight="3" Minimum="0" Maximum="100" Value="{Binding TotpProgress}" VerticalAlignment="Center" />
                                            <TextBlock Classes="secondary" Text="{Binding TotpSecondsLeft, StringFormat='{}{0} s left'}" />
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap" Text="{Binding FileText}" IsVisible="{Binding IsFile}" />
                                        <Image Margin="0,6,0,0" MaxHeight="200" HorizontalAlignment="Left" Stretch="Uniform"
                                               Source="{Binding Preview, Converter={x:Static local:PreviewBitmap.Converter}}" IsVisible="{Binding HasPreview}" />
                                    </StackPanel>
                                </DockPanel>
                                <!-- Edit: one row, [type] [name] [value] [x] -->
                                <Grid ColumnDefinitions="96,*,1.4*,Auto,Auto" IsVisible="{Binding Owner.IsEditing}">
                                    <ComboBox ItemsSource="{Binding Owner.FieldKinds}" SelectedItem="{Binding Kind}" HorizontalAlignment="Stretch" VerticalAlignment="Top" AutomationProperties.Name="Field type" />
                                    <TextBox Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Top" PlaceholderText="Name" Text="{Binding Name}" AutomationProperties.Name="Field name" />
                                    <TextBox Grid.Column="2" Margin="4,0,0,0" PlaceholderText="Value" Text="{Binding Value}" AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap"
                                             PasswordChar="{Binding IsSecret, Converter={x:Static local:SecretChar.Converter}}" RevealPassword="{Binding IsRevealed}"
                                             AutomationProperties.Name="{Binding Name}" IsVisible="{Binding IsValueField}" />
                                    <!-- A file: Choose / Replace, its name and a picture's preview -->
                                    <StackPanel Grid.Column="2" Margin="4,0,0,0" Spacing="4" IsVisible="{Binding IsFile}">
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ChooseFileCommand}" AutomationProperties.Name="Choose file">
                                            <Panel>
                                                <TextBlock Text="Choose…" IsVisible="{Binding !HasFile}" />
                                                <TextBlock Text="Replace…" IsVisible="{Binding HasFile}" />
                                            </Panel>
                                        </Button>
                                        <TextBlock Classes="secondary" Text="{Binding FileText}" TextTrimming="CharacterEllipsis" />
                                        <Image MaxHeight="96" HorizontalAlignment="Left" Stretch="Uniform"
                                               Source="{Binding Preview, Converter={x:Static local:PreviewBitmap.Converter}}" IsVisible="{Binding HasPreview}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Classes="flat" Width="40" Command="{Binding ToggleRevealCommand}" IsVisible="{Binding IsSecret}" AutomationProperties.Name="Show or hide">
                                            <Panel>
                                                <ic:SymbolIcon Symbol="Eye" FontSize="18" IsVisible="{Binding !IsRevealed}" />
                                                <ic:SymbolIcon Symbol="EyeOff" FontSize="18" IsVisible="{Binding IsRevealed}" />
                                            </Panel>
                                        </Button>
                                        <Button Classes="flat" Width="40" Command="{Binding GenerateCommand}" IsVisible="{Binding IsPassword}" AutomationProperties.Name="Generate a strong password">
                                            <ic:SymbolIcon Symbol="Wand" FontSize="18" />
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="4" Classes="flat" Width="40" VerticalAlignment="Top" Command="{Binding RemoveCommand}" AutomationProperties.Name="Remove field">
                                        <ic:SymbolIcon Symbol="Dismiss" FontSize="18" />
                                    </Button>
                                </Grid>
                                <!-- A two-factor key that gives no code, or its current code as a check -->
                                <TextBlock Margin="100,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource HelmDanger}" Text="{Binding TotpError}">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="Owner.IsEditing" />
                                            <Binding Path="HasTotpError" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                                <TextBlock Margin="100,4,0,0" Classes="secondary" Text="{Binding TotpCode, StringFormat='Current code: {0}'}">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="Owner.IsEditing" />
                                            <Binding Path="HasTotpCode" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add field" IsVisible="{Binding IsEditing}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Text" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Text}" />
                            <MenuItem Header="Username" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Username}" />
                            <MenuItem Header="Password" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Password}" />
                            <MenuItem Header="Hidden (PIN, code…)" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Secret}" />
                            <MenuItem Header="One-time code (2FA)" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Totp}" />
                            <MenuItem Header="Website" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Url}" />
                            <MenuItem Header="Email" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Email}" />
                            <MenuItem Header="Phone" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Phone}" />
                            <MenuItem Header="Several lines" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Multiline}" />
                            <Separator />
                            <MenuItem Header="Image" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Image}" />
                            <MenuItem Header="Document (any file)" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Document}" />
                            <MenuItem Header="Text file (.txt)" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.TextFile}" />
                            <MenuItem Header="Keystore" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Keystore}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Border>

        <!-- Notes and tags -->
        <TextBlock Classes="section" Text="{Binding NotesLabel}" />
        <Border Classes="card">
            <StackPanel Spacing="6">
                <TextBlock TextWrapping="Wrap" Text="{Binding Notes}" IsVisible="{Binding !IsEditing}" />
                <TextBox AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" Text="{Binding Notes}" IsVisible="{Binding IsEditing}" AutomationProperties.Name="Notes" />
                <TextBox PlaceholderText="Tags, separated by commas" Text="{Binding Tags}" IsVisible="{Binding IsEditing}" />
                <TextBlock Classes="secondary" Text="{Binding Tags}" IsVisible="{Binding !IsEditing}" />
            </StackPanel>
        </Border>

        <!-- Files are fields now (Image, Document, Text file, Keystore): opening one shows progress here -->
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding IsBusy}" Margin="0,4,0,0" />

        <!-- History -->
        <Expander Header="History" IsVisible="{Binding !IsNew}" HorizontalAlignment="Stretch" Margin="0,8,0,0">
            <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VersionViewModel">
                        <DockPanel Margin="0,4">
                            <Button DockPanel.Dock="Right" Content="Restore" Command="{Binding RestoreCommand}" />
                            <StackPanel>
                                <TextBlock Text="{Binding When}" />
                                <TextBlock Classes="secondary" Text="{Binding Summary}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
        <TextBlock Classes="secondary" Margin="4,8,0,0" Text="{Binding Modified}" />
    </StackPanel>
</UserControl>
