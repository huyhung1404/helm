<!-- The vault itself: the drawer and the Home tile open this page. Its settings are VaultPage (the Utilities chevron, or Settings here). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:local="using:Helm.Modules.Vault"
             xmlns:vm="using:Helm.Modules.Vault.ViewModels"
             xmlns:items="using:Helm.Modules.Vault.Items"
             x:Class="Helm.Modules.Vault.VaultContentPage"
             x:DataType="local:VaultPageViewModel">
    <UserControl.Styles>
        <!-- A section as a chip: a pill, outlined in the accent when chosen -->
        <Style Selector="Button.chip">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource HelmCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmCardStroke}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chip.on">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <!-- A row of the list: the whole row opens the item -->
        <Style Selector="Button.itemrow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="4">
        <!-- Title row: the icon, whether it is open and when it locks, Lock and the way to the settings -->
        <DockPanel Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Command="{Binding App.LockCommand}" IsVisible="{Binding App.IsItems}" AutomationProperties.Name="Lock" ToolTip.Tip="Lock">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="LockClosed" FontSize="16" />
                        <TextBlock Text="Lock" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenSettingsCommand}" AutomationProperties.Name="Vault settings" ToolTip.Tip="Vault settings">
                    <ic:SymbolIcon Symbol="Settings" FontSize="16" />
                </Button>
            </StackPanel>
            <!-- The top bar already names the page -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="{Binding VaultIcon}" Width="32" Height="32" VerticalAlignment="Center" />
                <Border CornerRadius="12" Padding="10,3" BorderThickness="1" Background="{DynamicResource HelmCardBackground}" BorderBrush="{DynamicResource HelmCardStroke}"
                        VerticalAlignment="Center" IsVisible="{Binding App.IsItems}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource HelmSuccess}" VerticalAlignment="Center" />
                        <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding App.LockCountdown, StringFormat='Unlocked · {0}', TargetNullValue=Unlocked}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <Border Classes="infobar warning" IsVisible="{Binding !Module.IsEnabled}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Settings" Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="Vault is turned off. Turn it on in its settings to use it." />
            </DockPanel>
        </Border>

        <StackPanel Spacing="4" IsVisible="{Binding Module.IsEnabled}">
            <!-- ===================== Setup ===================== -->
            <Border Classes="card" IsVisible="{Binding App.IsSetup}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Create your vault" Classes="title" FontSize="18" />
                    <TextBlock Classes="secondary" Text="Choose a vault password you will remember. It is different from your sync passphrase, and nobody can reset it. You also get a recovery key to keep safe." />
                    <TextBox PasswordChar="•" PlaceholderText="Vault password (at least 14 characters)" Text="{Binding App.NewPassword}" AutomationProperties.Name="Vault password" />
                    <TextBlock Classes="secondary" Text="{Binding App.PasswordStrength}" />
                    <TextBox PasswordChar="•" PlaceholderText="Type it again" Text="{Binding App.ConfirmPassword}" AutomationProperties.Name="Type it again" />
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Create vault" Command="{Binding App.CreateCommand}" />
                    <TextBlock Text="Have a backup?" Classes="title" Margin="0,12,0,0" />
                    <TextBlock Classes="secondary" Text="Restore the whole vault from a backup folder, with that vault's password or its recovery key." />
                    <CheckBox Content="Use the recovery key" IsChecked="{Binding App.UseRecoveryKey}" />
                    <TextBox PasswordChar="•" PlaceholderText="Vault password of the backup" Text="{Binding App.Password}" IsVisible="{Binding !App.UseRecoveryKey}" />
                    <TextBox Classes="mono" PlaceholderText="HELMV-XXXX-…" Text="{Binding App.RecoveryKey}" IsVisible="{Binding App.UseRecoveryKey}" />
                    <Button Content="Restore from a backup folder…" Command="{Binding App.RestoreFromBackupCommand}" />
                </StackPanel>
            </Border>

            <!-- ===================== Unlock: the fingerprint first, else the password (or the recovery key) ===================== -->
            <Border Classes="card" Padding="20,22" IsVisible="{Binding App.IsUnlock}">
                <StackPanel Spacing="8">
                    <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Left" Background="{DynamicResource HelmSubtleFill}">
                        <ic:SymbolIcon Symbol="LockClosed" FontSize="26" Foreground="{DynamicResource SystemAccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Vault is locked" Classes="title" FontSize="22" Margin="0,8,0,0" />
                    <TextBlock Classes="secondary" FontSize="13" Margin="0,0,0,8" Text="Your passwords and documents are encrypted on this device." />
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="48" IsVisible="{Binding App.CanUseDeviceUnlock}"
                            Command="{Binding App.QuickUnlockCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Fingerprint" FontSize="18" />
                            <TextBlock Text="{Binding App.DeviceUnlockName, StringFormat='Unlock with {0}'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,6" IsVisible="{Binding App.CanUseDeviceUnlock}">
                        <Border Height="1" Background="{DynamicResource HelmCardStroke}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="secondary" Margin="10,0" Text="or type the vault password" />
                        <Border Grid.Column="2" Height="1" Background="{DynamicResource HelmCardStroke}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="secondary" FontWeight="SemiBold" Text="Vault password" IsVisible="{Binding !App.UseRecoveryKey}" />
                    <TextBlock Classes="secondary" FontWeight="SemiBold" Text="Recovery key" IsVisible="{Binding App.UseRecoveryKey}" />
                    <TextBox PasswordChar="•" Text="{Binding App.Password}" IsVisible="{Binding !App.UseRecoveryKey}" AutomationProperties.Name="Vault password" />
                    <TextBox Classes="mono" PlaceholderText="HELMV-XXXX-…" Text="{Binding App.RecoveryKey}" IsVisible="{Binding App.UseRecoveryKey}" AutomationProperties.Name="Recovery key" />
                    <!-- What went wrong, right under the box -->
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding App.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ic:SymbolIcon Symbol="ErrorCircle" FontSize="16" Foreground="{DynamicResource HelmDanger}" VerticalAlignment="Top" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource HelmDanger}" Text="{Binding App.Error}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44" Content="Unlock" Command="{Binding App.UnlockCommand}"
                            Classes.accent="{Binding !App.CanUseDeviceUnlock}" />
                    <!-- The recovery key instead of the password (and back) -->
                    <Button Classes="flat" Margin="0,6,0,0" Padding="0,8" MinHeight="44" Command="{Binding App.ToggleRecoveryKeyCommand}"
                            AutomationProperties.Name="Use the recovery key instead of the password">
                        <Panel>
                            <TextBlock Text="Forgot it? Use the recovery key" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColor}" IsVisible="{Binding !App.UseRecoveryKey}" />
                            <TextBlock Text="Use the password" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColor}" IsVisible="{Binding App.UseRecoveryKey}" />
                        </Panel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ===================== After a recovery-key unlock ===================== -->
            <Border Classes="card" IsVisible="{Binding App.MustChangePassword}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Set a new vault password" Classes="title" FontSize="18" />
                    <TextBlock Classes="secondary" Text="You unlocked with the recovery key. Choose a new password; the recovery key keeps working." />
                    <TextBox PasswordChar="•" PlaceholderText="New password" Text="{Binding App.NewPassword}" />
                    <TextBlock Classes="secondary" Text="{Binding App.PasswordStrength}" />
                    <TextBox PasswordChar="•" PlaceholderText="Type it again" Text="{Binding App.ConfirmPassword}" />
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Set password" Command="{Binding App.SetNewPasswordCommand}" />
                </StackPanel>
            </Border>

            <!-- ===================== Emergency Kit ===================== -->
            <Border Classes="card" IsVisible="{Binding App.HasKit}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Save your Emergency Kit" Classes="title" FontSize="18" />
                    <TextBlock Classes="secondary" Text="This recovery key is the only way back in if you forget the vault password. It is shown only now. Save it, keep it offline, then type it below." />
                    <SelectableTextBlock Classes="mono" FontFamily="monospace" TextWrapping="Wrap" FontSize="15" Text="{Binding App.Kit.RecoveryKey}" />
                    <TextBlock Classes="secondary" Text="{Binding App.Kit.RecoveryId, StringFormat='Recovery key id: {0}'}" />
                    <Button Content="Save the Emergency Kit…" Command="{Binding App.SaveKitCommand}" />
                    <TextBox Classes="mono" PlaceholderText="Type the recovery key to confirm" Text="{Binding App.KitConfirmation}" />
                    <TextBlock Foreground="{DynamicResource HelmDanger}" TextWrapping="Wrap" Text="{Binding App.KitError}" IsVisible="{Binding App.KitError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="I saved it" Command="{Binding App.ConfirmKitCommand}" />
                </StackPanel>
            </Border>

            <!-- Errors of the vault itself (the lock screen shows its own under the password) -->
            <Border Classes="infobar warning">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="App.Error" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                        <Binding Path="!App.IsUnlock" />
                    </MultiBinding>
                </Border.IsVisible>
                <TextBlock TextWrapping="Wrap" Text="{Binding App.Error}" />
            </Border>

            <!-- ===================== The vault ===================== -->
            <StackPanel Spacing="4">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="App.IsItems" />
                        <Binding Path="!App.HasKit" />
                    </MultiBinding>
                </StackPanel.IsVisible>

                <Border Classes="infobar warning" IsVisible="{Binding App.HeldWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" Text="{Binding App.HeldWarning}" />
                        <Button Classes="accent" Content="Keep my items" Command="{Binding App.KeepHeldCommand}" />
                        <Button Content="Delete them here too" Command="{Binding App.ApplyHeldCommand}" />
                    </StackPanel>
                </Border>
                <Border Classes="infobar warning" IsVisible="{Binding App.BackupWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding App.BackupWarning}" />
                </Border>
                <Border Classes="infobar warning" IsVisible="{Binding App.WeakPasswordWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" Text="{Binding App.WeakPasswordWarning}" />
                        <Button Classes="accent" Content="Change the password…" Command="{Binding OpenSettingsCommand}" />
                    </StackPanel>
                </Border>

                <!-- The list: the sections as chips (swipe sideways), search and +, the rows. A tap opens an item in its place. -->
                <StackPanel Spacing="8">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="App.Items.Detail" Converter="{x:Static ObjectConverters.IsNull}" />
                            <Binding Path="App.Items.Editor" Converter="{x:Static ObjectConverters.IsNull}" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <Panel Margin="-16,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <!-- A soft right edge: more chips to swipe to (the last chip ends before it) -->
                            <ScrollViewer.OpacityMask>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Offset="0" Color="Black" />
                                    <GradientStop Offset="0.9" Color="Black" />
                                    <GradientStop Offset="1" Color="Transparent" />
                                </LinearGradientBrush>
                            </ScrollViewer.OpacityMask>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,2,40,2">
                                <ItemsControl ItemsSource="{Binding App.Items.Sections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VaultSection">
                                            <Button Classes="chip" Classes.on="{Binding IsSelected}" AutomationProperties.Name="{Binding Label}"
                                                    Command="{Binding $parent[UserControl].((local:VaultPageViewModel)DataContext).App.Items.ShowSectionCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ic:SymbolIcon Symbol="{Binding Kind, Converter={x:Static local:SectionIcon.Converter}}" FontSize="16" />
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding App.Items.TagSections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VaultSection">
                                            <Button Classes="chip" Classes.on="{Binding IsSelected}" AutomationProperties.Name="{Binding Label}"
                                                    Command="{Binding $parent[UserControl].((local:VaultPageViewModel)DataContext).App.Items.ShowSectionCommand}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ic:SymbolIcon Symbol="Tag" FontSize="16" />
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Classes="chip" Classes.on="{Binding App.Items.TrashSection.IsSelected}" AutomationProperties.Name="Trash"
                                        Command="{Binding App.Items.ShowSectionCommand}" CommandParameter="{Binding App.Items.TrashSection}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="Delete" FontSize="16" />
                                        <TextBlock Text="Trash" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Panel>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="accent" Margin="8,0,0,0" Width="48" MinHeight="44" Padding="0" HorizontalContentAlignment="Center"
                                AutomationProperties.Name="New item" Command="{Binding App.Items.NewCommand}" CommandParameter="{x:Static items:VaultItemKind.Login}">
                            <ic:SymbolIcon Symbol="Add" FontSize="18" />
                        </Button>
                        <TextBox PlaceholderText="Search" Text="{Binding App.Items.Search}" AutomationProperties.Name="Search" VerticalContentAlignment="Center" MinHeight="44" />
                    </DockPanel>

                    <StackPanel Spacing="8" Margin="4,12" IsVisible="{Binding App.Items.IsEmpty}">
                        <TextBlock Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding App.Items.EmptyText}" />
                        <Button HorizontalAlignment="Center" Content="Search all items" Command="{Binding App.Items.SearchEverywhereCommand}" IsVisible="{Binding App.Items.CanSearchEverywhere}" />
                    </StackPanel>

                    <Border Classes="card" Padding="4" IsVisible="{Binding !App.Items.IsEmpty}">
                        <ItemsControl ItemsSource="{Binding App.Items.Cards}" AutomationProperties.Name="Items">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:VaultCardViewModel">
                                    <Button Classes="flat itemrow" AutomationProperties.Name="{Binding Title}"
                                            Command="{Binding $parent[UserControl].((local:VaultPageViewModel)DataContext).App.Items.OpenCommand}" CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <!-- The icon: its picture; else a login's initial, or the kind's symbol -->
                                            <Panel Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Border CornerRadius="10" Background="{Binding AvatarColor, Converter={x:Static local:HexBrush.Converter}}">
                                                    <Border.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="!HasIcon" />
                                                            <Binding Path="IsLogin" />
                                                        </MultiBinding>
                                                    </Border.IsVisible>
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border CornerRadius="10" Background="{DynamicResource HelmSubtleFill}">
                                                    <Border.IsVisible>
                                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                            <Binding Path="!HasIcon" />
                                                            <Binding Path="!IsLogin" />
                                                        </MultiBinding>
                                                    </Border.IsVisible>
                                                    <ic:SymbolIcon Symbol="{Binding Kind, Converter={x:Static local:KindIcon.Converter}}" FontSize="20"
                                                                   Foreground="{DynamicResource SystemAccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border CornerRadius="10" ClipToBounds="True" IsVisible="{Binding HasIcon}">
                                                    <Image Source="{Binding Icon, Converter={x:Static local:IconBitmap.Converter}}" Stretch="UniformToFill" />
                                                </Border>
                                            </Panel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <ic:SymbolIcon Symbol="Warning" FontSize="14" IsVisible="{Binding HasConflict}" />
                                                </StackPanel>
                                                <TextBlock Classes="secondary" FontSize="13" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <!-- The current two-factor code and how long it lasts -->
                                                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasTotp}">
                                                    <TextBlock Text="{Binding TotpCode}" FontFamily="monospace" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource HelmSecondaryText}" />
                                                    <local:TotpRing Width="16" Height="16" Percent="{Binding TotpProgress}" VerticalAlignment="Center"
                                                                    Stroke="{DynamicResource SystemAccentColor}" Track="{DynamicResource HelmCardStroke}" />
                                                </StackPanel>
                                                <ic:SymbolIcon Symbol="Star" IconVariant="Filled" FontSize="15" Foreground="{DynamicResource SystemAccentColor}" IsVisible="{Binding Favorite}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Classes="secondary" Margin="4,4" TextWrapping="Wrap" IsVisible="{Binding App.Items.HasUnreadable}"
                               Text="{Binding App.Items.UnreadableCount, StringFormat='{}{0} records cannot be opened with this vault key; they are kept, not deleted.'}" />
                </StackPanel>

                <!-- An item, in place of the list (Back, or the arrow, returns) -->
                <StackPanel Spacing="4">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="App.Items.Detail" Converter="{x:Static ObjectConverters.IsNotNull}" />
                            <Binding Path="App.Items.Editor" Converter="{x:Static ObjectConverters.IsNull}" />
                        </MultiBinding>
                    </StackPanel.IsVisible>
                    <Button Classes="flat" HorizontalAlignment="Left" Padding="8,6" MinHeight="44" Command="{Binding App.Items.CloseDetailCommand}" AutomationProperties.Name="Back to the list">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="ArrowLeft" FontSize="18" />
                            <TextBlock Text="Back" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ContentControl Content="{Binding App.Items.Detail}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:ItemDetailViewModel">
                                <local:ItemDetailView />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>

                <!-- New or Edit: the editor takes the page (Back or Cancel closes it, asking first if something was typed) -->
                <ContentControl Content="{Binding App.Items.Editor}" IsVisible="{Binding App.Items.Editor, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:ItemDetailViewModel">
                            <local:ItemDetailView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
