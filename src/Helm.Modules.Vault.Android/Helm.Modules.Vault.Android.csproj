<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vault on Android: the Avalonia page over the shared Helm.Modules.Vault.Core, plus fingerprint/face unlock
       (Android Keystore + BiometricPrompt), FLAG_SECURE, Storage Access Framework backups and the protected clipboard. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Modules.Vault</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- The Android SDK's implicit usings clash with Avalonia/BCL names (Application, OperationCanceledException). -->
  <ItemGroup>
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
    <Using Remove="Android.OS.Bundle" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.343" />
    <PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.33" />
    <PackageReference Include="Xamarin.AndroidX.DocumentFile" Version="1.1.0.3" />
    <!-- Same pin as Helm.App.Android: Microsoft.Data.Sqlite 8 pulls SQLitePCLRaw 2.1.6 (advisory, no 16 KB pages). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core.Android\Helm.Core.Android.csproj" />
    <ProjectReference Include="..\Helm.Modules.Vault.Core\Helm.Modules.Vault.Core.csproj" />
  </ItemGroup>

</Project>
