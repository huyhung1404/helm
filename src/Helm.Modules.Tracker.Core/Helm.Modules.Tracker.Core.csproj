<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tracker logic shared by the Windows and Android apps: data model, store (on Helm Sync), reports, CSV and the
       page view model. No WPF, Avalonia or platform APIs here. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Modules.Tracker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core\Helm.Core.csproj" />
    <!-- IDialogService / IClipboardService: the portable seams both apps already implement. -->
    <ProjectReference Include="..\Helm.Shell\Helm.Shell.csproj" />
    <!-- The debt book moved to Wallet: Tracker hands its old one over and shows debts on its calendar. -->
    <ProjectReference Include="..\Helm.Modules.Wallet.Core\Helm.Modules.Wallet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>
