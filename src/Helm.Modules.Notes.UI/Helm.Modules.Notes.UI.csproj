<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Notes page, ONE view for every platform (Windows through Helm.Ui.Windows, Android, later macOS/iOS). What
       differs per platform (the folder picker for the Markdown export, the phone's menu button) comes through INotesPageHost. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Modules.Notes.Ui</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Ui\Helm.Ui.csproj" />
    <ProjectReference Include="..\Helm.Modules.Notes.Core\Helm.Modules.Notes.Core.csproj" />
  </ItemGroup>

</Project>
