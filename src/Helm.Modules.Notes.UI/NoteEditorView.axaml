<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Notes"
             xmlns:core="using:Helm.Core.Ui"
             x:Class="Helm.Modules.Notes.Ui.NoteEditorView"
             x:DataType="vm:NotesViewModel">

    <!-- One note: the toolbar, the title, its links and the text; "Make tasks" beside it (wide) or under the toolbar (phone).
         It saves as you type. -->
    <UserControl.Styles>
        <Style Selector="TextBox.body.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        </Style>
        <Style Selector="Button.chip.on ic|SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource HelmEyebrow}" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Layout" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,*">
        <!-- Toolbar: back (phone) or close (wide), what the note is, and its actions -->
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="20,16,16,8">
            <Button x:Name="BackButton" Classes="chip" Command="{Binding CloseEditorCommand}" IsVisible="False"
                    ToolTip.Tip="Back to the notes" AutomationProperties.Name="Back to the notes">
                <ic:SymbolIcon Symbol="ArrowLeft" FontSize="16" />
            </Button>
            <TextBlock Grid.Column="1" Classes="eyebrow" Text="{Binding EditorInfo, Converter={x:Static core:UpperCase.Instance}}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Classes="chip" Classes.on="{Binding EditPinned}" Command="{Binding TogglePinCommand}" IsVisible="{Binding CanEditPin}"
                        ToolTip.Tip="Pin to the top" AutomationProperties.Name="Pin">
                    <ic:SymbolIcon Symbol="Pin" FontSize="16" />
                </Button>
                <Button Classes="chip" Command="{Binding MakeTasksCommand}" IsVisible="{Binding CanMakeTasks}"
                        ToolTip.Tip="AI reads the note and proposes its tasks for the to-do lists" AutomationProperties.Name="Make tasks">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="Sparkle" FontSize="16" Foreground="{DynamicResource HelmEyebrow}" />
                        <TextBlock x:Name="MakeTasksLabel" Text="Make tasks" />
                    </StackPanel>
                </Button>
                <Button Classes="chip" Command="{Binding EditorLinks.StartPickingCommand}"
                        IsVisible="{Binding EditorLinks, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="Link to a task, a person in the debt book or a mission" AutomationProperties.Name="Link to a task, person or mission">
                    <ic:SymbolIcon Symbol="Link" FontSize="16" />
                </Button>
                <Button Classes="chip" Command="{Binding CopyNoteCommand}" ToolTip.Tip="Copy the note" AutomationProperties.Name="Copy the note">
                    <ic:SymbolIcon Symbol="Copy" FontSize="16" />
                </Button>
                <Button Classes="chip" Command="{Binding TrashCommand}" IsVisible="{Binding !EditTrashed}"
                        ToolTip.Tip="Move to the trash" AutomationProperties.Name="Move to the trash">
                    <ic:SymbolIcon Symbol="Delete" FontSize="16" />
                </Button>
                <Button x:Name="CloseButton" Classes="chip" Command="{Binding CloseEditorCommand}" ToolTip.Tip="Close (Esc)" AutomationProperties.Name="Close the note">
                    <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- A note in the trash: bring it back or delete it for good -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8" Margin="20,4,20,8" IsVisible="{Binding EditTrashed}">
            <Button Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Restore" Command="{Binding RestoreCommand}" />
            <Button Grid.Column="1" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding DeleteForeverCommand}"
                    AutomationProperties.Name="Delete for good">
                <TextBlock Text="Delete for good" Foreground="{DynamicResource HelmDanger}" />
            </Button>
        </Grid>

        <!-- The note itself: the card is the field -->
        <ScrollViewer x:Name="NoteScroller" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" core:ScrollFade.Enabled="True" Padding="0,0,6,0">
            <StackPanel Margin="20,0,14,20" Spacing="4">
                <TextBox x:Name="TitleBox" Classes="bare" PlaceholderText="Title" FontSize="24" FontWeight="SemiBold" MaxLength="500" TextWrapping="Wrap"
                         Text="{Binding EditTitle}" IsReadOnly="{Binding EditTrashed}" AutomationProperties.Name="Title" />
                <!-- What the note is linked to: tap a task, person or mission to open it -->
                <core:LinksPanel DataContext="{Binding EditorLinks}" Margin="0,0,0,6" />
                <TextBox x:Name="BodyBox" Classes="bare body" Classes.mono="{Binding Monospace}" PlaceholderText="Write something…"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" MinHeight="320" VerticalContentAlignment="Top"
                         FontSize="{Binding EditorFontSize}"
                         Text="{Binding EditBody}" IsReadOnly="{Binding EditTrashed}" AutomationProperties.Name="Note text" />
            </StackPanel>
        </ScrollViewer>

        <!-- "Make tasks": the note's tasks as AI found them, into one list; the lines they came from get a "→ Tracker" tag -->
        <Border x:Name="TasksPane" Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Width="340" Margin="0,0,16,16" Classes="glass" BoxShadow=""
                IsVisible="{Binding Tasks.IsOpen, FallbackValue=False}" core:Motion.EnterOnShow="True">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel DataContext="{Binding Tasks}" x:DataType="vm:NoteTasksViewModel" Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <ic:SymbolIcon Symbol="Sparkle" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource HelmEyebrow}" />
                        <TextBlock Grid.Column="1" Text="Tasks from this note" Classes="head" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="chip" Command="{Binding CloseCommand}" ToolTip.Tip="Close" AutomationProperties.Name="Close the tasks panel">
                            <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
                        </Button>
                    </Grid>

                    <!-- Asking: placeholder lines, and where it runs -->
                    <StackPanel IsVisible="{Binding IsBusy}">
                        <Border Classes="shimmer" Width="240" />
                        <Border Classes="shimmer" Width="180" />
                        <Border Classes="shimmer" Width="210" />
                        <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- The tasks to pick from, all into one list -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsProposing}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="eyebrow" Text="ADD TO" />
                            <ComboBox Classes="glass" HorizontalAlignment="Stretch" ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}"
                                      AutomationProperties.Name="Add to list" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Choices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:NoteTaskChoice">
                                    <CheckBox IsChecked="{Binding Keep}" AutomationProperties.Name="{Binding Title}" Margin="0,2">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                            <Border Classes="tag" HorizontalAlignment="Left" Margin="0,3,0,0" IsVisible="{Binding HasDue}">
                                                <TextBlock Text="{Binding DueText}" />
                                            </Border>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SkippedText}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasSkipped}" />
                        <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <Grid ColumnDefinitions="*,2*" ColumnSpacing="8">
                            <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Cancel" Command="{Binding CloseCommand}" />
                            <Button Grid.Column="1" Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Content="{Binding AddText}" Command="{Binding AddCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- A problem, or no task in the note -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsStuck}">
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Cancel" Command="{Binding CloseCommand}" />
                            <Button Grid.Column="1" Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Try again" Command="{Binding RetryCommand}" />
                        </Grid>
                    </StackPanel>

                    <!-- Added: Undo takes the tasks and the note's tags back -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsDone}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource HelmSuccess}" />
                            <TextBlock Grid.Column="1" Text="{Binding DoneText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Undo" Command="{Binding UndoCommand}" />
                            <Button Grid.Column="1" Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Done" Command="{Binding CloseCommand}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
