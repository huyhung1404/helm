<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:core="using:Helm.Core.Ui"
             xmlns:vm="using:Helm.Shell.Diagnostics"
             x:Class="Helm.Shell.Pages.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

    <!-- Diagnostics: Helm as it sees this computer, for a bug report. This Helm (version, folders) with copy and open
         buttons, the input hooks test, the shortcuts taken, the monitors, then every app window. "Copy all" puts the whole
         page on the clipboard as text. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <!-- A row in a list card: a thin line above each -->
        <Style Selector="Border.line">
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,10" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <core:Backdrop />
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" core:ScrollFade.Enabled="True">
            <StackPanel x:Name="Page" Margin="40,28,40,40">

                <!-- The eyebrow; Copy all and Refresh on the right -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="TopLine" Classes="eyebrow" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                    <Button x:Name="CopyAllButton" Grid.Column="1" Classes="ghost" Command="{Binding CopyAllCommand}"
                            ToolTip.Tip="Copy the whole page as text, for a bug report" AutomationProperties.Name="Copy all">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Copy" FontSize="15" />
                            <TextBlock Classes="label" Text="Copy all" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="chip" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" AutomationProperties.Name="Refresh">
                        <ic:SymbolIcon Symbol="ArrowClockwise" FontSize="16" />
                    </Button>
                </Grid>

                <TextBlock Classes="display" Text="Diagnostics" Margin="0,22,0,0" />
                <TextBlock Classes="muted" FontSize="14" Margin="0,4,0,0" Text="{Binding Summary}" TextWrapping="Wrap" />
                <TextBlock x:Name="CopiedText" Margin="0,6,0,0" Foreground="{DynamicResource HelmEyebrow}" Text="{Binding Copied}"
                           IsVisible="{Binding Copied, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" core:Motion.EnterOnShow="True" />

                <core:MasonryPanel x:Name="Cards" MinColumnWidth="430" Spacing="14" Margin="0,22,0,0">

                    <!-- This Helm -->
                    <Border Classes="glass">
                        <StackPanel Spacing="4">
                            <TextBlock Text="This Helm" Classes="head" Margin="0,0,0,6" />
                            <ItemsControl x:Name="FactList" ItemsSource="{Binding Facts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:DiagnosticsFact">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,10">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Classes="secondary" Text="{Binding Name}" />
                                                <SelectableTextBlock Classes="mono" Text="{Binding Value}" TextTrimming="PathSegmentEllipsis" ToolTip.Tip="{Binding Value}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="chip" MinHeight="36" Height="36" VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].((vm:DiagnosticsViewModel)DataContext).CopyCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="Copy" AutomationProperties.Name="{Binding Name, StringFormat='Copy {0}'}">
                                                <ic:SymbolIcon Symbol="Copy" FontSize="14" />
                                            </Button>
                                            <Button Grid.Column="2" Classes="chip" MinHeight="36" Height="36" VerticalAlignment="Center" IsVisible="{Binding IsFolder}"
                                                    Command="{Binding $parent[UserControl].((vm:DiagnosticsViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}"
                                                    ToolTip.Tip="Open the folder" AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}">
                                                <ic:SymbolIcon Symbol="FolderOpen" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Input hooks -->
                    <Border Classes="glass">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Test the keyboard and mouse hooks" Classes="head" TextWrapping="Wrap" />
                                    <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding HookStatus}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="HookSwitch" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsHookTestEnabled}" OnContent="" OffContent=""
                                              AutomationProperties.Name="Test the keyboard and mouse hooks" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                <TextBlock Classes="secondary" Text="Last key" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding LastKey}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Classes="secondary" Text="Last mouse" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding LastMouse}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Shortcuts taken -->
                    <Border Classes="glass">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Shortcut conflicts" Classes="head" />
                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="None: every shortcut works." IsVisible="{Binding !HasConflicts}" />
                            <ItemsControl ItemsSource="{Binding Conflicts}" IsVisible="{Binding HasConflicts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,8">
                                            <ic:SymbolIcon Symbol="Warning" FontSize="16" VerticalAlignment="Top" Margin="0,1,0,0" Foreground="{DynamicResource HelmDanger}" />
                                            <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Monitors -->
                    <Border Classes="glass">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Monitors" Classes="head" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Monitors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:DiagnosticsMonitor">
                                        <Border Classes="line">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding Bounds, StringFormat='Bounds {0}'}" />
                                                <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding WorkArea, StringFormat='Work area {0}'}" />
                                                <TextBlock Classes="secondary" Text="{Binding Scale}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </core:MasonryPanel>

                <!-- Every app window, the full width -->
                <Border Classes="glass" Margin="0,14,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="App windows" Classes="head" Margin="0,0,0,6" />
                        <ItemsControl x:Name="WindowList" ItemsSource="{Binding Windows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:DiagnosticsWindow">
                                    <Border Classes="line">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                                <TextBlock Classes="mono" Text="{Binding Handle}" Foreground="{DynamicResource HelmEyebrow}" />
                                                <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Process}" />
                                                <TextBlock Grid.Column="2" Classes="mono" TextWrapping="Wrap" Foreground="{DynamicResource HelmSecondaryText}">
                                                    <Run Text="{Binding Bounds}" /><Run Text="  " /><Run Text="{Binding Flags}" />
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
