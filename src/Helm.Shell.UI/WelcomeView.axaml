<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:core="using:Helm.Core.Ui"
             x:Class="Helm.Shell.Pages.WelcomeView">

    <!-- Welcome to Helm, the first run: one wide card with the three steps (only the first one to do now) and one button
         that takes you there. -->
    <Panel>
        <core:Backdrop />
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Page" Margin="40,28,40,40">
                <TextBlock Classes="eyebrow" Text="WELCOME" />
                <TextBlock Classes="display" Text="Welcome to Helm" Margin="0,22,0,0" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Your own toolkit: notes, tasks, money, habits and the tools that tidy your windows, in one place and on every device you sync." />

                <Border Classes="glass hero enter" Margin="0,28,0,0" Padding="28,26">
                    <StackPanel Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="eyebrow" Text="START HERE" />
                            <TextBlock Text="Three things to know" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <UniformGrid x:Name="Steps" Columns="3">
                            <Border x:Name="StepOne" Classes="glass" Margin="0,0,10,10" BorderBrush="{DynamicResource HelmGlassStrokeStrong}">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="eyebrow" Text="1" />
                                    <TextBlock Text="Pick the tools you want" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="Turn tools on or off in Home → Utilities, or on each tool's own page." />
                                </StackPanel>
                            </Border>
                            <Border Classes="glass" Margin="0,0,10,10" Opacity="0.55">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="eyebrow" Text="2" />
                                    <TextBlock Text="Open them from the menu" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="Each tool opens in its own tab; the ones you use most go in Quick access." />
                                </StackPanel>
                            </Border>
                            <Border Classes="glass" Margin="0,0,10,10" Opacity="0.55">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="eyebrow" Text="3" />
                                    <TextBlock Text="Helm stays in the tray" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" TextWrapping="Wrap" Text="Closing the window keeps your shortcuts working. Quit from the tray menu." />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <Button x:Name="StartButton" Classes="pill" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                AutomationProperties.Name="Pick my tools">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="Pick my tools" Foreground="{DynamicResource HelmPillForeground}" />
                                <ic:SymbolIcon Symbol="ArrowRight" FontSize="16" Foreground="{DynamicResource HelmPillForeground}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
