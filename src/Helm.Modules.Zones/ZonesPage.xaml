<core:ModulePageBase
    x:Class="Helm.Modules.Zones.ZonesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core"
    Module="{Binding Module}">

    <StackPanel>
        <!-- Editor -->
        <TextBlock Text="Editor" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon SlideLayout24}" Command="{Binding OpenEditorCommand}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Open layout editor" Description="Draw your own zones — for one monitor, or across several monitors — and choose the layout for each monitor." />
            </ui:CardControl.Header>
            <ui:SymbolIcon Symbol="Open24" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Keyboard24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Editor shortcut" Description="Opens (or closes) the layout editor on all monitors." />
            </ui:CardControl.Header>
            <core:HotkeyPicker Gesture="{Binding EditorHotkey}" DefaultGesture="{Binding DefaultEditorHotkey}" />
        </ui:CardControl>

        <!-- Layout switching -->
        <TextBlock Text="Layouts" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardExpander Margin="0,0,0,4" IsExpanded="True" Icon="{ui:SymbolIcon NumberSymbolSquare24}">
            <ui:CardExpander.Header>
                <core:RowLayout Margin="0,0,16,0">
                    <core:CardHeader Title="Switch layouts with Ctrl+Win+Alt+number" Description="Give a layout a number (1–9) in the editor; the shortcut applies it to the monitor under the mouse." />
                    <ui:ToggleSwitch IsChecked="{Binding LayoutHotkeys}" />
                </core:RowLayout>
            </ui:CardExpander.Header>
            <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0" IsEnabled="{Binding LayoutHotkeys}">
                <core:RowLayout>
                    <core:CardHeader Title="Show the layout after switching" Description="Briefly shows the new zones and the layout name." />
                    <ui:ToggleSwitch IsChecked="{Binding FlashLayoutOnSwitch}" />
                </core:RowLayout>
            </Border>
        </ui:CardExpander>

        <!-- Activation -->
        <TextBlock Text="Activation" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardExpander Margin="0,0,0,4" IsExpanded="True" Icon="{ui:SymbolIcon CursorClick24}">
            <ui:CardExpander.Header>
                <core:CardHeader Title="Zone behavior" Description="Manage how zones appear while dragging a window." />
            </ui:CardExpander.Header>
            <StackPanel>
                <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                    <core:RowLayout>
                        <core:CardHeader Title="Activation key" Description="Hold this key while dragging to show zones." />
                        <ComboBox HorizontalAlignment="Right" MinWidth="140" ItemsSource="{Binding ActivationKeys}" SelectedItem="{Binding ActivationKey}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Always show zones while dragging" Description="Zones appear on every drag; holding the activation key hides them instead." />
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding AlwaysShowZones}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <StackPanel>
                            <TextBlock Text="Select multiple zones by dragging across them" />
                            <TextBlock Style="{DynamicResource HelmSecondaryText}">
                                <Run Text="Hold" /> <Run Text="{Binding SpanKeyText, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="while dragging to span the window over every zone between the first and the current one." />
                            </TextBlock>
                        </StackPanel>
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding MultiZoneSpanning}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Highlight distance (px)" Description="How close the cursor must be to a zone for it to light up when it is between zones." />
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="160" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding HighlightDistance}" VerticalAlignment="Center" />
                            <TextBlock Width="36" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding HighlightDistance, StringFormat={}{0:0}}" />
                        </StackPanel>
                    </core:RowLayout>
                </Border>
            </StackPanel>
        </ui:CardExpander>

        <!-- Windows behavior -->
        <TextBlock Text="Window behavior" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon WindowMultiple20}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Switch between windows in a zone with Win+PgUp / Win+PgDn" Description="When several windows share the focused window's zone, activates the previous / next one." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding CycleWindowsInZone}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowSwap24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Override Windows Snap" Description="Win+Left/Right move the focused window to the previous/next zone (Win+Up/Down too when zones are stacked)." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding OverrideWindowsSnap}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ArrowMaximize24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Restore the original size of windows when unsnapping" Description="Dragging a snapped window out of its zone gives it back its previous size." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding RestoreSizeOnUnsnap}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon WindowNew24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Move newly created windows to their last known zone" Description="Remembered per app (and window title) whenever a window is snapped." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding MoveNewWindowsToLastZone}" />
        </ui:CardControl>

        <!-- Appearance -->
        <TextBlock Text="Appearance" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Color24}">
            <ui:CardExpander.Header>
                <core:CardHeader Title="Zone appearance" Description="Colors and opacity of the overlay shown while dragging." />
            </ui:CardExpander.Header>
            <StackPanel>
                <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                    <core:RowLayout>
                        <core:CardHeader Title="Show zone numbers" />
                        <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding ShowZoneNumbers}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Zone opacity (%)" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Slider Width="180" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding ZoneOpacity}" VerticalAlignment="Center" />
                            <TextBlock Width="36" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding ZoneOpacity, StringFormat={}{0:0}}" />
                        </StackPanel>
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Highlight color" />
                        <core:ColorSwatchPicker HorizontalAlignment="Right" Color="{Binding HighlightColor}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Inactive zone color" />
                        <core:ColorSwatchPicker HorizontalAlignment="Right" Color="{Binding ZoneColor}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Border and number color" />
                        <core:ColorSwatchPicker HorizontalAlignment="Right" Color="{Binding BorderColor}" />
                    </core:RowLayout>
                </Border>
            </StackPanel>
        </ui:CardExpander>

        <!-- Excluded apps -->
        <TextBlock Text="Excluded apps" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon AppsList24}">
            <ui:CardExpander.Header>
                <core:CardHeader Title="Excluded apps" Description="Zones ignores these processes, one per line (e.g. Unity.exe, games)." />
            </ui:CardExpander.Header>
            <ui:TextBox Text="{Binding ExcludedApps, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                        MinHeight="100" MaxHeight="240" VerticalScrollBarVisibility="Auto" PlaceholderText="Example: Unity.exe" />
        </ui:CardExpander>
    </StackPanel>
</core:ModulePageBase>
