<Window
    x:Class="Helm.Modules.Zones.Editor.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:editor="clr-namespace:Helm.Modules.Zones.Editor"
    Title="Helm Zones editor"
    AllowsTransparency="True"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    Background="#B0101010"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    WindowStartupLocation="Manual"
    Left="0" Top="0" Width="800" Height="600">

    <Window.Resources>
        <DataTemplate x:Key="LayoutCard" DataType="{x:Type editor:LayoutCardViewModel}">
            <Button Width="196" Margin="4" Padding="8" Cursor="Hand" HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.Session.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="2" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <Grid Height="84">
                        <editor:LayoutPreview Zones="{Binding Zones}" AspectRatio="{Binding AspectRatio}" Gap="2" HorizontalAlignment="Center" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" Padding="6,1" Margin="2"
                                Background="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding HasNumber, Converter={StaticResource BoolToVisibility}}" ToolTip="Ctrl+Win+Alt+number">
                            <TextBlock Text="{Binding NumberText}" FontWeight="SemiBold" Foreground="White" FontSize="12" />
                        </Border>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:SymbolIcon Symbol="CheckmarkCircle20" Filled="True" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Visibility="{Binding IsApplied, Converter={StaticResource BoolToVisibility}}" ToolTip="Active on this monitor" />
                    </Grid>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentPresenter x:Name="CanvasHost" />

        <!-- Other monitors: a small caption so it is clear the editor is open there too -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24" CornerRadius="8" Padding="12,6"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                Visibility="{Binding IsHome, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="{Binding MonitorCaption}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>

        <!-- Layout picker (home monitor) -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700" Margin="24"
                CornerRadius="10" Padding="20" BorderThickness="1"
                Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                Visibility="{Binding ShowPicker, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <StackPanel Margin="0,0,44,0">
                        <TextBlock Text="{Binding Session.Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Choose the layout for this monitor, or draw a new one. Ctrl+Win+Alt+number switches layouts at any time. Esc closes."
                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Transparent" Padding="8"
                               Command="{Binding Session.CloseCommand}" ToolTip="Close (Esc)">
                        <ui:SymbolIcon Symbol="Dismiss24" />
                    </ui:Button>
                </Grid>

                <ScrollViewer x:Name="PickerScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <ui:Button Content="New layout for this monitor" Icon="{ui:SymbolIcon Add24}" Command="{Binding Session.NewForMonitorCommand}" Margin="4" />
                            <ui:Button Content="New layout across monitors" Icon="{ui:SymbolIcon DesktopFlow24}" Command="{Binding Session.NewAcrossMonitorsCommand}" Margin="4"
                                       Visibility="{Binding Session.IsMultiMonitor, Converter={StaticResource BoolToVisibility}}" />
                        </WrapPanel>
                        <ItemsControl ItemsSource="{Binding Session.Layouts}" ItemTemplate="{StaticResource LayoutCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <WrapPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Right">
                    <ui:Button Content="Edit" Icon="{ui:SymbolIcon Edit24}" Command="{Binding Session.EditSelectedCommand}" Margin="4" IsEnabled="{Binding Session.HasSelection}" />
                    <ui:Button Content="Duplicate" Icon="{ui:SymbolIcon Copy24}" Command="{Binding Session.DuplicateCommand}" Margin="4" IsEnabled="{Binding Session.HasSelection}" />
                    <ui:Button Content="Delete" Icon="{ui:SymbolIcon Delete24}" Command="{Binding Session.DeleteCommand}" Margin="4" IsEnabled="{Binding Session.HasSelection}" />
                    <ui:Button Content="Apply" Command="{Binding Session.ApplyCommand}" Margin="4" IsEnabled="{Binding Session.HasSelection}" />
                    <ui:Button Content="Apply &amp; close" Appearance="Primary" Command="{Binding Session.ApplyAndCloseCommand}" Margin="4" IsEnabled="{Binding Session.HasSelection}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Edit toolbar (home monitor) -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24" MaxWidth="820" CornerRadius="10" Padding="14,10" BorderThickness="1"
                Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                Visibility="{Binding ShowToolbar, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <WrapPanel>
                    <ui:TextBox Text="{Binding Session.EditName, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="4" PlaceholderText="Layout name" />
                    <ComboBox Width="190" Margin="4" ItemsSource="{Binding Session.NumberOptions}" SelectedIndex="{Binding Session.EditNumberIndex}" ToolTip="Shortcut to switch to this layout" />
                    <ui:Button Content="Split ↔" Icon="{ui:SymbolIcon SplitVertical24}" Command="{Binding Session.SplitVerticalCommand}" Margin="4"
                               IsEnabled="{Binding Session.CanEditZone}" ToolTip="Split the selected zone into left and right halves" />
                    <ui:Button Content="Split ↕" Icon="{ui:SymbolIcon SplitHorizontal24}" Command="{Binding Session.SplitHorizontalCommand}" Margin="4"
                               IsEnabled="{Binding Session.CanEditZone}" ToolTip="Split the selected zone into top and bottom halves" />
                    <ui:Button Content="Delete zone" Icon="{ui:SymbolIcon Delete24}" Command="{Binding Session.DeleteZoneCommand}" Margin="4" IsEnabled="{Binding Session.CanEditZone}" />
                    <ui:Button Content="Reset" Icon="{ui:SymbolIcon ArrowReset24}" Command="{Binding Session.ResetZonesCommand}" Margin="4" ToolTip="One zone per monitor" />
                    <ui:Button Content="Save" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Command="{Binding Session.SaveEditCommand}" Margin="4" />
                    <ui:Button Content="Cancel" Command="{Binding Session.CancelEditCommand}" Margin="4" />
                </WrapPanel>
                <TextBlock Text="{Binding Session.EditHint}" FontSize="12" Margin="4,6,4,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
