<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:core="using:Helm.Core.Ui"
             xmlns:vm="using:Helm.Home"
             x:Class="Helm.Home.HomeView"
             x:DataType="vm:HomeViewModel">

    <!-- Home, top to bottom: how things stand (the update, shortcut conflicts, what's new) → your tools, one tap each →
         their shortcuts → the switches that turn tools on and off, folded away. -->
    <UserControl.Styles>
        <Style Selector="Border.keycap">
            <Setter Property="Background" Value="{DynamicResource HelmGlassHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelmGlassStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinWidth" Value="28" />
        </Style>
        <Style Selector="Border.keycap > TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="MinHeight" Value="72" />
        </Style>
        <Style Selector="ic|SymbolIcon.state">
            <Setter Property="FontSize" Value="26" />
        </Style>
        <!-- The update check is running -->
        <Style Selector="ic|SymbolIcon.spin">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Panel>
        <core:Backdrop />
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Page" Margin="40,28,40,40">

                <!-- Today, and the greeting -->
                <TextBlock Classes="eyebrow" Text="{Binding DateLine, Converter={x:Static core:UpperCase.Instance}}" />
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Classes="display" Text="{Binding Greeting}" />
                    <TextBlock Classes="muted" FontSize="14" Margin="0,4,0,0" Text="{Binding Summary}" />
                </StackPanel>

                <!-- How things stand: tap one to deal with it -->
                <UniformGrid x:Name="States" Columns="3" Margin="0,22,0,0">
                    <Button Classes="glass lift tool" Command="{Binding UpdateCommand}" AutomationProperties.Name="Updates">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Panel VerticalAlignment="Center">
                                <ic:SymbolIcon Classes="state" Symbol="CheckmarkCircle" IconVariant="Filled" Foreground="{DynamicResource HelmSuccess}">
                                    <ic:SymbolIcon.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="!IsCheckingForUpdates" />
                                            <Binding Path="IsToneOk" />
                                        </MultiBinding>
                                    </ic:SymbolIcon.IsVisible>
                                </ic:SymbolIcon>
                                <ic:SymbolIcon Classes="state" Symbol="ArrowCircleDown" IconVariant="Filled" Foreground="{DynamicResource HelmEyebrow}">
                                    <ic:SymbolIcon.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="!IsCheckingForUpdates" />
                                            <Binding Path="IsToneAttention" />
                                        </MultiBinding>
                                    </ic:SymbolIcon.IsVisible>
                                </ic:SymbolIcon>
                                <ic:SymbolIcon Classes="state" Symbol="Info" Foreground="{DynamicResource HelmSecondaryText}">
                                    <ic:SymbolIcon.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding Path="!IsCheckingForUpdates" />
                                            <Binding Path="IsToneMuted" />
                                        </MultiBinding>
                                    </ic:SymbolIcon.IsVisible>
                                </ic:SymbolIcon>
                                <ic:SymbolIcon Classes="state spin" Symbol="ArrowSync" Foreground="{DynamicResource HelmEyebrow}" RenderTransformOrigin="50%,50%"
                                               IsVisible="{Binding IsCheckingForUpdates}">
                                    <ic:SymbolIcon.RenderTransform><RotateTransform /></ic:SymbolIcon.RenderTransform>
                                </ic:SymbolIcon>
                            </Panel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="muted" Text="{Binding UpdateSubtitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="ConflictsTile" Classes="glass lift tool" Command="{Binding OpenConflictsCommand}" IsVisible="{Binding ShowsShortcuts}" AutomationProperties.Name="Shortcut conflicts">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Panel VerticalAlignment="Center">
                                <ic:SymbolIcon Classes="state" Symbol="CheckmarkCircle" IconVariant="Filled" Foreground="{DynamicResource HelmSuccess}" IsVisible="{Binding !HasConflicts}" />
                                <ic:SymbolIcon Classes="state" Symbol="Warning" IconVariant="Filled" Foreground="{DynamicResource HelmDanger}" IsVisible="{Binding HasConflicts}" />
                            </Panel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Shortcut conflicts" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="muted" Text="{Binding ConflictSummary}" Classes.late="{Binding HasConflicts}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Classes="glass lift tool" Command="{Binding OpenWhatsNewCommand}" AutomationProperties.Name="What's new">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <ic:SymbolIcon Classes="state" Symbol="Megaphone" Foreground="{DynamicResource HelmEyebrow}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="What's new" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="muted" Text="{Binding Version}" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </UniformGrid>

                <!-- Your tools: the ones that are on, one tap each -->
                <TextBlock Classes="eyebrow" Text="YOUR TOOLS" Margin="0,18,0,10" />
                <Border Classes="glass" Padding="24,22" IsVisible="{Binding !HasQuickAccess}" Margin="0,0,10,10">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <ic:SymbolIcon Symbol="ArrowDown" FontSize="18" Foreground="{DynamicResource HelmEyebrow}" HorizontalAlignment="Center" />
                        <TextBlock Classes="muted" FontSize="14" TextAlignment="Center" Text="No tool is on yet. Turn one on below." />
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="ToolList" ItemsSource="{Binding QuickAccess}" AutomationProperties.Name="Your tools">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HomeTool">
                            <Button Classes="glass lift fade tool" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).LaunchCommand}" CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <core:ModuleIcon Symbol="{Binding Icon}" Image="{Binding Image}" Size="30" Foreground="{DynamicResource HelmEyebrow}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="muted" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Their shortcuts (a desktop) -->
                <StackPanel IsVisible="{Binding HasShortcuts}" Margin="0,8,0,0">
                    <TextBlock Classes="eyebrow" Text="SHORTCUTS" Margin="0,10,0,10" />
                    <Border Classes="glass" Padding="16,8">
                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeShortcut">
                                    <Grid ColumnDefinitions="32,*,Auto" Margin="0,6">
                                        <core:ModuleIcon Symbol="{Binding Tool.Icon}" Image="{Binding Tool.Image}" Size="18" Foreground="{DynamicResource HelmEyebrow}" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Keys}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <Border Classes="keycap"><TextBlock Text="{Binding}" /></Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Turn tools on or off: folded away, it is not what Home is for every day -->
                <ToggleButton x:Name="ManageToggle" Classes="fold" HorizontalAlignment="Left" Margin="0,14,0,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Panel Width="12" Height="12" Classes="turn" core:Motion.Turn="{Binding #ManageToggle.IsChecked}"><ic:SymbolIcon Symbol="ChevronRight" FontSize="12" Foreground="{DynamicResource HelmSecondaryText}" /></Panel>
                        <TextBlock Text="Turn tools on or off" Classes="muted" FontSize="13" />
                    </StackPanel>
                </ToggleButton>
                <StackPanel IsVisible="{Binding #ManageToggle.IsChecked}" core:Motion.EnterOnShow="True" core:Motion.FromTop="True">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,10">
                        <TextBlock Classes="muted" VerticalAlignment="Center" Text="A tool that is off is hidden above and does nothing in the background." TextWrapping="Wrap" Margin="0,0,12,0" />
                        <Button Grid.Column="1" Classes="chip" Command="{Binding ToggleSortCommand}" ToolTip.Tip="Change the order" AutomationProperties.Name="Sort tools">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="ArrowSort" FontSize="14" />
                                <TextBlock Text="{Binding SortLabel}" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Tools}" AutomationProperties.Name="All tools">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeTool">
                                <Border Classes="glass" Padding="14,8,8,8" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                        <core:ModuleIcon Symbol="{Binding Icon}" Image="{Binding Image}" Size="22" Foreground="{DynamicResource HelmEyebrow}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Group}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                                        <Button Grid.Column="3" Classes="chip" Width="36" Height="36" MinHeight="36" Padding="0" IsEnabled="{Binding IsEnabled}"
                                                Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).LaunchCommand}" CommandParameter="{Binding}"
                                                ToolTip.Tip="Open" AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}">
                                            <ic:SymbolIcon Symbol="ChevronRight" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
