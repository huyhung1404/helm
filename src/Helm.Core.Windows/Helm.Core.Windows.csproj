<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only infrastructure on top of Helm.Core: Win32 (CsWin32), hooks, hotkeys, overlays, DPAPI, the clipboard,
       and the Windows module contract (IHelmModule, Avalonia types). No UI of its own. UseWPF stays only for two Windows
       desktop assemblies it reads with, not for UI: UI Automation (BrowserSites, the site in the browser in front) and
       Windows imaging (ShellIcons: a file's icon to PNG). Namespaces stay Helm.Core.*. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Helm.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.335">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.343" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core\Helm.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>
