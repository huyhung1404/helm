<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shell's own pages on Windows: Home, General and Bug reports (the shared Avalonia views from Helm.Shell.UI),
       filled from Helm's tools, plus what only Windows answers (startup task, administrator state, hotkey conflicts, the
       folders, General > MCP, the bug report window, the MCP consent window). No WPF. -->
  <PropertyGroup>
    <RootNamespace>Helm.Shell.Windows</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core.Windows\Helm.Core.Windows.csproj" />
    <ProjectReference Include="..\Helm.Shell.UI\Helm.Shell.UI.csproj" />
    <ProjectReference Include="..\Helm.ToolIcons\Helm.ToolIcons.csproj" />
    <ProjectReference Include="..\Helm.Ui\Helm.Ui.csproj" />
    <ProjectReference Include="..\Helm.Ui.Windows\Helm.Ui.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>