<Window
    x:Class="Helm.Modules.Vocab.VocabPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Helm.Modules.Vocab"
    Title="Vocabulary"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
    ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="Height" Width="352"
    UseLayoutRounding="True">

    <!-- One word to guess; a click on it shows the meaning, then the user says whether they remembered it. -->
    <Border Margin="16" Padding="16,12,16,16" CornerRadius="12" BorderThickness="1" MouseLeftButtonDown="Card_MouseLeftButtonDown"
            ToolTip="Drag to move it; double-click to put it back in the corner" ToolTipService.InitialShowDelay="1500"
            Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" Direction="270" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="4" MinWidth="0" Icon="{ui:SymbolIcon Dismiss16}"
                           ToolTip="Close (no answer)" AutomationProperties.Name="Close" Click="Close_Click" />
                <Image Width="16" Height="16" Source="{x:Static local:VocabLogo.Image}" VerticalAlignment="Center" />
                <TextBlock Margin="8,0,0,0" Text="Do you remember this word?" VerticalAlignment="Center" Style="{DynamicResource HelmSecondaryText}" />
            </DockPanel>

            <!-- The word: a click shows the meaning -->
            <Button Cursor="Hand" HorizontalAlignment="Stretch" Command="{Binding RevealCommand}" AutomationProperties.Name="Show the meaning" FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <TextBlock Text="{Binding Text}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Click to see the meaning" HorizontalAlignment="Center" Style="{DynamicResource HelmSecondaryText}"
                               Visibility="{Binding IsRevealed, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Button>

            <!-- The answer -->
            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsRevealed, Converter={StaticResource BoolToVisibility}}">
                <TextBlock HorizontalAlignment="Center" Style="{DynamicResource HelmSecondaryText}">
                    <Run Text="{Binding Phonetic, Mode=OneWay}" />
                    <Run Text="{Binding HanViet, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding Traditional, Mode=OneWay}" />
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <ui:Button Appearance="Transparent" Padding="6,2" Content="Listen" Icon="{ui:SymbolIcon Speaker224}" Command="{Binding SayCommand}"
                               Visibility="{Binding CanSay, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Appearance="Transparent" Padding="6,2" Margin="4,0,0,0" Content="YouGlish" Icon="{ui:SymbolIcon Video24}" Command="{Binding YouGlishCommand}"
                               Visibility="{Binding ShowYouGlish, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0" Text="{Binding Meaning}" FontSize="16" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Margin="0,4,0,0" Text="{Binding Explanation}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                           Style="{DynamicResource HelmSecondaryText}" />
                <!-- Each part with its meaning: enough to remember a forgotten word at once -->
                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding HasParts, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding PartLines}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ui:Button Margin="0,6,0,0" Appearance="Transparent" Padding="0,2" Content="See the whole tree" Icon="{ui:SymbolIcon Organization24}"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Click="SeeTree_Click" />
                    </StackPanel>
                </Border>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button HorizontalAlignment="Stretch" Content="Forgot" Icon="{ui:SymbolIcon DismissCircle24}" Command="{Binding ForgotCommand}" />
                    <ui:Button Grid.Column="2" HorizontalAlignment="Stretch" Appearance="Primary" Content="Remembered" Icon="{ui:SymbolIcon CheckmarkCircle24}"
                               Command="{Binding RememberedCommand}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
