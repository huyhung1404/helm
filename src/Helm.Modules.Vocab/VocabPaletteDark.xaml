<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Vocabulary's own colours in the dark theme: the design canvas's values (Main.dc.html, PcPopup.dc.html) where no
         theme brush has them. VocabPalette swaps this dictionary for VocabPaletteLight.xaml in the light theme; every
         key below must be in both. -->

    <!-- Surfaces: a card's hairline, the lines inside it, the lighter boxes in it (.part, .stat, chips), the tree -->
    <SolidColorBrush x:Key="VocabCardStroke" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="VocabHairline" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="VocabRowLine" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="VocabInset" Color="#323232" />
    <SolidColorBrush x:Key="VocabInsetHover" Color="#3A3A3A" />
    <SolidColorBrush x:Key="VocabInsetStroke" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="VocabNode" Color="#333333" />
    <SolidColorBrush x:Key="VocabNodeHover" Color="#3C3C3C" />
    <SolidColorBrush x:Key="VocabNodeStroke" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="VocabTreeLine" Color="#47FFFFFF" />
    <SolidColorBrush x:Key="VocabOnAccentSoft" Color="#00344A" />
    <SolidColorBrush x:Key="VocabMeaningText" Color="#D6D6D6" />
    <SolidColorBrush x:Key="VocabFaintText" Color="#A6A6A6" />
    <SolidColorBrush x:Key="VocabScrim" Color="#8C000000" />
    <SolidColorBrush x:Key="VocabDialogStroke" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="VocabPopupStroke" Color="#1AFFFFFF" />

    <!-- Buttons: .btn, .btn:hover, its stroke; a ghost's and an icon button's hover; .btn.danger-solid -->
    <SolidColorBrush x:Key="VocabButton" Color="#373737" />
    <SolidColorBrush x:Key="VocabButtonHover" Color="#404040" />
    <SolidColorBrush x:Key="VocabButtonStroke" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="VocabGhostHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="VocabIconHover" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="VocabDanger" Color="#C42B1C" />
    <SolidColorBrush x:Key="VocabDangerHover" Color="#D4392A" />
    <SolidColorBrush x:Key="VocabDangerText" Color="#FF99A4" />
    <SolidColorBrush x:Key="VocabSuccessText" Color="#6FD08C" />

    <!-- The segmented tabs: the frame, the one in front -->
    <SolidColorBrush x:Key="VocabSegment" Color="#1C1C1C" />
    <SolidColorBrush x:Key="VocabSegmentStroke" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="VocabSegmentOn" Color="#3A3A3A" />
    <SolidColorBrush x:Key="VocabSegmentHover" Color="#0DFFFFFF" />

    <!-- Tags (.tag, .tag.acc, .tag.warn, .tag.py, .tag.mute, .tag.user), the dim pill, the chip turned on -->
    <SolidColorBrush x:Key="VocabTag" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="VocabTagText" Color="#E0E0E0" />
    <SolidColorBrush x:Key="VocabAccentFill" Color="#2460CDFF" />
    <SolidColorBrush x:Key="VocabAccentText" Color="#8AD9FF" />
    <SolidColorBrush x:Key="VocabUserStroke" Color="#7360CDFF" />
    <SolidColorBrush x:Key="VocabChipOn" Color="#2960CDFF" />
    <SolidColorBrush x:Key="VocabWarnFill" Color="#24FFB86B" />
    <SolidColorBrush x:Key="VocabWarnText" Color="#FFC983" />
    <SolidColorBrush x:Key="VocabWarnStroke" Color="#99FFB86B" />
    <SolidColorBrush x:Key="VocabBusyStroke" Color="#9960CDFF" />
    <SolidColorBrush x:Key="VocabPinyinFill" Color="#24D58BEA" />
    <SolidColorBrush x:Key="VocabPinyinText" Color="#E7B5F2" />
    <SolidColorBrush x:Key="VocabMuteStroke" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="VocabPill" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="VocabKbdStroke" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="VocabKbdOnAccentStroke" Color="#59000000" />

    <!-- The boxes that help: .hook (the pinyin), .memo (to remember it) -->
    <SolidColorBrush x:Key="VocabHookFill" Color="#14D58BEA" />
    <SolidColorBrush x:Key="VocabHookStroke" Color="#40D58BEA" />
    <SolidColorBrush x:Key="VocabMemoFill" Color="#1460CDFF" />
    <SolidColorBrush x:Key="VocabMemoStroke" Color="#4D60CDFF" />

    <!-- The pop-up's round buttons: ✗ outlined, ✓ filled, Full details while open -->
    <SolidColorBrush x:Key="VocabNoStroke" Color="#B3FF99A4" />
    <SolidColorBrush x:Key="VocabNoHover" Color="#1FFF99A4" />
    <SolidColorBrush x:Key="VocabYes" Color="#6FD08C" />
    <SolidColorBrush x:Key="VocabYesHover" Color="#86DA9E" />
    <SolidColorBrush x:Key="VocabYesText" Color="#0B2A14" />
    <SolidColorBrush x:Key="VocabRoundHover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="VocabPopupInput" Color="#2D2D2D" />

    <!-- Pinyin tones 1-4 and the neutral tone -->
    <SolidColorBrush x:Key="VocabTone1" Color="#FF7A7A" />
    <SolidColorBrush x:Key="VocabTone2" Color="#6FD08C" />
    <SolidColorBrush x:Key="VocabTone3" Color="#5CB3FF" />
    <SolidColorBrush x:Key="VocabTone4" Color="#D58BEA" />
    <SolidColorBrush x:Key="VocabTone5" Color="#C5C5C5" />
</ResourceDictionary>
