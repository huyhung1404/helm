<Page
    x:Class="Helm.Modules.Vocab.VocabContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:Helm.Modules.Vocab.Views"
    Title="Vocabulary" ScrollViewer.CanContentScroll="False" Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Vocabulary itself (menu and Quick access): the header (Analysis, Add words, settings), three tabs (Learn, Words,
         Roots), each scrolling its own parts so the Learn card keeps its answer buttons in reach; Add words, Analysis,
         Edit and Ask for a new analysis are dialogs over the page. Its options live on VocabPage (Home → Utilities). -->
    <Page.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding OpenAddCommand}" />
    </Page.InputBindings>

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Helm.Modules.Vocab;component/VocabTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- The Analysis chip: outlined in the accent colour while the agent works, in amber while words wait -->
            <Style x:Key="AgentChip" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="16" Padding="10,0,12,0" BorderThickness="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAgentBusy}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAgentWaiting}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== The title, the Analysis chip, Add words, settings; then the tabs ===== -->
        <StackPanel Margin="24,16,24,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="HeaderActions" Orientation="Horizontal">
                        <Button Style="{StaticResource AgentChip}" Command="{Binding OpenAgentCommand}" ToolTip="What waits for Claude Code, and the analysis now"
                                AutomationProperties.Name="{Binding AgentChipText, StringFormat='Analysis: {0}'}">
                            <StackPanel Orientation="Horizontal">
                                <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"
                                                 Visibility="{Binding IsAgentBusy, Converter={StaticResource BoolToVisibility}}" />
                                <ui:SymbolIcon Symbol="HourglassHalf24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding IsAgentWaiting, Converter={StaticResource BoolToVisibility}}" />
                                <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="16" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                               Visibility="{Binding IsAllAnalyzed, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding AgentChipText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ui:Button Margin="10,0,0,0" Content="Add words" Icon="{ui:SymbolIcon Add24}" Command="{Binding OpenAddCommand}" ToolTip="Add words (Ctrl+N)" />
                    </StackPanel>
                    <ui:Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Icon="{ui:SymbolIcon Settings24}" Click="Settings_Click"
                               ToolTip="Settings: the pop-up card, display, analysis" AutomationProperties.Name="Vocabulary settings" />
                </StackPanel>
                <TextBlock Text="Vocabulary" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Learn (the card), Words (the list, a word's page), Roots (families) -->
            <Border x:Name="Tabs" Style="{StaticResource SegmentBar}" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource TabButton}" Tag="{Binding IsLearning}" Command="{Binding ShowLearnCommand}" AutomationProperties.Name="Learn">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="HatGraduation24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="Learn" VerticalAlignment="Center" />
                            <Border Style="{StaticResource AccentPill}" ToolTip="Due now">
                                <TextBlock Text="{Binding LearnCount}" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TabButton}" Tag="{Binding IsWordsTab}" Command="{Binding ShowWordsCommand}" AutomationProperties.Name="Words">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BookLetter24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="Words" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Pill}" ToolTip="Words on the cards">
                                <TextBlock Text="{Binding WordsCount}" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TabButton}" Tag="{Binding IsRootsTab}" Command="{Binding ShowRootsCommand}" AutomationProperties.Name="Roots">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Organization24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="Roots" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ===== Notices: the tool is off, or a problem / notice from the last action ===== -->
        <StackPanel Grid.Row="1" Margin="24,0">
            <ui:InfoBar x:Name="OffBar" Severity="Informational" IsClosable="False" IsOpen="False" Visibility="Collapsed" Margin="0,12,0,0"
                        Title="Vocabulary is turned off" Message="Your words are kept. Turn Vocabulary on in its settings to use them." />
            <Border Style="{DynamicResource HelmSurface}" Margin="0,12,0,0" Padding="12,8" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Dismiss"
                               AutomationProperties.Name="Dismiss" Command="{Binding DismissMessageCommand}" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ===== The tab in front ===== -->
        <Grid x:Name="Body" Grid.Row="2" Margin="24,16,24,0">
            <views:VocabLearnView x:Name="LearnView" Margin="0,0,0,24" Visibility="{Binding IsLearning, Converter={StaticResource BoolToVisibility}}" />
            <!-- Words: the list; an opened word takes the whole tab (Back or Esc returns, Previous / Next walk the list) -->
            <Grid Visibility="{Binding IsWordsTab, Converter={StaticResource BoolToVisibility}}">
                <views:VocabWordsView x:Name="WordsView" Visibility="{Binding HasDetail, Converter={StaticResource InverseBoolToVisibility}}" />
                <views:VocabWordView x:Name="WordView" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
            <views:VocabRootsView x:Name="RootsView" DataContext="{Binding Roots}"
                                  Visibility="{Binding DataContext.IsRootsTab, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- ===== Dialogs over the whole page ===== -->
        <views:VocabAddDialog x:Name="AddDialog" Grid.RowSpan="3" />
        <views:VocabAgentDialog Grid.RowSpan="3" />
        <views:VocabEditDialog x:Name="EditDialog" Grid.RowSpan="3" />
        <views:VocabRedoDialog x:Name="RedoDialog" Grid.RowSpan="3" />
    </Grid>
</Page>
