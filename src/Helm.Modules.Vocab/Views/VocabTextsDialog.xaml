<UserControl
    x:Class="Helm.Modules.Vocab.Views.VocabTextsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pc="clr-namespace:Helm.Modules.Vocab"
    xmlns:local="clr-namespace:Helm.Modules.Vocab;assembly=Helm.Modules.Vocab.Core">

    <!-- Add text (the header's button): paste an article or song lyrics with where it comes from; Claude Code picks the words
         worth learning; the user ticks the ones to keep and adds them. One card, two views: the list with the paste form, and
         one text with its proposed words. DataContext: VocabViewModel (its Texts). -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Helm.Modules.Vocab;component/VocabTemplates.xaml" />
    </UserControl.Resources>

    <Grid Style="{StaticResource DialogScrim}" DataContext="{Binding Texts}"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
        <Border Style="{StaticResource DialogCard}" Width="680" MaxWidth="680" AutomationProperties.Name="Add text">
            <DockPanel>
                <!-- Title: Back + the text's title when one is open -->
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Margin="12,0,0,0" pc:ButtonIcon.Symbol="Dismiss24" ToolTip="Close (Esc)"
                            AutomationProperties.Name="Close" Command="{Binding CloseCommand}" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconBtn}" Margin="0,0,8,0" pc:ButtonIcon.Symbol="ArrowLeft24" ToolTip="Back to your texts (Esc)"
                            AutomationProperties.Name="Back to your texts" Command="{Binding BackCommand}"
                            Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Add text" Style="{StaticResource DialogTitle}" Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource DialogTitle}" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}" />
                </DockPanel>

                <!-- Footer: Add N words for a text's proposals; the paste form has its own button -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Text="{Binding Message}"
                                   Style="{StaticResource Hint}" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn}" Content="Close" Command="{Binding CloseCommand}" />
                            <Button Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" Content="Add text" pc:ButtonIcon.Symbol="Add24" Command="{Binding AddTextCommand}"
                                    Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" Content="{Binding AddSelectedText}" pc:ButtonIcon.Symbol="Checkmark24"
                                    Command="{Binding AddSelectedCommand}" Visibility="{Binding HasProposals, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" MaxHeight="560">
                    <StackPanel Style="{StaticResource DialogBody}">

                        <!-- ===== The list: the paste form, then the texts pasted before ===== -->
                        <StackPanel Visibility="{Binding IsListOpen, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4">
                                <Run Text="Where it comes from" /> <Run Text="(optional)" FontWeight="Normal" />
                            </TextBlock>
                            <ui:TextBox x:Name="TitleBox" PlaceholderText="A song and its singer, a chapter, a page…" AutomationProperties.Name="Where the text comes from"
                                        Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Text" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" MaxHeight="230" VerticalContentAlignment="Top"
                                        VerticalScrollBarVisibility="Auto" PlaceholderText="Paste the lyrics or the article here — Chinese (simplified or traditional) or English"
                                        AutomationProperties.Name="Text to learn words from" Text="{Binding NewBody, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Hint}"
                                       Text="Claude Code reads it, turns Chinese into simplified characters and picks the words worth learning. You choose which to keep before any is analyzed." />

                            <StackPanel Margin="0,20,0,0" Visibility="{Binding HasTexts, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Your texts" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding Texts}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:VocabSourceRow}">
                                            <Border Padding="0,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="14" Margin="10,0,0,0" pc:ButtonIcon.Symbol="Delete24"
                                                            ToolTip="Remove this text (the words already added stay)" AutomationProperties.Name="Remove text" Command="{Binding Remove}" />
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource WarnTag}" Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="Waiting" />
                                                    </Border>
                                                    <ui:Button DockPanel.Dock="Left" Appearance="Transparent" Padding="4,2" Command="{Binding Open}" HorizontalContentAlignment="Stretch"
                                                            AutomationProperties.Name="{Binding Title}">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0" />
                                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </ui:Button>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>

                        <!-- ===== One text: waiting, or its proposed words ===== -->
                        <StackPanel Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource InsetBox}" Padding="12,8" Margin="0,0,0,12"
                                    Visibility="{Binding IsDetailWaiting, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <DockPanel>
                                        <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0"
                                                         Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Grid VerticalAlignment="Center">
                                            <!-- Not started yet -->
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Waiting for Claude Code to pick the words. It starts by itself, or press Analyze now in the Analysis chip."
                                                       Visibility="{Binding DataContext.IsAgentBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <!-- Helm's agent at work: how far it got, and the whole log one click away -->
                                            <DockPanel Visibility="{Binding DataContext.Agent.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostBtn}" Margin="10,0,0,0" Content="See all steps"
                                                        Command="{Binding DataContext.OpenAgentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="The Analysis dialog's Activity: every step, with Stop and Copy log" />
                                                <TextBlock VerticalAlignment="Center">
                                                    <Run Text="Claude Code is at work" /><Run Text=" · step " Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run
                                                        Text="{Binding DataContext.Agent.Steps, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </TextBlock>
                                            </DockPanel>
                                            <!-- Another AI agent (over MCP) took the text -->
                                            <TextBlock TextWrapping="Wrap" Text="{Binding DataContext.Agent.ExternalStatus, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                                       Visibility="{Binding DataContext.Agent.ExternalBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </DockPanel>
                                    <!-- The last few steps, the newest at the bottom -->
                                    <ItemsControl Margin="28,8,0,0" Focusable="False" AutomationProperties.Name="Latest steps"
                                                  ItemsSource="{Binding DataContext.Agent.RecentLog, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Visibility="{Binding DataContext.Agent.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="12" Margin="0,1,0,0" Style="{StaticResource Hint}" />
                                                    <TextBlock x:Name="Line" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsResult}" Value="True">
                                                        <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource VocabSuccessText}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                        <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource VocabDangerText}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                        <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Setter TargetName="Line" Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEdge}" Value="True">
                                                        <Setter TargetName="Line" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <DockPanel Margin="0,0,0,6" Visibility="{Binding HasProposals, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource SmallGhostBtn}" Content="All" Command="{Binding SelectAllCommand}" ToolTip="Tick every new word" />
                                    <Button Style="{StaticResource SmallGhostBtn}" Content="None" Command="{Binding SelectNoneCommand}" ToolTip="Untick every word" />
                                </StackPanel>
                                <TextBlock Text="Words to look at" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Proposals}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:VocabProposalRow}">
                                        <Border Padding="0,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanTick}" Value="False">
                                                            <Setter Property="Opacity" Value="0.6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,12,0" MinWidth="0" IsChecked="{Binding IsChosen, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanTick}" AutomationProperties.Name="{Binding Word, StringFormat='Add {0}'}" />
                                                <Border DockPanel.Dock="Right" Style="{StaticResource AccentTag}" VerticalAlignment="Top" Visibility="{Binding IsAdded, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Added" />
                                                </Border>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" VerticalAlignment="Top" Visibility="{Binding AlreadyThere, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Already yours" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding Word, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                                                        <Run Text="{Binding Phonetic, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Run Text=" · " Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding Meaning, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" FontStyle="Italic" Text="{Binding Sentence}" Style="{StaticResource Hint}" />
                                                    <TextBlock Margin="0,3,0,0" TextWrapping="Wrap" Text="{Binding Reason}" Style="{StaticResource Hint}"
                                                               Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The text itself, to read the lines the words come from -->
                            <TextBlock Margin="0,18,0,6" Text="The text" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource InsetBox}" Padding="14,10" MaxHeight="180">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <TextBlock Text="{Binding DetailBody}" TextWrapping="Wrap" LineHeight="22" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
