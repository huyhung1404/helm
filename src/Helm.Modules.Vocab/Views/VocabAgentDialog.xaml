<UserControl
    x:Class="Helm.Modules.Vocab.Views.VocabAgentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Helm.Modules.Vocab;assembly=Helm.Modules.Vocab.Core"
    xmlns:pc="clr-namespace:Helm.Modules.Vocab">

    <!-- Analysis (the header's chip): what Claude Code does by itself, the run in progress with Stop and its Activity log,
         the words waiting to be broken down, what else is on its list, and the request to copy into Claude Code by hand.
         DataContext: VocabViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Helm.Modules.Vocab;component/VocabTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- A line of "Also on its list": shown while its count is above 0 -->
            <Style x:Key="WorkRow" TargetType="Border" BasedOn="{StaticResource ListRow}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource DialogScrim}" Visibility="{Binding IsAgentOpen, Converter={StaticResource BoolToVisibility}}">
        <Border Style="{StaticResource DialogCard}" Width="560" AutomationProperties.Name="Analysis">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Margin="12,0,0,0" pc:ButtonIcon.Symbol="Dismiss24" ToolTip="Close (Esc)"
                            AutomationProperties.Name="Close" Command="{Binding CloseAgentCommand}" />
                    <TextBlock Text="Analysis" Style="{StaticResource DialogTitle}" />
                </DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource GhostBtn}" Content="Copy request" pc:ButtonIcon.Symbol="Copy24" Command="{Binding CopyPromptCommand}"
                                ToolTip="Paste it into Claude Code yourself" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn}" Content="Close" Command="{Binding CloseAgentCommand}" />
                            <Button Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" Content="Analyze now" pc:ButtonIcon.Symbol="Sparkle24" Command="{Binding Agent.AnalyzeCommand}"
                                    ToolTip="Claude Code does this without a window: breaks new words down, writes new ways to remember the words you keep forgetting, fills in missing details"
                                    Visibility="{Binding Agent.CanRun, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Style="{StaticResource DialogBody}">
                        <TextBlock FontSize="14" Style="{StaticResource Hint}"
                                   Text="Claude Code works without a window: it breaks new words into parts, writes new ways to remember the words you keep forgetting, and fills in missing details. With “Break new words down by itself” on (settings), it runs a moment after words arrive." />

                        <!-- The run in progress (.part as a row): how far it got, and Stop -->
                        <Border Margin="0,16,0,0" Style="{StaticResource InsetBox}" Visibility="{Binding Agent.IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallBtn}" Margin="10,0,0,0" Content="Stop" pc:ButtonIcon.Symbol="Stop24" Command="{Binding Agent.StopCommand}" />
                                <ui:ProgressRing DockPanel.Dock="Left" IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="Claude Code is at work" /><Run Text=" · step " Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run
                                        Text="{Binding Agent.Steps, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                            </DockPanel>
                        </Border>
                        <TextBlock Margin="0,8,0,0" Text="{Binding Agent.Status}" Style="{StaticResource Hint}"
                                   Visibility="{Binding Agent.HasLog, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- Activity: every step of the run in progress (or of the last one), the newest at the bottom -->
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding Agent.HasLog, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SmallGhostBtn}" Content="Copy log" pc:ButtonIcon.Symbol="Copy24"
                                        Command="{Binding CopyLogCommand}" ToolTip="Copy every line, to keep or to share" />
                                <TextBlock Text="Activity" Style="{StaticResource GroupTitle}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Style="{StaticResource InsetBox}" Padding="0">
                                <ScrollViewer x:Name="LogScroller" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False" AutomationProperties.Name="Activity">
                                    <ItemsControl ItemsSource="{Binding Agent.Log}" Margin="12,8" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="12" Margin="0,1,0,0" Style="{StaticResource Hint}" />
                                                    <TextBlock x:Name="Line" Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsResult}" Value="True">
                                                        <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource VocabSuccessText}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                        <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource VocabDangerText}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                        <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Setter TargetName="Line" Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEdge}" Value="True">
                                                        <Setter TargetName="Line" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- .grp: the words waiting to be broken down, each with where it was met and ✕ -->
                        <StackPanel Margin="0,20,0,0">
                            <TextBlock Style="{StaticResource GroupTitle}">
                                <Run Text="Waiting to be broken down" /> <Run Text="{Binding PendingCount, Mode=OneWay, StringFormat=({0})}" FontWeight="Normal" FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <TextBlock Text="Nothing waits. New words land here." Style="{StaticResource Hint}"
                                       Visibility="{Binding HasPending, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding PendingWords}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:VocabWordRow}">
                                        <Border Style="{StaticResource ListRow}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="14" Margin="10,0,0,0"
                                                        pc:ButtonIcon.Symbol="Dismiss24" ToolTip="Remove (a typo, or not worth learning)" AutomationProperties.Name="Remove"
                                                        Command="{Binding Remove}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{StaticResource Hint}"
                                                           MaxWidth="240" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Text}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- .grp: what else waits for it -->
                        <StackPanel Margin="0,20,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HardCount}" Value="0" />
                                                <Condition Binding="{Binding SlipCount}" Value="0" />
                                                <Condition Binding="{Binding LackingCount}" Value="0" />
                                                <Condition Binding="{Binding TextCount}" Value="0" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Also on its list" Style="{StaticResource GroupTitle}" />
                            <Border Style="{StaticResource WorkRow}" Tag="{Binding HardCount}">
                                <DockPanel>
                                    <Border Style="{StaticResource WarnTag}" Margin="0,0,10,0"><TextBlock Text="{Binding HardCount}" /></Border>
                                    <TextBlock Text="words you keep forgetting get a new way to remember them" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource WorkRow}" Tag="{Binding LackingCount}">
                                <DockPanel>
                                    <Border Style="{StaticResource Tag}" Margin="0,0,10,0"><TextBlock Text="{Binding LackingCount}" /></Border>
                                    <TextBlock Text="words get their missing word forms, synonyms and antonyms" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource WorkRow}" Tag="{Binding SlipCount}">
                                <DockPanel>
                                    <Border Style="{StaticResource PinyinTag}" Margin="0,0,10,0"><TextBlock Text="{Binding SlipCount}" /></Border>
                                    <TextBlock Text="Chinese words whose pinyin keeps slipping get a pinyin hook only, never a new analysis" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource WorkRow}" Tag="{Binding TextCount}">
                                <DockPanel>
                                    <Border Style="{StaticResource AccentTag}" Margin="0,0,10,0"><TextBlock Text="{Binding TextCount}" /></Border>
                                    <TextBlock Text="texts wait for an AI agent to pick their words" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
