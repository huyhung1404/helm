<UserControl
    x:Class="Helm.Modules.Vocab.Views.VocabRedoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pc="clr-namespace:Helm.Modules.Vocab">

    <!-- Ask for a new analysis (a word's ⋯ menu): what was wrong, sent back to the agent with the word.
         DataContext: VocabViewModel; the note is Detail's. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Helm.Modules.Vocab;component/VocabTemplates.xaml" />
    </UserControl.Resources>

    <Grid Style="{StaticResource DialogScrim}" Visibility="{Binding Detail.IsAskingRedo, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
        <Border Style="{StaticResource DialogCard}" Width="520" DataContext="{Binding Detail}" AutomationProperties.Name="Ask for a new analysis">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Margin="12,0,0,0" pc:ButtonIcon.Symbol="Dismiss24" ToolTip="Close (Esc)"
                            AutomationProperties.Name="Close" Command="{Binding BeginRedoCommand}" />
                    <TextBlock Text="Ask for a new analysis" Style="{StaticResource DialogTitle}" />
                </DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn}" Content="Cancel" Command="{Binding BeginRedoCommand}" />
                        <Button Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0" Content="Send back" pc:ButtonIcon.Symbol="Send24" Command="{Binding SendRedoCommand}" />
                    </StackPanel>
                </Border>
                <StackPanel Style="{StaticResource DialogBody}">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Claude Code breaks “" /><Run Text="{Binding Word.Text, Mode=OneWay}" /><Run Text="” down again. Until then it keeps its current parts." />
                    </TextBlock>
                    <TextBlock Text="What should change?" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
                    <!-- Three lines tall; Enter sends it -->
                    <ui:TextBox x:Name="NoteBox" MinHeight="72" TextWrapping="Wrap" VerticalContentAlignment="Top" PlaceholderText="e.g. tách lat thành ferre"
                                AutomationProperties.Name="What should change" Text="{Binding RedoNote, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendRedoCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
