<UserControl
    x:Class="Helm.Modules.Vocab.Views.VocabRedoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Ask for a new analysis (a word's ⋯ menu): what was wrong, sent back to the agent with the word.
         DataContext: VocabViewModel; the note is Detail's. -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Helm.Modules.Vocab;component/VocabTemplates.xaml" />
    </UserControl.Resources>

    <Grid Style="{StaticResource DialogScrim}" Visibility="{Binding Detail.IsAskingRedo, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
        <Border Style="{StaticResource DialogCard}" Width="520" DataContext="{Binding Detail}" AutomationProperties.Name="Ask for a new analysis">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="24,20,16,4">
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Close (Esc)"
                               AutomationProperties.Name="Close" Command="{Binding BeginRedoCommand}" />
                    <TextBlock Text="Ask for a new analysis" Style="{StaticResource DialogTitle}" />
                </DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Cancel" MinWidth="80" Command="{Binding BeginRedoCommand}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="Send back" Icon="{ui:SymbolIcon Send24}" Command="{Binding SendRedoCommand}" />
                    </StackPanel>
                </Border>
                <StackPanel Margin="24,8,24,24">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Claude Code breaks “" /><Run Text="{Binding Word.Text, Mode=OneWay}" /><Run Text="” down again. Until then it keeps its current parts." />
                    </TextBlock>
                    <TextBlock Text="What should change?" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                    <ui:TextBox x:Name="NoteBox" PlaceholderText="e.g. tách lat thành ferre" AutomationProperties.Name="What should change"
                                Text="{Binding RedoNote, UpdateSourceTrigger=PropertyChanged}">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendRedoCommand}" />
                        </ui:TextBox.InputBindings>
                    </ui:TextBox>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
