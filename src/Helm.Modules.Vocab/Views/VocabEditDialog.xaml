<UserControl
    x:Class="Helm.Modules.Vocab.Views.VocabEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Edit a word by hand (its page's Edit, or the card's ⋯ → Edit…): the word itself, what helps to remember and use
         it, its labels; saved as a whole. The tree stays the agent's. DataContext: VocabViewModel; the fields are
         Detail.Editor's. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Helm.Modules.Vocab;component/VocabTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="GroupTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,20,0,0" />
            </Style>
            <Style x:Key="Lines" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MinHeight" Value="56" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource DialogScrim}" Visibility="{Binding Detail.Editor.IsOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
        <Border Style="{StaticResource DialogCard}" Width="680" MaxWidth="680" VerticalAlignment="Stretch" DataContext="{Binding Detail.Editor}" AutomationProperties.Name="Edit the word">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="24,20,16,4">
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Close without saving (Esc)"
                               AutomationProperties.Name="Close" Command="{Binding CancelCommand}" />
                    <TextBlock Style="{StaticResource DialogTitle}">
                        <Run Text="Edit “" /><Run Text="{Binding DataContext.Detail.Word.Text, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" /><Run Text="”" />
                    </TextBlock>
                </DockPanel>
                <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Content="Cancel" MinWidth="80" Command="{Binding CancelCommand}" />
                            <ui:Button Margin="8,0,0,0" MinWidth="80" Appearance="Primary" Content="Save" Icon="{ui:SymbolIcon Checkmark24}" Command="{Binding SaveCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="24,0,24,24">
                        <!-- The word -->
                        <TextBlock Text="The word" Style="{StaticResource GroupTitle}" Margin="0,8,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Phonetic" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox x:Name="PhoneticBox" Text="{Binding Phonetic, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Phonetic" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hán Việt" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding HanViet, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Hán Việt" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Traditional" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding Traditional, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Traditional" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Meaning" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Style="{StaticResource Lines}" Text="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Meaning" />
                        <TextBlock Text="Explanation" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Style="{StaticResource Lines}" Text="{Binding Explanation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Explanation" />

                        <!-- What helps to remember and use it -->
                        <TextBlock Text="Help to remember and use it" Style="{StaticResource GroupTitle}" />
                        <TextBlock Text="To remember it" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Style="{StaticResource Lines}" Text="{Binding Mnemonic, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mnemonic" />
                        <StackPanel Visibility="{Binding IsChinese, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="To remember the pinyin" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox Style="{StaticResource Lines}" Text="{Binding PinyinMnemonic, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="To remember the pinyin" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Examples" /> <Run Text="· one per line: sentence | translation" FontWeight="Normal" /></TextBlock>
                        <ui:TextBox Style="{StaticResource Lines}" MinHeight="72" Text="{Binding Examples, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Examples" />
                        <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Goes with" /> <Run Text="· separated by commas" FontWeight="Normal" /></TextBlock>
                        <ui:TextBox Text="{Binding Collocations, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Collocations" />
                        <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Word family" /> <Run Text="· one per line: word | part of speech | meaning" FontWeight="Normal" /></TextBlock>
                        <ui:TextBox Style="{StaticResource Lines}" MinHeight="72" Text="{Binding Forms, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Word family" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Similar" /> <Run Text="· commas" FontWeight="Normal" /></TextBlock>
                                <ui:TextBox Text="{Binding Synonyms, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Synonyms" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Opposite" /> <Run Text="· commas" FontWeight="Normal" /></TextBlock>
                                <ui:TextBox Text="{Binding Antonyms, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Antonyms" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Easy to mix up with" /> <Run Text="· one per line: word | what tells them apart" FontWeight="Normal" /></TextBlock>
                        <ui:TextBox Style="{StaticResource Lines}" Text="{Binding Confusables, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Confusables" />

                        <!-- Labels -->
                        <TextBlock Text="Labels" Style="{StaticResource GroupTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Level" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox PlaceholderText="B1, HSK3" Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Level" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Part of speech" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding PartOfSpeech, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Part of speech" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Topic" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Topic" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}"><Run Text="Your tags" /> <Run Text="· separated by commas (Aptis, Truyện)" FontWeight="Normal" /></TextBlock>
                        <ui:TextBox Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tags" />
                        <TextBlock Text="Your note" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Your note" AcceptsReturn="True" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
