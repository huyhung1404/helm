<UserControl
    x:Class="Helm.Modules.Vocab.Views.VocabWordView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pc="clr-namespace:Helm.Modules.Vocab"
    x:Name="Root">

    <!-- A word's page, in place of the list, 12 px between its rows: back to the list and the words before and after it;
         the word with its labels and actions; how it is built beside what helps to use it. DataContext: VocabViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Helm.Modules.Vocab;component/VocabTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- What helps beside the tree; alone it takes the whole width -->
            <Style x:Key="InfoColumn" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Grid.Column" Value="2" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasTree}" Value="False">
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="3" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- A label of the word's: 8 px apart, rows 8 px apart when they wrap -->
            <Style x:Key="Label" TargetType="Border" BasedOn="{StaticResource Tag}">
                <Setter Property="Margin" Value="0,0,8,8" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <!-- At most 1100 px wide, flush left -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1100" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
        <StackPanel x:Name="DetailPanel" Margin="0,0,0,32" Focusable="True" FocusVisualStyle="{x:Null}">
            <!-- Back to the list, and the words before and after this one -->
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Left" Style="{StaticResource GhostBtn}" Content="All words" pc:ButtonIcon.Symbol="ArrowLeft24" ToolTip="Back to the list (Esc)"
                        AutomationProperties.Name="Back to the words" Command="{Binding CloseDetailCommand}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding WordPosition}" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Hint}" />
                    <Button Style="{StaticResource SmallGhostBtn}" Content="Previous" pc:ButtonIcon.Symbol="ChevronLeft24" ToolTip="The word before (←)"
                            Command="{Binding PreviousWordCommand}" IsEnabled="{Binding HasPreviousWord}" />
                    <Button Style="{StaticResource SmallGhostBtn}" Margin="4,0,0,0" Content="Next" pc:ButtonIcon.After="ChevronRight24" ToolTip="The word after (→)"
                            Command="{Binding NextWordCommand}" IsEnabled="{Binding HasNextWord}" />
                </StackPanel>
                <Border />
            </DockPanel>

            <!-- The word: its forms and reading on one baseline, meaning, explanation, note, how well it is known and its
                 labels; Listen, YouGlish, Edit, more -->
            <Border Style="{StaticResource Card}" Padding="24,20" Margin="0,0,0,12" DataContext="{Binding Detail}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="24,0,0,0">
                        <Button Style="{StaticResource GhostBtn}" Content="Listen" pc:ButtonIcon.Symbol="Speaker224" ToolTip="Say the word"
                                AutomationProperties.Name="Say the word" Command="{Binding SayWordCommand}"
                                Visibility="{Binding CanSay, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource GhostBtn}" Margin="4,0,0,0" Content="YouGlish" pc:ButtonIcon.Symbol="Video24"
                                ToolTip="Hear real people say it in YouTube videos (YouGlish, opens your browser)"
                                AutomationProperties.Name="YouGlish" Command="{Binding YouGlishCommand}"
                                Visibility="{Binding ShowYouGlish, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource Btn}" Margin="4,0,0,0" Content="Edit" pc:ButtonIcon.Symbol="Edit24" ToolTip="Edit the meaning, examples, labels…"
                                AutomationProperties.Name="Edit the word" Command="{Binding Editor.BeginCommand}" />
                        <Button Style="{StaticResource IconBtn}" Margin="4,0,0,0" pc:ButtonIcon.Symbol="MoreHorizontal24" ToolTip="More for this word"
                                AutomationProperties.Name="More for this word" pc:MoreMenu.OpensOnClick="True">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource Menu}">
                                    <MenuItem Header="I know it: back in a month" Command="{Binding KnowCommand}"
                                              Visibility="{Binding IsPending, Converter={StaticResource InverseBoolToVisibility}}">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Star24" FontSize="18" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Hide from the cards" Command="{Binding ToggleHiddenCommand}" ToolTip="Leave it out of the cards and the pop-up"
                                              Visibility="{Binding IsHidden, Converter={StaticResource InverseBoolToVisibility}}">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="EyeOff24" FontSize="18" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Show in the cards again" Command="{Binding ToggleHiddenCommand}"
                                              Visibility="{Binding IsHidden, Converter={StaticResource BoolToVisibility}}">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Eye24" FontSize="18" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Ask for a new analysis…" Command="{Binding BeginRedoCommand}">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="18" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Delete…" Click="Delete_Click" Foreground="{DynamicResource VocabDangerText}">
                                        <MenuItem.Icon><ui:SymbolIcon Symbol="Delete24" FontSize="18" Foreground="{DynamicResource VocabDangerText}" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <StackPanel>
                        <!-- The word, its traditional form, its reading (tones in colour) and its Hán Việt, 12 px apart on one baseline -->
                        <TextBlock TextWrapping="Wrap" LineHeight="42" LineStackingStrategy="BlockLineHeight">
                            <Run Text="{Binding Word.Text, Mode=OneWay}" FontSize="38" FontWeight="SemiBold" /><Run
                                Text="{Binding ShownTraditional, Mode=OneWay, Converter={StaticResource TextFormat}, ConverterParameter='&#x2002;'}" FontSize="24" /><Run
                                Text="{Binding ShownTraditional, Mode=OneWay}" FontSize="22" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run
                                Text="&#x2002;" FontSize="24" /><Span pc:ToneText.Text="{Binding Word.Phonetic}" FontSize="17" /><Run
                                Text="{Binding Word.HanViet, Mode=OneWay, Converter={StaticResource TextFormat}, ConverterParameter='&#x2002;'}" FontSize="24" /><Run
                                Text="{Binding Word.HanViet, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0" Text="{Binding Word.Meaning}" FontSize="19" TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding Word.Explanation}" FontSize="14" Style="{StaticResource Hint}"
                                   Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Margin="0,6,0,0" FontSize="13" FontStyle="Italic" Style="{StaticResource Hint}"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Your note:" /> <Run Text="{Binding Word.Note, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" FontSize="13" FontStyle="Italic" Style="{StaticResource Hint}"
                                   Visibility="{Binding HasSourceSentence, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="From the text:" /> <Run Text="{Binding Word.SourceSentence, Mode=OneWay}" />
                        </TextBlock>
                        <WrapPanel Margin="0,14,0,-8">
                            <ItemsControl Style="{StaticResource Dots}" ItemsSource="{Binding Dots}" Margin="0,0,5,8" />
                            <TextBlock Text="{Binding LevelText}" Margin="0,0,14,8" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                            <Border Style="{StaticResource Label}" Visibility="{Binding Word.Level, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="{Binding Word.Level}" />
                            </Border>
                            <Border Style="{StaticResource Label}" Visibility="{Binding Word.PartOfSpeech, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="{Binding Word.PartOfSpeech}" />
                            </Border>
                            <Border Style="{StaticResource Label}" Visibility="{Binding Word.Topic, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="{Binding Word.Topic}" />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Word.Tags}" Focusable="False" ItemsPanel="{StaticResource Wrap}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource UserTag}" Margin="0,0,8,8">
                                            <TextBlock Text="{Binding StringFormat='#{0}'}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource WarnTag}" Margin="0,0,8,8" Visibility="{Binding IsHard, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="You forgot it several times: Claude Code writes a new way to remember it">
                                <TextBlock Text="Often forgotten" />
                            </Border>
                            <Border Style="{StaticResource PinyinTag}" Margin="0,0,8,8" Visibility="{Binding IsSlipping, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="Its pinyin keeps slipping while you know the meaning: Claude Code writes a way to remember the reading">
                                <TextBlock Text="Pinyin slips" />
                            </Border>
                            <Border Style="{StaticResource MuteTag}" Margin="0,0,8,8" Visibility="{Binding IsHidden, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Hidden from the cards" />
                            </Border>
                        </WrapPanel>
                        <ui:InfoBar Margin="0,10,0,0" Severity="Informational" IsClosable="False" IsOpen="{Binding IsPending}" Title="Waiting for analysis"
                                    Message="{Binding PendingText}" Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- How it is built, beside what helps to remember and use it -->
            <Grid DataContext="{Binding Detail}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="20,16" VerticalAlignment="Top" Visibility="{Binding HasTree, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="How it's built" Style="{StaticResource CardTitle}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PartsView}" Focusable="False" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource InfoColumn}">
                    <StackPanel>
                        <!-- Chinese: how to remember the reading, first -->
                        <Border Margin="0,0,0,14" Style="{StaticResource PinyinBox}" Visibility="{Binding Info.HasPinyinMnemonic, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Remembering the pinyin" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource VocabPinyinText}" />
                                <TextBlock Text="{Binding Info.PinyinMnemonic}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Hint}"
                                           Text="The meaning never counted as forgotten. Written by Claude Code from the sound parts and the Hán Việt." />
                            </StackPanel>
                        </Border>
                        <ContentControl Content="{Binding Info}" ContentTemplate="{StaticResource InfoView}" Focusable="False" Margin="0,0,0,-14" />
                        <TextBlock FontSize="14" Style="{StaticResource Hint}" Visibility="{Binding Info.HasAny, Converter={StaticResource InverseBoolToVisibility}}">
                            <Run Text="No examples or memory hooks yet." />
                            <Hyperlink Command="{Binding Editor.BeginCommand}" Foreground="{DynamicResource AccentFillColorDefaultBrush}">Add them</Hyperlink>
                            <Run Text="or ask Claude Code to fill them in." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
