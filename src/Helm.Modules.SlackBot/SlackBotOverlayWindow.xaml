<Window
    x:Class="Helm.Modules.SlackBot.SlackBotOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Helm.Modules.SlackBot"
    Title="Slack Bot"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
    ShowInTaskbar="False" ShowActivated="False" Topmost="True" SizeToContent="WidthAndHeight"
    UseLayoutRounding="True">

    <!-- What needs the user, on top of every app until they answer it (SlackBotOverlay). It never takes the keyboard.
         Folded, it is a small badge with the count. -->
    <Window.Resources>
        <Style x:Key="SmallIcon" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="16" MouseLeftButtonDown="Surface_MouseLeftButtonDown"
          ToolTip="Drag to move it; double-click to put it back in the corner" ToolTipService.InitialShowDelay="1500">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" Direction="270" />
        </Grid.Effect>

        <!-- Folded: the icon and the count -->
        <Border x:Name="Folded" CornerRadius="18" BorderThickness="1" Padding="10,6" Cursor="Hand"
                Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                AutomationProperties.Name="Open Slack Bot's list">
            <StackPanel Orientation="Horizontal">
                <Image Width="18" Height="18" Source="{x:Static local:SlackBotLogo.Image}" VerticalAlignment="Center" />
                <Border Margin="8,0,0,0" MinWidth="22" Height="22" CornerRadius="11" Padding="6,0" Background="{DynamicResource SystemFillColorCriticalBrush}"
                        Visibility="{Binding HasToDo, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ToDoCount}" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Margin="8,0,0,0" Text="Report" VerticalAlignment="Center" Style="{DynamicResource HelmSecondaryText}"
                           Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Open: the to-do list -->
        <Border x:Name="Open" Width="360" CornerRadius="12" BorderThickness="1"
                Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="14,8,8,4">
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource SmallIcon}" Icon="{ui:SymbolIcon ChevronDown16}"
                               ToolTip="Fold" AutomationProperties.Name="Fold" Click="Fold_Click" />
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource SmallIcon}" Icon="{ui:SymbolIcon Open16}"
                               ToolTip="Open Slack Bot" AutomationProperties.Name="Open Slack Bot" Command="{Binding ShowPageCommand}" />
                    <Image Width="16" Height="16" Source="{x:Static local:SlackBotLogo.Image}" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold">
                        <Run Text="Slack Bot" />
                        <Run Text="·" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding ToDoCount, Mode=OneWay}" />
                        <Run Text="to do" />
                    </TextBlock>
                </DockPanel>

                <!-- The report (worth knowing), at the report times -->
                <Button DockPanel.Dock="Bottom" Margin="8,0,8,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand" Command="{Binding ShowPageCommand}" FocusVisualStyle="{x:Null}"
                        Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding ReportTitle}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Padding="8,6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <DockPanel>
                        <ui:SymbolIcon DockPanel.Dock="Right" Symbol="ChevronRight16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" Text="{Binding ReportTitle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </DockPanel>
                </Button>

                <!-- The reply being written: as the user, to the message chosen with Reply -->
                <Border x:Name="ReplyPanel" DockPanel.Dock="Bottom" Margin="8,0,8,8" Padding="10,8" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1"
                        BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Visibility="{Binding ReplyTo, Converter={StaticResource NotEmptyToVisibility}}">
                    <StackPanel>
                        <TextBlock TextTrimming="CharacterEllipsis" Style="{DynamicResource HelmSecondaryText}">
                            <Run Text="Reply to" />
                            <Run Text="{Binding ReplyTo.From, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="·" />
                            <Run Text="{Binding ReplyTo.Where, Mode=OneWay}" />
                        </TextBlock>
                        <ui:TextBox x:Name="ReplyBox" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" MinHeight="36"
                                    VerticalScrollBarVisibility="Auto" PlaceholderText="Your answer (Enter sends, Shift+Enter for a new line, Esc closes)"
                                    Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="ReplyBox_PreviewKeyDown"
                                    PreviewMouseLeftButtonDown="ReplyBox_MouseDown" AutomationProperties.Name="Your answer" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding ReplyProblem}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Visibility="{Binding ReplyProblem, Converter={StaticResource NotEmptyToVisibility}}" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Cancel" Padding="8,3" Click="CancelReply_Click" />
                            <ui:Button Margin="6,0,0,0" Content="Send" Appearance="Primary" Icon="{ui:SymbolIcon Send16}" Padding="8,3" Click="SendReply_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding ToDo}" Margin="0,0,0,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:InboxItemViewModel}">
                                <Border Margin="8,0,8,4" Padding="10,8" CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Style="{DynamicResource HelmSecondaryText}" />
                                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                                            <TextBlock Margin="8,0,8,0" TextTrimming="CharacterEllipsis" Style="{DynamicResource HelmSecondaryText}">
                                                <Run Text="{Binding From, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="·" />
                                                <Run Text="{Binding Where, Mode=OneWay}" />
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Margin="0,2,0,0" Text="{Binding Waiting}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Visibility="{Binding HasWaiting, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding CountText}" Style="{DynamicResource HelmSecondaryText}"
                                                   Visibility="{Binding HasCount, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Margin="0,4,0,0" Text="{Binding Headline}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Margin="0,2,0,0" Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="90" TextTrimming="WordEllipsis"
                                                   Style="{DynamicResource HelmSecondaryText}" Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontStyle="Italic" Style="{DynamicResource HelmSecondaryText}"
                                                   Visibility="{Binding HasBotReply, Converter={StaticResource BoolToVisibility}}">
                                            <Run Text="Replied for you:" FontWeight="SemiBold" />
                                            <Run Text="{Binding BotReply, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock x:Name="Unsorted" Margin="0,2,0,0" Text="Not sorted yet" Style="{DynamicResource HelmSecondaryText}" Visibility="Collapsed" />
                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                            <ui:Button Content="Open in Slack" Icon="{ui:SymbolIcon Open16}" Padding="8,3"
                                                       Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <ui:Button Margin="6,0,0,0" Content="Reply" Icon="{ui:SymbolIcon ArrowReply16}" Padding="8,3"
                                                       ToolTip="Write your answer here; it goes to Slack as you"
                                                       Command="{Binding DataContext.StartReplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                            <ui:Button Margin="6,0,0,0" Content="Done" Icon="{ui:SymbolIcon Checkmark16}" Padding="8,3"
                                                       ToolTip="Takes it off the list (replying in Slack or an emoji does too)"
                                                       Command="{Binding DataContext.DoneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUnsorted}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Setter TargetName="Unsorted" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
