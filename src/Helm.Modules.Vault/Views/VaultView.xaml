<!-- The vault itself: setup, unlock, the item list and the Emergency Kit. Hosted by VaultContentPage in Helm's
     main window (the navigation pane and Home Quick access open it; its settings are a separate page). -->
<UserControl x:Class="Helm.Modules.Vault.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Helm.Modules.Vault.ViewModels;assembly=Helm.Modules.Vault.Core"
             xmlns:items="clr-namespace:Helm.Modules.Vault.Items;assembly=Helm.Modules.Vault.Core"
             xmlns:local="clr-namespace:Helm.Modules.Vault.Views">
    <UserControl.Resources>
        <local:NotEmptyToBoolConverter x:Key="NotEmptyToBool" />
        <local:NotZeroToVisibilityConverter x:Key="NotZeroToVisibility" />
        <local:KindIconConverter x:Key="KindIcon" />
        <local:BytesToImageConverter x:Key="BytesToImage" />

        <local:EditorHeightConverter x:Key="EditorHeight" />

        <!-- The avatar of a login card: the item's picture, or its initial on a stable color. -->
        <!-- Every card's icon: its picture; else a login's initial on its colour, or the type's symbol (token, note, card…). -->
        <DataTemplate x:Key="CardAvatar" DataType="{x:Type vm:VaultCardViewModel}">
            <Grid Width="40" Height="40">
                <Border x:Name="Letter" CornerRadius="10" Background="{Binding AvatarColor, Converter={StaticResource HexToBrush}}" Visibility="Collapsed">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="Symbol" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="{Binding Kind, Converter={StaticResource KindIcon}}" FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="10" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Icon, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasIcon}" Value="False" />
                        <Condition Binding="{Binding IsLogin}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Letter" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasIcon}" Value="False" />
                        <Condition Binding="{Binding IsLogin}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Symbol" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A whole card as one flat button (hover and press shading, keyboard focus) -->
        <Style x:Key="CardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A sub-tab: a pill, filled with the accent when chosen -->
        <Style x:Key="SubTab" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="14" Padding="14,5" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CenteredCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="28,24" />
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- ============ Setup: create a vault, or restore one from a backup ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSetup, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CenteredCard}" Margin="16">
                <StackPanel>
                    <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="40" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Create your vault" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <TextBlock Style="{DynamicResource HelmSecondaryText}" FontSize="13"
                               Text="Choose a vault password you will remember. It is different from your sync passphrase, and nobody — not Helm, not the server — can reset it. You also get a recovery key to print and keep safe." />
                    <ui:HyperlinkButton Content="New to Vault? Read the guide first" Padding="0" Margin="0,6,0,0" Command="{Binding ShowGuideCommand}" />
                    <TextBlock Text="Vault password" Margin="0,16,0,4" />
                    <ui:PasswordBox x:Name="NewPasswordBox" AutomationProperties.Name="Vault password" Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="At least 14 characters" />
                    <TextBlock Text="{Binding PasswordStrength}" Style="{DynamicResource HelmSecondaryText}" Margin="0,4,0,0" />
                    <TextBlock Text="Type it again" Margin="0,12,0,4" />
                    <ui:PasswordBox AutomationProperties.Name="Type it again" Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:InfoBar Margin="0,12,0,0" IsOpen="{Binding Error, Converter={StaticResource NotEmptyToBool}}" Message="{Binding Error}" Severity="Error" IsClosable="False" />
                    <ui:Button Content="Create vault" Appearance="Primary" Margin="0,16,0,0" HorizontalAlignment="Stretch" Command="{Binding CreateCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" IsDefault="True" />
                    <ui:ProgressRing IsIndeterminate="True" Height="24" Width="24" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <Separator Margin="0,20" />
                    <TextBlock Text="Have a backup?" FontWeight="SemiBold" />
                    <TextBlock Style="{DynamicResource HelmSecondaryText}" Margin="0,2,0,8"
                               Text="Restore the whole vault from a backup folder, with that vault's password or its recovery key." />
                    <CheckBox Content="Use the recovery key instead of the password" IsChecked="{Binding UseRecoveryKey}" />
                    <ui:PasswordBox Margin="0,8,0,0" AutomationProperties.Name="Vault password of the backup" PlaceholderText="Vault password of the backup" Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding UseRecoveryKey, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ui:TextBox Margin="0,8,0,0" AutomationProperties.Name="Recovery key of the backup" PlaceholderText="HELMV-XXXX-XXXX-…" FontFamily="Consolas" Text="{Binding RecoveryKey, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding UseRecoveryKey, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Restore from a backup folder…" Margin="0,8,0,0" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Command="{Binding RestoreFromBackupCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ============ Unlock ============ -->
        <Border Grid.Row="1" Style="{StaticResource CenteredCard}" Width="420" Visibility="{Binding IsUnlock, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ui:SymbolIcon Symbol="LockClosed24" FontSize="40" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Vault is locked" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,16" />
                <ui:Button Content="{Binding DeviceUnlockName}" Icon="{ui:SymbolIcon Fingerprint24}" Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                           Command="{Binding QuickUnlockCommand}" Visibility="{Binding CanUseDeviceUnlock, Converter={StaticResource BoolToVisibility}}" />
                <ui:PasswordBox x:Name="UnlockPasswordBox" AutomationProperties.Name="Vault password" PlaceholderText="Vault password" Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding UseRecoveryKey, Converter={StaticResource InverseBoolToVisibility}}" />
                <ui:TextBox AutomationProperties.Name="Recovery key" PlaceholderText="HELMV-XXXX-XXXX-…" FontFamily="Consolas" Text="{Binding RecoveryKey, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding UseRecoveryKey, Converter={StaticResource BoolToVisibility}}" />
                <ui:InfoBar Margin="0,12,0,0" IsOpen="{Binding Error, Converter={StaticResource NotEmptyToBool}}" Message="{Binding Error}" Severity="Error" IsClosable="False" />
                <ui:Button Content="Unlock" Appearance="Primary" Margin="0,12,0,0" HorizontalAlignment="Stretch" Command="{Binding UnlockCommand}" IsDefault="True"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                <ui:ProgressRing IsIndeterminate="True" Height="24" Width="24" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <CheckBox Margin="0,16,0,0" Content="I forgot the password: use the recovery key" IsChecked="{Binding UseRecoveryKey}" />
            </StackPanel>
        </Border>

        <!-- ============ After a recovery-key unlock: a new password first ============ -->
        <Border Grid.Row="1" Style="{StaticResource CenteredCard}" Width="440" Visibility="{Binding MustChangePassword, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Set a new vault password" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Style="{DynamicResource HelmSecondaryText}" FontSize="13" Margin="0,4,0,12"
                           Text="You unlocked with the recovery key. Choose a new password; the recovery key keeps working." />
                <ui:PasswordBox AutomationProperties.Name="New password" PlaceholderText="New password" Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding PasswordStrength}" Style="{DynamicResource HelmSecondaryText}" Margin="0,4,0,8" />
                <ui:PasswordBox AutomationProperties.Name="New password again" PlaceholderText="Type it again" Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ui:InfoBar Margin="0,12,0,0" IsOpen="{Binding Error, Converter={StaticResource NotEmptyToBool}}" Message="{Binding Error}" Severity="Error" IsClosable="False" />
                <ui:Button Content="Set password" Appearance="Primary" Margin="0,12,0,0" HorizontalAlignment="Stretch" Command="{Binding SetNewPasswordCommand}" />
            </StackPanel>
        </Border>

        <!-- ============ The vault ============ -->
        <Grid Grid.Row="1" Margin="8,0,8,8" Visibility="{Binding IsItems, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Warnings that must not be missed -->
            <StackPanel>
                <ui:InfoBar Title="Sync is holding back deletions" Message="{Binding HeldWarning}" Severity="Warning" IsClosable="False" Margin="0,0,0,6"
                            IsOpen="{Binding HeldWarning, Converter={StaticResource NotEmptyToBool}}">
                    <ui:InfoBar.Content>
                        <WrapPanel Margin="0,4,0,0">
                            <ui:Button Content="Keep my items (restore them everywhere)" Appearance="Primary" Command="{Binding KeepHeldCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Delete them here too" Command="{Binding ApplyHeldCommand}" />
                        </WrapPanel>
                    </ui:InfoBar.Content>
                </ui:InfoBar>
                <ui:InfoBar Title="Backup" Message="{Binding BackupWarning}" Severity="Warning" IsClosable="False" Margin="0,0,0,6"
                            IsOpen="{Binding BackupWarning, Converter={StaticResource NotEmptyToBool}}" />
                <ui:InfoBar Message="{Binding Error}" Severity="Error" IsClosable="False" Margin="0,0,0,6" IsOpen="{Binding Error, Converter={StaticResource NotEmptyToBool}}" />
            </StackPanel>

            <!-- The list: search over every tab, the two tabs with their own Create, sub-tabs, then the cards -->
            <DockPanel Grid.Row="1" DataContext="{Binding Items}">
                <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top" AutomationProperties.Name="Search" PlaceholderText="Search every tab" Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" />

                <Grid DockPanel.Dock="Top" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource {x:Type ToggleButton}}" GroupName="VaultTabs" MinWidth="150" Margin="0,0,6,0"
                                     Content="{Binding CredentialsHeader}" IsChecked="{Binding IsCredentialsTab}" AutomationProperties.Name="Credentials"
                                     ToolTip="Logins and tokens" />
                        <RadioButton Style="{StaticResource {x:Type ToggleButton}}" GroupName="VaultTabs" MinWidth="150"
                                     Content="{Binding OtherHeader}" IsChecked="{Binding IsOtherTab}" AutomationProperties.Name="Other"
                                     ToolTip="Info items: notes, cards, documents, pictures, with the fields you choose" />
                    </StackPanel>
                    <!-- Create: each tab makes its own kinds -->
                    <ui:DropDownButton Grid.Column="2" Content="New" Icon="{ui:SymbolIcon Add24}" AutomationProperties.Name="New credential"
                                       Visibility="{Binding IsCredentialsTab, Converter={StaticResource BoolToVisibility}}">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Header="Login" Command="{Binding NewCommand}" CommandParameter="{x:Static items:VaultItemKind.Login}" />
                                <MenuItem Header="Token (API key)" Command="{Binding NewCommand}" CommandParameter="{x:Static items:VaultItemKind.Token}" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                    </ui:DropDownButton>
                    <ui:Button Grid.Column="2" Content="New info" Icon="{ui:SymbolIcon Add24}" AutomationProperties.Name="New info"
                               Command="{Binding NewCommand}" CommandParameter="{x:Static items:VaultItemKind.Note}"
                               Visibility="{Binding IsOtherTab, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Sub-tabs -->
                <ListBox DockPanel.Dock="Top" Margin="0,8,0,4" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="Show" ItemContainerStyle="{StaticResource SubTab}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <!-- Favorites is a star, the trash a bin; the others their name -->
                        <DataTemplate DataType="{x:Type vm:VaultFilter}">
                            <Grid AutomationProperties.Name="{Binding}" ToolTip="{Binding}">
                                <TextBlock x:Name="Label" Text="{Binding}" />
                                <ui:SymbolIcon x:Name="Glyph" Visibility="Collapsed" FontSize="16" Margin="-2,1" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Static vm:VaultFilter.Favorites}">
                                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Glyph" Property="Symbol" Value="Star24" />
                                    <Setter TargetName="Glyph" Property="Filled" Value="True" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding}" Value="{x:Static vm:VaultFilter.Trash}">
                                    <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Glyph" Property="Symbol" Value="Delete24" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <TextBlock DockPanel.Dock="Bottom" Margin="4,6,4,0" Style="{DynamicResource HelmSecondaryText}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Visibility="{Binding UnreadableCount, Converter={StaticResource NotZeroToVisibility}}">
                    <Run Text="{Binding UnreadableCount, Mode=OneWay}" /><Run Text=" records cannot be opened with this vault's key; they are kept, not deleted." />
                </TextBlock>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CardList" ItemsSource="{Binding Cards}" Margin="0,4,0,0" AutomationProperties.Name="Items">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VaultCardViewModel}">
                                    <Border Style="{DynamicResource HelmSurface}" Padding="0" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <!-- The whole card is one button: click to open, click again to close. -->
                                                <Button Style="{StaticResource CardButton}" AutomationProperties.Name="{Binding Title}"
                                                        Command="{Binding DataContext.ToggleCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                <Grid Margin="14,10,10,10">
                                                    <Grid.Resources>
                                                        <!-- Text lets clicks through to the card button; only the copy/show buttons take them -->
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="IsHitTestVisible" Value="False" />
                                                        </Style>
                                                    </Grid.Resources>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- The icon: picture, initial or type -->
                                                    <ContentPresenter Grid.RowSpan="4" Content="{Binding}" ContentTemplate="{StaticResource CardAvatar}" Margin="0,0,14,0" VerticalAlignment="Center"
                                                                      IsHitTestVisible="False" />

                                                    <DockPanel Grid.Column="1" Grid.ColumnSpan="2">
                                                        <ui:SymbolIcon DockPanel.Dock="Right" Symbol="Warning24" Foreground="{DynamicResource SystemFillColorCautionBrush}" IsHitTestVisible="False"
                                                                       ToolTip="Edited on two devices: choose a version" Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisibility}}" />
                                                        <!-- Star: favorite or not, one click -->
                                                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="4" Margin="4,-4,0,-4"
                                                                   Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                                   ToolTip="Favorite" AutomationProperties.Name="Favorite"
                                                                   Visibility="{Binding Trashed, Converter={StaticResource InverseBoolToVisibility}}">
                                                            <ui:SymbolIcon Symbol="Star24" FontSize="16">
                                                                <ui:SymbolIcon.Style>
                                                                    <Style TargetType="ui:SymbolIcon">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Favorite}" Value="True">
                                                                                <Setter Property="Filled" Value="True" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:SymbolIcon.Style>
                                                            </ui:SymbolIcon>
                                                        </ui:Button>
                                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>

                                                    <!-- Login: username (copy) and password (show, copy) -->
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Username}" Style="{DynamicResource HelmSecondaryText}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" Visibility="{Binding HasUsername, Converter={StaticResource BoolToVisibility}}" />
                                                    <ui:Button Grid.Row="1" Grid.Column="2" Padding="6" Appearance="Transparent" Command="{Binding CopyUsernameCommand}"
                                                               ToolTip="Copy the username" AutomationProperties.Name="Copy the username" Visibility="{Binding HasUsername, Converter={StaticResource BoolToVisibility}}">
                                                        <ui:SymbolIcon>
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Symbol" Value="Copy24" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUsernameCopied}" Value="True"><Setter Property="Symbol" Value="Checkmark24" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </ui:Button>

                                                    <!-- Login password or token: hidden until shown, copy with feedback -->
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SecretDisplay}" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasSecret, Converter={StaticResource BoolToVisibility}}" />
                                                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Visibility="{Binding CanCopySecret, Converter={StaticResource BoolToVisibility}}">
                                                        <ui:Button Appearance="Transparent" Padding="6" Command="{Binding ToggleRevealCommand}" ToolTip="Show or hide" AutomationProperties.Name="Show or hide">
                                                            <ui:SymbolIcon>
                                                                <ui:SymbolIcon.Style>
                                                                    <Style TargetType="ui:SymbolIcon">
                                                                        <Setter Property="Symbol" Value="Eye24" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRevealed}" Value="True"><Setter Property="Symbol" Value="EyeOff24" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:SymbolIcon.Style>
                                                            </ui:SymbolIcon>
                                                        </ui:Button>
                                                        <ui:Button Margin="4,0,0,0" Padding="10,5" Command="{Binding CopyCommand}" ToolTip="{Binding CopyLabel}" AutomationProperties.Name="{Binding CopyLabel}">
                                                            <ui:Button.Style>
                                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                                    <Setter Property="Appearance" Value="Secondary" />
                                                                    <Setter Property="Icon" Value="{ui:SymbolIcon Copy24}" />
                                                                    <Setter Property="Content" Value="Copy" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                                            <Setter Property="Appearance" Value="Success" />
                                                                            <Setter Property="Icon" Value="{ui:SymbolIcon Checkmark24}" />
                                                                            <Setter Property="Content" Value="Copied" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:Button.Style>
                                                        </ui:Button>
                                                    </StackPanel>

                                                    <!-- Two-factor code: the current one, how long it lasts, copy with feedback -->
                                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0"
                                                                Visibility="{Binding HasTotp, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding TotpCode}" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   AutomationProperties.Name="One-time code" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding TotpSecondsLeft, StringFormat='{} · {0} s'}" Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <ui:Button Grid.Row="3" Grid.Column="2" Margin="0,2,0,0" Padding="10,5" Command="{Binding CopyTotpCommand}" HorizontalAlignment="Right"
                                                               ToolTip="Copy the one-time code" AutomationProperties.Name="Copy the one-time code"
                                                               Visibility="{Binding HasTotp, Converter={StaticResource BoolToVisibility}}">
                                                        <ui:Button.Style>
                                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                                <Setter Property="Appearance" Value="Secondary" />
                                                                <Setter Property="Icon" Value="{ui:SymbolIcon Copy24}" />
                                                                <Setter Property="Content" Value="Code" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTotpCopied}" Value="True">
                                                                        <Setter Property="Appearance" Value="Success" />
                                                                        <Setter Property="Icon" Value="{ui:SymbolIcon Checkmark24}" />
                                                                        <Setter Property="Content" Value="Copied" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                    </ui:Button>

                                                    <!-- Info: its description, two lines at most -->
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Description}" Style="{DynamicResource HelmSecondaryText}"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,2,0,0"
                                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Grid>

                                            <!-- The open card: its detail right below it -->
                                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="14,10,14,14"
                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                                <ContentControl Content="{Binding DataContext.Detail, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <ContentControl.ContentTemplate>
                                                        <DataTemplate DataType="{x:Type vm:ItemDetailViewModel}">
                                                            <local:ItemDetailView />
                                                        </DataTemplate>
                                                    </ContentControl.ContentTemplate>
                                                </ContentControl>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Nothing here yet. Use New to add one." Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap"
                               Margin="8,24" TextAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </DockPanel>

            <!-- The editor, above the list (in this window, so it is hidden from screen capture like the rest of the vault) -->
            <Grid Grid.RowSpan="2" Visibility="{Binding Items.IsEditorOpen, Converter={StaticResource BoolToVisibility}}" Background="#99000000">
                <Grid.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding Items.Detail.CancelCommand}" />
                </Grid.InputBindings>
                <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"
                        MaxWidth="860" Margin="24" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
                    </Border.Effect>
                    <ContentControl Content="{Binding Items.Detail}" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource EditorHeight}}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:ItemDetailViewModel}">
                                <local:ItemEditorView />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ Emergency Kit (after the vault or a new recovery key is created) ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource SmokeFillColorDefaultBrush}" Visibility="{Binding HasKit, Converter={StaticResource BoolToVisibility}}">
            <!-- Solid, not the translucent card fill: nothing of the vault may show through the kit. -->
            <Border Style="{StaticResource CenteredCard}" MaxWidth="620" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}">
                <StackPanel>
                    <ui:SymbolIcon Symbol="BookInformation24" FontSize="36" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Save your Emergency Kit" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <TextBlock Style="{DynamicResource HelmSecondaryText}" FontSize="13"
                               Text="This recovery key is the only way back into the vault if you forget its password. It is shown only now. Print it (or print to PDF and keep the file offline), then type it below to confirm." />
                    <TextBox Margin="0,16,0,0" AutomationProperties.Name="Your recovery key" IsReadOnly="True" FontFamily="Consolas" FontSize="15" TextWrapping="Wrap" Text="{Binding Kit.RecoveryKey, Mode=OneWay}" />
                    <TextBlock Margin="0,6,0,0" Style="{DynamicResource HelmSecondaryText}">
                        <Run Text="Recovery key id: " /><Run Text="{Binding Kit.RecoveryId, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <ui:Button Content="Print the Emergency Kit…" Icon="{ui:SymbolIcon Print24}" Margin="0,12,0,0" Command="{Binding SaveKitCommand}" />
                    <TextBlock Text="Type the recovery key to confirm you saved it" Margin="0,16,0,4" />
                    <ui:TextBox AutomationProperties.Name="Confirm the recovery key" FontFamily="Consolas" Text="{Binding KitConfirmation, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="HELMV-…" />
                    <ui:InfoBar Margin="0,8,0,0" IsOpen="{Binding KitError, Converter={StaticResource NotEmptyToBool}}" Message="{Binding KitError}" Severity="Error" IsClosable="False" />
                    <ui:Button Content="I saved it" Appearance="Primary" Margin="0,12,0,0" HorizontalAlignment="Stretch" Command="{Binding ConfirmKitCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
