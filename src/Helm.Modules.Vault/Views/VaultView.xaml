<!-- The vault itself: setup, unlock, the item list and the Emergency Kit. Hosted by VaultContentPage in Helm's
     main window (the navigation pane and Home Quick access open it; its settings are a separate page). -->
<UserControl x:Class="Helm.Modules.Vault.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Helm.Modules.Vault.ViewModels;assembly=Helm.Modules.Vault.Core"
             xmlns:items="clr-namespace:Helm.Modules.Vault.Items;assembly=Helm.Modules.Vault.Core"
             xmlns:local="clr-namespace:Helm.Modules.Vault.Views">
    <UserControl.Resources>
        <local:NotEmptyToBoolConverter x:Key="NotEmptyToBool" />
        <local:NotZeroToVisibilityConverter x:Key="NotZeroToVisibility" />
        <local:KindIconConverter x:Key="KindIcon" />
        <local:BytesToImageConverter x:Key="BytesToImage" />

        <local:EditorHeightConverter x:Key="EditorHeight" />

        <!-- The avatar of a login card: the item's picture, or its initial on a stable color. -->
        <!-- Every card's icon: its picture; else a login's initial on its colour, or the type's symbol (token, note, card…). -->
        <DataTemplate x:Key="CardAvatar" DataType="{x:Type vm:VaultCardViewModel}">
            <Grid Width="40" Height="40">
                <Border x:Name="Letter" CornerRadius="10" Background="{Binding AvatarColor, Converter={StaticResource HexToBrush}}" Visibility="Collapsed">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border x:Name="Symbol" CornerRadius="10" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="{Binding Kind, Converter={StaticResource KindIcon}}" FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="10" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Icon, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasIcon}" Value="False" />
                        <Condition Binding="{Binding IsLogin}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Letter" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasIcon}" Value="False" />
                        <Condition Binding="{Binding IsLogin}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Symbol" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <local:SectionIconConverter x:Key="SectionIcon" />
        <local:NullToVisibilityConverter x:Key="NullToVisible" />
        <local:NullToVisibilityConverter x:Key="NotNullToVisible" Invert="True" />

        <!-- A section in the left column: icon, name, count; the chosen one is filled and marked with the accent -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="0,1">
                            <Border x:Name="Bd" CornerRadius="6" Padding="10,0" MinHeight="36" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Mark" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NavItem" DataType="{x:Type vm:VaultSection}">
            <Button Style="{StaticResource NavButton}" ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                    Command="{Binding DataContext.Items.ShowSectionCommand, RelativeSource={RelativeSource AncestorType=local:VaultView}}" CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="{Binding Kind, Converter={StaticResource SectionIcon}}" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsCompactNav, RelativeSource={RelativeSource AncestorType=local:VaultView}, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" FontWeight="Normal" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding IsCompactNav, RelativeSource={RelativeSource AncestorType=local:VaultView}, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!-- A section as a chip (narrow window): a pill, outlined in the accent when chosen -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Padding="12,0" Height="32" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChipItem" DataType="{x:Type vm:VaultSection}">
            <Button Style="{StaticResource ChipButton}" AutomationProperties.Name="{Binding Label}"
                    Command="{Binding DataContext.Items.ShowSectionCommand, RelativeSource={RelativeSource AncestorType=local:VaultView}}" CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="{Binding Kind, Converter={StaticResource SectionIcon}}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- A row of the list: hover and selection fill, the accent mark on the chosen one -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1">
                            <Border x:Name="Bd" CornerRadius="8" Padding="10,8" MinHeight="56" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Mark" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CenteredCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="28,24" />
            <Setter Property="MaxWidth" Value="460" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <!-- ============ Setup: create a vault, or restore one from a backup ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSetup, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CenteredCard}" Margin="16">
                <StackPanel>
                    <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="40" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Create your vault" FontSize="22" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <TextBlock Style="{DynamicResource HelmSecondaryText}" FontSize="13"
                               Text="Choose a vault password you will remember. It is different from your sync passphrase, and nobody — not Helm, not the server — can reset it. You also get a recovery key to print and keep safe." />
                    <ui:HyperlinkButton Content="New to Vault? Read the guide first" Padding="0" Margin="0,6,0,0" Command="{Binding ShowGuideCommand}" />
                    <TextBlock Text="Vault password" Margin="0,16,0,4" />
                    <ui:PasswordBox x:Name="NewPasswordBox" AutomationProperties.Name="Vault password" Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="At least 14 characters" />
                    <TextBlock Text="{Binding PasswordStrength}" Style="{DynamicResource HelmSecondaryText}" Margin="0,4,0,0" />
                    <TextBlock Text="Type it again" Margin="0,12,0,4" />
                    <ui:PasswordBox AutomationProperties.Name="Type it again" Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:InfoBar Margin="0,12,0,0" IsOpen="{Binding Error, Converter={StaticResource NotEmptyToBool}}" Message="{Binding Error}" Severity="Error" IsClosable="False" />
                    <ui:Button Content="Create vault" Appearance="Primary" Margin="0,16,0,0" HorizontalAlignment="Stretch" Command="{Binding CreateCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" IsDefault="True" />
                    <ui:ProgressRing IsIndeterminate="True" Height="24" Width="24" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <Separator Margin="0,20" />
                    <TextBlock Text="Have a backup?" FontWeight="SemiBold" />
                    <TextBlock Style="{DynamicResource HelmSecondaryText}" Margin="0,2,0,8"
                               Text="Restore the whole vault from a backup folder, with that vault's password or its recovery key." />
                    <CheckBox Content="Use the recovery key instead of the password" IsChecked="{Binding UseRecoveryKey}" />
                    <ui:PasswordBox Margin="0,8,0,0" AutomationProperties.Name="Vault password of the backup" PlaceholderText="Vault password of the backup" Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding UseRecoveryKey, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ui:TextBox Margin="0,8,0,0" AutomationProperties.Name="Recovery key of the backup" PlaceholderText="HELMV-XXXX-XXXX-…" FontFamily="Consolas" Text="{Binding RecoveryKey, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding UseRecoveryKey, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Restore from a backup folder…" Margin="0,8,0,0" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Command="{Binding RestoreFromBackupCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ============ Unlock: Windows Hello first, else the password (or the recovery key) ============ -->
        <Border Grid.Row="1" Style="{StaticResource CenteredCard}" Width="400" Padding="28,28,28,20" Visibility="{Binding IsUnlock, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Left" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="26" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Vault is locked" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap" Margin="0,0,0,20"
                           Text="Your passwords and documents are encrypted on this device." />
                <ui:Button Content="{Binding DeviceUnlockName}" Icon="{ui:SymbolIcon Fingerprint24}" Appearance="Primary" HorizontalAlignment="Stretch" Height="42"
                           Command="{Binding QuickUnlockCommand}" Visibility="{Binding CanUseDeviceUnlock, Converter={StaticResource BoolToVisibility}}" />
                <Grid Margin="0,16" Visibility="{Binding CanUseDeviceUnlock, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Separator VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="10,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="or type the vault password" />
                    <Separator Grid.Column="2" VerticalAlignment="Center" />
                </Grid>
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Vault password" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UseRecoveryKey}" Value="True"><Setter Property="Text" Value="Recovery key" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ui:PasswordBox x:Name="UnlockPasswordBox" AutomationProperties.Name="Vault password" Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding UseRecoveryKey, Converter={StaticResource InverseBoolToVisibility}}" />
                <ui:TextBox AutomationProperties.Name="Recovery key" PlaceholderText="HELMV-XXXX-XXXX-…" FontFamily="Cascadia Mono, Consolas" Text="{Binding RecoveryKey, UpdateSourceTrigger=PropertyChanged}"
                            Visibility="{Binding UseRecoveryKey, Converter={StaticResource BoolToVisibility}}" />
                <!-- What went wrong, right under the box -->
                <DockPanel Margin="0,8,0,0" Visibility="{Binding Error, Converter={StaticResource NotEmptyToVisibility}}">
                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="16" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" Margin="0,1,6,0" />
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Assertive" />
                </DockPanel>
                <ui:Button Content="Unlock" Margin="0,12,0,0" HorizontalAlignment="Stretch" Height="38" Command="{Binding UnlockCommand}" IsDefault="True"
                           IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Secondary" />
                            <Style.Triggers>
                                <!-- Without Windows Hello, Unlock is the main button -->
                                <DataTrigger Binding="{Binding CanUseDeviceUnlock}" Value="False"><Setter Property="Appearance" Value="Primary" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:ProgressRing IsIndeterminate="True" Height="22" Width="22" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <!-- The recovery key instead of the password (and back) -->
                <Button Margin="0,18,0,0" HorizontalAlignment="Left" Command="{Binding ToggleRecoveryKeyCommand}" Cursor="Hand" AutomationProperties.Name="Use the recovery key instead of the password">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="Text" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Forgot it? Use the recovery key" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UseRecoveryKey}" Value="True"><Setter Property="Text" Value="Use the password" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Text" Property="TextDecorations" Value="Underline" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Text" Property="TextDecorations" Value="Underline" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ After a recovery-key unlock: a new password first ============ -->
        <Border Grid.Row="1" Style="{StaticResource CenteredCard}" Width="440" Visibility="{Binding MustChangePassword, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Set a new vault password" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Style="{DynamicResource HelmSecondaryText}" FontSize="13" Margin="0,4,0,12"
                           Text="You unlocked with the recovery key. Choose a new password; the recovery key keeps working." />
                <ui:PasswordBox AutomationProperties.Name="New password" PlaceholderText="New password" Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding PasswordStrength}" Style="{DynamicResource HelmSecondaryText}" Margin="0,4,0,8" />
                <ui:PasswordBox AutomationProperties.Name="New password again" PlaceholderText="Type it again" Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ui:InfoBar Margin="0,12,0,0" IsOpen="{Binding Error, Converter={StaticResource NotEmptyToBool}}" Message="{Binding Error}" Severity="Error" IsClosable="False" />
                <ui:Button Content="Set password" Appearance="Primary" Margin="0,12,0,0" HorizontalAlignment="Stretch" Command="{Binding SetNewPasswordCommand}" />
            </StackPanel>
        </Border>

        <!-- ============ The vault: sections | items | the selected item ============ -->
        <Grid Grid.Row="1" Visibility="{Binding IsItems, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Warnings that must not be missed -->
            <StackPanel Margin="0,0,0,4">
                <ui:InfoBar Title="Sync is holding back deletions" Message="{Binding HeldWarning}" Severity="Warning" IsClosable="False" Margin="0,0,0,6"
                            IsOpen="{Binding HeldWarning, Converter={StaticResource NotEmptyToBool}}">
                    <ui:InfoBar.Content>
                        <WrapPanel Margin="0,4,0,0">
                            <ui:Button Content="Keep my items (restore them everywhere)" Appearance="Primary" Command="{Binding KeepHeldCommand}" Margin="0,0,8,0" />
                            <ui:Button Content="Delete them here too" Command="{Binding ApplyHeldCommand}" />
                        </WrapPanel>
                    </ui:InfoBar.Content>
                </ui:InfoBar>
                <ui:InfoBar Title="Backup" Message="{Binding BackupWarning}" Severity="Warning" IsClosable="False" Margin="0,0,0,6"
                            IsOpen="{Binding BackupWarning, Converter={StaticResource NotEmptyToBool}}" />
                <ui:InfoBar Title="Weak vault password" Message="{Binding WeakPasswordWarning}" Severity="Warning" IsClosable="False" Margin="0,0,0,6"
                            IsOpen="{Binding WeakPasswordWarning, Converter={StaticResource NotEmptyToBool}}">
                    <ui:InfoBar.Content>
                        <ui:Button Content="Change the password…" Appearance="Primary" Margin="0,4,0,0"
                                   Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Page}}" />
                    </ui:InfoBar.Content>
                </ui:InfoBar>
                <ui:InfoBar Message="{Binding Error}" Severity="Error" IsClosable="False" Margin="0,0,0,6" IsOpen="{Binding Error, Converter={StaticResource NotEmptyToBool}}" />
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" ClipToBounds="True"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <Grid x:Name="Panes">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="NavColumn" Width="216" />
                        <ColumnDefinition x:Name="ListColumn" Width="340" />
                        <ColumnDefinition x:Name="DetailColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sections: kinds, tags, the trash, and how the backup is doing -->
                    <Border x:Name="NavPane" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,10">
                                <ContentControl Content="{Binding Items.TrashSection}" ContentTemplate="{StaticResource NavItem}" Focusable="False" />
                                <Border x:Name="BackupCard" Margin="0,8,0,0" Padding="10,8" CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        ToolTip="{Binding BackupDetail}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon FontSize="16" Margin="0,0,6,0">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="CloudCheckmark24" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BackupOk}" Value="False">
                                                                <Setter Property="Symbol" Value="CloudError24" />
                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock x:Name="BackupTitleText" Text="{Binding BackupTitle}" FontWeight="SemiBold" FontSize="12.5" />
                                        </StackPanel>
                                        <TextBlock x:Name="BackupDetailText" Text="{Binding BackupDetail}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="8,10,8,4">
                                    <ItemsControl ItemsSource="{Binding Items.Sections}" ItemTemplate="{StaticResource NavItem}" Focusable="False" />
                                    <TextBlock x:Name="TagsHeader" Text="TAGS" FontSize="11" FontWeight="SemiBold" Margin="10,14,0,4"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding Items.HasTags, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Items.TagSections}" ItemTemplate="{StaticResource NavItem}" Focusable="False" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Items of the section: search, New, the list -->
                    <Border x:Name="ListPane" Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <DockPanel DataContext="{Binding Items}">
                            <!-- On a narrow window the sections are a row of chips here instead of a column -->
                            <Grid x:Name="ChipRow" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,8,0,0">
                                <ScrollViewer x:Name="ChipScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">
                                    <StackPanel Orientation="Horizontal" Margin="10,0">
                                        <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource ChipItem}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding TagSections}" ItemTemplate="{StaticResource ChipItem}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <ContentControl Content="{Binding TrashSection}" ContentTemplate="{StaticResource ChipItem}" Focusable="False" />
                                    </StackPanel>
                                </ScrollViewer>
                                <ui:Button x:Name="ChipLeft" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" HorizontalAlignment="Left" Margin="4,0,0,0" Padding="6" Icon="{ui:SymbolIcon ChevronLeft24}" Visibility="Collapsed"
                                           AutomationProperties.Name="Scroll the sections left" Focusable="False" />
                                <ui:Button x:Name="ChipRight" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6" Icon="{ui:SymbolIcon ChevronRight24}" Visibility="Collapsed"
                                           AutomationProperties.Name="Scroll the sections right" Focusable="False" />
                            </Grid>

                            <DockPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                                <ui:Button DockPanel.Dock="Right" Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="New"
                                           AutomationProperties.Name="New item" ToolTip="Add a login, token, note, card, identity or document"
                                           Command="{Binding NewCommand}" CommandParameter="{x:Static items:VaultItemKind.Login}" />
                                <ui:TextBox x:Name="SearchBox" AutomationProperties.Name="Search" PlaceholderText="Search (Ctrl+F)" Icon="{ui:SymbolIcon Search24}"
                                            ClearButtonEnabled="True" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                            </DockPanel>

                            <TextBlock DockPanel.Dock="Bottom" Margin="14,4,14,10" Style="{DynamicResource HelmSecondaryText}" TextWrapping="Wrap"
                                       Visibility="{Binding HasUnreadable, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="{Binding UnreadableCount, Mode=OneWay}" /><Run Text=" item(s) were made by a newer Helm or could not be opened. They are kept untouched." />
                            </TextBlock>

                            <Grid>
                                <ListBox x:Name="ItemList" ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource RowItem}" Background="Transparent" BorderThickness="0" Padding="6,0,6,6"
                                         AutomationProperties.Name="Items" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:VaultCardViewModel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CardAvatar}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <ui:SymbolIcon Symbol="Warning24" FontSize="14" Margin="6,0,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                                       ToolTip="Edited on two devices: open it to choose a version"
                                                                       Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasTotp, Converter={StaticResource BoolToVisibility}}"
                                                                ToolTip="{Binding TotpSecondsLeft, StringFormat='Two-factor code · {0} s left'}">
                                                        <TextBlock Text="{Binding TotpCode}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding TotpEndingSoon}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ui:ProgressRing Width="14" Height="14" Margin="6,0,0,0" IsIndeterminate="False" Progress="{Binding TotpProgress, Mode=OneWay}" />
                                                    </StackPanel>
                                                    <ui:SymbolIcon Symbol="Star24" Filled="True" FontSize="15" Margin="8,0,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   AutomationProperties.Name="Favorite" Visibility="{Binding Favorite, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel VerticalAlignment="Top" Margin="20,24" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <ui:Button Content="Search all items" Margin="0,10,0,0" HorizontalAlignment="Center" Command="{Binding SearchEverywhereCommand}"
                                               Visibility="{Binding CanSearchEverywhere, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- The selected item -->
                    <Grid x:Name="DetailPane" Grid.Column="2">
                        <TextBlock Text="Choose an item, or press New." HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding Items.Detail, Converter={StaticResource NullToVisible}}" />
                        <DockPanel Visibility="{Binding Items.Detail, Converter={StaticResource NotNullToVisible}}">
                            <ui:Button x:Name="BackButton" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="12,10,0,0" Appearance="Transparent"
                                       Icon="{ui:SymbolIcon ArrowLeft24}" Content="Back" AutomationProperties.Name="Back to the list" Visibility="Collapsed"
                                       Command="{Binding Items.CloseDetailCommand}" />
                            <ScrollViewer x:Name="DetailScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ContentControl Content="{Binding Items.Detail}" Focusable="False" HorizontalAlignment="Stretch">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate DataType="{x:Type vm:ItemDetailViewModel}">
                                            <local:ItemDetailView />
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- The editor pop-up, over the vault (in this window, so it is hidden from screen capture like the rest of the vault) -->
            <Grid Grid.RowSpan="2" Visibility="{Binding Items.IsEditorOpen, Converter={StaticResource BoolToVisibility}}" Background="#99000000">
                <Grid.InputBindings>
                    <KeyBinding Key="Escape" Command="{Binding Items.Editor.CancelCommand}" />
                </Grid.InputBindings>
                <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                        MaxWidth="760" Margin="24" VerticalAlignment="Center" ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" />
                    </Border.Effect>
                    <ContentControl Content="{Binding Items.Editor}" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource EditorHeight}}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:ItemDetailViewModel}">
                                <local:ItemEditorView />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ Emergency Kit (after the vault or a new recovery key is created) ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource SmokeFillColorDefaultBrush}" Visibility="{Binding HasKit, Converter={StaticResource BoolToVisibility}}">
            <!-- Solid, not the translucent card fill: nothing of the vault may show through the kit. -->
            <Border Style="{StaticResource CenteredCard}" MaxWidth="620" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}">
                <StackPanel>
                    <ui:SymbolIcon Symbol="BookInformation24" FontSize="36" HorizontalAlignment="Left" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Save your Emergency Kit" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,4" />
                    <TextBlock Style="{DynamicResource HelmSecondaryText}" FontSize="13"
                               Text="This recovery key is the only way back into the vault if you forget its password. It is shown only now. Print it (or print to PDF and keep the file offline), then type it below to confirm." />
                    <TextBox Margin="0,16,0,0" AutomationProperties.Name="Your recovery key" IsReadOnly="True" FontFamily="Consolas" FontSize="15" TextWrapping="Wrap" Text="{Binding Kit.RecoveryKey, Mode=OneWay}" />
                    <TextBlock Margin="0,6,0,0" Style="{DynamicResource HelmSecondaryText}">
                        <Run Text="Recovery key id: " /><Run Text="{Binding Kit.RecoveryId, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <ui:Button Content="Print the Emergency Kit…" Icon="{ui:SymbolIcon Print24}" Margin="0,12,0,0" Command="{Binding SaveKitCommand}" />
                    <TextBlock Text="Type the recovery key to confirm you saved it" Margin="0,16,0,4" />
                    <ui:TextBox AutomationProperties.Name="Confirm the recovery key" FontFamily="Consolas" Text="{Binding KitConfirmation, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="HELMV-…" />
                    <ui:InfoBar Margin="0,8,0,0" IsOpen="{Binding KitError, Converter={StaticResource NotEmptyToBool}}" Message="{Binding KitError}" Severity="Error" IsClosable="False" />
                    <ui:Button Content="I saved it" Appearance="Primary" Margin="0,12,0,0" HorizontalAlignment="Stretch" Command="{Binding ConfirmKitCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
