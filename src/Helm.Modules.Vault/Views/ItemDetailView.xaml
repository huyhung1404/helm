<UserControl x:Class="Helm.Modules.Vault.Views.ItemDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Helm.Modules.Vault.ViewModels;assembly=Helm.Modules.Vault.Core"
             xmlns:items="clr-namespace:Helm.Modules.Vault.Items;assembly=Helm.Modules.Vault.Core"
             xmlns:local="clr-namespace:Helm.Modules.Vault.Views">
    <UserControl.Resources>
        <local:NotEmptyToBoolConverter x:Key="NotEmptyToBool" />
        <local:KindIconConverter x:Key="KindIcon" />
        <local:BytesToImageConverter x:Key="BytesToImage" />
    </UserControl.Resources>

    <!-- The detail of an open card, shown below it in the list (read only; Edit opens the editor above the list).
         The card itself shows the title, so this view does not repeat it. -->
    <StackPanel Margin="0,4,0,0">
        <!-- Actions -->
        <WrapPanel HorizontalAlignment="Right">
            <ui:Button Content="Edit" Icon="{ui:SymbolIcon Edit24}" Margin="4,0,0,0" Command="{Binding EditCommand}"
                       Visibility="{Binding Trashed, Converter={StaticResource InverseBoolToVisibility}}" />
            <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="Move to the trash" AutomationProperties.Name="Move to the trash" Margin="4,0,0,0"
                       Command="{Binding MoveToTrashCommand}" Visibility="{Binding Trashed, Converter={StaticResource InverseBoolToVisibility}}" />
            <ui:Button Content="Restore" Icon="{ui:SymbolIcon ArrowCounterclockwise24}" Appearance="Primary" Margin="4,0,0,0" Command="{Binding RestoreFromTrashCommand}"
                       Visibility="{Binding Trashed, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button Content="Delete for good" Appearance="Danger" Margin="4,0,0,0" Command="{Binding DeleteForeverCommand}"
                       Visibility="{Binding Trashed, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>

        <ui:InfoBar Margin="0,12,0,0" Severity="Error" IsClosable="False" Message="{Binding Error}" IsOpen="{Binding Error, Converter={StaticResource NotEmptyToBool}}" />
        <ui:InfoBar Margin="0,12,0,0" Severity="Informational" IsClosable="False" Title="In the trash"
                    Message="This item is deleted for good after 30 days in the trash. Restore it to edit it."
                    IsOpen="{Binding Trashed}" />

        <!-- Conflicts: the same item was edited on two devices -->
            <Border Style="{DynamicResource HelmSurface}" Margin="0,12,0,0" Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Edited on two devices" FontWeight="SemiBold" />
                    <TextBlock Style="{DynamicResource HelmSecondaryText}" Margin="0,2,0,8"
                               Text="Both versions are kept. Choose the one to keep; the other goes into the history, so nothing is lost." />
                    <ui:Button Content="Keep the version shown here" Margin="0,0,0,8" Command="{Binding KeepCurrentCommand}" />
                    <ItemsControl ItemsSource="{Binding Conflicts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConflictViewModel}">
                                <DockPanel Margin="0,4">
                                    <ui:Button DockPanel.Dock="Right" Content="Keep this one" Command="{Binding KeepThisCommand}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding When}" />
                                        <TextBlock Text="{Binding Summary}" Style="{DynamicResource HelmSecondaryText}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        <!-- Fields: name above the value, show/hide and copy on the right -->
        <ItemsControl ItemsSource="{Binding Fields}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:FieldViewModel}">
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button ToolTip="Show or hide" AutomationProperties.Name="Show or hide" Command="{Binding ToggleRevealCommand}" Appearance="Transparent"
                                       Visibility="{Binding IsSecret, Converter={StaticResource BoolToVisibility}}">
                                <ui:SymbolIcon>
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Eye24" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRevealed}" Value="True"><Setter Property="Symbol" Value="EyeOff24" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </ui:Button>
                            <ui:Button Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy" AutomationProperties.Name="Copy" Command="{Binding CopyCommand}" Appearance="Transparent"
                                       Visibility="{Binding CanCopy, Converter={StaticResource BoolToVisibility}}" />
                            <!-- A file: open it, or save a copy -->
                            <ui:Button Icon="{ui:SymbolIcon Open24}" ToolTip="Open" AutomationProperties.Name="Open" Command="{Binding OpenFileCommand}" Appearance="Transparent"
                                       Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Icon="{ui:SymbolIcon ArrowDownload24}" ToolTip="Save a copy…" AutomationProperties.Name="Save a copy" Command="{Binding SaveFileCommand}" Appearance="Transparent"
                                       Visibility="{Binding HasFile, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{DynamicResource HelmSecondaryText}" />
                            <TextBlock AutomationProperties.Name="{Binding Name}" Text="{Binding Display}" TextWrapping="Wrap" FontSize="14" Margin="0,2,0,0"
                                       Visibility="{Binding IsValueField, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock AutomationProperties.Name="{Binding Name}" Text="{Binding FileText}" TextWrapping="Wrap" FontSize="14" Margin="0,2,0,0"
                                       Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}" />
                            <Image Margin="0,6,0,0" MaxHeight="200" HorizontalAlignment="Left" Stretch="Uniform"
                                   Source="{Binding Preview, Converter={StaticResource BytesToImage}, ConverterParameter=480}" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Description (Info) or notes, and tags -->
        <StackPanel Visibility="{Binding Notes, Converter={StaticResource NotEmptyToVisibility}}">
            <TextBlock Text="{Binding NotesLabel}" Style="{DynamicResource HelmSectionHeader}" />
            <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Margin="0,6,0,0" Style="{DynamicResource HelmSecondaryText}" Text="{Binding Tags}" Visibility="{Binding Tags, Converter={StaticResource NotEmptyToVisibility}}" />

        <!-- Files are fields now (Image, Document, Text file, Keystore): opening one shows progress here -->
        <ProgressBar Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- History -->
        <Expander Margin="0,16,0,0" Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}">
            <Expander.Header>
                <TextBlock><Run Text="History (" /><Run Text="{Binding History.Count, Mode=OneWay}" /><Run Text=" earlier versions)" /></TextBlock>
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding History}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:VersionViewModel}">
                        <DockPanel Margin="0,4">
                            <ui:Button DockPanel.Dock="Right" Content="Restore" Command="{Binding RestoreCommand}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding When}" />
                                <TextBlock Text="{Binding Summary}" Style="{DynamicResource HelmSecondaryText}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
        <TextBlock Margin="0,12,0,0" Text="{Binding Modified}" Style="{DynamicResource HelmSecondaryText}" />
    </StackPanel>
</UserControl>
