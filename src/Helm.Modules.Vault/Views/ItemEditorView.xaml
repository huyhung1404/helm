<!-- Adding or editing an item: the pop-up over the vault (VaultView), never in the list or the detail itself. A kind
     picker (chips for a new item, a drop-down for an existing one), then one row per field: [type] [name] [value] [x]. -->
<UserControl x:Class="Helm.Modules.Vault.Views.ItemEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Helm.Modules.Vault.ViewModels;assembly=Helm.Modules.Vault.Core"
             xmlns:items="clr-namespace:Helm.Modules.Vault.Items;assembly=Helm.Modules.Vault.Core"
             xmlns:local="clr-namespace:Helm.Modules.Vault.Views">
    <UserControl.Resources>
        <local:NotEmptyToBoolConverter x:Key="NotEmptyToBool" />
        <local:BytesToImageConverter x:Key="BytesToImage" />
        <local:KindIconConverter x:Key="KindIcon" />

        <!-- A kind of a new item: a pill with its symbol, outlined in the accent when chosen -->
        <Style x:Key="KindChip" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="16" Padding="12,6" BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{Binding Kind, Converter={StaticResource KindIcon}}" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- "New item" / "Edit GitHub", and a way out -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="20,10,10,10"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Close without saving (Esc)"
                           AutomationProperties.Name="Close without saving" Command="{Binding CancelCommand}" />
                <TextBlock Text="{Binding EditorTitle}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Save / Cancel stay visible however long the item is -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="20,12"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Cancel" Margin="0,0,8,0" Command="{Binding CancelCommand}" MinWidth="90" />
                    <ui:Button Icon="{ui:SymbolIcon Checkmark24}" Appearance="Primary" Command="{Binding SaveCommand}" MinWidth="90">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Content" Value="Save" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNew}" Value="True"><Setter Property="Content" Value="Create" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </StackPanel>
                <ui:InfoBar Severity="Error" IsClosable="False" Message="{Binding Error}" IsOpen="{Binding Error, Converter={StaticResource NotEmptyToBool}}" Margin="0,0,12,0" />
                <TextBlock Style="{DynamicResource HelmSecondaryText}" VerticalAlignment="Center" Text="The current version goes into the history."
                           Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,18,20,16">
                <!-- What a new item is: its usual fields follow the choice while nothing is typed -->
                <ListBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding KindOption}" ItemContainerStyle="{StaticResource KindChip}"
                         Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,10" AutomationProperties.Name="Kind of item"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <!-- Picture and title -->
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="48" Height="48" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border CornerRadius="12" Background="{Binding AvatarColor, Converter={StaticResource HexToBrush}}"
                                Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="12" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Icon, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ui:TextBox x:Name="TitleBox" AutomationProperties.Name="Title" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Title" FontSize="16" VerticalAlignment="Center" />
                </DockPanel>
                <WrapPanel Margin="62,10,0,0">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsNew, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="Kind" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding KindOption}" DisplayMemberPath="Label" MinWidth="120" Margin="0,0,16,0"
                                  VerticalAlignment="Center" AutomationProperties.Name="Kind" ToolTip="Where the item is listed. Its fields stay as they are." />
                    </StackPanel>
                    <CheckBox Content="Favorite" IsChecked="{Binding Favorite}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <ui:Button Content="Choose icon…" Icon="{ui:SymbolIcon ImageAdd24}" Command="{Binding ChooseIconCommand}" Margin="0,0,8,0"
                               ToolTip="A picture for this item (PNG, JPEG or WebP up to 256 KB). It is encrypted with the item." />
                    <ui:Button Content="Remove icon" Icon="{ui:SymbolIcon ImageOff24}" Appearance="Transparent" Command="{Binding RemoveIconCommand}"
                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                </WrapPanel>

                <!-- Fields: one row each -->
                <TextBlock Text="Fields" Style="{DynamicResource HelmSectionHeader}" />
                <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FieldViewModel}">
                            <Grid Margin="0,0,0,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox AutomationProperties.Name="Field type" ItemsSource="{Binding Owner.FieldKinds}" SelectedItem="{Binding Kind}" VerticalAlignment="Top" />
                                <ui:TextBox Grid.Column="1" Margin="6,0,0,0" AutomationProperties.Name="Field name" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Name" VerticalAlignment="Top" />
                                <!-- A file: its name and size, a picture's preview, and Choose / Replace -->
                                <StackPanel Grid.Column="2" Margin="6,0,0,0" Visibility="{Binding IsFile, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding ChooseFileCommand}" AutomationProperties.Name="Choose file">
                                            <ui:Button.Style>
                                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                    <Setter Property="Content" Value="Choose file…" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasFile}" Value="True"><Setter Property="Content" Value="Replace…" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:Button.Style>
                                        </ui:Button>
                                        <TextBlock Text="{Binding FileText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{DynamicResource HelmSecondaryText}" />
                                    </DockPanel>
                                    <Image Margin="0,6,0,0" MaxHeight="120" HorizontalAlignment="Left" Stretch="Uniform"
                                           Source="{Binding Preview, Converter={StaticResource BytesToImage}, ConverterParameter=480}" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <Grid Grid.Column="2" Margin="6,0,0,0" Visibility="{Binding IsValueField, Converter={StaticResource BoolToVisibility}}">
                                    <!-- Hidden: a password box; shown (the eye) or not secret: a text box -->
                                    <ui:PasswordBox AutomationProperties.Name="{Binding Name}" Password="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RevealButtonEnabled="False" VerticalAlignment="Top">
                                        <ui:PasswordBox.Style>
                                            <Style TargetType="ui:PasswordBox" BasedOn="{StaticResource {x:Type ui:PasswordBox}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSecret}" Value="True" />
                                                            <Condition Binding="{Binding IsRevealed}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:PasswordBox.Style>
                                    </ui:PasswordBox>
                                    <ui:TextBox AutomationProperties.Name="{Binding Name}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap"
                                                PlaceholderText="Value" VerticalAlignment="Top">
                                        <ui:TextBox.Style>
                                            <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsSecret}" Value="True" />
                                                            <Condition Binding="{Binding IsRevealed}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:TextBox.Style>
                                    </ui:TextBox>
                                </Grid>
                                <!-- A two-factor key that gives no code, or its current code as a check -->
                                <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           Text="{Binding TotpError}" Visibility="{Binding HasTotpError, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,4,0,0" Style="{DynamicResource HelmSecondaryText}"
                                           Text="{Binding TotpCode, StringFormat='Current code: {0}'}" Visibility="{Binding HasTotpCode, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                                    <ui:Button Appearance="Transparent" Margin="2,0,0,0" Command="{Binding ToggleRevealCommand}" ToolTip="Show or hide" AutomationProperties.Name="Show or hide"
                                               Visibility="{Binding IsSecret, Converter={StaticResource BoolToVisibility}}">
                                        <ui:SymbolIcon>
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Eye24" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRevealed}" Value="True"><Setter Property="Symbol" Value="EyeOff24" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </ui:Button>
                                    <ui:Button Icon="{ui:SymbolIcon Wand24}" ToolTip="Generate a strong password" AutomationProperties.Name="Generate a strong password" Command="{Binding GenerateCommand}" Appearance="Transparent"
                                               Margin="2,0,0,0" Visibility="{Binding IsPassword, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Remove this field" AutomationProperties.Name="Remove this field" Command="{Binding RemoveCommand}" Appearance="Transparent"
                                           Margin="2,0,0,0" VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:DropDownButton Content="Add field" Icon="{ui:SymbolIcon Add24}" HorizontalAlignment="Left" Margin="0,2,0,0">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem Header="Text" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Text}" />
                            <MenuItem Header="Username" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Username}" />
                            <MenuItem Header="Password" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Password}" />
                            <MenuItem Header="Hidden (PIN, code…)" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Secret}" />
                            <MenuItem Header="One-time code (2FA)" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Totp}" />
                            <MenuItem Header="Website" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Url}" />
                            <MenuItem Header="Email" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Email}" />
                            <MenuItem Header="Phone" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Phone}" />
                            <MenuItem Header="Date" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Date}" />
                            <MenuItem Header="Several lines" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Multiline}" />
                            <Separator />
                            <MenuItem Header="Image" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Image}" />
                            <MenuItem Header="Document (any file)" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Document}" />
                            <MenuItem Header="Text file (.txt)" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.TextFile}" />
                            <MenuItem Header="Keystore" Command="{Binding AddFieldCommand}" CommandParameter="{x:Static items:VaultFieldKind.Keystore}" />
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>

                <!-- Description (Info) or notes, and tags -->
                <TextBlock Text="{Binding NotesLabel}" Style="{DynamicResource HelmSectionHeader}" />
                <ui:TextBox AutomationProperties.Name="{Binding NotesLabel}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalContentAlignment="Top" />
                <ui:TextBox Margin="0,8,0,0" AutomationProperties.Name="Tags" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Tags, separated by commas" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
