<Project Sdk="Microsoft.NET.Sdk">

  <!-- Vault on Windows: hosts the shared Vault page (Helm.Modules.Vault.UI) over Helm.Modules.Vault.Core, plus the Windows
       parts: Windows Hello, the protected clipboard, auto-type, locking with Windows. -->
  <PropertyGroup>
    <RootNamespace>Helm.Modules.Vault</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core.Windows\Helm.Core.Windows.csproj" />
    <ProjectReference Include="..\Helm.Modules.Vault.Core\Helm.Modules.Vault.Core.csproj" />
    <!-- The vault page itself is the shared Avalonia view (the module's CreatePage). -->
    <ProjectReference Include="..\Helm.Modules.Vault.UI\Helm.Modules.Vault.UI.csproj" />
    <ProjectReference Include="..\Helm.Ui.Windows\Helm.Ui.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>
