<Page x:Class="Helm.Modules.Vault.VaultContentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:uiw="clr-namespace:Helm.Ui.Windows;assembly=Helm.Ui.Windows"
      ScrollViewer.CanContentScroll="False"
      Title="Vault">

    <!-- The vault itself (menu, Home tile, Utilities) is the shared Avalonia page, Helm.Modules.Vault.UI/VaultView: the same
         view on every platform. This WPF page only hosts it and does the Windows parts (hiding the window from screen
         capture, forgetting what was typed when the page is left, hidden or minimized). Its settings are a sheet inside it. -->
    <uiw:AvaloniaHost x:Name="Host" />
</Page>
