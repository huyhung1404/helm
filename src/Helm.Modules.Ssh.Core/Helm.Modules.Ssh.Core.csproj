<Project Sdk="Microsoft.NET.Sdk">

  <!-- SSH logic shared by the Windows and (later) Android apps: hosts, this device's key, known host keys and the
       sessions. No WPF, Avalonia or platform APIs here. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <RootNamespace>Helm.Modules.Ssh</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core\Helm.Core.csproj" />
    <ProjectReference Include="..\Helm.Shell\Helm.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SSH protocol (MIT). Brings BouncyCastle, which also generates this device's Ed25519 key. -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>
