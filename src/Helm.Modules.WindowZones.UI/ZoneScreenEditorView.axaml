<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:ed="using:Helm.Modules.WindowZones.Editor"
             xmlns:ui="using:Helm.Modules.WindowZones.Ui"
             xmlns:core="using:Helm.Core.Ui"
             x:Class="Helm.Modules.WindowZones.Ui.ZoneScreenEditorView"
             x:DataType="ed:EditorSession">

    <!-- The full-screen zone editor on ONE monitor (a window per monitor covers it; they share the session): the monitor's
         zones at full size on a dark veil (set in code), drawn on directly as in the sheet. The monitor the editor was
         opened on shows the toolbar; the others say where it is. Esc cancels, Del deletes the chosen zone, Ctrl+Enter saves. -->
    <Panel>
        <ui:ZoneLayoutView x:Name="Canvas" IsEditable="True" Session="{Binding}" Focusable="True" />

        <!-- Another monitor: where the toolbar is -->
        <Border x:Name="Caption" Classes="sheet" CornerRadius="16" Padding="18,10" Margin="24" MaxWidth="560"
                HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="False">
            <TextBlock x:Name="CaptionText" Classes="secondary" TextWrapping="Wrap" />
        </Border>

        <!-- The toolbar (the monitor it was opened on) -->
        <Border x:Name="Toolbar" Classes="sheet" Padding="20,16,20,14" Margin="24" MaxWidth="900"
                HorizontalAlignment="Center" VerticalAlignment="Top" core:Motion.EnterOnShow="True">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel>
                        <TextBlock Classes="eyebrow" Text="WINDOW ZONES" />
                        <TextBlock FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap">
                            <Run Text="Edit zones" />
                            <Run Text="  " />
                            <Run Text="{Binding Summary}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource HelmSecondaryText}" />
                        </TextBlock>
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="1" Classes="chip" VerticalAlignment="Top" Command="{Binding CloseCommand}"
                            ToolTip.Tip="Close without saving (Esc)" AutomationProperties.Name="Close the editor">
                        <ic:SymbolIcon Symbol="Dismiss" FontSize="14" />
                    </Button>
                </Grid>

                <TextBlock x:Name="Hint" Classes="secondary" Text="{Binding Hint}" TextWrapping="Wrap" />

                <!-- What to do with the chosen zone and with all of them; Cancel and Save on the right -->
                <Grid x:Name="Actions" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <WrapPanel x:Name="ZoneActions" VerticalAlignment="Center">
                        <Button Classes="act" Command="{Binding SplitVerticalCommand}" IsEnabled="{Binding CanEditZone}"
                                ToolTip.Tip="Split the chosen zone into left and right halves" AutomationProperties.Name="Split left and right">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="↔" FontWeight="SemiBold" />
                                <TextBlock Classes="label" Text="Split" />
                            </StackPanel>
                        </Button>
                        <Button Classes="act" Command="{Binding SplitHorizontalCommand}" IsEnabled="{Binding CanEditZone}"
                                ToolTip.Tip="Split the chosen zone into top and bottom halves" AutomationProperties.Name="Split top and bottom">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="↕" FontWeight="SemiBold" />
                                <TextBlock Classes="label" Text="Split" />
                            </StackPanel>
                        </Button>
                        <Button Classes="act" Command="{Binding DeleteZoneCommand}" IsEnabled="{Binding CanEditZone}"
                                ToolTip.Tip="Delete the chosen zone (Del)" AutomationProperties.Name="Delete zone">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="Delete" FontSize="15" Foreground="{DynamicResource HelmDanger}" />
                                <TextBlock Classes="label" Text="Delete zone" Foreground="{DynamicResource HelmDanger}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="act" Command="{Binding DeleteAllCommand}" ToolTip.Tip="Remove every zone and start again"
                                AutomationProperties.Name="Delete all">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="DismissCircle" FontSize="15" Foreground="{DynamicResource HelmDanger}" />
                                <TextBlock Classes="label" Text="Delete all" Foreground="{DynamicResource HelmDanger}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <Button x:Name="CancelButton" Grid.Column="1" Classes="ghost" MinWidth="100" HorizontalContentAlignment="Center"
                            VerticalAlignment="Top" Content="Cancel" Command="{Binding CloseCommand}" ToolTip.Tip="Close without saving (Esc)" />
                    <Button x:Name="SaveButton" Grid.Column="2" Classes="pill" MinWidth="120" HorizontalContentAlignment="Center" VerticalAlignment="Top"
                            Command="{Binding SaveCommand}" ToolTip.Tip="Save the zones (Ctrl+Enter). Windows in a zone follow it."
                            AutomationProperties.Name="Save">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <ic:SymbolIcon Symbol="Checkmark" FontSize="15" Foreground="{DynamicResource HelmPillForeground}" />
                            <TextBlock Text="Save" Foreground="{DynamicResource HelmPillForeground}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
