<core:ModulePageBase
    x:Class="Helm.Modules.ShortcutGuide.ShortcutGuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:core="clr-namespace:Helm.Core.Ui;assembly=Helm.Core.Windows"
    xmlns:local="clr-namespace:Helm.Modules.ShortcutGuide"
    Module="{Binding Module}">

    <!-- Shortcut Guide's settings (Home → Utilities). The shortcuts themselves are on ShortcutGuideContentPage. -->
    <StackPanel>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:ImageIcon Width="24" Height="24" Source="{x:Static local:ShortcutGuideLogo.Image}" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <core:CardHeader Title="Open Shortcut Guide" Description="Browse the shortcuts of every app, add your own, hide the ones you know. Also in the menu and on Home." />
            </ui:CardControl.Header>
            <ui:Button Appearance="Primary" Content="Open Shortcut Guide" Click="OpenGuide_Click" />
        </ui:CardControl>

        <!-- Activation -->
        <TextBlock Text="Activation" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Keyboard24}" IsExpanded="True">
            <ui:CardExpander.Header>
                <core:CardHeader Title="Keys that open the guide" Description="Hold one of them alone; add another while the guide shows (Ctrl, then Shift) to see those shortcuts." />
            </ui:CardExpander.Header>
            <StackPanel>
                <Border Style="{DynamicResource HelmExpanderRow}" BorderThickness="0">
                    <core:RowLayout>
                        <core:CardHeader Title="Ctrl" Description="Most app shortcuts start with Ctrl." />
                        <ui:ToggleSwitch AutomationProperties.Name="Hold Ctrl" IsChecked="{Binding HoldCtrl}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Alt" Description="Letting go of Alt after the guide showed does not open the app's menu." />
                        <ui:ToggleSwitch AutomationProperties.Name="Hold Alt" IsChecked="{Binding HoldAlt}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Win" Description="Windows' own shortcuts. Letting go of Win after the guide showed does not open Start." />
                        <ui:ToggleSwitch AutomationProperties.Name="Hold Win" IsChecked="{Binding HoldWin}" />
                    </core:RowLayout>
                </Border>
                <Border Style="{DynamicResource HelmExpanderRow}">
                    <core:RowLayout>
                        <core:CardHeader Title="Shift" Description="Off by default: Shift is held for capitals, and few shortcuts start with Shift alone." />
                        <ui:ToggleSwitch AutomationProperties.Name="Hold Shift" IsChecked="{Binding HoldShift}" />
                    </core:RowLayout>
                </Border>
            </StackPanel>
        </ui:CardExpander>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Timer24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Hold for" Description="How long to hold before the guide appears. Shorter shows it sooner, longer keeps it out of quick shortcuts." />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <Slider Width="180" VerticalAlignment="Center" Minimum="{Binding MinHoldDelay}" Maximum="{Binding MaxHoldDelay}"
                        TickFrequency="100" IsSnapToTickEnabled="True" SmallChange="100" LargeChange="200"
                        Value="{Binding HoldDelay}" AutomationProperties.Name="Hold for" />
                <TextBlock Width="40" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding HoldDelayText}" />
            </StackPanel>
        </ui:CardControl>

        <!-- Behavior -->
        <TextBlock Text="Behavior" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Apps24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Shortcuts of most apps and Windows" Description="Below the app's own: copy, paste, undo and the like, then Windows shortcuts." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="Shortcuts of most apps and Windows" IsChecked="{Binding IncludeGeneral}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Filter24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Skip the basics" Description="Leave out what everyone knows: copy, paste, undo, select all, Alt+Tab and the like. They stay in the list, marked Basic." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="Skip the basics" IsChecked="{Binding SkipBasics}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Games24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Not over full-screen games" Description="Never shows over a full-screen game or a presentation." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch AutomationProperties.Name="Not over full-screen games" IsChecked="{Binding HideInFullScreen}" />
        </ui:CardControl>

        <!-- Appearance -->
        <TextBlock Text="Appearance" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Window24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Position" Description="Where the guide appears on the screen of the app in front." />
            </ui:CardControl.Header>
            <ComboBox Width="140" AutomationProperties.Name="Position" ItemsSource="{Binding PositionNames}" SelectedIndex="{Binding PositionIndex}" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Eye24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Background opacity" Description="Lower lets more of the app show through the guide." />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <Slider Width="180" VerticalAlignment="Center" Minimum="{Binding MinOpacity}" Maximum="{Binding MaxOpacity}"
                        TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                        Value="{Binding BackgroundOpacity}" AutomationProperties.Name="Background opacity" />
                <TextBlock Width="44" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding BackgroundOpacityText}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon TextAlignJustify24}">
            <ui:CardControl.Header>
                <core:CardHeader Title="Rows of keys" Description="The most the guide shows at once; the rest are in the list here." />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <Slider Width="180" VerticalAlignment="Center" Minimum="{Binding MinRows}" Maximum="{Binding MaxRows}"
                        TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1"
                        Value="{Binding Rows}" AutomationProperties.Name="Rows of keys" />
                <TextBlock Width="44" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Rows}" />
            </StackPanel>
        </ui:CardControl>

        <!-- Excluded apps -->
        <TextBlock Text="Excluded apps" Style="{DynamicResource HelmSectionHeader}" />
        <ui:CardExpander Margin="0,0,0,4" Icon="{ui:SymbolIcon Prohibited24}">
            <ui:CardExpander.Header>
                <core:CardHeader Title="Excluded apps" Description="Process names the guide never shows over, one per line (e.g. a game or a remote desktop)." />
            </ui:CardExpander.Header>
            <ui:TextBox Text="{Binding ExcludedAppsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                        MinHeight="100" MaxHeight="240" VerticalScrollBarVisibility="Auto" PlaceholderText="Example: mstsc.exe"
                        AutomationProperties.Name="Excluded apps" />
        </ui:CardExpander>
    </StackPanel>
</core:ModulePageBase>
