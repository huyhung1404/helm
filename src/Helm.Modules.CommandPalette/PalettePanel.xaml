<UserControl
    x:Class="Helm.Modules.CommandPalette.PalettePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Helm.Modules.CommandPalette">

    <UserControl.Resources>
        <local:PaletteKindSymbolConverter x:Key="KindSymbol" />
        <local:PaletteKindNameConverter x:Key="KindName" />
        <local:FileIconConverter x:Key="FileIcon" />
        <local:NullToVisibleConverter x:Key="NullToVisible" />
    </UserControl.Resources>

    <!-- The command palette: one search box over Helm's pages and settings, the tools' data and the apps. -->
    <StackPanel Margin="12">
        <ui:TextBox x:Name="Input" FontSize="18" Padding="12,10" ClearButtonEnabled="False" SpellCheck.IsEnabled="False"
                    PlaceholderText="Search Helm, apps, files, windows, settings…" Icon="{ui:SymbolIcon Search24}"
                    AutomationProperties.Name="Search" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" />

        <ListBox x:Name="List" Margin="0,8,0,0" MaxHeight="440" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}"
                 AutomationProperties.Name="Results" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource HelmListItem}"
                 Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:PaletteResult}">
                    <Grid Margin="0,3" AutomationProperties.Name="{Binding Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Source="{Binding Item.IconFile, Converter={StaticResource FileIcon}}" />
                        <ui:SymbolIcon Symbol="{Binding Kind, Converter={StaticResource KindSymbol}}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Margin="2,0,0,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       Visibility="{Binding Item.IconFile, Converter={StaticResource NullToVisible}}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Margin="12,0,4,0" FontSize="12" VerticalAlignment="Center"
                                   Text="{Binding Kind, Converter={StaticResource KindName}}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Margin="8,12,8,4" Text="Nothing found. Try fewer letters, or turn on more tools in Helm." FontSize="13"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />

        <DockPanel Margin="8,10,8,0">
            <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Searching files…"
                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="↑↓ move · Enter open · Esc close" />
        </DockPanel>
    </StackPanel>
</UserControl>
