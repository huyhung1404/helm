<Project Sdk="Microsoft.NET.Sdk">

  <!-- The command palette on Windows: a global shortcut opens one search box over everything. Results come from the
       tools themselves (IPaletteProvider in Helm.Core) plus the apps in the Start menu, so this project references no
       other tool. -->
  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>Helm.Modules.CommandPalette</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Helm.Core.Windows\Helm.Core.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Files and folders come from the Windows Search index (the one the Start menu uses), through its OLE DB provider. -->
    <PackageReference Include="System.Data.OleDb" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Helm.Tests" />
  </ItemGroup>

</Project>
