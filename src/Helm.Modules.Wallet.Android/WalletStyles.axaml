<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- What the Wallet page and its sheets share: one look for every choice, chip, row and jar. Touch targets are 44 dp
         or more. -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WalletSegOn" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WalletLine" Color="#14000000" />
                    <SolidColorBrush x:Key="WalletCardStroke" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="WalletLow" Color="#66C29C00" />
                    <SolidColorBrush x:Key="WalletUsedUp" Color="#8CC98500" />
                    <SolidColorBrush x:Key="WalletOver" Color="#99C42B1C" />
                    <SolidColorBrush x:Key="WalletField" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WalletChip" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="WalletFab" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="WalletChipStroke" Color="#1A000000" />
                    <SolidColorBrush x:Key="WalletChipPicked" Color="#1F0067C0" />
                    <SolidColorBrush x:Key="WalletFieldFocus" Color="#FFFFFF" />
                    <LinearGradientBrush x:Key="WalletFieldStroke" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#0F000000" />
                        <GradientStop Offset="0.97" Color="#0F000000" />
                        <GradientStop Offset="0.97" Color="#72000000" />
                        <GradientStop Offset="1" Color="#72000000" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WalletSegOn" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="WalletLine" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="WalletCardStroke" Color="#0FFFFFFF" />
                    <SolidColorBrush x:Key="WalletLow" Color="#66FCE100" />
                    <SolidColorBrush x:Key="WalletUsedUp" Color="#8CFFB86B" />
                    <SolidColorBrush x:Key="WalletOver" Color="#99FF99A4" />
                    <SolidColorBrush x:Key="WalletField" Color="#333333" />
                    <SolidColorBrush x:Key="WalletChip" Color="#323232" />
                    <SolidColorBrush x:Key="WalletFab" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="WalletChipStroke" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="WalletChipPicked" Color="#2960CDFF" />
                    <SolidColorBrush x:Key="WalletFieldFocus" Color="#1F1F1F" />
                    <LinearGradientBrush x:Key="WalletFieldStroke" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#12FFFFFF" />
                        <GradientStop Offset="0.97" Color="#12FFFFFF" />
                        <GradientStop Offset="0.97" Color="#80FFFFFF" />
                        <GradientStop Offset="1" Color="#80FFFFFF" />
                    </LinearGradientBrush>
                    <!-- Buttons as drawn: dark text on the accent, plain ones raised with a faint edge -->
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#000000" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#CC000000" />
                    <SolidColorBrush x:Key="ButtonBackground" Color="#373737" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#404040" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#333333" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#14FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Text boxes: raised, a brighter line along the bottom, the accent under the one being typed in -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource WalletField}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WalletFieldStroke}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox[AcceptsReturn=True]">
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <!-- An amount: a tall box, big digits -->
    <Style Selector="TextBox.amount">
        <Setter Property="MinHeight" Value="56" />
    </Style>
    <!-- The search box sits on the page, a card's colour -->
    <Style Selector="TextBox.search">
        <Setter Property="Background" Value="{DynamicResource HelmCardBackground}" />
        <Setter Property="Padding" Value="8,0,12,0" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource WalletField}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WalletFieldStroke}" />
    </Style>
    <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource HelmCardBackground}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource WalletFieldFocus}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>

    <!-- An accent button's own foreground too: content that is not plain text (an icon and a label) inherits it from
         the button, not from the template's presenter -->
    <Style Selector="Button.accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>

    <!-- Cards: rounder than Helm's, a faint edge -->
    <Style Selector="Border.card">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="{DynamicResource WalletCardStroke}" />
    </Style>
    <Style Selector="TextBlock.figure">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- A small label over a figure ("Spent") -->
    <Style Selector="TextBlock.lbl">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
    </Style>
    <!-- Money · Debts: the one in front is raised and underlined -->
    <Style Selector="Border.seg">
        <Setter Property="Background" Value="{DynamicResource HelmBarBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WalletLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Button.seg">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
    </Style>
    <Style Selector="Button.seg.on">
        <Setter Property="Background" Value="{DynamicResource WalletSegOn}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.seg.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource WalletSegOn}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="TextBlock.income">
        <Setter Property="Foreground" Value="{DynamicResource HelmSuccess}" />
    </Style>
    <Style Selector="TextBlock.owed">
        <Setter Property="Foreground" Value="{DynamicResource HelmSuccess}" />
    </Style>
    <Style Selector="TextBlock.iowe">
        <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
    </Style>
    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
    </Style>
    <Style Selector="TextBlock.secondary.overdue">
        <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
    </Style>
    <!-- A fund's status: amber low, orange used up, red over (with its words and icon) -->
    <Style Selector="TextBlock.status">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource HelmSuccess}" />
    </Style>
    <Style Selector="TextBlock.status.warn">
        <Setter Property="Foreground" Value="#C98500" />
    </Style>
    <Style Selector="TextBlock.status.over">
        <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
    </Style>

    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource HelmSubtleFill}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.box">
        <Setter Property="Background" Value="{DynamicResource HelmSubtleFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmCardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.box.over">
        <Setter Property="BorderBrush" Value="{DynamicResource HelmDanger}" />
    </Style>

    <!-- Square icon button (44 dp touch target) -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.wide">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <!-- A chip: a category or a choice; a picked one gets the accent outline -->
    <Style Selector="Button.chip">
        <Setter Property="Background" Value="{DynamicResource WalletChip}" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="4,4,14,4" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource WalletChipStroke}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip.picked">
        <Setter Property="Background" Value="{DynamicResource WalletChipPicked}" />
    </Style>
    <Style Selector="Button.chip.plain">
        <Setter Property="Padding" Value="14,4" />
    </Style>
    <Style Selector="Button.chip.dashed">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
    </Style>
    <Style Selector="Button.chip.picked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource WalletChipPicked}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
    </Style>

    <!-- One choice of a few, side by side (kind, filter, due date…): the picked one is the accent -->
    <Style Selector="ListBox.seg">
        <Setter Property="Background" Value="{DynamicResource HelmBarBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WalletLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.seg > ListBoxItem">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
    </Style>
    <Style Selector="ListBox.seg > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource WalletSegOn}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="ListBox.seg > ListBoxItem:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
    </Style>

    <!-- The floating buttons over the bottom of the page -->
    <Style Selector="Button.fab">
        <Setter Property="Background" Value="{DynamicResource WalletFab}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WalletChipStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="56" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Padding" Value="16,0,20,0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- Solid, so the page under it never shows through -->
    <Style Selector="Button.fab.accent">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- A fund in the strip: its jar, name, what is left or over -->
    <Style Selector="Button.fund">
        <Setter Property="Width" Value="108" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="11,10" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmCardStroke}" />
        <Setter Property="Background" Value="{DynamicResource HelmCardBackground}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.fund.over /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource WalletOver}" />
    </Style>
    <Style Selector="Button.fund.usedup /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource WalletUsedUp}" />
    </Style>
    <Style Selector="Button.fund.low /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource WalletLow}" />
    </Style>
    <Style Selector="Button.fund.dashed">
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
