<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- What the Wallet page and its sheets share: one look for every choice, chip, row and jar. Touch targets are 44 dp
         or more. -->

    <Style Selector="TextBlock.figure">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.cardTitle">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="TextBlock.income">
        <Setter Property="Foreground" Value="{DynamicResource HelmSuccess}" />
    </Style>
    <Style Selector="TextBlock.owed">
        <Setter Property="Foreground" Value="{DynamicResource HelmSuccess}" />
    </Style>
    <Style Selector="TextBlock.iowe">
        <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
    </Style>
    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
    </Style>
    <Style Selector="TextBlock.secondary.overdue">
        <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
    </Style>
    <!-- A fund's status: amber low, orange used up, red over (with its words and icon) -->
    <Style Selector="TextBlock.status">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource HelmSuccess}" />
    </Style>
    <Style Selector="TextBlock.status.warn">
        <Setter Property="Foreground" Value="#C98500" />
    </Style>
    <Style Selector="TextBlock.status.over">
        <Setter Property="Foreground" Value="{DynamicResource HelmDanger}" />
    </Style>

    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource HelmSubtleFill}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="MinWidth" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.box">
        <Setter Property="Background" Value="{DynamicResource HelmSubtleFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmCardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.box.over">
        <Setter Property="BorderBrush" Value="{DynamicResource HelmDanger}" />
    </Style>

    <!-- Square icon button (44 dp touch target) -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Button.wide">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <!-- A chip: a category or a choice; a picked one gets the accent outline -->
    <Style Selector="Button.chip">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="4,4,14,4" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmCardStroke}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip.plain">
        <Setter Property="Padding" Value="14,4" />
    </Style>
    <Style Selector="Button.chip.dashed">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
    </Style>
    <Style Selector="Button.chip.picked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- One choice of a few, side by side (kind, filter, due date…): the picked one is the accent -->
    <Style Selector="ListBox.seg">
        <Setter Property="Background" Value="{DynamicResource HelmBarBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmCardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.seg > ListBoxItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource HelmSecondaryText}" />
    </Style>
    <Style Selector="ListBox.seg > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HelmCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
    <Style Selector="ListBox.seg > ListBoxItem:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextControlForeground}" />
    </Style>

    <!-- The floating buttons over the bottom of the page -->
    <Style Selector="Button.fab">
        <Setter Property="Height" Value="56" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="Padding" Value="16,0,20,0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- A fund in the strip: its jar, name, what is left or over -->
    <Style Selector="Button.fund">
        <Setter Property="Width" Value="112" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="8,10" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HelmCardStroke}" />
        <Setter Property="Background" Value="{DynamicResource HelmCardBackground}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.fund.over /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource HelmDanger}" />
    </Style>
    <Style Selector="Button.fund.dashed">
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
