<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Helm.Modules.Wallet"
             x:Class="Helm.Modules.Wallet.WalletContentPage"
             x:DataType="vm:WalletViewModel">

    <!-- Wallet itself (drawer and Quick access). Its options live on WalletPage (Home → Utilities). The page shows the
         month; every add, edit and delete opens a bottom sheet (WalletSheet), and the floating buttons add a transaction
         or open the ones to categorize. -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Helm.Modules.Wallet.Android/WalletStyles.axaml" />
    </UserControl.Styles>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Helm.Modules.Wallet.Android/WalletTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Room at the bottom for the floating buttons -->
    <StackPanel Spacing="12" Margin="0,0,0,88">
        <!-- Money (the month) or Debts (who owes whom) -->
        <Border Classes="seg" IsVisible="{Binding HasDebts}">
            <Grid ColumnDefinitions="*,3,*">
                <Button Classes="seg" Classes.on="{Binding IsMoneyView}" Command="{Binding ShowMoneyCommand}" AutomationProperties.Name="Show the money">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="Wallet" FontSize="18" />
                        <TextBlock Text="Money" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="seg" Classes.on="{Binding IsDebtsView}" Command="{Binding ShowDebtsCommand}" AutomationProperties.Name="Show the debts">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="People" FontSize="18" />
                        <TextBlock Text="Debts" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Shown while the tool is turned off -->
        <Border x:Name="OffBar" Classes="infobar" IsVisible="False">
            <StackPanel>
                <TextBlock Text="Wallet is turned off" Classes="title" />
                <TextBlock Text="Your transactions are kept, but new ones are not saved. Turn Wallet on in its settings." TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="Body" Spacing="12">
            <!-- What happened: a problem, or "Copied" -->
            <Border Classes="infobar" IsVisible="{Binding HasMessage}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="icon flat" Command="{Binding DismissMessageCommand}" AutomationProperties.Name="Dismiss">
                        <ic:SymbolIcon Symbol="Dismiss" FontSize="16" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============================== Money ============================== -->
            <StackPanel Spacing="12" IsVisible="{Binding IsMoneyView}">
                <!-- Helm cannot read the banks' notifications yet -->
                <Border Classes="infobar warning" IsVisible="{Binding NeedsAccess}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Turn on notification access" Classes="title" />
                        <TextBlock Text="To save your transactions by itself, Helm needs to read your bank's notifications. Nothing else is read or sent anywhere."
                                   TextWrapping="Wrap" />
                        <Button Classes="accent wide" Content="Open notification access" Command="{Binding OpenNotificationAccessCommand}" />
                        <StackPanel Spacing="8" IsVisible="{Binding ShowRestrictedHelp}">
                            <TextBlock Text="Android blocked it (“Restricted setting”)?" Classes="title" />
                            <TextBlock Text="Android 13 and later block this for apps installed from a file, until you allow it once:" TextWrapping="Wrap" />
                            <TextBlock Text="1. Try turning Helm on in Notification access and close the block message. Android only offers the next step after that."
                                       TextWrapping="Wrap" />
                            <TextBlock Text="2. Open App info, tap ⋮ (top right) → Allow restricted settings, and confirm." TextWrapping="Wrap" />
                            <TextBlock Text="3. Open notification access again and turn Helm on." TextWrapping="Wrap" />
                            <Button Classes="wide" Content="Open App info" Command="{Binding OpenAppDetailsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The month -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Classes="icon flat" Command="{Binding PreviousMonthCommand}" AutomationProperties.Name="Previous month">
                        <ic:SymbolIcon Symbol="ChevronLeft" FontSize="18" />
                    </Button>
                    <Button Grid.Column="1" Classes="flat" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding ThisMonthCommand}"
                            AutomationProperties.Name="This month">
                        <TextBlock Text="{Binding MonthTitle}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Button Grid.Column="2" Classes="icon flat" Command="{Binding NextMonthCommand}" IsEnabled="{Binding CanGoNext}" AutomationProperties.Name="Next month">
                        <ic:SymbolIcon Symbol="ChevronRight" FontSize="18" />
                    </Button>
                </Grid>

                <!-- The month in three numbers, short, and one line under them -->
                <Border Classes="card" Padding="14,12" Margin="0">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,8,*,8,*">
                            <StackPanel>
                                <TextBlock Text="Spent" Classes="lbl" />
                                <TextBlock Text="{Binding SpentShort}" Classes="figure" TextWrapping="NoWrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Money in" Classes="lbl" />
                                <TextBlock Text="{Binding IncomeShort}" Classes="figure income" TextWrapping="NoWrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Net" Classes="lbl" />
                                <TextBlock Text="{Binding NetShort}" Classes="figure" Classes.danger="{Binding IsNetNegative}" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding MonthLine}" Classes="secondary" TextWrapping="Wrap"
                                   IsVisible="{Binding MonthLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Border>

                <!-- The funds as honey pots, side by side (swipe for more) -->
                <!-- As with the debts below: the panel's DataContext binding is read as the page's, what is inside it as the funds'. -->
                <Panel IsVisible="{Binding Funds, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Panel DataContext="{Binding Funds}">
                <StackPanel Spacing="8" x:DataType="vm:FundsViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,0">
                        <TextBlock Text="Funds" Classes="cardTitle" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasFunds}">
                            <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="14" Foreground="{DynamicResource HelmSuccess}" IsVisible="{Binding !HasAlerts}" VerticalAlignment="Center" />
                            <ic:SymbolIcon Symbol="Warning" FontSize="14" Foreground="#C98500" IsVisible="{Binding HasAlerts}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AlertText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Border Classes="card" Margin="0" IsVisible="{Binding HasNoFunds}">
                        <StackPanel Spacing="8">
                            <TextBlock TextWrapping="Wrap" Classes="secondary" FontSize="13"
                                       Text="Set an amount for each part of your month (eating, getting around, home and bills…) and pick its categories. Spending in them comes off the fund, and Helm warns before a fund runs out." />
                            <Button Classes="accent wide" Command="{Binding OpenAddCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Add" FontSize="16" />
                                    <TextBlock Text="Add a fund" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasFunds}" Margin="-16,0" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource FundTile}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Button Classes="fund dashed" Command="{Binding OpenOutsideCommand}" IsVisible="{Binding HasOutside}" AutomationProperties.Name="Outside funds: put them in a fund">
                                <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Outside funds" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding OutsideShort}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="spent" Classes="secondary" HorizontalAlignment="Center" />
                                    <TextBlock Text="Put in a fund" FontSize="12" Foreground="{DynamicResource AccentButtonBackground}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="fund dashed" Width="96" Command="{Binding OpenAddCommand}" AutomationProperties.Name="Add a fund">
                                <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <vm:FundJar Width="48" Height="56" IsAdd="True" HorizontalAlignment="Center" />
                                    <TextBlock Text="Add fund" FontSize="12" Foreground="{DynamicResource AccentButtonBackground}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
                </Panel>
                </Panel>

                <!-- Where the money went: one bar, the slices named; every chart in a sheet -->
                <Border Classes="card" Margin="0">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Where it went" Classes="cardTitle" />
                            <Button Grid.Column="1" Classes="flat" Padding="8,6" HorizontalAlignment="Right" Command="{Binding OpenChartsCommand}" AutomationProperties.Name="All charts">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="DataBarVertical" FontSize="16" Foreground="{DynamicResource AccentButtonBackground}" />
                                    <TextBlock Text="All charts" Foreground="{DynamicResource AccentButtonBackground}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="Nothing spent this month yet." Classes="secondary" IsVisible="{Binding !HasSpending}" />
                        <StackPanel IsVisible="{Binding HasSpending}" Spacing="6">
                            <vm:ShareBar Model="{Binding SpendingDonut}" />
                            <ItemsControl ItemsSource="{Binding SpendingDonut.Segments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DonutSegment">
                                        <Grid ColumnDefinitions="Auto,*,Auto,44" Margin="0,4">
                                            <vm:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="28" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding ShareText}" Classes="secondary" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The month's transactions -->
                <TextBlock Text="Transactions" Classes="cardTitle" Margin="4,4,0,0" />
                <ListBox Classes="seg" ItemsSource="{x:Static vm:WalletViewModel.FilterNames}" SelectedIndex="{Binding FilterIndex}" AutomationProperties.Name="Show" />
                <TextBox Classes="search" Text="{Binding SearchText}" PlaceholderText="Search" AutomationProperties.Name="Search transactions">
                    <TextBox.InnerLeftContent>
                        <ic:SymbolIcon Symbol="Search" FontSize="18" Margin="12,0,0,0" Foreground="{DynamicResource HelmSecondaryText}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <TextBlock Text="{Binding EmptyText}" Classes="secondary" Margin="4,0" IsVisible="{Binding !HasDays}" />
                <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DayGroup">
                            <StackPanel Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto" Margin="4,4,4,6">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" Classes="secondary" />
                                </Grid>
                                <Border Classes="card" Padding="0" ClipToBounds="True">
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TransactionRow">
                                                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource HelmCardStroke}">
                                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TransactionRow}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Only the newest few are drawn: the whole month made the page slow to scroll -->
                <Button Classes="wide" Content="{Binding TransactionPager.MoreText}" Command="{Binding TransactionPager.ShowMoreCommand}"
                        IsVisible="{Binding TransactionPager.HasMore}" AutomationProperties.Name="Show more transactions" />
            </StackPanel>

            <!-- ============================== Debts ============================== -->
            <!-- The inner panel's DataContext binding is read as the page's (WalletViewModel); what is inside it, as the debt book's. -->
            <Panel IsVisible="{Binding IsDebtsView}">
                <Panel DataContext="{Binding Debts}">
                    <StackPanel x:DataType="vm:DebtsViewModel" Spacing="12">
                        <Border Classes="infobar" IsVisible="{Binding HasMessage}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="icon flat" Command="{Binding DismissMessageCommand}" AutomationProperties.Name="Dismiss">
                                    <ic:SymbolIcon Symbol="Dismiss" FontSize="16" />
                                </Button>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,6,*,6,*">
                            <Border Classes="card" Padding="12,10" Margin="0">
                                <StackPanel>
                                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding OwedToMeText}" Classes="figure owed" FontSize="15" /></Viewbox>
                                    <TextBlock Text="Owed to me" Classes="secondary" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="card" Padding="12,10" Margin="0">
                                <StackPanel>
                                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding IOweText}" Classes="figure iowe" FontSize="15" /></Viewbox>
                                    <TextBlock Text="I owe" Classes="secondary" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Classes="card" Padding="12,10" Margin="0">
                                <StackPanel>
                                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left"><TextBlock Text="{Binding NetText}" Classes="figure" FontSize="15" /></Viewbox>
                                    <TextBlock Text="Net" Classes="secondary" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="card" Padding="0" Margin="0" ClipToBounds="True">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Margin="12,12,12,8">
                                    <TextBlock Text="Outstanding" Classes="cardTitle" />
                                    <TextBlock Grid.Column="1" Text="{Binding OpenSummary}" Classes="secondary" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Margin="12,0,12,12" Text="Nothing outstanding. Everyone is square." Classes="secondary" IsVisible="{Binding HasNoPeople}" />
                                <ItemsControl ItemsSource="{Binding People}" ItemTemplate="{StaticResource PersonRow}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="0" Margin="0" ClipToBounds="True" IsVisible="{Binding HasSettled}">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Margin="12,4,4,4">
                                    <TextBlock Text="Settled" Classes="cardTitle" />
                                    <Button Grid.Column="1" Classes="flat" Content="Show or hide" Command="{Binding ToggleSettledCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SettledPeople}" ItemTemplate="{StaticResource PersonRow}" IsVisible="{Binding ShowSettled}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="secondary" Margin="4,0"
                                   Text="Lent or borrowed by bank transfer? Open that transaction in Money and tap Lent, borrowed, paid back. It then counts neither as spending nor as income." />
                    </StackPanel>
                </Panel>
            </Panel>
        </StackPanel>
    </StackPanel>
</UserControl>
