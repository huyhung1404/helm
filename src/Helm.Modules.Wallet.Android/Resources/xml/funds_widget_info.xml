<?xml version="1.0" encoding="utf-8"?>
<!-- The Funds home-screen widget: the month's funds as jars, the most urgent first. From about 2 x 2 (two jars) to 4 x 2
     and wider (four jars and the total left); FundsWidgets picks how many fit. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/funds_widget"
    android:previewLayout="@layout/funds_widget"
    android:description="@string/funds_widget_description" />
