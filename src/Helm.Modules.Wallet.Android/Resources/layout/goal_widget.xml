<?xml version="1.0" encoding="utf-8"?>
<!-- The Goal widget: the card behind (for the wide size) and one picture drawn in code (GoalWidgets): the photo lit up to
     what is saved, and beside it, when wide, the money and "+ Set aside". A widget cannot grey part of a picture. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/goal_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/goal_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wallet_widget_background"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/goal_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/goal_widget_off"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="14dp"
        android:textColor="@color/wallet_widget_secondary"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
