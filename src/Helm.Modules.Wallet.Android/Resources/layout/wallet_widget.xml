<?xml version="1.0" encoding="utf-8"?>
<!-- The Wallet widget, 4 columns wide: the balance in a ring (spending by category, or against the balance), tabs for
     the period (D W M All beside the ring; full names across the top when the widget is tall), what was spent and
     earned in it, and the largest slices. The ring is a bitmap drawn in code (a widget cannot draw arcs). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wallet_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wallet_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wallet_widget_background"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- Tall widgets only -->
        <LinearLayout
            android:id="@+id/wallet_widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageView
                android:id="@+id/wallet_widget_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/wallet_notification"
                android:tint="@color/wallet_widget_brand"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/wallet_widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Wallet"
                android:textColor="@color/wallet_widget_secondary"
                android:textSize="12.5sp"
                android:singleLine="true" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/wallet_widget_toptabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/wallet_widget_toptab0"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Today"
                android:textColor="@color/wallet_widget_secondary"
                android:textSize="11sp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/wallet_widget_toptab1"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Week"
                android:textColor="@color/wallet_widget_secondary"
                android:textSize="11sp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/wallet_widget_toptab2"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Month"
                android:textColor="@color/wallet_widget_secondary"
                android:textSize="11sp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/wallet_widget_toptab3"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="All"
                android:textColor="@color/wallet_widget_secondary"
                android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>
        <TextView
            android:id="@+id/wallet_widget_off"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/wallet_widget_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/wallet_widget_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/wallet_widget_donut"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical">
                <ImageView
                    android:id="@+id/wallet_widget_ring"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />
                <TextView
                    android:id="@+id/wallet_widget_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:minWidth="20dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:gravity="center"
                    android:background="@drawable/wallet_widget_badge"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/wallet_widget_sidetabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/wallet_widget_sidetab0"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="D"
                        android:textColor="@color/wallet_widget_secondary"
                        android:textSize="11sp"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/wallet_widget_sidetab1"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="W"
                        android:textColor="@color/wallet_widget_secondary"
                        android:textSize="11sp"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/wallet_widget_sidetab2"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="M"
                        android:textColor="@color/wallet_widget_secondary"
                        android:textSize="11sp"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/wallet_widget_sidetab3"
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="All"
                        android:textColor="@color/wallet_widget_secondary"
                        android:textSize="11sp"
                        android:singleLine="true" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/wallet_widget_spent_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Spent"
                        android:textColor="@color/wallet_widget_secondary"
                        android:textSize="11.5sp"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/wallet_widget_spent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wallet_widget_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:singleLine="true" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/wallet_widget_earned_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Earned"
                        android:textColor="@color/wallet_widget_secondary"
                        android:textSize="11.5sp"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/wallet_widget_earned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wallet_widget_text"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:singleLine="true" />
                </LinearLayout>
                <TextView
                    android:id="@+id/wallet_widget_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/wallet_widget_secondary"
                    android:textSize="11.5sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/wallet_widget_row1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/wallet_widget_dot1"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/wallet_widget_dot"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/wallet_widget_name1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/wallet_widget_text"
                        android:textSize="11.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/wallet_widget_amount1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wallet_widget_text"
                        android:textSize="11.5sp"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/wallet_widget_share1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wallet_widget_secondary"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:visibility="gone" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/wallet_widget_row2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/wallet_widget_dot2"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/wallet_widget_dot"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/wallet_widget_name2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/wallet_widget_text"
                        android:textSize="11.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/wallet_widget_amount2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wallet_widget_text"
                        android:textSize="11.5sp"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/wallet_widget_share2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wallet_widget_secondary"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:visibility="gone" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/wallet_widget_row3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/wallet_widget_dot3"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/wallet_widget_dot"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/wallet_widget_name3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/wallet_widget_text"
                        android:textSize="11.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/wallet_widget_amount3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wallet_widget_text"
                        android:textSize="11.5sp"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/wallet_widget_share3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wallet_widget_secondary"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:visibility="gone" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/wallet_widget_row4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/wallet_widget_dot4"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/wallet_widget_dot"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/wallet_widget_name4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/wallet_widget_text"
                        android:textSize="11.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/wallet_widget_amount4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wallet_widget_text"
                        android:textSize="11.5sp"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/wallet_widget_share4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wallet_widget_secondary"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:visibility="gone" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/wallet_widget_row5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/wallet_widget_dot5"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/wallet_widget_dot"
                        android:importantForAccessibility="no" />
                    <TextView
                        android:id="@+id/wallet_widget_name5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/wallet_widget_text"
                        android:textSize="11.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/wallet_widget_amount5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wallet_widget_text"
                        android:textSize="11.5sp"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/wallet_widget_share5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/wallet_widget_secondary"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:visibility="gone" />
                </LinearLayout>
                <TextView
                    android:id="@+id/wallet_widget_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:paddingStart="14dp"
                    android:textColor="@color/wallet_widget_secondary"
                    android:textSize="10.5sp"
                    android:singleLine="true"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
