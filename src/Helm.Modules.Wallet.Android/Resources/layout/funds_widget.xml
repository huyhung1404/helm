<?xml version="1.0" encoding="utf-8"?>
<!-- The Funds widget: a title with what is left of all the funds, the jars (a bitmap drawn in code: a widget cannot clip
     to a pot's shape) and a line about the rest. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/funds_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/funds_widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/wallet_widget_background"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/funds_widget_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="7dp"
                android:src="@drawable/wallet_notification"
                android:tint="@color/wallet_widget_brand"
                android:importantForAccessibility="no" />
            <TextView
                android:id="@+id/funds_widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Funds"
                android:textColor="@color/wallet_widget_secondary"
                android:textSize="12.5sp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/funds_widget_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wallet_widget_text"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <ImageView
            android:id="@+id/funds_widget_jars"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/funds_widget_off"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/wallet_widget_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/funds_widget_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/wallet_widget_secondary"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
