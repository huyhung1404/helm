<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ic="using:FluentIcons.Avalonia"
                    xmlns:vm="using:Helm.Modules.Wallet">

    <!-- The rows and chips the Wallet page and its sheets share. -->

    <!-- A category chip (form, details): its badge, name, and why it says more -->
    <DataTemplate x:Key="PickChip" x:DataType="vm:CategoryPick">
        <Button Classes="chip" Classes.picked="{Binding IsSelected}" Command="{Binding PickCommand}" AutomationProperties.Name="{Binding Name}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <vm:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="26" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Note, StringFormat='· {0}'}" Classes="secondary" VerticalAlignment="Center" IsVisible="{Binding HasNote}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- A one-tap category under a transaction to categorize -->
    <DataTemplate x:Key="SuggestionChip" x:DataType="vm:CategoryChip">
        <Button Classes="chip" Command="{Binding PickCommand}" AutomationProperties.Name="{Binding Name}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <vm:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="26" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- A fund's category, shown (not picked) -->
    <DataTemplate x:Key="ChoiceChip" x:DataType="vm:CategoryChoice">
        <Border BorderThickness="1" BorderBrush="{DynamicResource HelmCardStroke}" CornerRadius="19" Padding="4,4,14,4" Margin="0,0,6,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <vm:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="26" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A transaction: badge, title, category (and "auto"), time, amount; a tap opens its details -->
    <DataTemplate x:Key="TransactionRow" x:DataType="vm:TransactionRow">
        <Button Classes="flat" Padding="12,10" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Title}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <vm:CategoryBadge Icon="{Binding CategoryIcon}" Color="{Binding CategoryColor}" Size="40" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <!-- A grid, not a row of its own width: the time and the bank trim before the amount -->
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding IsCategorized}" Margin="0,0,6,0" />
                        <TextBlock Text="To categorize" Classes="secondary" FontWeight="SemiBold" VerticalAlignment="Center" IsVisible="{Binding !IsCategorized}" Margin="0,0,6,0" />
                        <Border Grid.Column="1" Classes="badge" IsVisible="{Binding IsAuto}" Margin="0,0,6,0">
                            <TextBlock Text="auto" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Details}" Classes="secondary" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" Classes.income="{Binding IsIncome}" />
            </Grid>
        </Button>
    </DataTemplate>

    <!-- A transaction to categorize: its row, then one-tap categories (AI's pick first, or the new one it proposes, made
         only when tapped) and "Lent, borrowed…" -->
    <DataTemplate x:Key="ToCategorizeRow" x:DataType="vm:TransactionRow">
        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HelmCardStroke}" Padding="0,0,0,10">
            <StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TransactionRow}" />
                <WrapPanel Margin="12,0">
                    <Button Classes="chip dashed" Command="{Binding AcceptProposedCategoryCommand}" IsVisible="{Binding HasProposedCategory}"
                            AutomationProperties.Name="{Binding ProposedCategoryText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Sparkle" FontSize="16" Margin="6,0,0,0" Foreground="{DynamicResource AccentButtonBackground}" />
                            <TextBlock Text="{Binding ProposedCategoryText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Suggestions}" ItemTemplate="{StaticResource SuggestionChip}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Classes="chip dashed" Command="{Binding OpenDebtFormCommand}" IsVisible="{Binding CanBeDebt}" AutomationProperties.Name="Lent, borrowed or paid back">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="PersonMoney" FontSize="16" Margin="6,0,0,0" />
                            <TextBlock Text="Lent, borrowed…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A fund in the strip: its honey pot, name, what is left or over (a tap opens it) -->
    <DataTemplate x:Key="FundTile" x:DataType="vm:FundRow">
        <Button Classes="fund" Classes.over="{Binding IsOver}" Classes.usedup="{Binding IsUsedUp}" Classes.low="{Binding IsLow}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}"
                AutomationProperties.HelpText="{Binding StatusText}">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <vm:FundJar Width="52" Height="66" HorizontalAlignment="Center" Level="{Binding LeftShare}" Color="{Binding Color}" Status="{Binding Status}"
                            Text="{Binding PercentText}" TextSize="12" />
                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" MaxWidth="96" />
                <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                    <ic:SymbolIcon Symbol="Warning" FontSize="12" Foreground="{DynamicResource HelmDanger}" IsVisible="{Binding IsOver}" VerticalAlignment="Center" />
                    <ic:SymbolIcon Symbol="Warning" FontSize="12" Foreground="#C98500" IsVisible="{Binding IsUsedUp}" VerticalAlignment="Center" />
                    <ic:SymbolIcon Symbol="Warning" FontSize="12" Foreground="#C98500" IsVisible="{Binding IsLow}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BigShort}" FontSize="13" FontWeight="SemiBold" Classes.danger="{Binding IsOver}" />
                    <TextBlock Text="{Binding BigLabel}" Classes="secondary" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- A person in the debt book: a tap opens their sheet -->
    <DataTemplate x:Key="PersonRow" x:DataType="vm:DebtPersonViewModel">
        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HelmCardStroke}">
            <Button Classes="flat" Padding="12,10" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0" Background="{Binding Name, Converter={x:Static vm:WalletConverters.PersonFill}}">
                        <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding Name, Converter={x:Static vm:WalletConverters.PersonInk}}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" Classes="secondary" Classes.overdue="{Binding IsOverdue}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding BalanceText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                               Classes.owed="{Binding OwedToMe}" Classes.iowe="{Binding IOwe}" />
                </Grid>
            </Button>
        </Border>
    </DataTemplate>

    <!-- A slice of the donut, named: badge, name, a bar of its share, amount and share -->
    <DataTemplate x:Key="LegendRow" x:DataType="vm:DonutSegment">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5">
            <vm:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="32" Margin="0,0,10,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <ProgressBar MinWidth="0" Height="6" MinHeight="6" Minimum="0" Maximum="1" Background="Transparent" Value="{Binding Share}"
                             Foreground="{Binding Color, Converter={x:Static vm:WalletConverters.Ink}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding ShareText}" Classes="secondary" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- Money in by category -->
    <DataTemplate x:Key="EarningRow" x:DataType="vm:CategorySpendRow">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5">
            <vm:CategoryBadge Icon="{Binding Icon}" Color="{Binding Color}" Size="32" Margin="0,0,10,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding CountText}" Classes="secondary" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding ShareText}" Classes="secondary" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- A savings goal: its photo lit up to what is saved, the money under it; a tap opens its sheet -->
    <DataTemplate x:Key="GoalTile" x:DataType="vm:GoalRow">
        <Button Classes="goal" Classes.ready="{Binding IsReady}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding LeftText}">
            <StackPanel>
                <Panel Height="168">
                    <vm:GoalPicture Photo="{Binding Photo}" Share="{Binding Share}" Color="{Binding Color}" Initial="{Binding Initial}" CornerRadius="9" />
                    <TextBlock Text="{Binding PercentText}" Classes="onPhoto" FontSize="26" Margin="12,0,0,8" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    <Border Classes="readyTag" IsVisible="{Binding IsReady}">
                        <TextBlock Text="Ready" FontSize="11" FontWeight="SemiBold" Foreground="#2A1C00" />
                    </Border>
                </Panel>
                <StackPanel Margin="14,10,14,12" Spacing="2">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding PriceShort}" Classes="secondary" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock>
                        <Run Text="{Binding SavedText}" FontWeight="SemiBold" />
                        <Run Text="saved" Foreground="{DynamicResource HelmSecondaryText}" />
                    </TextBlock>
                    <ProgressBar Classes="goal" Classes.ready="{Binding IsReady}" Value="{Binding Percent}" Margin="0,6,0,4" />
                    <TextBlock Text="{Binding LeftText}" Classes="secondary" FontSize="13" />
                    <TextBlock Text="{Binding PaceText}" Classes="secondary" FontSize="13" IsVisible="{Binding HasPace}" />
                </StackPanel>
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- A goal bought or given up: a small photo, what happened -->
    <DataTemplate x:Key="FinishedGoalRow" x:DataType="vm:GoalRow">
        <Button Classes="goalRow" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding EndedText}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <vm:GoalPicture Width="56" Height="42" CornerRadius="5" Margin="0,0,12,0" Photo="{Binding Photo}" Share="{Binding Share}" Color="{Binding Color}" Initial="{Binding Initial}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding EndedText}" Classes="secondary" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2" Classes="state" Margin="8,0,0,0">
                    <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
