<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the shared Avalonia UI (Helm.Ui, Helm.Modules.<X>.UI) on Avalonia's headless platform: no window opens.
       Separate from Helm.Tests: Avalonia.Headless.XUnit needs xUnit v3, and the headless platform must not share a
       process with the Win32 Avalonia that Helm.Ui.Windows starts. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Helm.Ui\Helm.Ui.csproj" />
    <ProjectReference Include="..\..\src\Helm.Modules.Tracker.UI\Helm.Modules.Tracker.UI.csproj" />
    <ProjectReference Include="..\..\src\Helm.Modules.Vault.UI\Helm.Modules.Vault.UI.csproj" />
    <ProjectReference Include="..\..\src\Helm.Shell.UI\Helm.Shell.UI.csproj" />
    <ProjectReference Include="..\..\src\Helm.ToolIcons\Helm.ToolIcons.csproj" />
    <ProjectReference Include="..\..\src\Helm.Modules.Notes.UI\Helm.Modules.Notes.UI.csproj" />
    <ProjectReference Include="..\..\src\Helm.Modules.Scratch.UI\Helm.Modules.Scratch.UI.csproj" />
    <ProjectReference Include="..\..\src\Helm.Modules.Habits.UI\Helm.Modules.Habits.UI.csproj" />
  </ItemGroup>

  <!-- The Gallery's in-memory stand-ins, so a page runs with its real view model here too. -->
  <ItemGroup>
    <Compile Include="..\..\src\Helm.Gallery\Fakes.cs" Link="Fakes.cs" />
    <Compile Include="..\..\src\Helm.Gallery\VaultDemo.cs" Link="VaultDemo.cs" />
    <Compile Include="..\..\src\Helm.Gallery\HomeDemo.cs" Link="HomeDemo.cs" />
    <Compile Include="..\..\src\Helm.Gallery\NotesDemo.cs" Link="NotesDemo.cs" />
    <Compile Include="..\..\src\Helm.Gallery\ScratchDemo.cs" Link="ScratchDemo.cs" />
    <Compile Include="..\..\src\Helm.Gallery\HabitsDemo.cs" Link="HabitsDemo.cs" />
  </ItemGroup>

</Project>
